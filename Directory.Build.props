<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Vast op C# 12 (standaard voor .NET 8): nieuwere SDK's op de build-server veranderen anders de betekenis van code -->
    <LangVersion>12</LangVersion>
    <Company>Moss365 contributors</Company>
    <Product>Moss365</Product>
    <Version>0.10.0</Version>
  </PropertyGroup>
</Project>
