<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Fixed at C# 12 (the default for .NET 8): otherwise newer SDKs on the build server change the meaning of code -->
    <LangVersion>12</LangVersion>
    <Company>Moss365 contributors</Company>
    <Product>Moss365</Product>
    <Version>0.13.0</Version>
  </PropertyGroup>
</Project>
