@using Moss365.Core.Helpdesk
@* Message trace for one user (R10, 0.33): did the mail arrive, and if not, why. Read only, in the access log. *@
@inject ManagementState State

<section class="kb-kaart">
    <h2>@T["message-trace-card.message-trace"]</h2>
    <p class="kb-zacht">@T["message-trace-card.did-the-mail-arrive-and"]</p>
    <div class="kb-filters">
        <label><input type="checkbox" @bind="received" /> @T["message-trace-card.received"]</label>
        <label><input type="checkbox" @bind="sent" /> @T["message-trace-card.sent"]</label>
        <label>@T["message-trace-card.days"]
            <select class="kb-invoer" @bind="days" aria-label="@T["message-trace-card.days"]"><option value="1">1</option><option value="2">2</option><option value="7">7</option><option value="10">10</option></select>
        </label>
        <input class="kb-invoer" placeholder="@T["message-trace-card.only-with-this-address-optional"]" @bind="other" aria-label="@T["message-trace-card.other-address"]" />
        <button class="kb-knop" disabled="@(busy || (!received && !sent))" @onclick="Load">@T["message-trace-card.look-up"]</button>
        @if (busy) { <span class="kb-zacht">@T["message-trace-card.busy"]</span> }
    </div>
    @if (error is not null) { <div class="kb-melding kb-fout">@error</div> }
    @if (rows is not null)
    {
        <p>@Shown.Count bericht(en)@(Shown.Count(r => !Delivered(r)) is var n && n > 0 ? T.Format("code.message-trace-card.of-which-not-delivered", n) : null).</p>
        <table class="kb-tabel">
            <thead><tr><th>@T["message-trace-card.when"]</th><th>@T["absence-card.from"]</th><th>@T["message-trace-card.to"]</th><th>@T["message-trace-card.subject"]</th><th>@T["service-health-card.status"]</th></tr></thead>
            <tbody>
                @foreach (var r in Shown.Take(200))
                {
                    <tr class="@(Delivered(r) ? null : "kb-verschil")">
                        <td>@r.Received.LocalDateTime.ToString("dd/MM HH:mm")</td><td>@r.Sender</td><td>@r.Recipient</td><td>@r.Subject</td><td>@StatusText(r.Status)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    [Parameter, EditorRequired] public Person Person { get; set; } = default!;

    private bool received = true;
    private bool sent;
    private int days = 2;
    private string other = string.Empty;
    private bool busy;
    private string? error;
    private IReadOnlyList<MessageTraceRow>? rows;

    private string Address => Person.Entra?.Mail is { Length: > 0 } m ? m : Person.Upn;

    private IReadOnlyList<MessageTraceRow> Shown => (rows ?? Array.Empty<MessageTraceRow>())
        .Where(r => other.Trim().Length == 0 || r.Sender.Contains(other.Trim(), StringComparison.OrdinalIgnoreCase) || r.Recipient.Contains(other.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private static bool Delivered(MessageTraceRow r) => r.Status is "Delivered" or "Expanded" or "Resolved";

    private static string StatusText(string s) => s switch
    {
        "Delivered" => "afgeleverd",
        "Failed" => "mislukt",
        "FilteredAsSpam" => "als spam tegengehouden",
        "Quarantined" => "in quarantaine",
        "Pending" => "onderweg",
        "Expanded" => "uitgebreid (groep)",
        "GettingStatus" => "status ophalen",
        _ => s,
    };

    private async Task Load()
    {
        busy = true;
        error = null;
        try
        {
            rows = await State.MessageTraceAsync(Address, received, sent, days);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
