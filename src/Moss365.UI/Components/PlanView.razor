@* Shows a plan, lets you choose and runs after confirmation. While the plan is ready, it registers itself with
   ManagementState.Pending: the work area gets a tint and a bar, the menu a dot. *@
@implements IDisposable
@inject ManagementState State
@inject NavigationManager Nav

@if (!discarded)
{
<section class="kb-kaart kb-plan" id="@anchor">
    <h2>@Title</h2>
    @if (Plan.Count == 0)
    {
        <p class="kb-zacht">@T["plan.nothing"]</p>
    }
    else
    {
        @if (results is null)
        {
            <p class="kb-zacht">
                @Html("plan.intro")
                @if (Plan.Any(w => w.TargetSystem == TargetSystem.Exchange && w.Selected))
                {
                    <br />@T["plan.exchange"]
                }
            </p>
            @if (Run is null && State.MissingConnections(Plan) is { Count: > 0 } ontbreekt)
            {
                <div class="kb-melding kb-fout">
                    @T.Format("plan.noconnection", string.Join(", ", ontbreekt.Select(SystemName))) <a href="verbindingen">@T["plan.setconnections"]</a>
                </div>
            }
        }

        <table class="kb-tabel">
            <thead>
                <tr>
                    <th>@if (results is null) { <input type="checkbox" title="@T["plan.all"]" checked="@Plan.All(w => w.Selected)" @onchange="AllOnOff" /> }</th>
                    <th>@T["plan.system"]</th><th>@T["plan.change"]</th><th>@T["plan.object"]</th><th>@T["plan.now"]</th><th>@T["plan.becomes"]</th>
                    @if (results is not null) { <th>@T["plan.result"]</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var w in Plan)
                {
                    var r = results?.FirstOrDefault(x => x.ChangeId == w.Id);
                    <tr class="@RowClass(w, r)">
                        <td>
                            @if (results is null)
                            {
                                <input type="checkbox" aria-label="@w.Description" checked="@w.Selected" @onchange="e => Set(w, e)" disabled="@(busy || Refused(w) is not null)" />
                            }
                        </td>
                        <td><PlatformLabel Platform="@Platforms.Of(w)" /></td>
                        <td>
                            @w.Description
                            @if (w.Warning is not null) { <div class="kb-waarschuwing">@w.Warning</div> }
                            @if (results is null && Refused(w) is { } reason) { <div class="kb-waarschuwing kb-geweigerd">@T.Format("plan.refused", reason)</div> }
                        </td>
                        <td><ObjectLink Id="@w.Target" Text="@(w.TargetName.Length > 0 ? w.TargetName : null)" /></td>
                        <td class="kb-zacht">@w.CurrentValue</td>
                        <td>@w.NewValue</td>
                        @if (results is not null)
                        {
                            <td>@(r is null ? T["plan.notrun"] : r.Status switch { ResultStatus.Succeeded => T["plan.succeeded"], ResultStatus.Failed => T["plan.failed"], _ => T["plan.skipped"] }) <span class="kb-zacht">@r?.Message</span></td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        @if (results is null)
        {
            <div class="kb-filters">
                @if (!confirm)
                {
                    <button class="kb-knop kb-primair" disabled="@(Selected == 0 || busy)" @onclick="() => confirm = true">@T.Format("plan.run", Selected)</button>
                }
                else
                {
                    <span style="--kb-tenant: @State.Tenant.Colour">@Html("plan.confirm", Selected, string.Join(", ", Plan.Where(w => w.Selected).Select(w => w.SystemText).Distinct()), State.Tenant.Name)</span>
                    @if (Selected > BulkPlans.LargePlan)
                    {
                        <label class="kb-groot-plan"><input type="checkbox" @bind="largeConfirmed" /> @Html("plan.large", Selected)</label>
                    }
                    <button class="kb-knop kb-gevaar" disabled="@(busy || (Selected > BulkPlans.LargePlan && !largeConfirmed))" @onclick="Execute">@T.Format("plan.yes", State.Tenant.Name)</button>
                    <button class="kb-knop" disabled="@busy" @onclick="() => confirm = false">@T["action.cancel"]</button>
                }
                @if (progress is not null) { <span class="kb-zacht">@progress</span> }
            </div>
            @if (error is not null) { <div class="kb-melding kb-fout">@error</div> }
        }
        else
        {
            <div class="kb-melding @(results.All(r => r.Status == ResultStatus.Succeeded) ? "kb-goed" : "kb-fout")">
                @T.Format("plan.summary", results.Count(r => r.Status == ResultStatus.Succeeded), results.Count(r => r.Status == ResultStatus.Failed), results.Count(r => r.Status == ResultStatus.Skipped))
                @if (State.TaskBusy)
                {
                    @T["plan.rereading"]
                }
                else
                {
                    @T["plan.reread"]
                }
            </div>
        }
    }
</section>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Change> Plan { get; set; } = Array.Empty<Change>();
    [Parameter] public string Title { get; set; } = T["plan.title"];
    [Parameter, EditorRequired] public string Context { get; set; } = string.Empty;
    [Parameter] public EventCallback<IReadOnlyList<ChangeResult>> Executed { get; set; }

    /// <summary>Runs the plan another way than the connections of the app (the wizard, with its own sign-in).</summary>
    [Parameter] public Func<IReadOnlyList<Change>, string, IProgress<string>, Task<IReadOnlyList<ChangeResult>>>? Run { get; set; }

    private IReadOnlyList<ChangeResult>? results;
    private bool confirm;
    private bool busy;
    private string? progress;
    private string? error;
    private IReadOnlyList<Change>? previousPlan;

    private int Selected => Plan.Count(w => w.Selected);

    private string? Refused(Change w) => PermissionTable.Refusal(State.Roles, w, State.Data);

    private readonly string anchor = "plan-" + Guid.NewGuid().ToString("N")[..8];
    private bool discarded;
    private bool largeConfirmed;
    private string? path;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(previousPlan, Plan))
        {
            previousPlan = Plan;
            results = null;
            confirm = false;
            error = null;
            progress = null;
            discarded = false;
            largeConfirmed = false;

            // What the profile does not allow is off (the engine would refuse it anyway)
            foreach (var w in Plan.Where(w => Refused(w) is not null))
            {
                w.Selected = false;
            }
        }

        Report();
    }

    /// <summary>Register with or unregister from Pending: registered while something is ready that has not run or been discarded.</summary>
    private void Report()
    {
        var now = Pending.Normalise(Nav.ToBaseRelativePath(Nav.Uri));
        if (path is not null && path != now)
        {
            State.Pending.Route(path, OpenKind.Plan, this);
        }

        path = now;
        if (discarded || results is not null || Plan.Count == 0)
        {
            State.Pending.Route(path, OpenKind.Plan, this);
            return;
        }

        State.Pending.Set(new OpenItem(path, OpenKind.Plan, T.Format("plan.pending", Selected, Selected == 1 ? T["plan.change.one"] : T["plan.change.more"]))
        {
            Count = Selected,
            Screen = Title,
            Anchor = "#" + anchor,
            Discard = Discard,
        }, this);
    }

    private Task Discard() => InvokeAsync(() =>
    {
        discarded = true;
        Report();
        StateHasChanged();
    });

    public void Dispose()
    {
        if (path is not null)
        {
            State.Pending.Route(path, OpenKind.Plan, this);
        }
    }

    private static string SystemName(TargetSystem s) => s switch
    {
        TargetSystem.ActiveDirectory => "AD",
        TargetSystem.Graph => "Entra (Graph)",
        _ => "Exchange",
    };

    private static string? RowClass(Change w, ChangeResult? r) => r?.Status switch
    {
        ResultStatus.Succeeded => "kb-gelukt",
        ResultStatus.Failed => "kb-ontbreekt",
        ResultStatus.Skipped => "kb-zacht",
        _ => w.Selected ? null : "kb-uit",
    };

    private void Set(Change w, ChangeEventArgs e)
    {
        w.Selected = e.Value is true || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        confirm = false;
        Report();
    }

    private void AllOnOff(ChangeEventArgs e)
    {
        var enabled = e.Value is true || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        foreach (var w in Plan)
        {
            w.Selected = enabled && Refused(w) is null;
        }

        confirm = false;
        Report();
    }

    private async Task Execute()
    {
        busy = true;
        error = null;
        try
        {
            var reporter = new Progress<string>(t =>
            {
                progress = t;
                _ = InvokeAsync(StateHasChanged);
            });
            results = Run is { } run ? await run(Plan, Context, reporter) : await State.ExecuteAsync(Plan, Context, reporter);
            Report();
            await Executed.InvokeAsync(results);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
            confirm = false;
            progress = null;
        }
    }
}
