@* Editing a user (0.8; R21 in sections): identity, organisation, contact and access, each with its current values and
   edited in place. The app chooses the route from the source of truth (AD for a synchronised account, Entra follows;
   otherwise Graph; the usage location always in Entra), checks while typing, and makes one plan with the previous
   values in the change log (can be undone). *@
@inject ManagementState State

<section class="kb-kaart kb-bewerken">
    <h2>
        @T["edit-user.edit-details"]
        <PlatformLabel Platform="@(viaAd ? Platform.ActiveDirectory : Platform.EntraId)" />
        @if (viaAd && Person.Entra is not null) { <span class="kb-zacht kb-klein-tekst">@T["edit-user.entra-follows"]</span> }
    </h2>
    <p class="kb-zacht">@T.Format("edit-user.0-you-do-not-change", viaAd ? T["code.edit-user.this-account-comes-from-ad"] : T["code.edit-user.cloud-account-the-app-changes"])</p>

    <div class="kb-secties">
        @foreach (var section in Sections.Where(s => s.Fields.Any(Visible)))
        {
            var editing = open.Contains(section.Key);
            <div class="kb-sectie">
                <div class="kb-sectie-kop">
                    <h3>@T["edit-user.section." + section.Key]</h3>
                    @if (!editing && CanEdit)
                    {
                        <button class="kb-knop kb-klein" @onclick="() => Open(section.Key)">@T["edit-user.edit"]</button>
                    }
                </div>
                <dl class="kb-velden">
                    @if (!editing && section.Key == "extra" && section.Fields.Where(Visible).All(f => CurrentText(f).Length == 0))
                    {
                        <dd class="kb-zacht">@T["edit-user.no-extensions"]</dd>
                    }
                    @* Extension attributes: only the filled in ones, until you edit them *@
                    @foreach (var field in section.Fields.Where(Visible).Where(f => editing || section.Key != "extra" || CurrentText(f).Length > 0))
                    {
                        var current = CurrentText(field);
                        <dt>
                            @Label(field)
                            @if (field == nameof(UserDesired.UsageLocation) && viaAd) { <PlatformLabel Platform="Platform.EntraId" /> }
                        </dt>
                        <dd>
                            @if (!editing)
                            {
                                <span>@(current.Length > 0 ? current : EmptyText(field))</span>
                            }
                            else
                            {
                                @Input(field)
                                @if (Changed(field)) { <div class="kb-zacht kb-klein-tekst">@T.Format("edit-user.now", current.Length > 0 ? current : EmptyText(field))</div> }
                                @if (Problem(field) is { } problem) { <div class="kb-waarschuwing">@problem</div> }
                            }
                        </dd>
                    }
                </dl>
            </div>
        }
    </div>

    @if (open.Count > 0)
    {
        @if (SignInChanges)
        {
            <p><label>
                <input type="checkbox" checked="@signInConfirmed" @onchange="e => signInConfirmed = e.Value is true" />
                @T.Format("edit-user.sign-in-confirm", Person.Name)
            </label></p>
        }
        @if (AddressChanges)
        {
            <p><label>
                <input type="checkbox" checked="@addressConfirmed" @onchange="e => addressConfirmed = e.Value is true" />
                @T.Format("edit-user.address-confirm", Person.Name, desired.PrimaryAddress?.Trim())
            </label></p>
        }
        <div class="kb-filters">
            <button class="kb-knop kb-primair" disabled="@(Problems > 0 || (SignInChanges && !signInConfirmed) || (AddressChanges && !addressConfirmed))" @onclick="MakePlan">@T["bulk-tasks.make-plan"]</button>
            <button class="kb-knop" @onclick="Empty">@T["edit-user.reset"]</button>
            <button class="kb-knop" @onclick="Close">@T["edit-user.close"]</button>
            @if (ChangedCount > 0) { <span class="kb-label">@T.Format("edit-user.changed", ChangedCount)</span> }
        </div>
    }
    @foreach (var f in errors)
    {
        <div class="kb-melding">@f</div>
    }
</section>

@if (plan is not null)
{
    <PlanView Plan="plan" Context="@($"Gegevens {Person.Name}")" Title="@T["edit-user.edit-details"]" Executed="AfterExecute" />
}

@code {
    [Parameter, EditorRequired] public Person Person { get; set; } = default!;

    private sealed record Section(string Key, string[] Fields);

    /// <summary>The sections of a user (R21), in the order of the page.</summary>
    private static readonly Section[] Sections =
    {
        new("identity", new[] { nameof(UserDesired.DisplayName), nameof(UserDesired.GivenName), nameof(UserDesired.Surname), nameof(UserDesired.EmployeeId), nameof(UserDesired.EmployeeType) }),
        new("organisation", new[] { nameof(UserDesired.JobTitle), nameof(UserDesired.Department), nameof(UserDesired.Company), nameof(UserDesired.Office), nameof(UserDesired.Manager), nameof(UserDesired.Description) }),
        new("contact", new[] { nameof(UserDesired.Phone), nameof(UserDesired.Mobile), nameof(UserDesired.HomePhone), nameof(UserDesired.Fax), nameof(UserDesired.IpPhone), nameof(UserDesired.StreetAddress), nameof(UserDesired.PostalCode), nameof(UserDesired.City), nameof(UserDesired.State), nameof(UserDesired.Country), nameof(UserDesired.UsageLocation) }),
        new("access", new[] { nameof(UserDesired.Upn), nameof(UserDesired.PrimaryAddress), nameof(UserDesired.AccountExpires), nameof(UserDesired.LogonScript) }),
        new("extra", UserDesired.ExtensionFields.ToArray()),
    };

    private readonly HashSet<string> open = new();
    private UserDesired desired = new();
    private UserDesired current = new();
    private IReadOnlyList<Change>? plan;
    private IReadOnlyList<string> errors = Array.Empty<string>();
    private string? loaded;
    private bool viaAd;
    private bool signInConfirmed;
    private bool addressConfirmed;
    private IReadOnlyCollection<string> upnDomains = Array.Empty<string>();

    private string Form => $"gebruiker/{Person.Key}/bewerken";

    private bool CanEdit => !State.IsHistoric && State.Can(Moss365.Core.Permissions.Permission.Manage);

    protected override void OnParametersSet()
    {
        if (loaded != Person.Key)
        {
            loaded = Person.Key;
            viaAd = AttributePlans.ViaAd(Person);
            upnDomains = AttributePlans.UpnDomains(State.Data);
            signInConfirmed = false;
            addressConfirmed = false;
            current = UserDesired.Of(Person, State.Data);
            open.Clear();
            if (State.PageState.Has(Form))
            {
                desired = Saved();
                foreach (var s in Sections) open.Add(s.Key);
            }
            else
            {
                desired = UserDesired.Of(Person, State.Data);
            }

            plan = null;
            errors = Array.Empty<string>();
        }
    }

    /// <summary>A field the account has: AD-only fields for an account from AD, the usage location with Entra.</summary>
    private bool Visible(string field)
    {
        if (field == nameof(UserDesired.PrimaryAddress))
        {
            return AttributePlans.HasPrimaryAddress(Person);
        }

        if (field.StartsWith("ExtensionAttribute", StringComparison.Ordinal) && !AttributePlans.HasExtensions(State.Data, Person))
        {
            return false;
        }

        var (_, inAd, inEntra) = field == nameof(UserDesired.Manager) ? (field, true, true) : AttributePlans.UserFields.First(f => f.Field == field);
        return (viaAd && inAd) || (Person.Entra is not null && inEntra);
    }

    // What you filled in is kept until the plan has run (Back, Forward, menu)
    private UserDesired Saved() => State.PageState.Form(Form, "gebruiker/" + Person.Key, $"Gegevens {Person.Name}", () => UserDesired.Of(Person, State.Data));

    private void Open(string section)
    {
        if (open.Count == 0)
        {
            desired = Saved();
        }

        open.Add(section);
    }

    private void Close()
    {
        open.Clear();
        signInConfirmed = false;
        addressConfirmed = false;
        desired = UserDesired.Of(Person, State.Data);
    }

    private void Empty()
    {
        State.PageState.Forget(Form);
        desired = Saved();
        plan = null;
        errors = Array.Empty<string>();
    }

    private static string? Get(UserDesired d, string field) => (string?)typeof(UserDesired).GetProperty(field)!.GetValue(d);

    private void Set(string field, string? value) => typeof(UserDesired).GetProperty(field)!.SetValue(desired, value);

    private string Label(string field) => field == nameof(UserDesired.Manager) ? T["reports.manager"] : AttributePlans.FieldName(field);

    /// <summary>An empty value: no expiry date is "never".</summary>
    private string EmptyText(string field) => field == nameof(UserDesired.AccountExpires) ? T["edit-user.never"] : T["edit-user.empty"];

    private string CurrentText(string field) => field == nameof(UserDesired.Manager)
        ? (string.IsNullOrEmpty(current.Manager) ? string.Empty : State.Data.SearchPerson(current.Manager)?.Name ?? string.Empty)
        : Get(current, field) ?? string.Empty;

    private bool Changed(string field) => !string.Equals((Get(desired, field) ?? string.Empty).Trim(), (Get(current, field) ?? string.Empty).Trim(), StringComparison.Ordinal);

    private int ChangedCount => Sections.SelectMany(s => s.Fields).Count(f => Visible(f) && Changed(f));

    /// <summary>The sign-in name or the logon name changes: the person signs in differently afterwards (R21).</summary>
    private bool SignInChanges => AttributePlans.SignInFields.Any(f => Visible(f) && Changed(f));

    /// <summary>The primary address changes: the person sends from the new one afterwards (R21).</summary>
    private bool AddressChanges => Visible(nameof(UserDesired.PrimaryAddress)) && Changed(nameof(UserDesired.PrimaryAddress));

    private int Problems => Sections.SelectMany(s => s.Fields).Count(f => Visible(f) && Problem(f) is not null && !Warning(f));

    /// <summary>Only a warning: a duplicate employee id may be right (two accounts of one person), a new UPN domain
    /// may be verified already.</summary>
    private bool Warning(string field)
    {
        var value = (Get(desired, field) ?? string.Empty).Trim();
        return field switch
        {
            nameof(UserDesired.EmployeeId) => AttributePlans.ValidValue(field, value),
            nameof(UserDesired.Upn) or nameof(UserDesired.PrimaryAddress) => AttributePlans.ValidValue(field, value) && AttributePlans.Taken(State.Data, Person, field, value) is null,
            nameof(UserDesired.AccountExpires) => AttributePlans.ValidValue(field, value),
            _ => false,
        };
    }

    /// <summary>What is wrong with a value, while typing (R21).</summary>
    private string? Problem(string field)
    {
        if (field == nameof(UserDesired.Manager) || !Changed(field))
        {
            return null;
        }

        var value = (Get(desired, field) ?? string.Empty).Trim();
        if (!AttributePlans.ValidValue(field, value))
        {
            return T["attribute.invalid.hint." + field.ToLowerInvariant()] is var hint && !hint.StartsWith("attribute.", StringComparison.Ordinal) ? hint : T.Format("attribute.invalid", Label(field));
        }

        if (AttributePlans.Taken(State.Data, Person, field, value) is { } holder)
        {
            return T.Format("attribute.taken", Label(field), holder);
        }

        if (field == nameof(UserDesired.AccountExpires) && AttributePlans.ExpiresBeforeToday(value))
        {
            return T.Format("attribute.expires-past", value);
        }

        if (field is nameof(UserDesired.Upn) or nameof(UserDesired.PrimaryAddress) && upnDomains.Count > 0 && value[(value.IndexOf('@') + 1)..] is var domain && !upnDomains.Contains(domain))
        {
            return T.Format("edit-user.upn-domain", domain);
        }

        return field == nameof(UserDesired.EmployeeId) && AttributePlans.SameEmployeeId(State.Data, Person, value) is { } other
            ? T.Format("edit-user.duplicate-employee", other.Name)
            : null;
    }

    private RenderFragment Input(string field) => field switch
    {
        nameof(UserDesired.Department) => @<select class="kb-invoer" value="@desired.Department" @onchange="e => desired.Department = e.Value?.ToString()" aria-label="@Label(field)">
                                              <option value="">@T["edit-user.empty"]</option>
                                              @foreach (var d in Choices(State.Config.Departments.Select(d => d.Department), desired.Department)) { <option value="@d">@d</option> }
                                          </select>,
        nameof(UserDesired.Office) => @<select class="kb-invoer" value="@desired.Office" @onchange="e => desired.Office = e.Value?.ToString()" aria-label="@Label(field)">
                                          <option value="">@T["edit-user.empty"]</option>
                                          @foreach (var k in Choices(State.Config.Offices, desired.Office)) { <option value="@k">@k</option> }
                                      </select>,
        nameof(UserDesired.LogonScript) => @<select class="kb-invoer" value="@desired.LogonScript" @onchange="e => desired.LogonScript = e.Value?.ToString()" aria-label="@Label(field)">
                                               <option value="">@T["edit-user.none"]</option>
                                               @foreach (var s in Choices(State.Config.LogonScripts, desired.LogonScript)) { <option value="@s">@s</option> }
                                           </select>,
        nameof(UserDesired.Manager) => @<div>
                                           <PersonPicker Label="@T["reports.manager"]" Selected="@(string.IsNullOrEmpty(desired.Manager) ? null : State.Data.SearchPerson(desired.Manager))" SelectedChanged="ChooseManager" />
                                           @if (!string.IsNullOrEmpty(desired.Manager)) { <button class="kb-knop kb-klein" @onclick="() => desired.Manager = string.Empty">@T["edit-user.no-manager"]</button> }
                                       </div>,
        nameof(UserDesired.UsageLocation) => @<input class="kb-invoer kb-smal" maxlength="2" value="@desired.UsageLocation" @oninput="e => desired.UsageLocation = e.Value?.ToString()?.ToUpperInvariant()" aria-label="@Label(field)" placeholder="BE" />,
        nameof(UserDesired.Upn) or nameof(UserDesired.PrimaryAddress) => @<input class="kb-invoer" value="@Get(desired, field)" @oninput="e => Set(field, e.Value?.ToString())" aria-label="@Label(field)" autocomplete="off" spellcheck="false" />,
        nameof(UserDesired.AccountExpires) => @<div>
                                                  <input class="kb-invoer kb-smal" type="date" value="@desired.AccountExpires" @onchange="e => desired.AccountExpires = e.Value?.ToString()" aria-label="@Label(field)" />
                                                  @if (!string.IsNullOrEmpty(desired.AccountExpires)) { <button class="kb-knop kb-klein" @onclick="() => desired.AccountExpires = string.Empty">@T["edit-user.never-expires"]</button> }
                                              </div>,
        nameof(UserDesired.Phone) or nameof(UserDesired.Mobile) or nameof(UserDesired.HomePhone) or nameof(UserDesired.Fax) => @<input class="kb-invoer" type="tel" value="@Get(desired, field)" @oninput="e => Set(field, e.Value?.ToString())" aria-label="@Label(field)" />,
        _ => @<input class="kb-invoer" value="@Get(desired, field)" @oninput="e => Set(field, e.Value?.ToString())" aria-label="@Label(field)" />,
    };

    private void ChooseManager(Person? p) => desired.Manager = p?.Key ?? string.Empty;

    /// <summary>The choice list, with the current value added when it is not (yet) in it.</summary>
    private static IEnumerable<string> Choices(IEnumerable<string> list, string? current)
    {
        var l = list.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
        if (!string.IsNullOrWhiteSpace(current) && !l.Contains(current, StringComparer.OrdinalIgnoreCase))
        {
            l.Insert(0, current);
        }

        return l;
    }

    private void MakePlan()
    {
        var u = AttributePlans.User(State.Data, State.Config, Person, desired);
        errors = u.Errors;
        plan = u.Plan.Count > 0 ? u.Plan : null;
    }

    private void AfterExecute(IReadOnlyList<ChangeResult> results)
    {
        if (results.Any(r => r.Status == ResultStatus.Succeeded))
        {
            State.PageState.Forget(Form);
            open.Clear();
        }
    }
}
