@* MFA, admin roles, privileged AD groups and (live) sign-ins of one person *@
@inject ManagementState State

<section class="kb-kaart kb-beveiliging">
    <h2>@T["group.beveiliging"]</h2>
    <table class="kb-tabel kb-naast">
        <tbody>
            <tr>
                <th>@T["security-card.mfa"]</th>
                <td>
                    @if (Person.Entra is null)
                    {
                        <span class="kb-zacht">@T["security-card.no-entra-account"]</span>
                    }
                    else if (State.Data.Security is not { MfaKnown: true } b)
                    {
                        <span class="kb-zacht">@T["security-card.unknown-load-live-connections-load"]</span>
                    }
                    else if (b.MfaOf(Person.Entra.Id) is not { } m)
                    {
                        <span class="kb-zacht">@T["security-card.not-in-the-report"]</span>
                    }
                    else if (m.MfaRegistered)
                    {
                        <span class="kb-label kb-label-goed">@T["security-card.registered"]</span>
                        <span>@string.Join(", ", m.Methods.Select(SecurityStatistics.MethodName))</span>
                        @if (m.DefaultMethod.Length > 0) { <span class="kb-zacht">@T.Format("security-card.default-0", SecurityStatistics.MethodName(m.DefaultMethod))</span> }
                    }
                    else
                    {
                        <span class="kb-label kb-rood">@T["security-card.no-mfa"]</span>
                        @if (m.Methods.Count > 0) { <span class="kb-zacht">@T.Format("security-card.only-0", string.Join(", ", m.Methods.Select(SecurityStatistics.MethodName)))</span> }
                    }
                </td>
            </tr>
            <tr>
                <th>@T["security-card.entra-admin-roles"]</th>
                <td>
                    @if (State.Data.Security is not { RolesKnown: true } br)
                    {
                        <span class="kb-zacht">@T["security-card.unknown"]</span>
                    }
                    else if (br.RolesOf(Person.Entra?.Id).ToList() is { Count: > 0 } roles)
                    {
                        @foreach (var r in roles)
                        {
                            <span class="kb-label @(SecurityData.IsCriticalRole(r.Role) ? "kb-rood" : null)">@r.Role</span>
                        }
                    }
                    else
                    {
                        <span class="kb-zacht">@T["security-card.none"]</span>
                    }
                </td>
            </tr>
            <tr>
                <th>@T["security-card.privileged-ad-groups"]</th>
                <td>
                    @if (State.Data.AdGroupsOf(Person).Where(MirrorUser.IsPrivileged).ToList() is { Count: > 0 } groups)
                    {
                        @foreach (var g in groups)
                        {
                            <span class="kb-label kb-rood">@g.Name</span>
                        }
                    }
                    else
                    {
                        <span class="kb-zacht">@T["security-card.none"]</span>
                    }
                </td>
            </tr>
        </tbody>
    </table>

    @if (Person.Entra is { } entra)
    {
        <div class="kb-filters">
            <button class="kb-knop" disabled="@busy" @onclick="() => Load(entra.Id)">@T["security-card.load-sign-ins-30-days"]</button>
            <label><input type="checkbox" @bind="onlyFailed" /> @T["security-card.only-failed"]</label>
        </div>
        @if (error is not null)
        {
            <div class="kb-melding kb-fout">@error</div>
        }
        else if (signIns is not null)
        {
            <SignInList SignIns="signIns" WithUser="false" />
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public Person Person { get; set; } = default!;

    private IReadOnlyList<SignInEvent>? signIns;
    private bool onlyFailed;
    private bool busy;
    private string? error;
    private string? previous;

    private string? logged;

    protected override void OnParametersSet()
    {
        if (logged != Person.Key)
        {
            logged = Person.Key;
            State.Access("Beveiliging bekeken", $"gebruiker {Person.Key}");
        }

        if (previous != Person.Key)
        {
            previous = Person.Key;
            signIns = null;
            error = null;
        }
    }

    private async Task Load(string id)
    {
        busy = true;
        error = null;
        try
        {
            signIns = await State.ReadSignInsAsync(id, 30, onlyFailed);
            if (signIns is null)
            {
                error = T["code.security-card.fill-in-the-entra-details"];
            }
        }
        catch (Exception ex)
        {
            error = (T["code.security-card.reading-sign-ins-failed"] + " ") + ex.Message + (" " + T["code.security-card.needed-role-reports-reader-or"]);
        }
        finally
        {
            busy = false;
        }
    }
}
