@using Moss365.Core.Storage
@* The systems of a tenant (0.21.1): Active Directory, Microsoft 365 or both. What the tenant does not have is left out of
   the menu, the screens and the connections. *@

<fieldset class="kb-systemen">
    <legend>@Legend</legend>
    @foreach (var (value, text, explanation) in Options)
    {
        <label class="kb-keuze @(Value == value ? "kb-actief" : null)">
            <input type="radio" name="@name" checked="@(Value == value)" @onchange="() => ValueChanged.InvokeAsync(value)" />
            <strong>@text</strong>
            <span class="kb-zacht">@explanation</span>
        </label>
    }
</fieldset>

@code {
    [Parameter] public TenantSystems Value { get; set; } = TenantSystems.Both;
    [Parameter] public EventCallback<TenantSystems> ValueChanged { get; set; }
    [Parameter] public string Legend { get; set; } = "Systemen";

    private readonly string name = "systemen-" + Guid.NewGuid().ToString("N");

    private static readonly (TenantSystems, string, string)[] Options =
    {
        (TenantSystems.Both, "AD en Microsoft 365", "Hybride: on-prem Active Directory, gesynchroniseerd naar Entra ID."),
        (TenantSystems.Microsoft365, "Enkel Microsoft 365", "Cloud: Entra ID en Exchange Online, geen Active Directory."),
        (TenantSystems.ActiveDirectory, "Enkel Active Directory", "On-prem: geen Microsoft 365."),
    };

    /// <summary>The words for a choice, for in a sentence.</summary>
    public static string Text(TenantSystems s) => s switch
    {
        TenantSystems.ActiveDirectory => "enkel Active Directory",
        TenantSystems.Microsoft365 => "enkel Microsoft 365",
        _ => "Active Directory en Microsoft 365",
    };
}
