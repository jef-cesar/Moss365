@* A distribution as one stacked bar (100%), with a legend that shows the count and the share. Every part and every
   line of the legend opens the list with exactly those rows (KPI). Colour follows the role of the part (Colour in
   ChartPart). *@
@inject NavigationManager Nav

@if (Total == 0)
{
    <p class="kb-zacht">@EmptyText</p>
}
else
{
    <div class="kb-verdeling" role="img" aria-label="@AriaText">
        @foreach (var d in Share.Where(d => d.Count > 0))
        {
            <span class="kb-verdeling-deel kb-kleur-@d.Colour @(d.Kpi is not null ? "kb-klikbaar" : null)" style="flex-grow: @d.Count"
                  title="@($"{d.Name}: {d.Count} ({Part(d)})")" @onclick="() => Open(d)"></span>
        }
    </div>
    <ul class="kb-legende" role="list">
        @foreach (var d in Share)
        {
            <li>
                <span class="kb-sleutel kb-kleur-@d.Colour" aria-hidden="true"></span>
                @if (d.Kpi is not null && d.Count > 0) { <a href="@d.Kpi.Link">@d.Name</a> } else { <span>@d.Name</span> }
                <strong>@d.Count</strong> <span class="kb-zacht">@Part(d)</span>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ChartPart> Share { get; set; } = Array.Empty<ChartPart>();
    [Parameter] public string EmptyText { get; set; } = "Geen gegevens.";

    private int Total => Share.Sum(d => d.Count);

    private string Part(ChartPart d) => Total == 0 ? "" : ((double)d.Count / Total).ToString("P0", System.Globalization.CultureInfo.GetCultureInfo("nl-BE"));

    private string AriaText => string.Join(", ", Share.Select(d => $"{d.Name}: {d.Count}"));

    private void Open(ChartPart d)
    {
        if (d.Kpi is not null)
        {
            Nav.NavigateTo(d.Kpi.Link);
        }
    }
}
