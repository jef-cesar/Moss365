@using Moss365.Core.Helpdesk
@* Member of which groups, and why (R10, 0.33): also through other groups, with the groups in between. *@
@inject ManagementState State

<section class="kb-kaart">
    <h2>@T.Format("nested-groups.all-groups-also-through-other", Paths.Count)</h2>
    @if (Paths.Count(p => p.Via.Count > 0) == 0)
    {
        <p class="kb-zacht">@T["nested-groups.only-direct-memberships-no-groups"]</p>
    }
    <table class="kb-tabel">
        <thead><tr><th>@T["nested-groups.group"]</th><th>@T["nested-groups.kind"]</th><th>@T["nested-groups.why"]</th></tr></thead>
        <tbody>
            @foreach (var p in Paths)
            {
                <tr>
                    <td><ObjectLink Object="p.Group.Ref" /></td>
                    <td class="kb-zacht">@p.Group.KindText</td>
                    <td>@(p.Via.Count == 0 ? T["code.nested-groups.direct-member"] : "via " + string.Join(" → ", p.Via))</td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    [Parameter, EditorRequired] public Person Person { get; set; } = default!;

    private IReadOnlyList<GroupPath> Paths => HelpdeskTools.GroupsWithPaths(State.Data, Person);
}
