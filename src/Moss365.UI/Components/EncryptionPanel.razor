@using Moss365.Core.Storage
@* Encryption of the open tenant (R6, decision U7: off by default). The key is random; the recovery key is shown once
   and opens the database on its own. Turning it on or off makes a checked copy and reloads the screens. *@
@inject ManagementState State
@inject IServiceProvider Services
@inject NavigationManager Nav

<section class="kb-kaart" id="versleuteling">
    <h2>@T["encryption-panel.encryption"]</h2>
    @if (Hub is not { } hub)
    {
        <p class="kb-zacht">@T["encryption-panel.encrypting-is-only-possible-in"]</p>
    }
    else
    {
        var info = hub.Encryption(State.Tenant.Id);
        @if (info is null)
        {
            <p>
                @Html("encryption.off")
            </p>
        }
        else
        {
            <p>
                @Html("encryption.on", info.Since.LocalDateTime.ToString("dd/MM/yyyy"), MethodText(info.Method) + (info.Group is { } g ? $" ({g})" : string.Empty))
                <span class="kb-zacht">@T["encryption-panel.a-backup-is-encrypted-with"]</span>
            </p>
        }

        @if (recoveryKey is not null && step == Step.Done)
        {
            <div class="kb-melding">
                <p>@Html("encryption.newkey")</p>
                <p><code class="kb-herstelsleutel">@recoveryKey</code></p>
                <button class="kb-knop kb-primair" @onclick='() => Nav.NavigateTo("databank", forceLoad: true)'>@T["encryption-panel.saved-continue"]</button>
            </div>
        }

        @switch (step)
        {
            case Step.Choose:
                <fieldset class="kb-formulier">
                    <legend>@(info is null ? T["code.encryption-panel.how-do-you-open-the"] : T["code.encryption-panel.other-protection-of-the-key"])</legend>
                    @foreach (var m in new[] { EncryptionMethod.WindowsAccount, EncryptionMethod.Password, EncryptionMethod.AdGroup })
                    {
                        <label class="@(hub.CanProtect(m) ? null : "kb-zacht")">
                            <input type="radio" name="methode" checked="@(method == m)" disabled="@(!hub.CanProtect(m))" @onchange="() => method = m" />
                            <strong>@MethodText(m)</strong>: @MethodExplanation(m)
                        </label>
                    }
                    @if (method == EncryptionMethod.Password)
                    {
                        <label>@T["encryption-panel.password"] <input type="password" class="kb-invoer" @bind="password" aria-label="@T["encryption-panel.password"]" /></label>
                        <label>@T["encryption-panel.again"] <input type="password" class="kb-invoer" @bind="again" aria-label="@T["encryption-panel.password-again"]" /></label>
                    }
                    @if (method == EncryptionMethod.AdGroup)
                    {
                        <label>@T["encryption-panel.ad-group"] <input class="kb-invoer" @bind="group" placeholder="@T["encryption-panel.domain-gg-moss365-administrators"]" aria-label="@T["encryption-panel.ad-group"]" /></label>
                    }
                </fieldset>
                <div class="kb-rij">
                    <button class="kb-knop kb-primair" disabled="@(method == EncryptionMethod.None)" @onclick="() => Next(info)">@(info is null ? "Volgende" : "Bewaren")</button>
                    <button class="kb-knop" @onclick="Reset">@T["action.cancel"]</button>
                </div>
                break;

            case Step.Recovery:
                <div class="kb-melding">
                    <p>
                        @Html("encryption.recovery")
                    </p>
                    <p><code class="kb-herstelsleutel">@recoveryKey</code></p>
                    <label>@T["encryption-panel.type-the-last-group-of"] <input class="kb-invoer" @bind="confirmation" @bind:event="oninput" aria-label="@T["encryption-panel.last-group-of-the-recovery"]" /></label>
                </div>
                <p class="kb-zacht">@T["encryption-panel.the-app-makes-an-encrypted"]</p>
                <div class="kb-rij">
                    <button class="kb-knop kb-gevaar" disabled="@(!RecoveryConfirmed || busy)" @onclick="Encrypt">Versleutelen in @State.Tenant.Name</button>
                    <button class="kb-knop" @onclick="Reset">@T["action.cancel"]</button>
                </div>
                break;

            case Step.Renew:
                <p>@T["encryption-panel.a-new-key-for-example"]</p>
                @if (info?.Method == EncryptionMethod.Password)
                {
                    <label>@T["encryption-panel.password"] <input type="password" class="kb-invoer" @bind="password" aria-label="@T["encryption-panel.password"]" /></label>
                }
                <div class="kb-rij">
                    <button class="kb-knop kb-gevaar" disabled="@busy" @onclick="() => Renew(info)">@T["encryption-panel.yes-new-key"]</button>
                    <button class="kb-knop" @onclick="Reset">@T["action.cancel"]</button>
                </div>
                break;

            case Step.Off:
                <p>@Html("encryption.decrypt", State.Tenant.Name)</p>
                <div class="kb-rij">
                    <button class="kb-knop kb-gevaar" disabled="@busy" @onclick="Decrypt">@T["encryption-panel.yes-turn-off-encryption"]</button>
                    <button class="kb-knop" @onclick="Reset">@T["action.cancel"]</button>
                </div>
                break;

            default:
                <div class="kb-rij">
                    @if (info is null)
                    {
                        <button class="kb-knop kb-primair" disabled="@(State.TaskBusy || State.ScriptBusy)" @onclick="() => step = Step.Choose">@T["encryption-panel.encrypt"]</button>
                    }
                    else
                    {
                        <button class="kb-knop" @onclick="() => { method = info.Method; group = info.Group ?? string.Empty; step = Step.Choose; }">@T["encryption-panel.change-protection"]</button>
                        <button class="kb-knop" disabled="@(State.TaskBusy || State.ScriptBusy)" @onclick="() => step = Step.Renew">@T["encryption-panel.new-key"]</button>
                        <button class="kb-knop kb-gevaar" disabled="@(State.TaskBusy || State.ScriptBusy)" @onclick="() => step = Step.Off">@T["encryption-panel.turn-off"]</button>
                    }
                </div>
                break;
        }

        @if (error is not null) { <div class="kb-melding kb-fout">@error</div> }
        @if (done is not null) { <p class="kb-ok">@done</p> }
    }
</section>

@code {
    private enum Step { None, Choose, Recovery, Renew, Off, Done }

    private TenantHub? Hub => Services.GetService(typeof(TenantHub)) as TenantHub;

    private Step step;
    private EncryptionMethod method;
    private string password = string.Empty;
    private string again = string.Empty;
    private string group = string.Empty;
    private string confirmation = string.Empty;
    private byte[]? key;
    private string? recoveryKey;
    private string? error;
    private string? done;
    private bool busy;

    private bool RecoveryConfirmed => recoveryKey is not null && confirmation.Trim().Length > 0
                                      && string.Equals(confirmation.Trim(), recoveryKey[(recoveryKey.LastIndexOf('-') + 1)..], StringComparison.OrdinalIgnoreCase);

    private void Reset()
    {
        step = Step.None;
        password = again = confirmation = string.Empty;
        key = null;
        recoveryKey = null;
        error = null;
    }

    private void Next(EncryptionInfo? info)
    {
        error = method == EncryptionMethod.Password ? TenantKeys.CheckPassword(password, again) : null;
        if (error is not null)
        {
            return;
        }

        if (info is not null)
        {
            Run(() => Hub!.ChangeProtection(State.Tenant, method, password, group), (T["code.encryption-panel.the-key-is-now-protected"] + " ") + MethodText(method) + ".");
            return;
        }

        (key, recoveryKey) = TenantHub.NewKey();
        step = Step.Recovery;
    }

    private void Encrypt() => Run(() => Hub!.Encrypt(State.Tenant, key!, method, password, group), null, reload: true);

    private void Renew(EncryptionInfo? info)
    {
        string? recovery = null;
        Run(() => recovery = Hub!.RenewKey(State.Tenant, info?.Method == EncryptionMethod.Password ? password : null), "Nieuwe sleutel gemaakt.");
        if (recovery is not null)
        {
            recoveryKey = recovery;
            step = Step.Done;
        }
    }

    private void Decrypt() => Run(() => Hub!.Decrypt(State.Tenant), null, reload: true);

    private void Run(Action action, string? message, bool reload = false)
    {
        busy = true;
        error = null;
        try
        {
            action();
            done = message;
            var keep = recoveryKey;
            Reset();
            recoveryKey = message is null ? null : keep;
            if (reload)
            {
                // The state of this tenant was closed: the screens start again with the database as it is now
                Nav.NavigateTo("databank", forceLoad: true);
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or InvalidDataException or IOException
                                       or System.Security.Cryptography.CryptographicException or Microsoft.Data.Sqlite.SqliteException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static string MethodText(EncryptionMethod m) => m switch
    {
        EncryptionMethod.WindowsAccount => "Windows-account",
        EncryptionMethod.Password => "Wachtwoord",
        EncryptionMethod.AdGroup => "AD-groep",
        _ => "Uit",
    };

    private static string MethodExplanation(EncryptionMethod m) => m switch
    {
        EncryptionMethod.WindowsAccount => T["code.encryption-panel.nothing-to-type-only-you"],
        EncryptionMethod.Password => T["code.encryption-panel.when-opening-the-tenant-good"],
        _ => T["code.encryption-panel.every-administrator-in-the-group"],
    };
}
