@using Moss365.Core.Changes
@* Updating the app (R7): channel, own source, update now or later, back to an older version. Never while something
   runs or is open; first a copy of every database; the fingerprint of the download is checked. *@
@inject IServiceProvider Services

<section class="kb-kaart" id="updates">
    <h2>@T["update-panel.updates"]</h2>
    @if (Updates is not { } u)
    {
        <p class="kb-zacht">@T["update-panel.updating-is-only-possible-in"]</p>
    }
    else
    {
        var settings = u.Settings;
        <fieldset class="kb-formulier">
            <legend>@T["update-panel.channel"]</legend>
            <label><input type="radio" name="kanaal" checked="@(settings.Channel == UpdateChannel.Stable)" @onchange="() => Save(settings with { Channel = UpdateChannel.Stable })" />
                @Html("update.stable")</label>
            <label><input type="radio" name="kanaal" checked="@(settings.Channel == UpdateChannel.Preview)" @onchange="() => Save(settings with { Channel = UpdateChannel.Preview })" />
                @Html("update.preview")</label>
            <label>@T["update-panel.own-source-shared-folder-with"]
                <input class="kb-invoer kb-breed" @bind="source" placeholder="@T["update-panel.server-share-moss365"]" aria-label="@T["update-panel.own-source"]" /></label>
            <div><button class="kb-knop kb-klein" @onclick="() => Save(settings with { Source = source })">@T["update-panel.save-source"]</button></div>
        </fieldset>
        <p class="kb-zacht">
            @T["update-panel.until-1-0-every-installation"]
        </p>

        @if (!u.CanUpdate)
        {
            <div class="kb-melding">
                @Html("update.notinstalled")
            </div>
        }
        else
        {
            <div class="kb-rij">
                <button class="kb-knop kb-primair" disabled="@busy" @onclick="Check">@T["update-panel.search-now"]</button>
                <button class="kb-knop" disabled="@busy" @onclick="LoadOlder">@T["update-panel.to-a-previous-version"]</button>
            </div>

            @if (older is { Count: > 0 })
            {
                <div class="kb-rij">
                    <label>@T["update-panel.version"]
                        <select class="kb-invoer" @bind="olderChoice" aria-label="@T["update-panel.previous-version"]">
                            <option value="">@T["script-form.choose"]</option>
                            @foreach (var v in older) { <option value="@v">@v</option> }
                        </select>
                    </label>
                    <button class="kb-knop" disabled="@(olderChoice.Length == 0 || busy)" @onclick="ChooseOlder">@T["update-panel.take-this-version"]</button>
                </div>
            }
            else if (older is { Count: 0 })
            {
                <p class="kb-zacht">@T["update-panel.no-previous-version-in-this"]</p>
            }

            @if (checkedOnce && u.Found is null && u.Message is null)
            {
                <p class="kb-ok">Dit is de nieuwste versie in dit kanaal (@ManagementState.AppVersion).</p>
            }

            @if (u.Found is { } found)
            {
                <div class="kb-melding">
                    <p>
                        <strong>Versie @found.Version</strong> @(found.Downgrade ? T["code.update-panel.an-older-version-putting-back"] : "beschikbaar").
                        @if (found.Sha256 is { } sha) { <span class="kb-zacht">@Html("update.sha", sha[..Math.Min(16, sha.Length)])</span> }
                    </p>
                    @if (found.Notes.Length > 0) { <pre class="kb-nota">@found.Notes</pre> }
                    @if (u.Blockers() is { Count: > 0 } blockers)
                    {
                        <p>@T["update-panel.not-now"] </p>
                        <ul>@foreach (var b in blockers) { <li>@b</li> }</ul>
                    }
                    else
                    {
                        <p class="kb-zacht">@T["update-panel.before-installing-the-app-makes"]</p>
                    }
                    <div class="kb-rij">
                        <button class="kb-knop kb-primair" disabled="@(busy || u.Blockers().Count > 0)" @onclick="Install">@(found.Downgrade ? "Nu terugzetten" : "Nu bijwerken")</button>
                        <button class="kb-knop" disabled="@busy" @onclick="Later">@T["update-panel.later"]</button>
                        @if (progress is { } p) { <span class="kb-zacht">Downloaden… @p%</span> }
                    </div>
                </div>
            }
        }

        @if (u.Message is { } m) { <div class="kb-melding kb-fout">@m</div> }
        @if (error is not null) { <div class="kb-melding kb-fout">@error</div> }
    }
</section>

@code {
    private AppUpdates? Updates => Services.GetService(typeof(AppUpdates)) as AppUpdates;

    private string source = string.Empty;
    private bool busy;
    private bool checkedOnce;
    private int? progress;
    private string? error;
    private IReadOnlyList<string>? older;
    private string olderChoice = string.Empty;

    protected override void OnInitialized() => source = Updates?.Settings.Source ?? string.Empty;

    private void Save(UpdateSettings settings)
    {
        Updates!.Save(settings);
        source = settings.Source ?? string.Empty;
        older = null;
        checkedOnce = false;
    }

    private async Task Check()
    {
        busy = true;
        error = null;
        await Updates!.CheckAsync();
        checkedOnce = true;
        busy = false;
    }

    private async Task LoadOlder()
    {
        busy = true;
        older = await Updates!.OlderVersionsAsync();
        busy = false;
    }

    private async Task ChooseOlder()
    {
        busy = true;
        await Updates!.ChooseAsync(olderChoice);
        busy = false;
    }

    private void Later()
    {
        Updates!.Save(Updates.Settings);
        checkedOnce = false;
    }

    private async Task Install()
    {
        busy = true;
        error = null;
        var reporter = new Progress<int>(p => { progress = p; _ = InvokeAsync(StateHasChanged); });
        error = await Updates!.InstallAsync(reporter);
        busy = false;
        progress = null;
    }
}
