@* The result of a run: output, tables, files and details *@
@inject ManagementState State

<div class="kb-filters">
    <span class="kb-segment" role="group" aria-label="@T["plan.result"]">
        <button class="kb-knop @(part == 0 ? "kb-primair" : null)" @onclick="() => part = 0">@T["script-result.output"]</button>
        <button class="kb-knop @(part == 1 ? "kb-primair" : null)" @onclick="() => part = 1">@T.Format("script-result.tables-0", tables.Count)</button>
        <button class="kb-knop @(part == 2 ? "kb-primair" : null)" @onclick="() => part = 2">@T.Format("script-result.files-0", files.Count)</button>
        <button class="kb-knop @(part == 3 ? "kb-primair" : null)" @onclick="() => part = 3">@T["script-result.details"]</button>
    </span>
</div>

@switch (part)
{
    case 0:
        <ScriptOutputList Events="Events" EmptyText="@T["code.script-result.the-script-gave-no-text"]" />
        break;
    case 1:
        @if (tables.Count == 0)
        {
            <p class="kb-zacht">@T["script-result.the-script-returned-no-objects"]</p>
        }
        else
        {
            @if (tables.Count > 1)
            {
                <div class="kb-filters">
                    <select class="kb-invoer" @bind="tableIndex" aria-label="@T["script-result.table"]">
                        @for (var i = 0; i < tables.Count; i++)
                        {
                            <option value="@i">@tables[i].Name (@tables[i].Rows.Count)</option>
                        }
                    </select>
                </div>
            }
            var t = tables[Math.Min(tableIndex, tables.Count - 1)];
            <KbTable @key="t" Id="@($"script-{Run.Key}-{t.Name}")" ExportName="@($"{Run.Key}-{t.Name}")" Items="t.Rows" Columns="ColumnsOf(t)" DefaultSorting="@t.Columns.FirstOrDefault()" />
        }
        break;
    case 2:
        @if (files.Count == 0)
        {
            <p class="kb-zacht">@T["script-result.the-script-put-no-files"]</p>
        }
        else
        {
            <table class="kb-tabel">
                <thead><tr><th>@T["start.file"]</th><th class="kb-getal">@T["script-result.size"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var b in files)
                    {
                        <tr>
                            <td>@b.Path[(FilesFolder.Length + 1)..]</td>
                            <td class="kb-getal">@Size(b.Size)</td>
                            <td><button class="kb-knop kb-klein" @onclick="() => Open(b)">@T["script-result.open"]</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (opened is not null)
            {
                <p class="kb-zacht">@T["script-result.copied-to"] <code>@opened</code>.</p>
            }
        }
        <p class="kb-zacht">@T.Format("script-result.the-files-of-this-run", State.Tenant.Name)</p>
        break;
    default:
        <table class="kb-tabel kb-naast">
            <tbody>
                <tr><th>@T["code-editor.script"]</th><td>@Run.Name @if (Run.Once) { <span class="kb-label">@T["script-result.one-off"]</span> }</td></tr>
                <tr><th>@T["plan.result"]</th><td>@Run.ResultText <span class="kb-zacht">@Run.Message</span></td></tr>
                <tr><th>@T["script-result.who"]</th><td>@Run.Who</td></tr>
                <tr><th>@T["script-result.start"]</th><td>@Run.Start.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss")</td></tr>
                <tr><th>@T["script-result.duration"]</th><td>@(Run.Duration is { } d ? $"{(int)d.TotalMinutes}:{d.Seconds:00}" : T["word.busy"])</td></tr>
                <tr><th>@T["script-result.values"]</th><td>@foreach (var (k, v) in Run.Values) { <div><strong>@k</strong>: @v.Replace("\n", ", ")</div> }</td></tr>
                <tr><th>@T["script-result.fingerprint"]</th><td><code>@Run.Fingerprint</code></td></tr>
            </tbody>
        </table>
        break;
}

@code {
    [Parameter, EditorRequired] public ScriptRun Run { get; set; } = new();
    [Parameter, EditorRequired] public IReadOnlyList<ScriptEvent> Events { get; set; } = Array.Empty<ScriptEvent>();

    private int part;
    private int tableIndex;
    private IReadOnlyList<ScriptTable> tables = Array.Empty<ScriptTable>();
    private IReadOnlyList<Moss365.Core.Storage.StoredFile> files = Array.Empty<Moss365.Core.Storage.StoredFile>();
    private string? opened;
    private readonly Dictionary<ScriptTable, IReadOnlyList<Column<IReadOnlyDictionary<string, string>>>> columns = new();

    private string FilesFolder => Run.Folder + "/bestanden";

    protected override void OnParametersSet()
    {
        tables = ScriptOutput.Tables(Events, State.Files, FilesFolder);
        files = ScriptRuns.Files(State.ScriptFolders, Run);
        if (part == 0 && tables.Count > 0 && Events.All(g => g.Kind is EventKind.Row or EventKind.Info or EventKind.Progress))
        {
            part = 1;
        }
    }

    private IReadOnlyList<Column<IReadOnlyDictionary<string, string>>> ColumnsOf(ScriptTable t)
    {
        if (!columns.TryGetValue(t, out var k))
        {
            k = t.Columns.Select(name => new Column<IReadOnlyDictionary<string, string>>
            {
                Key = name,
                Title = name,
                Cell = r => @<text>@(r.TryGetValue(name, out var w) ? w : string.Empty)</text>,
                SortBy = r => r.TryGetValue(name, out var w) ? w : string.Empty,
            }).ToList();
            columns[t] = k;
        }

        return k;
    }

    private static string Size(long b) => b < 1024 ? $"{b} B" : b < 1024 * 1024 ? $"{b / 1024.0:0.#} kB" : $"{b / 1024.0 / 1024.0:0.#} MB";

    /// <summary>A copy of the file in the export folder of the tenant, shown in Explorer.</summary>
    private void Open(Moss365.Core.Storage.StoredFile file)
    {
        var target = Path.Combine(State.ExportFolder, "Scripts", $"{Run.Key}-{Run.FolderName}", file.Path[(FilesFolder.Length + 1)..].Replace('/', Path.DirectorySeparatorChar));
        Directory.CreateDirectory(Path.GetDirectoryName(target)!);
        File.WriteAllBytes(target, State.Files.ReadBytes(file.Path)!);
        State.Access(T["code.script-result.file-of-a-script-run"], file.Name);
        opened = target;
        State.AppEnvironment.ShowFile(target);
    }
}
