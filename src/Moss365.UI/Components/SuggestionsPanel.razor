@using Moss365.Core.Setup
@* Suggestions for the organisation from the loaded data (R5, R9): only what is not in the settings yet. Nothing is
   taken over by itself: tick what you want, then Overnemen (saved in the database of the tenant). *@
@inject ManagementState State

<section class="kb-kaart" id="voorstellen">
    <h2>@Title</h2>
    @if (State.Data.Persons.Count == 0)
    {
        <p class="kb-zacht">@T["suggestions-panel.load-data-first-connections-the"]</p>
    }
    else if (suggestions.Count == 0)
    {
        <p class="kb-ok">@T["suggestions-panel.nothing-to-suggest-what-is"]</p>
    }
    else
    {
        <p class="kb-zacht">@T["suggestions-panel.found-in-the-loaded-data"]</p>
        <table class="kb-tabel">
            <thead><tr><th></th><th>@T["nested-groups.kind"]</th><th>@T["suggestions-panel.value"]</th><th>@T["suggestions-panel.number"]</th><th>@T["suggestions-panel.explanation"]</th></tr></thead>
            <tbody>
                @foreach (var s in suggestions)
                {
                    var key = Key(s);
                    <tr>
                        <td><input type="checkbox" aria-label="@s.Value" checked="@chosen.Contains(key)" @onchange="e => Toggle(key, e.Value is true)" /></td>
                        <td>@KindText(s.Kind)</td>
                        <td>@ValueText(s)</td>
                        <td>@s.Count</td>
                        <td>@s.Explanation</td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="kb-knop kb-primair" disabled="@(chosen.Count == 0 || State.IsHistoric)" @onclick="TakeOver">Overnemen (@suggestions.Count(s => chosen.Contains(Key(s))))</button>
    }
    @if (State.HasMicrosoft365 && State.Data.Security is null && State.Data.Persons.Count > 0)
    {
        <p class="kb-zacht">@T["suggestions-panel.the-app-suggests-emergency-accounts"]</p>
    }
    @if (takenOver is not null) { <p class="kb-ok">@takenOver</p> }
</section>

@code {
    [Parameter] public string Title { get; set; } = T["code.suggestions-panel.suggestions-from-the-data"];

    /// <summary>After taking over (the organisation page reloads its form).</summary>
    [Parameter] public EventCallback TakenOver { get; set; }

    private IReadOnlyList<Suggestion> suggestions = Array.Empty<Suggestion>();
    private readonly HashSet<string> chosen = new(StringComparer.OrdinalIgnoreCase);
    private string? takenOver;

    protected override void OnParametersSet() => suggestions = State.Data.Persons.Count == 0 ? Array.Empty<Suggestion>() : State.Suggestions();

    private static string Key(Suggestion s) => $"{s.Kind}|{s.Value}";

    private void Toggle(string key, bool on)
    {
        if (on) { chosen.Add(key); } else { chosen.Remove(key); }
    }

    private async Task TakeOver()
    {
        var list = suggestions.Where(s => chosen.Contains(Key(s))).ToList();
        State.TakeOver(list);
        chosen.Clear();
        takenOver = T.Format("code.suggestions-panel.suggestion-s-taken-over-under", list.Count);
        suggestions = State.Suggestions();
        await TakenOver.InvokeAsync();
    }

    private static string ValueText(Suggestion s) => s.Kind switch
    {
        SuggestionKind.LocalPart when Enum.TryParse<Moss365.Core.Configuration.LocalPartPattern>(s.Value, out var l) => Moss365.Core.Configuration.NamingSettings.Example(l) + "@...",
        SuggestionKind.DisplayName when Enum.TryParse<Moss365.Core.Configuration.DisplayNamePattern>(s.Value, out var d) => Moss365.Core.Configuration.NamingSettings.Example(d),
        _ => s.Value,
    };

    private static string KindText(SuggestionKind k) => k switch
    {
        SuggestionKind.AdDomain => T["word.ad-domain"],
        SuggestionKind.SynchronisedOu => T["word.synchronised-ou"],
        SuggestionKind.Department => T["service-health-card.service"],
        SuggestionKind.Office => T["bulk-tasks.office"],
        SuggestionKind.GroupPrefix => T["word.group-prefix"],
        SuggestionKind.EmergencyAccount => T["word.emergency-account"],
        SuggestionKind.Company => T["organisation.company"],
        SuggestionKind.NewUsersOu => T["word.ou-new-users"],
        SuggestionKind.OffboardingOu => T["code.suggestions-panel.ou-on-offboarding"],
        SuggestionKind.GroupsOu => T["word.ou-new-groups"],
        SuggestionKind.LocalPart => T["organisation.account-name"],
        SuggestionKind.DisplayName => T["edit-user.display-name"],
        _ => T["word.licence-name"],
    };
}
