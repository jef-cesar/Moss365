@using Moss365.Core.Helpdesk
@* Out of office and forwarding for someone else (R10, 0.33): illness and leave, with end dates. The end of the
   forwarding is prepared in Gepland and never runs by itself. *@
@inject ManagementState State

<section class="kb-kaart">
    <h2>Afwezig en doorsturen</h2>
    <label><input type="checkbox" @bind="a.AutoReply" @bind:after="Clear" /> Automatisch antwoord</label>
    @if (a.AutoReply)
    {
        <div class="kb-raster">
            <label>Van <input class="kb-invoer" type="datetime-local" @bind="start" @bind:after="Clear" aria-label="Van" /></label>
            <label>Tot (leeg = tot je het uitzet) <input class="kb-invoer" type="datetime-local" @bind="end" @bind:after="Clear" aria-label="Tot" /></label>
        </div>
        <label>Bericht voor collega's <textarea class="kb-invoer kb-breed" rows="3" @bind="a.Internal" @bind:after="Clear" aria-label="Bericht voor collega's"></textarea></label>
        <label>Bericht voor buiten (leeg = hetzelfde) <textarea class="kb-invoer kb-breed" rows="3" @bind="a.External" @bind:after="Clear" aria-label="Bericht voor buiten"></textarea></label>
    }
    <div class="kb-raster">
        <label>Doorsturen naar (optioneel) <input class="kb-invoer" type="email" @bind="forward" @bind:after="Clear" placeholder="collega@contoso.com" aria-label="Doorsturen naar" /></label>
        <label>Doorsturen tot <input class="kb-invoer" type="date" @bind="until" @bind:after="Clear" aria-label="Doorsturen tot" /></label>
    </div>
    <label><input type="checkbox" @bind="a.KeepCopy" @bind:after="Clear" /> Een kopie in het postvak houden</label>
    <div class="kb-filters">
        <button class="kb-knop kb-primair" @onclick="MakePlan">Afwezigheid plannen</button>
        <button class="kb-knop" @onclick="() => outcome = HelpdeskTools.AutoReplyOff(Person)">Automatisch antwoord uitzetten</button>
    </div>
    @if (outcome is not null)
    {
        @foreach (var e in outcome.Errors) { <div class="kb-melding kb-fout">@e</div> }
        @if (outcome.Plan.Count > 0) { <PlanView Plan="outcome.Plan" Context="@($"Afwezigheid {Person.Name}")" Title="Afwezig en doorsturen" Executed="AfterExecute" /> }
    }
    @if (scheduled is not null) { <div class="kb-melding kb-goed">Het einde van het doorsturen staat klaar bij <a href="gepland">Gepland</a> op @scheduled.Value.ToString("dd/MM/yyyy").</div> }
</section>

@code {
    [Parameter, EditorRequired] public Person Person { get; set; } = default!;

    private readonly AbsenceRequest a = new();
    private DateTime? start;
    private DateTime? end;
    private string forward = string.Empty;
    private DateTime? until;
    private PlanOutcome? outcome;
    private IReadOnlyList<Change> endOfForwarding = Array.Empty<Change>();
    private DateTime? scheduled;

    private void Clear()
    {
        outcome = null;
        scheduled = null;
    }

    private void MakePlan()
    {
        a.Start = start is { } s ? new DateTimeOffset(s) : null;
        a.End = end is { } e ? new DateTimeOffset(e) : null;
        a.ForwardTo = forward.Trim().Length > 0 ? forward.Trim() : null;
        a.ForwardUntil = until is { } u ? DateOnly.FromDateTime(u) : null;
        (outcome, endOfForwarding) = HelpdeskTools.Absence(Person, a);
    }

    /// <summary>When the forwarding is on: the end of it goes to Gepland (never run by itself).</summary>
    private void AfterExecute(IReadOnlyList<ChangeResult> results)
    {
        if (endOfForwarding.Count > 0 && a.ForwardUntil is { } u && results.Any(r => r.Status == ResultStatus.Succeeded))
        {
            var moment = u.ToDateTime(new TimeOnly(23, 59));
            State.Schedule(ScheduledPlans.Plan($"Einde doorsturen {Person.Name}", endOfForwarding, new DateTimeOffset(moment, TimeZoneInfo.Local.GetUtcOffset(moment)), State.User));
            scheduled = moment;
            endOfForwarding = Array.Empty<Change>();
        }
    }
}
