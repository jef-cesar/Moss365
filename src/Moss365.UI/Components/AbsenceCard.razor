@using Moss365.Core.Helpdesk
@* Out of office and forwarding for someone else (R10, 0.33): illness and leave, with end dates. The end of the
   forwarding is prepared in Gepland and never runs by itself. *@
@inject ManagementState State

<section class="kb-kaart">
    <h2>@T["absence-card.away-and-forwarding"]</h2>
    <label><input type="checkbox" @bind="a.AutoReply" @bind:after="Clear" /> @T["absence-card.automatic-reply"]</label>
    @if (a.AutoReply)
    {
        <div class="kb-raster">
            <label>@T["absence-card.from"] <input class="kb-invoer" type="datetime-local" @bind="start" @bind:after="Clear" aria-label="@T["absence-card.from"]" /></label>
            <label>@T["absence-card.until-empty-until-you-turn"] <input class="kb-invoer" type="datetime-local" @bind="end" @bind:after="Clear" aria-label="@T["absence-card.until"]" /></label>
        </div>
        <label>@T["absence-card.message-for-colleagues"] <textarea class="kb-invoer kb-breed" rows="3" @bind="a.Internal" @bind:after="Clear" aria-label="@T["absence-card.message-for-colleagues"]"></textarea></label>
        <label>@T["absence-card.message-for-outside-empty-the"] <textarea class="kb-invoer kb-breed" rows="3" @bind="a.External" @bind:after="Clear" aria-label="@T["absence-card.message-for-outside"]"></textarea></label>
    }
    <div class="kb-raster">
        <label>@T["absence-card.forward-to-optional"] <input class="kb-invoer" type="email" @bind="forward" @bind:after="Clear" placeholder="collega@contoso.com" aria-label="@T["absence-card.forward-to"]" /></label>
        <label>@T["absence-card.forward-until"] <input class="kb-invoer" type="date" @bind="until" @bind:after="Clear" aria-label="@T["absence-card.forward-until"]" /></label>
    </div>
    <label><input type="checkbox" @bind="a.KeepCopy" @bind:after="Clear" /> @T["absence-card.keep-a-copy-in-the"]</label>
    <div class="kb-filters">
        <button class="kb-knop kb-primair" @onclick="MakePlan">@T["absence-card.schedule-absence"]</button>
        <button class="kb-knop" @onclick="() => outcome = HelpdeskTools.AutoReplyOff(Person)">@T["absence-card.turn-off-automatic-reply"]</button>
    </div>
    @if (outcome is not null)
    {
        @foreach (var e in outcome.Errors) { <div class="kb-melding kb-fout">@e</div> }
        @if (outcome.Plan.Count > 0) { <PlanView Plan="outcome.Plan" Context="@($"Afwezigheid {Person.Name}")" Title="@T["absence-card.away-and-forwarding"]" Executed="AfterExecute" /> }
    }
    @if (scheduled is not null) { <div class="kb-melding kb-goed">@Html("absence.forwardend", scheduled.Value.ToString("dd/MM/yyyy"))</div> }
</section>

@code {
    [Parameter, EditorRequired] public Person Person { get; set; } = default!;

    private readonly AbsenceRequest a = new();
    private DateTime? start;
    private DateTime? end;
    private string forward = string.Empty;
    private DateTime? until;
    private PlanOutcome? outcome;
    private IReadOnlyList<Change> endOfForwarding = Array.Empty<Change>();
    private DateTime? scheduled;

    private void Clear()
    {
        outcome = null;
        scheduled = null;
    }

    private void MakePlan()
    {
        a.Start = start is { } s ? new DateTimeOffset(s) : null;
        a.End = end is { } e ? new DateTimeOffset(e) : null;
        a.ForwardTo = forward.Trim().Length > 0 ? forward.Trim() : null;
        a.ForwardUntil = until is { } u ? DateOnly.FromDateTime(u) : null;
        (outcome, endOfForwarding) = HelpdeskTools.Absence(Person, a);
    }

    /// <summary>When the forwarding is on: the end of it goes to Gepland (never run by itself).</summary>
    private void AfterExecute(IReadOnlyList<ChangeResult> results)
    {
        if (endOfForwarding.Count > 0 && a.ForwardUntil is { } u && results.Any(r => r.Status == ResultStatus.Succeeded))
        {
            var moment = u.ToDateTime(new TimeOnly(23, 59));
            State.Schedule(ScheduledPlans.Plan($"Einde doorsturen {Person.Name}", endOfForwarding, new DateTimeOffset(moment, TimeZoneInfo.Local.GetUtcOffset(moment)), State.User));
            scheduled = moment;
            endOfForwarding = Array.Empty<Change>();
        }
    }
}
