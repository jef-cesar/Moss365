@* Job profiles (R9, 0.22) on Organisatie: what someone in a job gets. Changes go into the organisation in memory;
   the page saves them (and a saved profile that changed gets a new version). *@
@inject ManagementState State

<section class="kb-kaart">
    <h2>@T["menu.organisatie.functieprofielen"]</h2>
    <p class="kb-zacht">
        @Html("job-profile-editor.intro")
    </p>

    @if (State.Config.JobProfiles.Count == 0)
    {
        <p>@T["job-profile-editor.no-job-profiles-yet"]</p>
    }
    else
    {
        <table class="kb-tabel">
            <thead><tr><th>@T["nav.profile"]</th><th class="kb-getal">@T["update-panel.version"]</th><th class="kb-getal">@T["menu.groepen"]</th><th class="kb-getal">@T["nav.part.Postvakken"]</th><th>@T["job-profile-editor.licences"]</th><th>@T["bulk-tasks.job-title"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in State.Config.JobProfiles.OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase))
                {
                    <tr class="@(p.Id == editing ? "kb-actief" : null)">
                        <td><strong>@p.Name</strong> <span class="kb-zacht">@p.Description</span></td>
                        <td class="kb-getal">@p.Version</td>
                        <td class="kb-getal">@p.Groups.Count</td>
                        <td class="kb-getal">@p.Mailboxes.Count</td>
                        <td>@string.Join(", ", p.Licences)</td>
                        <td>@p.JobTitle</td>
                        <td>
                            <span class="kb-filters">
                                <button class="kb-knop kb-klein" @onclick="() => editing = p.Id">@T["edit-user.edit"]</button>
                                <button class="kb-knop kb-klein kb-gevaar" @onclick="() => Remove(p)">@T["variables-editor.remove"]</button>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3>@T["job-profile-editor.new-profile"]</h3>
    <div class="kb-rij">
        <label>@T["variables-editor.name"] <input class="kb-invoer" @bind="newName" @bind:event="oninput" placeholder="@T["job-profile-editor.e-g-reception-employee"]" aria-label="@T["job-profile-editor.name-of-the-new-profile"]" /></label>
        <button class="kb-knop" disabled="@(!CanAdd)" @onclick="AddEmpty">@T["job-profile-editor.empty-profile"]</button>
    </div>
    <PersonPicker Label="@T["code.job-profile-editor.or-take-over-from-a"]" Selected="example" SelectedChanged="p => example = p" />
    <div class="kb-rij">
        <button class="kb-knop" disabled="@(!CanAdd || example is null)" @onclick="AddFromPerson">@T.Format("job-profile-editor.make-profile-from-0", example?.Name ?? "deze gebruiker")</button>
    </div>
    @if (error is not null) { <div class="kb-melding kb-fout">@error</div> }
</section>

@if (Editing is { } jp)
{
    <section class="kb-kaart" id="profiel-bewerken">
        <h2>@jp.Name <span class="kb-zacht">@T.Format("job-profile-editor.version-0", jp.Version)</span></h2>
        <div class="kb-raster">
            <label>@T["variables-editor.name"] <input class="kb-invoer" value="@jp.Name" @onchange="e => Change(() => jp.Name = Text(e.Value) ?? jp.Name)" aria-label="@T["variables-editor.name"]" /></label>
            <label>@T["edit-user.description"] <input class="kb-invoer" value="@jp.Description" @onchange="e => Change(() => jp.Description = Text(e.Value) ?? string.Empty)" aria-label="@T["edit-user.description"]" /></label>
            <label>@T["bulk-tasks.job-title"] <input class="kb-invoer" value="@jp.JobTitle" @onchange="e => Change(() => jp.JobTitle = Text(e.Value))" aria-label="@T["bulk-tasks.job-title"]" /></label>
            <label>@T["service-health-card.service"]
                <select class="kb-invoer" aria-label="@T["service-health-card.service"]" @onchange="e => Change(() => jp.Department = Text(e.Value))">
                    <option value="" selected="@(jp.Department is null)">@T["yesno.nochange"]</option>
                    @foreach (var d in State.Config.Departments.OrderBy(d => d.Department, StringComparer.CurrentCultureIgnoreCase))
                    {
                        <option value="@d.Department" selected="@(string.Equals(jp.Department, d.Department, StringComparison.OrdinalIgnoreCase))">@d.Department</option>
                    }
                </select>
            </label>
            <label>@T["bulk-tasks.office"]
                <select class="kb-invoer" aria-label="@T["bulk-tasks.office"]" @onchange="e => Change(() => jp.Office = Text(e.Value))">
                    <option value="" selected="@(jp.Office is null)">@T["yesno.nochange"]</option>
                    @foreach (var o in State.Config.Offices.Append(jp.Office).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@o" selected="@(string.Equals(jp.Office, o, StringComparison.OrdinalIgnoreCase))">@o</option>
                    }
                </select>
            </label>
            @if (State.HasAd)
            {
                <label>@T["edit-user.logon-script"]
                    <select class="kb-invoer" aria-label="@T["edit-user.logon-script"]" @onchange="e => Change(() => jp.LogonScript = Text(e.Value))">
                        <option value="" selected="@(jp.LogonScript is null)">@T["yesno.nochange"]</option>
                        @foreach (var s in State.Config.LogonScripts.Append(jp.LogonScript).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@s" selected="@(string.Equals(jp.LogonScript, s, StringComparison.OrdinalIgnoreCase))">@s</option>
                        }
                    </select>
                </label>
            }
        </div>

        <h3>@T.Format("job-profile-editor.groups-0", jp.Groups.Count)</h3>
        <ul class="kb-lijst">
            @foreach (var name in jp.Groups.ToList())
            {
                var g = JobProfilePlans.FindGroup(State.Data, name);
                <li>
                    @if (g is null) { <span>@name</span> <span class="kb-label">@T["start.notfound"]</span> }
                    else { <ObjectLink Object="g.Ref" /> <span class="kb-zacht">@g.KindText</span> }
                    <button class="kb-knop kb-klein" aria-label="@name uit het profiel" @onclick="() => Change(() => jp.Groups.Remove(name))">&times;</button>
                </li>
            }
        </ul>
        <ObjectPicker Label="Groep toevoegen" Kinds="GroupKinds" Selected="AddGroup" />

        @if (State.HasMicrosoft365)
        {
            <h3>@T.Format("job-profile-editor.shared-mailboxes-0", jp.Mailboxes.Count)</h3>
            <ul class="kb-lijst">
                @foreach (var smtp in jp.Mailboxes.ToList())
                {
                    var mb = State.Data.Index.Mailbox(smtp);
                    <li>
                        @(mb?.DisplayName ?? smtp) <span class="kb-zacht">@smtp</span>
                        @if (mb is null) { <span class="kb-label">@T["start.notfound"]</span> }
                        else if (State.Data.Index.AccessGroupOf(mb) is null) { <span class="kb-label">@T["job-profile-editor.no-access-group"]</span> }
                        <button class="kb-knop kb-klein" aria-label="@smtp uit het profiel" @onclick="() => Change(() => jp.Mailboxes.Remove(smtp))">&times;</button>
                    </li>
                }
            </ul>
            <div class="kb-rij">
                <select class="kb-invoer" aria-label="@T["job-profile-editor.add-mailbox"]" @onchange="e => AddMailbox(jp, Text(e.Value))">
                    <option value="">@T["job-profile-editor.add-mailbox-2"]</option>
                    @foreach (var m in State.Data.Mailboxes.Where(m => !jp.Mailboxes.Contains(m.Smtp, StringComparer.OrdinalIgnoreCase)))
                    {
                        <option value="@m.Smtp">@m.DisplayName (@m.Smtp)</option>
                    }
                </select>
            </div>

            <h3>@T["job-profile-editor.licences"]</h3>
            <div class="kb-keuzelijst">
                @foreach (var (sku, name) in LicenceChoices(jp))
                {
                    <label>
                        <input type="checkbox" checked="@jp.Licences.Contains(sku, StringComparer.OrdinalIgnoreCase)" aria-label="Licentie @sku"
                               @onchange="e => Change(() => { jp.Licences.RemoveAll(l => string.Equals(l, sku, StringComparison.OrdinalIgnoreCase)); if (e.Value is true) jp.Licences.Add(sku); })" />
                        @name
                    </label>
                }
            </div>
        }
        <p class="kb-zacht">@T["job-profile-editor.the-app-never-gives-dynamic"]</p>
    </section>
}

@code {
    [Parameter] public EventCallback Changed { get; set; }

    private static readonly ObjectKind[] GroupKinds = { ObjectKind.Group };
    private string? editing;
    private string newName = string.Empty;
    private Person? example;
    private string? error;

    private JobProfile? Editing => JobProfiles.Find(State.Config, editing);

    private bool CanAdd => newName.Trim().Length > 0;

    private async Task Change(Action change)
    {
        change();
        error = null;
        await Changed.InvokeAsync();
    }

    private static string? Text(object? value) => value?.ToString()?.Trim() is { Length: > 0 } t ? t : null;

    private async Task AddEmpty() => await Add(new JobProfile { Name = newName.Trim() });

    private async Task AddFromPerson()
    {
        if (example is not null)
        {
            await Add(JobProfilePlans.FromPerson(State.Data, State.Config, example, newName));
        }
    }

    private async Task Add(JobProfile profile)
    {
        if (State.Config.JobProfiles.Any(p => string.Equals(p.Name, profile.Name, StringComparison.CurrentCultureIgnoreCase)))
        {
            error = T.Format("code.job-profile-editor.there-is-already-a-profile", profile.Name);
            return;
        }

        await Change(() => State.Config.JobProfiles.Add(profile));
        editing = profile.Id;
        newName = string.Empty;
        example = null;
    }

    private async Task Remove(JobProfile profile)
    {
        await Change(() => State.Config.JobProfiles.Remove(profile));
        if (editing == profile.Id)
        {
            editing = null;
        }
    }

    private async Task AddGroup(ObjectRef r)
    {
        if (Editing is { } jp && !jp.Groups.Contains(r.Name, StringComparer.OrdinalIgnoreCase))
        {
            await Change(() => jp.Groups.Add(r.Name));
        }
    }

    private async Task AddMailbox(JobProfile jp, string? smtp)
    {
        if (smtp is not null && !jp.Mailboxes.Contains(smtp, StringComparer.OrdinalIgnoreCase))
        {
            await Change(() => jp.Mailboxes.Add(smtp));
        }
    }

    /// <summary>The licences of the organisation and of the tenant, and those already in the profile.</summary>
    private IEnumerable<(string Sku, string Name)> LicenceChoices(JobProfile jp)
        => State.Config.Licences.Select(l => (l.Sku, $"{l.Name} ({l.Sku})"))
            .Concat(State.Data.Licences.Select(l => (l.SkuPartNumber, l.SkuPartNumber)))
            .Concat(jp.Licences.Select(l => (l, l)))
            .Where(x => x.Item1.Length > 0)
            .DistinctBy(x => x.Item1, StringComparer.OrdinalIgnoreCase);
}
