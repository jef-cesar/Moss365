@page "/gebruikers"
@inherits VerversendePagina
@inject NavigationManager Nav

<div class="kb-titelbalk">
    <h1>Gebruikers</h1>
    @if (State.Mag(Recht.Acties)) { <a class="kb-knop kb-primair" href="nieuw">+ Nieuwe gebruiker</a> }
</div>

<KpiFilter Kpi="ActieveKpi" Aantal="KpiRijen.Count" Getoond="Gefilterd.Count" Gewist="() => z.Kpi = null">
    @if (Opkuis is { } link) { <a class="kb-knop" href="@link">Opkuisronde voor deze accounts</a> }
    @if (LicentieVerschil is { } verschil) { <span class="kb-zacht">@verschil</span> }
</KpiFilter>

<div class="kb-filters">
    <input class="kb-invoer kb-breed" placeholder="Zoek op naam, UPN, sAMAccountName, e-mail of dienst" @bind="z.Zoek" @bind:event="oninput" />
    @if (ActieveKpi is null)
    {
        <label><input type="checkbox" @bind="z.MetGasten" /> Gasten tonen</label>
        <label><input type="checkbox" @bind="z.AlleenIngeschakeld" /> Actieve gebruikers</label>
        <select class="kb-invoer" @bind="z.Bron">
            <option value="">Alle bronnen</option>
            <option>AD + Entra</option>
            <option>Alleen AD</option>
            <option>Alleen Entra</option>
            <option>Gast</option>
        </select>
    }
</div>

<KbTabel Id="gebruikers" Items="Gefilterd" Kolommen="kolommen" Selecteerbaar SleutelVan="p => p.Sleutel" SelectieGewijzigd="_ => { }" StandaardSortering="naam" Telling="@($"{Gefilterd.Count} gevonden")" />

<BulkTaken Lijst="gebruikers" Aantal="AantalGekozen" />

@code {
    /// <summary>Zoekterm en filters, bewaard zolang de app open is (Terug, Vooruit, menu).</summary>
    private sealed class Zoeken { public string Zoek { get; set; } = string.Empty; public bool MetGasten { get; set; } public bool AlleenIngeschakeld { get; set; } = true; public string Bron { get; set; } = string.Empty; public string? Kpi { get; set; } }
    private Zoeken? _z;
    private Zoeken z => _z ??= State.Paginastatus.Van<Zoeken>("gebruikers");

    /// <summary>Vanuit een KPI-tegel: gebruikers?kpi=uitgeschakeld (zie Core/Analyse/Kpis.cs).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "kpi")] public string? KpiVraag { get; set; }
    private string? verwerkteKpi;

    protected override void OnParametersSet()
    {
        if (KpiVraag != verwerkteKpi)
        {
            verwerkteKpi = KpiVraag;
            if (State.KpiAankomst(KpiVraag, Nav.Uri, "gebruikers", "gebruikers"))
            {
                _z = null;
                z.Kpi = KpiVraag;
            }
        }
    }

    private Kpi? ActieveKpi => Kpis.Zoek(z.Kpi) is { Lijst: KpiLijst.Gebruikers } k ? k : null;
    private IReadOnlyList<Persoon> KpiRijen => ActieveKpi is { } k ? Kpis.Personen(k, State.KpiBron) : Array.Empty<Persoon>();

    /// <summary>Bij een licentie: Microsoft telt de toegewezen licenties zelf; zegt het als dat anders is dan de lijst.</summary>
    private string? LicentieVerschil => ActieveKpi is { } k && k.Sleutel.StartsWith("licentie:", StringComparison.Ordinal)
        && State.Data.Licenties.FirstOrDefault(l => l.SkuPartNumber == k.Waarde) is { } l && l.Toegewezen != KpiRijen.Count
            ? $"Microsoft telt {l.Toegewezen} toegewezen; het verschil zijn accounts die niet geladen zijn."
            : null;

    private string? Opkuis => ActieveKpi?.Sleutel switch
    {
        "inactief-90" or "nooit-aangemeld" => "opkuis?dagen=90",
        "inactief-180" => "opkuis?dagen=180",
        _ => null,
    };

    private IReadOnlyList<Kolom<Persoon>> kolommen = Array.Empty<Kolom<Persoon>>();

    protected override void OnInitialized() => kolommen = new List<Kolom<Persoon>>
    {
        new() { Sleutel = "naam", Titel = "Naam", Cel = p => @<a href="@Zoeker.Link(p)">@p.Naam</a>, SorteerOp = p => p.Naam },
        new() { Sleutel = "upn", Titel = "UPN", Cel = p => @<text>@p.Upn</text>, SorteerOp = p => p.Upn },
        new() { Sleutel = "bron", Titel = "Bron", Cel = p => @<text>@p.Bron</text>, SorteerOp = p => p.Bron },
        new() { Sleutel = "ou", Titel = "OU", Cel = p => @<text>@p.Ad?.OuPad</text>, SorteerOp = p => p.Ad?.OuPad },
        new() { Sleutel = "dienst", Titel = "Dienst", Cel = p => @<text>@p.Dienst</text>, SorteerOp = p => p.Dienst },
        new() { Sleutel = "afdeling", Titel = "Afdeling", Cel = p => @<text>@(State.Config.AfdelingVoor(p.Dienst)?.Naam)</text>, SorteerOp = p => State.Config.AfdelingVoor(p.Dienst)?.Naam },
        new() { Sleutel = "status", Titel = "Status", Cel = p => @<text>@(p.Ingeschakeld ? "ingeschakeld" : "uitgeschakeld")</text>, SorteerOp = p => p.Ingeschakeld ? "ingeschakeld" : "uitgeschakeld" },
        new() { Sleutel = "sam", Titel = "sAMAccountName", Verborgen = true, Cel = p => @<text>@p.Ad?.SamAccountName</text>, SorteerOp = p => p.Ad?.SamAccountName },
        new() { Sleutel = "mail", Titel = "E-mail", Verborgen = true, Cel = p => @<text>@(p.Entra?.Mail ?? p.Ad?.EmailAddress)</text>, SorteerOp = p => p.Entra?.Mail ?? p.Ad?.EmailAddress },
        new() { Sleutel = "functie", Titel = "Functie", Verborgen = true, Cel = p => @<text>@(p.Ad?.Title ?? p.Entra?.JobTitle)</text>, SorteerOp = p => p.Ad?.Title ?? p.Entra?.JobTitle },
        new() { Sleutel = "kantoor", Titel = "Kantoor", Verborgen = true, Cel = p => @<text>@(p.Ad?.Office ?? p.Entra?.OfficeLocation)</text>, SorteerOp = p => p.Ad?.Office ?? p.Entra?.OfficeLocation },
        new() { Sleutel = "aanmelding", Titel = "Laatste aanmelding", Verborgen = true, Cel = p => @<text>@LaatsteAanmelding(p)</text>, SorteerOp = p => LaatsteAanmelding(p) },
        new() { Sleutel = "licenties", Titel = "Licenties", Verborgen = true, Cel = p => @<text>@(p.Entra is null ? null : string.Join(", ", p.Entra.Licenties))</text>, SorteerOp = p => p.Entra is null ? null : string.Join(", ", p.Entra.Licenties) },
        new() { Sleutel = "aangemaakt", Titel = "Aangemaakt", Verborgen = true, Cel = p => @<text>@(p.Ad?.WhenCreated ?? p.Entra?.CreatedDateTime)</text>, SorteerOp = p => p.Ad?.WhenCreated ?? p.Entra?.CreatedDateTime },
        new() { Sleutel = "entraid", Titel = "Entra-ID", Verborgen = true, Cel = p => @<code>@(p.Entra?.Id)</code>, SorteerOp = p => p.Entra?.Id },
    };

    /// <summary>De recentste van AD en Entra (ISO-datums sorteren als tekst correct).</summary>
    private static string LaatsteAanmelding(Persoon p)
        => new[] { p.Ad?.LastLogonDate, p.Entra?.LaatsteAanmelding }.Where(d => !string.IsNullOrWhiteSpace(d)).OrderByDescending(d => d, StringComparer.Ordinal).FirstOrDefault() ?? string.Empty;

    private List<Persoon> Gefilterd => ActieveKpi is not null
        ? Zoeker.Zoek(KpiRijen, z.Zoek, metGasten: true).ToList()
        : Zoeker.Zoek(State.Data.Personen, z.Zoek, z.MetGasten || z.Bron == "Gast")
            .Where(p => !z.AlleenIngeschakeld || p.Ingeschakeld)
            .Where(p => z.Bron.Length == 0 || p.Bron == z.Bron)
            .ToList();

    private int AantalGekozen => State.TabelSessie("gebruikers").Gekozen.Count;
}
