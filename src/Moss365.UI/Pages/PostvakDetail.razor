@page "/postvak/{Smtp}"
@inherits VerversendePagina

@if (postvak is null)
{
    <h1>Postvak niet gevonden</h1>
    <p><a href="postvakken">Terug naar de postvakken</a></p>
}
else
{
    <h1>@postvak.DisplayName</h1>
    <ObjectStatus Object="State.Data.Index.Ref(postvak.Smtp)" />
    <p class="kb-zacht">
        @postvak.TypeTekst &middot; @postvak.Smtp
        @if (postvak.Verborgen) { <span class="kb-label">verborgen in de adreslijst</span> }
        @if (postvak.Doorsturen.Length > 0) { <span class="kb-label">doorsturen: @postvak.Doorsturen</span> }
    </p>

    <section class="kb-kaart">
        <h2>Aanmelden met het account</h2>
        @if (State.Data.Index.AccountVan(postvak.Smtp, postvak.Alias) is not { } account)
        {
            <p class="kb-zacht">Het account van dit postvak staat niet in de geladen gegevens (AD of Entra).</p>
        }
        else
        {
            <table class="kb-tabel kb-naast">
                <tbody>
                    <tr>
                        <th>Kan aanmelden</th>
                        <td>
                            @if (account.Ingeschakeld)
                            {
                                <span class="kb-label kb-label-let">⚠ ja</span> <span class="kb-zacht">niemand hoort zich met een gedeeld postvak aan te melden</span>
                            }
                            else
                            {
                                <span class="kb-label kb-label-goed">✓ nee, geblokkeerd</span> <span class="kb-zacht">het postvak werkt gewoon</span>
                            }
                        </td>
                    </tr>
                    <tr><th>Account</th><td><ObjectLink Object="State.Data.Index.Ref(account)" /> <span class="kb-zacht">@account.Bron</span></td></tr>
                    <tr><th>Laatste aanmelding</th><td>@(Statistiek.LaatsteAanmelding(account)?.ToString("dd/MM/yyyy HH:mm") ?? "nooit (of onbekend)")</td></tr>
                </tbody>
            </table>
            <div class="kb-filters" hidden="@(!State.Mag(Recht.Beheren))">
                @if (account.Ingeschakeld)
                {
                    <button class="kb-knop kb-primair" @onclick="@(() => Plan(PostvakPlannen.Aanmelden(State.Data, postvak, false), "Aanmelden blokkeren"))">Aanmelden blokkeren</button>
                }
                else
                {
                    <button class="kb-knop" @onclick="@(() => Plan(PostvakPlannen.Aanmelden(State.Data, postvak, true), "Aanmelden toestaan"))">Aanmelden toestaan</button>
                }
            </div>
        }
    </section>

    <div class="kb-kolommen">
        <section class="kb-kaart">
            <h2>Toegang</h2>
            @if (groep is null)
            {
                <div class="kb-melding">Er is geen toegangsgroep. Volgens de afspraak heet die <code>@ObjectIndex.VerwachteToegangsgroep(postvak)</code>.</div>
                <div class="kb-filters">
                    <button class="kb-knop kb-primair" @onclick="@(() => Plan(PostvakPlannen.ToegangsgroepAanmaken(State.Data, postvak), "Toegangsgroep aanmaken"))">Toegangsgroep aanmaken</button>
                </div>
            }
            else
            {
                <p>Via <ObjectLink Object="groep.Ref" /> (@groepLeden.Count leden)</p>
                <ul class="kb-lijst-plat">
                    @foreach (var l in groepLeden)
                    {
                        <li><ObjectLink Object="l.Object" />
                            <button class="kb-knop kb-klein" @onclick="@(() => Plan(GroepPlannen.LidVerwijderen(State.Data, groep, l.Object), "Toegang intrekken"))">weghalen</button></li>
                    }
                </ul>
                <ObjectKiezer Label="Toegang geven aan" Soorten="Personen" Gekozen="@(r => Plan(GroepPlannen.LidToevoegen(State.Data, groep, r), "Toegang geven"))" />
            }
        </section>

        <section class="kb-kaart">
            <h2>Lid van (@groepen.Count)</h2>
            @if (groepen.Count == 0) { <p class="kb-zacht">Geen groepen.</p> }
            <ul class="kb-lijst-plat">
                @foreach (var g in groepen)
                {
                    <li><ObjectLink Object="g.Object" /> <span class="kb-zacht">(@g.Laag)</span></li>
                }
            </ul>
        </section>
    </div>

    <section class="kb-kaart">
        <h2>Rechten (@rechten.Count)</h2>
        @if (rechten.Count == 0)
        {
            <p class="kb-zacht">Geen expliciete rechten gekend.</p>
        }
        else
        {
            <table class="kb-tabel">
                <thead><tr><th>Wie</th><th>Soort</th><th>Recht</th><th>Hoe</th></tr></thead>
                <tbody>
                    @foreach (var r in rechten)
                    {
                        <tr class="@(r.Direct ? "kb-verschil" : null)">
                            <td><ObjectLink Object="r.Wie" /></td>
                            <td>@r.Wie.SoortTekst</td>
                            <td>@r.Recht</td>
                            <td>@(r.Direct ? "rechtstreeks" : "via groep")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (rechten.Any(r => r.Direct))
        {
            <p class="kb-zacht">
                Opruimen: wie rechtstreeks een recht heeft, wordt lid van de toegangsgroep en verliest het rechtstreekse recht. De groep krijgt
                eerst zelf FullAccess en SendAs als die ontbreken. Onbekende rechthebbenden (bv. verwijderde accounts) staan in het plan maar
                zijn niet aangevinkt.
            </p>
            <div class="kb-filters">
                <button class="kb-knop kb-primair" @onclick="@(() => Plan(PostvakPlannen.DirecteRechtenOpruimen(State.Data, postvak), "Rechtstreekse rechten naar de groep"))">Rechtstreekse rechten opruimen</button>
            </div>
        }
    </section>

    @if (State.Mag(Recht.Beheren))
    {
    <section class="kb-kaart">
        <h2>Instellingen</h2>
        @if (postvak.AutoAntwoord.Length == 0)
        {
            <p class="kb-zacht">Doorsturen en automatisch antwoord zijn niet live geladen; de huidige waarde is dan onbekend. <a href="verbindingen">Postvakken laden uit Exchange</a></p>
        }
        <div class="kb-raster">
            <label>Weergavenaam <input class="kb-invoer" @bind="gewenst.Weergavenaam" /></label>
            <label>Verbergen in de adreslijst <JaNee @bind-Waarde="gewenst.Verborgen" /></label>
            <label>Doorsturen naar (leeg = uit) <input class="kb-invoer" placeholder="@(postvak.DoorsturenNaar.Length > 0 ? postvak.DoorsturenNaar : "(niet wijzigen)")" @bind="extra.Doorsturen" /></label>
            <label>Ook bewaren bij doorsturen <JaNee @bind-Waarde="gewenst.DoorsturenEnBewaren" /></label>
            <label>Automatisch antwoord
                <select class="kb-invoer" @bind="extra.AutoAntwoord">
                    <option value="">(niet wijzigen)</option>
                    <option value="Enabled">aan</option>
                    <option value="Disabled">uit</option>
                </select>
            </label>
        </div>
        <label><input type="checkbox" @bind="extra.DoorsturenUitzetten" /> Doorsturen uitzetten</label>
        @if (extra.AutoAntwoord == "Enabled")
        {
            <div class="kb-raster kb-breed-raster">
                <label>Tekst intern <textarea class="kb-invoer" rows="3" @bind="gewenst.AutoAntwoordIntern"></textarea></label>
                <label>Tekst extern <textarea class="kb-invoer" rows="3" @bind="gewenst.AutoAntwoordExtern"></textarea></label>
            </div>
        }
        <div class="kb-filters">
            <button class="kb-knop kb-primair" @onclick="InstellingenPlan">Plan maken</button>
        </div>
    </section>
    }

    @foreach (var f in fouten)
    {
        <div class="kb-melding kb-fout">@f</div>
    }
    @if (plan is not null)
    {
        <PlanWeergave Plan="plan" Context="@($"Postvak {postvak.DisplayName}")" Titel="@planTitel" Uitgevoerd="NaUitvoeren" />
    }
}

@code {
    [Parameter] public string Smtp { get; set; } = string.Empty;

    private static readonly ObjectSoort[] Personen = { ObjectSoort.Gebruiker };

    private Postvak? postvak;
    private Groep? groep;
    private IReadOnlyList<Relatie> groepLeden = Array.Empty<Relatie>();
    private IReadOnlyList<Relatie> groepen = Array.Empty<Relatie>();
    private IReadOnlyList<RechtRegel> rechten = Array.Empty<RechtRegel>();
    private PostvakGewenst gewenst = new();
    // Wat je invulde blijft per postvak bewaard tot het plan uitgevoerd is (Terug, Vooruit, menu)
    private sealed class Extra { public string? Doorsturen { get; set; } public bool DoorsturenUitzetten { get; set; } public string AutoAntwoord { get; set; } = string.Empty; }
    private Extra extra = new();
    private string Formulier => $"postvakken/{geladen}/wijzigen";
    private IReadOnlyList<Wijziging>? plan;
    private IReadOnlyList<string> fouten = Array.Empty<string>();
    private string planTitel = string.Empty;
    private string? geladen;

    protected override void OnParametersSet()
    {
        var index = State.Data.Index;
        var nieuw = index.Postvak(Smtp);
        if (nieuw?.Smtp != geladen)
        {
            geladen = nieuw?.Smtp;
            plan = null;
            fouten = Array.Empty<string>();
            gewenst = nieuw is null ? new() : State.Paginastatus.Formulier(Formulier, "postvak/" + nieuw.Smtp, $"Postvak {nieuw.DisplayName}", () => new PostvakGewenst
            {
                Weergavenaam = nieuw.DisplayName,
                AutoAntwoordIntern = nieuw.AutoAntwoordIntern,
                AutoAntwoordExtern = nieuw.AutoAntwoordExtern,
            });
            extra = nieuw is null ? new() : State.Paginastatus.Formulier<Extra>(Formulier + "/extra", "postvak/" + nieuw.Smtp, $"Postvak {nieuw.DisplayName}");
        }

        postvak = nieuw;
        if (postvak is not null)
        {
            groep = index.ToegangsgroepVan(postvak);
            groepLeden = groep is null ? Array.Empty<Relatie>() : index.UniekeLedenVan(groep);
            groepen = index.GroepenVanAdres(postvak.Smtp);
            rechten = index.RechtenOp(postvak);
        }
    }

    private void NaUitvoeren(IReadOnlyList<WijzigingResultaat> resultaten)
    {
        if (resultaten.Any(r => r.Status == ResultaatStatus.Gelukt))
        {
            State.Paginastatus.Vergeet(Formulier);
            State.Paginastatus.Vergeet(Formulier + "/extra");
        }
    }

    private void InstellingenPlan()
    {
        gewenst.DoorsturenNaar = extra.DoorsturenUitzetten ? string.Empty : string.IsNullOrWhiteSpace(extra.Doorsturen) ? null : extra.Doorsturen;
        gewenst.AutoAntwoord = extra.AutoAntwoord.Length == 0 ? null : extra.AutoAntwoord;
        Plan(PostvakPlannen.Instellingen(postvak!, gewenst), "Instellingen van het postvak");
    }

    private void Plan(PlanUitkomst u, string titel)
    {
        planTitel = titel;
        fouten = u.Fouten;
        plan = u.Plan.Count > 0 || u.Fouten.Count == 0 ? u.Plan : null;
    }
}
