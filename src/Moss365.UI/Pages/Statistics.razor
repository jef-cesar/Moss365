@page "/statistieken"
@using Moss365.Core.Analysis
@inherits RefreshingPage

<h1>@T["menu.statistieken"]</h1>

<p class="kb-zacht">
    @T.Format("statistics.indicators-from-the-loaded-data", State.OriginOf(new ObjectRef(ObjectKind.User, "", "")))
</p>

<section class="kb-kaart">
    <h2>@T["start.accounts"]</h2>
    <div class="kb-tegels">
        <Tile Kpi="Kpis.Active" />
        <Tile Kpi="Kpis.Disabled" />
        <Tile Kpi="Kpis.Guests" />
        @if (State.HasAd && State.HasMicrosoft365)
        {
            <Tile Kpi="Kpis.AdAndEntra" />
            <Tile Kpi="Kpis.OnlyAd" />
            <Tile Kpi="Kpis.OnlyEntra" />
        }
        @if (State.HasMicrosoft365)
        {
            <Tile Kpi="Kpis.MailboxAccounts" />
            <Tile Kpi="Kpis.SignInAllowed" />
        }
    </div>
    <p class="kb-zacht">
        @T["statistics.shared-mailboxes-rooms-and-scheduling"]
    </p>
</section>

<section class="kb-kaart">
    <h2>@T["statistics.points-of-attention"]</h2>
    <p class="kb-zacht">@T["statistics.signals-to-check-not-conclusions"]</p>
    <div class="kb-tegels">
        <Tile Kpi="Kpis.Inactive90" />
        <Tile Kpi="Kpis.Inactive180" />
        <Tile Kpi="Kpis.NeverSignedIn" />
        @if (State.HasAd)
        {
            <Tile Kpi="Kpis.PasswordExpiresNever" />
            <Tile Kpi="Kpis.Privileged" />
        }
        @if (State.HasAd && State.HasMicrosoft365)
        {
            <Tile Count="s.DifferencesAdEntra.Sum(v => v.Count)" Label="@T["code.statistics.differences-ad-and-entra"]" Link="vergelijk" />
        }
    </div>
</section>

<section class="kb-kaart">
    <div class="kb-titelbalk">
        <h2>@T["statistics.employees-in-view"]</h2>
        <label class="kb-schuif">
            @T["statistics.division"]
            <select class="kb-invoer" @bind="f.Division" aria-label="@T["statistics.filter-on-division"]">
                <option value="">@T["statistics.all-divisions"]</option>
                @foreach (var a in Divisions) { <option value="@a">@a</option> }
            </select>
        </label>
    </div>
    <p class="kb-zacht">
        @T.Format("statistics.active-employees-0-the-filter", Division is null ? "" : (" " + T.Format("code.statistics.of", Division)))
    </p>
    <div class="kb-kolommen">
        <div>
            <h3>@T["statistics.last-sign-in"]</h3>
            <Distribution Share="BiStatistics.SignInRecency(State.KpiSource, Division)" />
        </div>
        @if (State.HasMicrosoft365)
        {
        <div>
            <h3>@T["security-card.mfa"]</h3>
            <Distribution Share="BiStatistics.Mfa(State.KpiSource, Division)" EmptyText="@T["statistics.no-active-employees"]" />
            @if (State.Data.Security is null) { <p class="kb-zacht">@T["statistics.mfa-registrations-not-loaded-yet"]</p> }
        </div>
        }
    </div>
    <div class="kb-kolommen">
        @if (State.HasAd)
        {
        <div>
            <h3>@T["statistics.age-of-the-password-ad"]</h3>
            <Distribution Share="BiStatistics.PasswordAge(State.KpiSource, Division)" EmptyText="@T["statistics.no-active-ad-accounts"]" />
        </div>
        }
        <div>
            <h3>@T["statistics.per-office"]</h3>
            <BarList Bars="PerOffice" />
        </div>
    </div>
    <h3>@T["statistics.new-accounts-per-month"]</h3>
    <ColumnChart Columns="BiStatistics.CreatedPerMonth(State.KpiSource, Division)" Title="@T["code.statistics.new-accounts-per-month-the"]" ColumnTitle="@T["period.month"]"
                  Series="@(new[] { new ColumnChart.SeriesItem("Nieuwe accounts") })" />
</section>

<section class="kb-kaart">
    <h2>@T["statistics.trend"]</h2>
    <p class="kb-zacht">
        @Html("statistics.history")
    </p>
    <span class="kb-segment" role="group" aria-label="@T["statistics.trend-per"]">
        @foreach (var (p, text) in new[] { (TrendPeriod.Day, T["period.day"]), (TrendPeriod.Week, T["period.week"]), (TrendPeriod.Month, T["period.month"]), (TrendPeriod.Year, T["period.year"]) })
        {
            <button class="kb-knop @(period == p ? "kb-primair" : null)" aria-pressed="@(period == p)" @onclick="() => ChoosePeriod(p)">@text</button>
        }
    </span>
    <div class="kb-verlopen">
        @foreach (var v in trend)
        {
            <Sparkline Trend="v" />
        }
    </div>
</section>

@if (State.HasMicrosoft365)
{
<section class="kb-kaart">
    <h2>@T["group.beveiliging"]</h2>
    @if (s.Security is not { } bv)
    {
        <p class="kb-zacht">@T["statistics.mfa-and-admin-roles-are"] <a href="beveiliging">@T["statistics.to-security"]</a></p>
    }
    else
    {
        <div class="kb-tegels">
            <Tile Kpi="Kpis.WithoutMfa" Label="@(bv.MfaKnown ? $"zonder MFA (van {bv.WithMfaData})" : "zonder MFA (onbekend)")" />
            <Tile Kpi="Kpis.AdministratorsWithoutMfa" />
            <Tile Kpi="Kpis.WithAdminRole" />
            <Tile Kpi="Kpis.GlobalAdministrators" />
        </div>
        @if (bv.Methods.Count > 0)
        {
            <h3>@T["statistics.registered-methods"]</h3>
            <BarList Bars="bv.Methods" />
        }
    }
</section>

<section class="kb-kaart">
    <h2>@T["menu.conditional-access"]</h2>
    @if (State.Data.ConditionalAccess is not { Message: null } ca)
    {
        <p class="kb-zacht">@T["statistics.not-loaded-yet-or-not"] <a href="conditional-access">@T["ca-user-card.to-conditional-access"]</a></p>
    }
    else
    {
        <div class="kb-tegels">
            <Tile Kpi="Kpis.CaOn" />
            <Tile Kpi="Kpis.CaReport" />
            <Tile Kpi="Kpis.CaProblems" />
            <Tile Kpi="Kpis.CaAttention" />
            <Tile Kpi="Kpis.OutsideMfaPolicy" />
        </div>
    }
</section>
}

<div class="kb-kolommen">
    @if (State.HasMicrosoft365)
    {
    <section class="kb-kaart">
        <h2>@T["job-profile-editor.licences"]</h2>
        @if (s.Licences.Count == 0)
        {
            <p class="kb-zacht">@T["statistics.no-licence-data-loaded"]</p>
        }
        <BarList Bars="s.Licences" Warning="Statistic.AlmostFull" WarningText="@T["code.statistics.almost-full"]" />
    </section>
    }
    <section class="kb-kaart">
        <h2>@T["statistics.active-employees-per-division"]</h2>
        <BarList Bars="s.PerDivision" />
    </section>
</div>

<div class="kb-kolommen">
    @if (State.HasMicrosoft365)
    {
    <section class="kb-kaart">
        <h2>@T.Format("job-profile-editor.shared-mailboxes-0", s.SharedMailboxes)</h2>
        <BarList Bars="s.PermissionModel" />
        <div class="kb-tegels">
            <Tile Kpi="Kpis.WithDirectPermissions" />
            <Tile Kpi="Kpis.WithoutAccessGroup" />
        </div>
    </section>
    }
    <section class="kb-kaart">
        <h2>@T.Format("job-profile-editor.groups-0", s.Groups)</h2>
        <BarList Bars="s.GroupsPerKind" />
        <div class="kb-tegels">
            <Tile Kpi="Kpis.DynamicGroups" />
            <Tile Kpi="Kpis.EmptyGroups" />
        </div>
    </section>
</div>

@if (State.HasMicrosoft365)
{
<div class="kb-kolommen">
    <section class="kb-kaart">
        <h2>@T["nav.part.Rooms"]</h2>
        <div class="kb-tegels">
            <Tile Count="s.Rooms" Label="@T["statistics.meeting-rooms"]" Link="rooms" Attention="false" />
            <Tile Kpi="Kpis.RoomsWithDeviation" />
        </div>
    </section>
    <section class="kb-kaart">
        <h2>@T["statistics.guest-users-per-organisation"]</h2>
        <BarList Bars="GuestsPerDomain" />
        @if (GuestsPerDomain.Count == 0) { <p class="kb-zacht">@T["statistics.no-guest-users-loaded"]</p> }
    </section>
</div>
}

<section class="kb-kaart">
    <h2>@T["statistics.activity-in-the-app"]</h2>
    <div class="kb-tegels">
        <Tile Kpi="Kpis.Succeeded7" />
        <Tile Kpi="Kpis.Failed7" />
        <Tile Count="State.CountFollowUpTasks" Label="@T["statistics.follow-up-tasks-open"]" Link="opvolging" />
    </div>
    <h3>@T["statistics.changes-per-week"]</h3>
    <ColumnChart Columns="perWeek" Title="@T["code.statistics.changes-run-per-week-the"]" ColumnTitle="@T["period.week"]" EmptyText="@T["code.statistics.no-changes-run-in-the"]"
                  Series="@(new[] { new ColumnChart.SeriesItem("Gelukt", "goed"), new ColumnChart.SeriesItem("Mislukt", "kritiek") })" />
</section>

@code {
    private Statistic s = Statistic.Compute(new InventoryData(), new Moss365.Core.Configuration.OrganisationConfig(), DateTime.Now);

    /// <summary>The division filter above the charts, kept while the app is open.</summary>
    private sealed class Filters { public string Division { get; set; } = string.Empty; }
    private Filters? _f;
    private Filters f => _f ??= State.PageState.Of<Filters>("statistieken");
    private string? Division => f.Division.Length == 0 ? null : f.Division;

    private IReadOnlyList<KpiTrend> trend = Array.Empty<KpiTrend>();
    private TrendPeriod period = TrendPeriod.Day;

    private void ChoosePeriod(TrendPeriod p)
    {
        period = p;
        trend = State.KpiTrend(p);
    }
    private IReadOnlyList<ChartColumn> perWeek = Array.Empty<ChartColumn>();

    protected override void OnParametersSet()
    {
        s = Statistic.Compute(State.Data, State.Config, DateTime.Now);
        trend = State.KpiTrend(period);
        perWeek = BiStatistics.ChangeLogPerWeek(State.ChangeLog.Recent(5000), DateTime.Now);
    }

    private IEnumerable<string> Divisions => State.KpiSource.Staff
        .Select(p => State.Config.DivisionFor(p.Department)?.Name ?? Statistic.NoDivision)
        .Distinct().OrderBy(a => a, StringComparer.CurrentCultureIgnoreCase);

    private IReadOnlyList<Bar> PerOffice => BiStatistics.PerOffice(State.KpiSource, Division)
        .Select(d => new Bar(d.Name, d.Count, Link: d.Kpi?.Link)).ToList();

    private IReadOnlyList<Bar> GuestsPerDomain => BiStatistics.GuestsPerDomain(State.KpiSource)
        .Select(d => new Bar(d.Name, d.Count, Link: d.Kpi?.Link)).ToList();
}
