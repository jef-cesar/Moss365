@page "/gasten"
@inherits RefreshingPage

<div class="kb-titelbalk">
    <h1>@T["menu.gasten"]</h1>
    @if (State.Can(Permission.InviteGuests)) { <a class="kb-knop kb-primair" href="gasten#uitnodigen">@T["guests.invite-guest"]</a> }
</div>

<p class="kb-zacht">
    @T["guests.external-users-b2b-guests-in"]
</p>

<div class="kb-tegels">
    <div class="kb-tegel"><div class="kb-tegel-getal">@All.Count</div><div>@T["guests.guests"]</div></div>
    <div class="kb-tegel"><div class="kb-tegel-getal">@All.Count(p => !p.Enabled)</div><div>@T["guests.blocked"]</div></div>
    <a class="kb-tegel" href="opkuis?soort=gasten&amp;dagen=180"><div class="kb-tegel-getal">@All.Count(p => Inactive(p))</div><div>@T["guests.not-signed-in-for-180"]</div></a>
</div>

@if (State.Can(Permission.InviteGuests))
{
<section class="kb-kaart" id="uitnodigen">
    <h2>@T["guests.invite-guest-2"]</h2>
    <div class="kb-raster">
        <label>@T["guests.e-mail-address"] <input class="kb-invoer" type="email" placeholder="naam@example.com" @bind="input.Address" /></label>
        <label>@T["variables-editor.name"] <input class="kb-invoer" placeholder="@T["guests.first-name-last-name-company"]" @bind="input.Name" /></label>
    </div>
    <label><input type="checkbox" @bind="input.Message" /> @T["guests.send-invitation-by-e-mail"]</label>
    <ObjectPicker Label="@T["guests.put-in-groups-right-away"]" Kinds="GroupKinds" Selected="r => { if (!input.Groups.Contains(r.Key)) input.Groups.Add(r.Key); }" />
    @if (input.Groups.Count > 0)
    {
        <p>
            @foreach (var key in input.Groups.ToList())
            {
                <span class="kb-label">@(State.Data.Index.Group(key)?.Name ?? key) <button class="kb-knop kb-klein" aria-label="@($"{State.Data.Index.Group(key)?.Name ?? key} niet")" @onclick="() => input.Groups.Remove(key)">&times;</button></span>
            }
        </p>
    }
    <div class="kb-filters">
        <button class="kb-knop kb-primair" @onclick="Invite">@T["bulk-tasks.make-plan"]</button>
    </div>
</section>
}

<div class="kb-filters kb-plak">
    <input class="kb-invoer kb-breed" placeholder="@T["mailboxes.search-by-name-or-address"]" @bind="input.Find" @bind:event="oninput" aria-label="@T["nav.search"]" />
    <button class="kb-knop" hidden="@(!State.Can(Permission.Manage))" disabled="@(selected.Count == 0)" @onclick="Delete">@T.Format("guests.delete-chosen-guests-0", selected.Count)</button>
</div>
@if (selected.Count > 0 && State.Can(Permission.GroupMembers))
{
    <div class="kb-kolommen">
        <ObjectPicker Label="@($"Gekozen gasten ({selected.Count}) in een groep plaatsen")" Kinds="GroupKinds" Selected="r => InGroup(r, true)" />
        <ObjectPicker Label="@($"Gekozen gasten ({selected.Count}) uit een groep halen")" Kinds="GroupKinds" Selected="r => InGroup(r, false)" />
    </div>
}

<KbTable Id="gasten" Items="Items" Columns="columns" DefaultSorting="naam" CountText="@($"{Items.Count} gasten")"
         Selectable KeyOf="p => p.Key" Selected="selected" SelectionChanged="_ => { }"
         RowClass="@(p => Inactive(p) ? "kb-verschil" : null)" />

@foreach (var f in errors)
{
    <div class="kb-melding @(plan is null ? "kb-fout" : null)">@f</div>
}
@if (plan is not null)
{
    <PlanView Plan="plan" Context="@T["menu.gasten"]" Title="@T["menu.gasten"]" Executed="AfterExecute" />
}

@code {
    /// <summary>Search term and the invitation being filled in, kept while the app is open (Back, Forward, menu).</summary>
    private sealed class Input { public string Find { get; set; } = string.Empty; public string Address { get; set; } = string.Empty; public string Name { get; set; } = string.Empty; public bool Message { get; set; } = true; public List<string> Groups { get; set; } = new(); }

    private static readonly ObjectKind[] GroupKinds = { ObjectKind.Group };
    private Input? _input;
    private Input input => _input ??= State.PageState.Form<Input>("gasten", "gasten", "Gast uitnodigen", filled: i => i.Address.Trim().Length > 0 || i.Name.Trim().Length > 0);
    private readonly HashSet<string> selected = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<Change>? plan;
    private IReadOnlyList<string> errors = Array.Empty<string>();
    private IReadOnlyList<Column<Person>> columns = Array.Empty<Column<Person>>();

    private List<Person> All => State.Data.Persons.Where(p => p.IsGuest).ToList();

    private List<Person> Items
    {
        get
        {
            var z = input.Find.Trim();
            return All.Where(p => z.Length == 0 || p.Name.Contains(z, StringComparison.OrdinalIgnoreCase)
                                   || (p.Entra?.Mail.Contains(z, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        }
    }

    protected override void OnInitialized() => columns = new List<Column<Person>>
    {
        new() { Key = "naam", Title = T["variables-editor.name"], Cell = p => @<ObjectLink Object="State.Data.Index.Ref(p)" />, SortBy = p => p.Name },
        new() { Key = "mail", Title = T["guests.e-mail-address"], Cell = p => @<text>@p.Entra?.Mail</text>, SortBy = p => p.Entra?.Mail },
        new() { Key = "domein", Title = T["new-mailbox.domain"], Cell = p => @<text>@Domain(p)</text>, SortBy = p => Domain(p) },
        new() { Key = "status", Title = "Status", Cell = p => @<text>@(p.Enabled ? T["word.active"] : T["word.blocked"])</text>, SortBy = p => p.Enabled ? "actief" : "geblokkeerd" },
        new() { Key = "aangemaakt", Title = T["guests.invited"], Cell = p => @<text>@Date(p.Entra?.CreatedDateTime)</text>, SortBy = p => p.Entra?.CreatedDateTime },
        new() { Key = "aanmelding", Title = T["statistics.last-sign-in"], Cell = p => @<text>@Date(p.Entra?.LastSignIn)</text>, SortBy = p => p.Entra?.LastSignIn },
        new() { Key = "groepen", Title = T["menu.groepen"], Number = true, Cell = p => @<text>@State.Data.CloudGroupsOf(p).Count()</text>, SortBy = p => State.Data.CloudGroupsOf(p).Count() },
        new() { Key = "upn", Title = "UPN", Hidden = true, Cell = p => @<text>@p.Upn</text>, SortBy = p => p.Upn },
        new() { Key = "entraid", Title = T["object-status.entra-id"], Hidden = true, Cell = p => @<code>@(p.Entra?.Id)</code>, SortBy = p => p.Entra?.Id },
    };

    private static string Domain(Person p) => p.Entra?.Mail is { } m && m.Contains('@') ? m[(m.IndexOf('@') + 1)..] : string.Empty;

    private static string Date(string? d) => string.IsNullOrEmpty(d) ? string.Empty : d.Length >= 10 ? d[..10] : d;

    /// <summary>Not signed in for 180 days (or never, when the invitation is older than 180 days).</summary>
    private static bool Inactive(Person p)
    {
        var limit = DateTime.Now.AddDays(-180);
        if (DateTime.TryParse(p.Entra?.LastSignIn, out var last))
        {
            return last < limit;
        }

        return DateTime.TryParse(p.Entra?.CreatedDateTime, out var created) && created < limit;
    }

    private void Invite() => Show(GuestPlans.Invite(State.Data, input.Address, input.Name, input.Message,
        input.Groups.Select(State.Data.Index.Group).OfType<Group>()));

    /// <summary>The selected guests in a group or out of it (0.31): one plan, the usual checks per guest.</summary>
    private void InGroup(ObjectRef r, bool add)
    {
        if (State.Data.Index.Group(r.Key) is { } g)
        {
            Show(BulkPlans.UsersInGroup(State.Data, All.Where(p => selected.Contains(p.Key)), g, add));
        }
    }

    private void Delete() => Show(GuestPlans.Delete(State.Data, All.Where(p => selected.Contains(p.Key))));

    // After a successful invitation the form is empty again (the search term stays)
    private void AfterExecute(IReadOnlyList<ChangeResult> results)
    {
        if (results.Any(r => r.Status == ResultStatus.Succeeded))
        {
            input.Address = string.Empty;
            input.Name = string.Empty;
            input.Groups.Clear();
        }
    }

    private void Show(PlanOutcome u)
    {
        errors = u.Errors;
        plan = u.Plan.Count > 0 ? u.Plan : null;
    }
}
