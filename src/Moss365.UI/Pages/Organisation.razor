@page "/organisatie"
@page "/organisatie/{Part}"
@layout SettingsLayout
@implements IDisposable
@inject ManagementState State

<h1>@T["menu.organisatie"]<span class="kb-zacht">: @PartTitle</span></h1>

<p class="kb-zacht">
    @Html("organisation.intro", State.Tenant.Name)
</p>

<LeaveConfirm Active="changed" CanSave="@(Errors.Count == 0)" Saving="Save" Discard="Undone"
                   Text="@T["code.organisation.you-changed-the-organisation-but"]" />

<div class="kb-filters kb-plak">
    <button class="kb-knop kb-primair" disabled="@(!changed || Errors.Count > 0)" @onclick="Save">@T["action.save"]</button>
    <button class="kb-knop" disabled="@(!changed)" @onclick="Undone">@T["organisation.undo-changes"]</button>
    @if (State.ConfigIsModified)
    {
        <button class="kb-knop" @onclick="Restore">@T["organisation.back-to-the-list-that"]</button>
    }
    @if (message is not null)
    {
        <span class="kb-ok">@message</span>
    }
    @if (changed)
    {
        <span class="kb-label">@T["connections.not-saved"]</span>
    }
</div>

@foreach (var f in Errors)
{
    <div class="kb-melding kb-fout">@f</div>
}

@if (Is(null))
{
<SuggestionsPanel TakenOver="Recompute" />

<section class="kb-kaart">
    <h2>@T["organisation.company"]</h2>
    <div class="kb-rij">
        <label>@T["organisation.company-2"]</label>
        <input class="kb-invoer" value="@State.Config.Company" @onchange="e => Set(() => State.Config.Company = e.Value?.ToString() ?? string.Empty)" />
    </div>
</section>

<section class="kb-kaart">
    <h2>@T["organisation.naming-of-new-accounts"]</h2>
    <div class="kb-raster">
        <label>@T["organisation.account-name-before-the"]
            <select class="kb-invoer" aria-label="@T["organisation.account-name"]" @onchange="e => Set(() => State.Config.Naming.LocalPart = Enum.Parse<LocalPartPattern>(e.Value?.ToString() ?? nameof(LocalPartPattern.GivenDotSurname)))">
                @foreach (var p in Enum.GetValues<LocalPartPattern>())
                {
                    <option value="@p" selected="@(State.Config.Naming.LocalPart == p)">@NamingSettings.Example(p)</option>
                }
            </select>
        </label>
        <label>@T["edit-user.display-name"]
            <select class="kb-invoer" aria-label="@T["edit-user.display-name"]" @onchange="e => Set(() => State.Config.Naming.DisplayName = Enum.Parse<DisplayNamePattern>(e.Value?.ToString() ?? nameof(DisplayNamePattern.GivenSurname)))">
                @foreach (var p in Enum.GetValues<DisplayNamePattern>())
                {
                    <option value="@p" selected="@(State.Config.Naming.DisplayName == p)">@NamingSettings.Example(p)</option>
                }
            </select>
        </label>
    </div>
    <p class="kb-zacht">@T["organisation.example-for-an-peeters-accents"]</p>
</section>

<section class="kb-kaart">
    <h2>@T["organisation.template-export-and-import"]</h2>
    <div class="kb-rij">
        <label>@T["manage-ca.template"]
            <select class="kb-invoer" @bind="templateKey" aria-label="@T["manage-ca.template"]">
                <option value="">@T["script-form.choose"]</option>
                @foreach (var t in OrganisationTemplates.All) { <option value="@t.Key">@t.Name: @t.Description</option> }
            </select>
        </label>
        <button class="kb-knop" disabled="@(templateKey.Length == 0)" @onclick="ApplyTemplate">@T["organisation.apply"]</button>
    </div>
    <p class="kb-zacht">@T["organisation.a-template-only-adds-what"]</p>
    <div class="kb-rij">
        <button class="kb-knop" @onclick="Export">@T["kb-table.export"]</button>
        <label class="kb-knop kb-bestandknop">@T["organisation.import-json"]<InputFile OnChange="Import" accept=".json" /></label>
    </div>
    <p class="kb-zacht">
        @T["organisation.export-writes-the-settings-to"]
    </p>
    @if (exchangeMessage is not null) { <div class="kb-melding @(exchangeError ? "kb-fout" : null)">@exchangeMessage</div> }
</section>
}

@if (Is("diensten"))
{
<section class="kb-kaart">
    <h2>@T["menu.organisatie.diensten"]</h2>
    <p class="kb-zacht">
        @T.Format("organisation.department-holds-the-department-the", Unlinked, State.Config.Departments.Count)
    </p>
    <div class="kb-filters">
        <label><input type="checkbox" @bind="onlyUnlinked" /> @T["organisation.only-departments-without-a-division"]</label>
    </div>
    <table class="kb-tabel">
        <thead><tr><th>@T["organisation.department"]</th><th>@T["statistics.division"]</th><th class="kb-getal">@T["menu.gebruikers"]</th><th>@T["mirror.note"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var d in State.Config.Departments.Where(d => !onlyUnlinked || string.IsNullOrWhiteSpace(d.Division)).ToList())
            {
                <tr class="@(string.IsNullOrWhiteSpace(d.Division) ? "kb-ontbreekt" : null)">
                    <td><input class="kb-invoer" value="@d.Department" @onchange="e => Set(() => d.Department = e.Value?.ToString() ?? string.Empty)" /></td>
                    <td>
                        <select class="kb-invoer" aria-label="@($"Afdeling voor {d.Department}")" @onchange="e => Set(() => d.Division = EmptyIsNull(e.Value))">
                            <option value="" selected="@string.IsNullOrWhiteSpace(d.Division)">@T["organisation.not-linked-yet"]</option>
                            @foreach (var a in State.Config.Divisions)
                            {
                                <option value="@a.Name" selected="@(string.Equals(a.Name, d.Division, StringComparison.OrdinalIgnoreCase))">@a.Name</option>
                            }
                        </select>
                    </td>
                    <td class="kb-getal">@(counts.TryGetValue(d.Department, out var n) ? n : 0)</td>
                    <td><input class="kb-invoer" value="@d.Remark" @onchange="e => Set(() => d.Remark = EmptyIsNull(e.Value))" /></td>
                    <td><button class="kb-knop kb-klein" title="@T["variables-editor.remove"]" @onclick="() => Set(() => State.Config.Departments.Remove(d))">&times;</button></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="@T["organisation.new-department"]" @bind="newDepartment" />
        <button class="kb-knop" @onclick="AddDepartment">@T["organisation.add-department"]</button>
    </div>

    @if (departmentsInData.Any(x => !x.InConfig || x.IsSpellingVariant))
    {
        <h3>@T["organisation.in-the-data-but-not"]</h3>
        <p class="kb-zacht">@T["organisation.department-values-of-enabled-users"]</p>
        <table class="kb-tabel">
            <thead><tr><th>@T["suggestions-panel.value"]</th><th class="kb-getal">@T["menu.gebruikers"]</th><th>@T["service-health-card.status"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in departmentsInData.Where(x => !x.InConfig || x.IsSpellingVariant))
                {
                    <tr>
                        <td><code>"@x.Value"</code></td>
                        <td class="kb-getal">@x.Count</td>
                        <td>@(x.InConfig ? $"schrijfvariant van \"{State.Config.SearchDepartment(x.Value)?.Department}\"" : T["code.organisation.not-in-the-list"])</td>
                        <td>
                            @if (!x.InConfig)
                            {
                                <button class="kb-knop kb-klein" @onclick="() => Add(x.Value.Trim())">@T["tenants.add"]</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="kb-kaart">
    <h2>@T["organisation.divisions"]</h2>
    <table class="kb-tabel">
        <thead><tr><th>@T["statistics.division"]</th><th>@T["organisation.cloud-group"]</th><th class="kb-getal">@T["organisation.departments"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in State.Config.Divisions.ToList())
            {
                <tr>
                    <td><input class="kb-invoer" value="@a.Name" @onchange="e => RenameDivision(a, e.Value?.ToString())" /></td>
                    <td><input class="kb-invoer" value="@a.Group" @onchange="e => Set(() => a.Group = EmptyIsNull(e.Value))" /></td>
                    <td class="kb-getal">@State.Config.Departments.Count(d => string.Equals(d.Division, a.Name, StringComparison.OrdinalIgnoreCase))</td>
                    <td><button class="kb-knop kb-klein" title="@T["variables-editor.remove"]" @onclick="() => RemoveDivision(a)">&times;</button></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="@T["organisation.new-division"]" @bind="newDivision" />
        <button class="kb-knop" @onclick="AddDivision">@T["organisation.add-division"]</button>
    </div>
</section>
}

@if (Is("kantoren"))
{
<section class="kb-kaart">
    <h2>@T["menu.organisatie.kantoren"]</h2>
    <p class="kb-zacht">
        @T["organisation.offices"]
    </p>
    <ul class="kb-lijst">
        @foreach (var k in State.Config.Offices.ToList())
        {
            <li>@k <button class="kb-knop kb-klein" title="@T["variables-editor.remove"]" @onclick="() => Set(() => State.Config.Offices.Remove(k))">&times;</button></li>
        }
    </ul>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="@T["organisation.new-office"]" @bind="newOffice" />
        <button class="kb-knop" @onclick="AddOffice">@T["organisation.add-office"]</button>
    </div>
    @if (officesInData.Any(x => !x.InConfig))
    {
        <h3>@T["organisation.offices-in-the-data-that"]</h3>
        <table class="kb-tabel">
            <thead><tr><th>@T["suggestions-panel.value"]</th><th class="kb-getal">@T["menu.gebruikers"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in officesInData.Where(x => !x.InConfig))
                {
                    <tr>
                        <td><code>"@x.Value"</code></td>
                        <td class="kb-getal">@x.Count</td>
                        <td><button class="kb-knop kb-klein" @onclick="() => Set(() => State.Config.Offices.Add(x.Value.Trim()))">@T["tenants.add"]</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
}

@if (Is("groepen"))
{
<section class="kb-kaart">
    <h2>@T["menu.organisatie.groepen"]</h2>
    <div class="kb-raster">
        @if (State.HasAd)
        {
        <label>@T["organisation.ou-for-new-ad-groups"]
            <input class="kb-invoer" placeholder="@T["organisation.e-g-organisation-groups"]" value="@State.Config.GroupsOu"
                   @onchange="e => Set(() => State.Config.GroupsOu = EmptyIsNull(e.Value))" />
        </label>
        }
        <label>@T["organisation.prefixes-naming-separated-by-commas"]
            <input class="kb-invoer" placeholder="@T["organisation.gg-afd-dnst-sg-wkg"]" value="@string.Join(", ", State.Config.GroupPrefixes)"
                   @onchange="e => Set(() => State.Config.GroupPrefixes = (e.Value?.ToString() ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList())" />
        </label>
    </div>
    <p class="kb-zacht">@T["organisation.a-name-that-does-not"]</p>
</section>
}

@if (Is("functieprofielen"))
{
<JobProfileEditor Changed="() => Set(() => { })" />
}

@if (Is("rollen") || Is("profielen"))
{
<section class="kb-kaart">
    <h2>@T["menu.organisatie.rollen"]</h2>
    <p class="kb-zacht">
        @Html("organisation.roles")
    </p>
    <div class="kb-keuzes">
        @foreach (var (mode, title, explanation) in RoleModes)
        {
            <label class="kb-keuze @(State.Config.RolesModeEffective == mode ? "kb-actief" : null)">
                <input type="radio" name="rollen" checked="@(State.Config.RolesModeEffective == mode)" @onchange="() => ChooseRoles(mode)" aria-label="@title" />
                <strong>@title</strong>
                <span class="kb-zacht">@explanation</span>
            </label>
        }
    </div>
    @if (rolesError is not null) { <div class="kb-melding kb-fout">@rolesError</div> }
    <p class="kb-zacht">@T.Format("organisation.now-0-do-not-forget", State.ProfileMessage ?? (State.Config.RolesModeEffective == RolesMode.Off ? T["code.organisation.without-roles-everyone-may-do"] : (T["code.organisation.according-to-your-role"] + " ") + PermissionTable.Text(State.Roles, "en") + "."))</p>
</section>
}

@if (Is("noodaccounts"))
{
<section class="kb-kaart">
    <h2>@T["menu.organisatie.noodaccounts"]</h2>
    <p class="kb-zacht">
        @T["organisation.the-upns-of-the-emergency"]
    </p>
    <ul class="kb-lijst">
        @foreach (var n in State.Config.EmergencyAccounts.ToList())
        {
            <li>@n <button class="kb-knop kb-klein" title="@T["variables-editor.remove"]" @onclick="() => Set(() => State.Config.EmergencyAccounts.Remove(n))">&times;</button></li>
        }
    </ul>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="bv. nood1@contoso.onmicrosoft.com" @bind="newEmergencyAccount" />
        <button class="kb-knop" @onclick="AddEmergencyAccount">@T["organisation.add-emergency-account"]</button>
    </div>
</section>
}

@code {
    private string newEmergencyAccount = string.Empty;
    private string? rolesError;

    private static readonly (RolesMode, string, string)[] RoleModes =
    {
        (RolesMode.Off, "Zonder rollen", "Iedereen die de app hier gebruikt, mag alles. Voor een klein team of één beheerder."),
        (RolesMode.Transition, "Rollen als ze er zijn", "Wie een rol heeft, mag wat de rol zegt; wie geen rol heeft, mag nog alles (de overgang)."),
        (RolesMode.Required, "Rollen verplicht", T["code.organisation.whoever-has-no-role-may"]),
    };

    private void ChooseRoles(RolesMode mode)
    {
        rolesError = State.RolesModeRefusal(mode);
        if (rolesError is null)
        {
            Set(() => State.Config.SetRoles(mode));
        }
    }
    private bool onlyUnlinked;
    private string? message;
    private string newDepartment = string.Empty;
    private string newDivision = string.Empty;
    private string newOffice = string.Empty;
    private IReadOnlyDictionary<string, int> counts = new Dictionary<string, int>();
    private IReadOnlyList<DepartmentUse> departmentsInData = Array.Empty<DepartmentUse>();
    private IReadOnlyList<DepartmentUse> officesInData = Array.Empty<DepartmentUse>();

    private int Unlinked => State.Config.Departments.Count(d => string.IsNullOrWhiteSpace(d.Division));

    /// <summary>Errors that block saving.</summary>
    private List<string> Errors => ManagementState.ConfigErrors(State.Config);

    // Not saved: counts in ManagementState, so that the indication (tint, bar, menu) is also right outside this screen
    private bool changed => State.ConfigModifications > 0;

    protected override void OnInitialized()
    {
        Recompute();
        State.Changed += Reload;
    }

    // Saving or discarding is also possible via the bar at the top
    private void Reload() => _ = InvokeAsync(() =>
    {
        Recompute();
        StateHasChanged();
    });

    public void Dispose() => State.Changed -= Reload;

    private void Recompute()
    {
        counts = OrganisationAnalysis.CountPerDepartment(State.Data, State.Config);
        departmentsInData = OrganisationAnalysis.DepartmentsInData(State.Data, State.Config);
        officesInData = OrganisationAnalysis.OfficesInData(State.Data, State.Config);
    }

    /// <summary>The part of the organisation settings on this page (0.21: one page per part); null = company and naming.</summary>
    [Parameter] public string? Part { get; set; }

    private bool Is(string? part) => string.Equals(Part, part, StringComparison.OrdinalIgnoreCase);

    private string PartTitle => MenuModel.OrganisationParts.FirstOrDefault(p => p.Href == (Part is null ? "organisatie" : "organisatie/" + Part))?.Text ?? T["menu.organisatie.bedrijf"];

    private string templateKey = string.Empty;
    private string? exchangeMessage;
    private bool exchangeError;

    private void ApplyTemplate()
    {
        if (OrganisationTemplates.All.FirstOrDefault(t => t.Key == templateKey) is not { } template)
        {
            return;
        }

        IReadOnlyList<string> added = Array.Empty<string>();
        Set(() => added = OrganisationTemplates.Apply(State.Config, template));
        (exchangeMessage, exchangeError) = (added.Count == 0
            ? T.Format("code.organisation.the-template-adds-nothing-everything", template.Name)
            : $"Uit het sjabloon {template.Name}: {string.Join(", ", added)}. Kijk na en bewaar.", false);
    }

    private void Export()
    {
        try
        {
            var path = Path.Combine(State.ExportFolder, $"Organisatie-{DateTime.Now:yyyyMMdd-HHmmss}.json");
            Directory.CreateDirectory(State.ExportFolder);
            File.WriteAllText(path, ConfigStorage.To(State.Config), new System.Text.UTF8Encoding(false));
            State.Access("Organisatie geëxporteerd", Path.GetFileName(path));
            (exchangeMessage, exchangeError) = ($"Geëxporteerd: {path}", false);
            State.AppEnvironment.ShowFile(path);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            (exchangeMessage, exchangeError) = ((T["code.organisation.export-failed"] + " ") + ex.Message, true);
        }
    }

    private async Task Import(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(1024 * 1024));
            var imported = ConfigStorage.Parse(await reader.ReadToEndAsync());
            var keepDomain = State.Config.AdDomain;
            var keepEmergency = State.Config.EmergencyAccounts.ToList();
            var keepRoles = State.Config.RolesModeEffective;
            Set(() =>
            {
                ConfigStorage.CopyInto(imported, State.Config);
                State.Config.AdDomain = keepDomain;
                State.Config.EmergencyAccounts = keepEmergency;
                State.Config.SetRoles(keepRoles);
            });
            (exchangeMessage, exchangeError) = (T.Format("code.organisation.imported-from-check-and-save", e.File.Name), false);
        }
        catch (Exception ex) when (ex is IOException or System.Text.Json.JsonException or InvalidOperationException)
        {
            (exchangeMessage, exchangeError) = ((T["code.organisation.this-is-not-a-file"] + " ") + ex.Message, true);
        }
    }

    private void Set(Action change)
    {
        change();
        State.ConfigModified();
        message = null;
        Recompute();
    }

    private static string? EmptyIsNull(object? value)
    {
        var text = value?.ToString()?.Trim();
        return string.IsNullOrEmpty(text) ? null : text;
    }

    private void Add(string department)
    {
        if (department.Length > 0 && State.Config.SearchDepartment(department) is null)
        {
            Set(() => State.Config.Departments.Add(new DepartmentMapping { Department = department }));
        }
    }

    private void AddDepartment()
    {
        Add(newDepartment.Trim());
        newDepartment = string.Empty;
    }

    private void AddDivision()
    {
        var name = newDivision.Trim();
        if (name.Length > 0)
        {
            Set(() => State.Config.Divisions.Add(new Division { Name = name }));
        }

        newDivision = string.Empty;
    }

    private void AddEmergencyAccount()
    {
        var upn = newEmergencyAccount.Trim();
        if (upn.Contains('@') && !State.Config.EmergencyAccounts.Contains(upn, StringComparer.OrdinalIgnoreCase))
        {
            Set(() => State.Config.EmergencyAccounts.Add(upn));
        }

        newEmergencyAccount = string.Empty;
    }

    private void AddOffice()
    {
        var name = newOffice.Trim();
        if (name.Length > 0 && !State.Config.Offices.Any(k => OrganisationConfig.Normalise(k) == OrganisationConfig.Normalise(name)))
        {
            Set(() => State.Config.Offices.Add(name));
        }

        newOffice = string.Empty;
    }

    /// <summary>Renaming a division also adjusts the departments that refer to it.</summary>
    private void RenameDivision(Division division, string? newName)
    {
        var name = (newName ?? string.Empty).Trim();
        if (name.Length == 0)
        {
            return;
        }

        Set(() =>
        {
            foreach (var d in State.Config.Departments.Where(d => string.Equals(d.Division, division.Name, StringComparison.OrdinalIgnoreCase)))
            {
                d.Division = name;
            }

            division.Name = name;
        });
    }

    /// <summary>Deleting a division makes the departments that referred to it unlinked again.</summary>
    private void RemoveDivision(Division division) => Set(() =>
    {
        foreach (var d in State.Config.Departments.Where(d => string.Equals(d.Division, division.Name, StringComparison.OrdinalIgnoreCase)))
        {
            d.Division = null;
        }

        State.Config.Divisions.Remove(division);
    });

    private void Save()
    {
        try
        {
            State.SaveConfig();
            message = "Bewaard.";
        }
        catch (Exception ex)
        {
            message = (T["code.organisation.saving-failed"] + " ") + ex.Message;
        }
    }

    private void Undone()
    {
        State.LoadConfig();
        message = "Wijzigingen ongedaan gemaakt.";
        Recompute();
    }

    private void Restore()
    {
        State.RestoreDefaultConfig();
        message = T["code.organisation.back-to-the-list-that"];
        Recompute();
    }
}
