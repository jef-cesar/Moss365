@page "/organisatie"
@implements IDisposable
@inject ManagementState State

<h1>Organisatie</h1>

<p class="kb-zacht">
    Keuzelijsten voor nieuwe gebruikers. Bewaren schrijft naar de databank van <strong>@State.Tenant.Name</strong>;
    de meegeleverde lijst blijft ongewijzigd.
</p>

<LeaveConfirm Active="changed" CanSave="@(Errors.Count == 0)" Saving="Save" Discard="Undone"
                   Text="Je hebt de organisatie aangepast maar nog niet bewaard." />

<div class="kb-filters kb-plak">
    <button class="kb-knop kb-primair" disabled="@(!changed || Errors.Count > 0)" @onclick="Save">Bewaren</button>
    <button class="kb-knop" disabled="@(!changed)" @onclick="Undone">Wijzigingen ongedaan maken</button>
    @if (State.ConfigIsModified)
    {
        <button class="kb-knop" @onclick="Restore">Terug naar de meegeleverde lijst</button>
    }
    @if (message is not null)
    {
        <span class="kb-ok">@message</span>
    }
    @if (changed)
    {
        <span class="kb-label">niet bewaard</span>
    }
</div>

@foreach (var f in Errors)
{
    <div class="kb-melding kb-fout">@f</div>
}

<section class="kb-kaart">
    <h2>Bedrijf</h2>
    <div class="kb-rij">
        <label>Company</label>
        <input class="kb-invoer" value="@State.Config.Company" @onchange="e => Set(() => State.Config.Company = e.Value?.ToString() ?? string.Empty)" />
    </div>
</section>

<section class="kb-kaart">
    <h2>Diensten en afdelingen</h2>
    <p class="kb-zacht">
        Department bevat de dienst; de app leidt de afdeling af uit deze koppeling.
        @Unlinked van de @State.Config.Departments.Count diensten hebben nog geen afdeling.
    </p>
    <div class="kb-filters">
        <label><input type="checkbox" @bind="onlyUnlinked" /> Alleen diensten zonder afdeling</label>
    </div>
    <table class="kb-tabel">
        <thead><tr><th>Dienst (Department)</th><th>Afdeling</th><th class="kb-getal">Gebruikers</th><th>Opmerking</th><th></th></tr></thead>
        <tbody>
            @foreach (var d in State.Config.Departments.Where(d => !onlyUnlinked || string.IsNullOrWhiteSpace(d.Division)).ToList())
            {
                <tr class="@(string.IsNullOrWhiteSpace(d.Division) ? "kb-ontbreekt" : null)">
                    <td><input class="kb-invoer" value="@d.Department" @onchange="e => Set(() => d.Department = e.Value?.ToString() ?? string.Empty)" /></td>
                    <td>
                        <select class="kb-invoer" aria-label="@($"Afdeling voor {d.Department}")" @onchange="e => Set(() => d.Division = EmptyIsNull(e.Value))">
                            <option value="" selected="@string.IsNullOrWhiteSpace(d.Division)">(nog niet gekoppeld)</option>
                            @foreach (var a in State.Config.Divisions)
                            {
                                <option value="@a.Name" selected="@(string.Equals(a.Name, d.Division, StringComparison.OrdinalIgnoreCase))">@a.Name</option>
                            }
                        </select>
                    </td>
                    <td class="kb-getal">@(counts.TryGetValue(d.Department, out var n) ? n : 0)</td>
                    <td><input class="kb-invoer" value="@d.Remark" @onchange="e => Set(() => d.Remark = EmptyIsNull(e.Value))" /></td>
                    <td><button class="kb-knop kb-klein" title="Verwijderen" @onclick="() => Set(() => State.Config.Departments.Remove(d))">&times;</button></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="Nieuwe dienst" @bind="newDepartment" />
        <button class="kb-knop" @onclick="AddDepartment">Dienst toevoegen</button>
    </div>

    @if (departmentsInData.Any(x => !x.InConfig || x.IsSpellingVariant))
    {
        <h3>In de data, maar niet (exact) in de lijst</h3>
        <p class="kb-zacht">Department-waarden van ingeschakelde gebruikers. Een schrijfvariant hoort bij een dienst uit de lijst, maar met andere hoofdletters of spaties.</p>
        <table class="kb-tabel">
            <thead><tr><th>Waarde</th><th class="kb-getal">Gebruikers</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in departmentsInData.Where(x => !x.InConfig || x.IsSpellingVariant))
                {
                    <tr>
                        <td><code>"@x.Value"</code></td>
                        <td class="kb-getal">@x.Count</td>
                        <td>@(x.InConfig ? $"schrijfvariant van \"{State.Config.SearchDepartment(x.Value)?.Department}\"" : "niet in de lijst")</td>
                        <td>
                            @if (!x.InConfig)
                            {
                                <button class="kb-knop kb-klein" @onclick="() => Add(x.Value.Trim())">Toevoegen</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="kb-kaart">
    <h2>Afdelingen</h2>
    <table class="kb-tabel">
        <thead><tr><th>Afdeling</th><th>Cloudgroep</th><th class="kb-getal">Diensten</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in State.Config.Divisions.ToList())
            {
                <tr>
                    <td><input class="kb-invoer" value="@a.Name" @onchange="e => RenameDivision(a, e.Value?.ToString())" /></td>
                    <td><input class="kb-invoer" value="@a.Group" @onchange="e => Set(() => a.Group = EmptyIsNull(e.Value))" /></td>
                    <td class="kb-getal">@State.Config.Departments.Count(d => string.Equals(d.Division, a.Name, StringComparison.OrdinalIgnoreCase))</td>
                    <td><button class="kb-knop kb-klein" title="Verwijderen" @onclick="() => RemoveDivision(a)">&times;</button></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="Nieuwe afdeling" @bind="newDivision" />
        <button class="kb-knop" @onclick="AddDivision">Afdeling toevoegen</button>
    </div>
</section>

<section class="kb-kaart">
    <h2>Kantoren</h2>
    <p class="kb-zacht">
        Verplichte keuze bij een nieuwe gebruiker. Let op: <code>SG-INTRANET-SHAREPOINT-Gemeentehuis</code> sluit kantoren uit die
        beginnen met "bib" of "Visit".
    </p>
    <ul class="kb-lijst">
        @foreach (var k in State.Config.Offices.ToList())
        {
            <li>@k <button class="kb-knop kb-klein" title="Verwijderen" @onclick="() => Set(() => State.Config.Offices.Remove(k))">&times;</button></li>
        }
    </ul>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="Nieuw kantoor" @bind="newOffice" />
        <button class="kb-knop" @onclick="AddOffice">Kantoor toevoegen</button>
    </div>
    @if (officesInData.Any(x => !x.InConfig))
    {
        <h3>Kantoren in de data die niet in de lijst staan</h3>
        <table class="kb-tabel">
            <thead><tr><th>Waarde</th><th class="kb-getal">Gebruikers</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in officesInData.Where(x => !x.InConfig))
                {
                    <tr>
                        <td><code>"@x.Value"</code></td>
                        <td class="kb-getal">@x.Count</td>
                        <td><button class="kb-knop kb-klein" @onclick="() => Set(() => State.Config.Offices.Add(x.Value.Trim()))">Toevoegen</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="kb-kaart">
    <h2>Nieuwe groepen</h2>
    <div class="kb-raster">
        <label>OU voor nieuwe AD-groepen
            <input class="kb-invoer" placeholder="bv. GEMEENTEBESTUUR/GROEPEN" value="@State.Config.GroupsOu"
                   @onchange="e => Set(() => State.Config.GroupsOu = EmptyIsNull(e.Value))" />
        </label>
        <label>Voorvoegsels (naamgeving, gescheiden door komma's)
            <input class="kb-invoer" placeholder="gg_, AFD_, DNST_, SG-, WKG_" value="@string.Join(", ", State.Config.GroupPrefixes)"
                   @onchange="e => Set(() => State.Config.GroupPrefixes = (e.Value?.ToString() ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList())" />
        </label>
    </div>
    <p class="kb-zacht">Een naam die niet met een van de voorvoegsels begint, geeft een waarschuwing in het plan.</p>
</section>

<section class="kb-kaart">
    <h2>Profielen</h2>
    <p class="kb-zacht">
        Wie wat mag in Moss365 volgt uit de app-rollen in Entra (Lezer, Helpdesk, Beheerder, Auditor, Appbeheer), toegekend via
        de groepen <code>GG-Moss365-...</code> (zie <code>docs/voorbereiding-0.8.md</code>). Zolang dit uit staat, mag wie zich
        aanmeldt zonder rol alles, zoals vroeger.
    </p>
    <label><input type="checkbox" checked="@State.Config.ProfilesRequired" @onchange="e => Set(() => State.Config.ProfilesRequired = e.Value is true)" />
        Profielen verplicht: zonder rol enkel lezen</label>
</section>

<section class="kb-kaart">
    <h2>Noodaccounts</h2>
    <p class="kb-zacht">
        De UPN's van de noodaccounts (break glass): cloud-only accounts met de rol Global Administrator, buiten alle Conditional
        Access-beleiden, voor als niemand zich nog kan aanmelden. De controle bij Conditional Access kijkt ze na.
    </p>
    <ul class="kb-lijst">
        @foreach (var n in State.Config.EmergencyAccounts.ToList())
        {
            <li>@n <button class="kb-knop kb-klein" title="Verwijderen" @onclick="() => Set(() => State.Config.EmergencyAccounts.Remove(n))">&times;</button></li>
        }
    </ul>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="bv. nood1@contoso.onmicrosoft.com" @bind="newEmergencyAccount" />
        <button class="kb-knop" @onclick="AddEmergencyAccount">Noodaccount toevoegen</button>
    </div>
</section>

@code {
    private string newEmergencyAccount = string.Empty;
    private bool onlyUnlinked;
    private string? message;
    private string newDepartment = string.Empty;
    private string newDivision = string.Empty;
    private string newOffice = string.Empty;
    private IReadOnlyDictionary<string, int> counts = new Dictionary<string, int>();
    private IReadOnlyList<DepartmentUse> departmentsInData = Array.Empty<DepartmentUse>();
    private IReadOnlyList<DepartmentUse> officesInData = Array.Empty<DepartmentUse>();

    private int Unlinked => State.Config.Departments.Count(d => string.IsNullOrWhiteSpace(d.Division));

    /// <summary>Errors that block saving.</summary>
    private List<string> Errors => ManagementState.ConfigErrors(State.Config);

    // Not saved: counts in ManagementState, so that the indication (tint, bar, menu) is also right outside this screen
    private bool changed => State.ConfigModifications > 0;

    protected override void OnInitialized()
    {
        Recompute();
        State.Changed += Reload;
    }

    // Saving or discarding is also possible via the bar at the top
    private void Reload() => _ = InvokeAsync(() =>
    {
        Recompute();
        StateHasChanged();
    });

    public void Dispose() => State.Changed -= Reload;

    private void Recompute()
    {
        counts = OrganisationAnalysis.CountPerDepartment(State.Data, State.Config);
        departmentsInData = OrganisationAnalysis.DepartmentsInData(State.Data, State.Config);
        officesInData = OrganisationAnalysis.OfficesInData(State.Data, State.Config);
    }

    private void Set(Action change)
    {
        change();
        State.ConfigModified();
        message = null;
        Recompute();
    }

    private static string? EmptyIsNull(object? value)
    {
        var text = value?.ToString()?.Trim();
        return string.IsNullOrEmpty(text) ? null : text;
    }

    private void Add(string department)
    {
        if (department.Length > 0 && State.Config.SearchDepartment(department) is null)
        {
            Set(() => State.Config.Departments.Add(new DepartmentMapping { Department = department }));
        }
    }

    private void AddDepartment()
    {
        Add(newDepartment.Trim());
        newDepartment = string.Empty;
    }

    private void AddDivision()
    {
        var name = newDivision.Trim();
        if (name.Length > 0)
        {
            Set(() => State.Config.Divisions.Add(new Division { Name = name }));
        }

        newDivision = string.Empty;
    }

    private void AddEmergencyAccount()
    {
        var upn = newEmergencyAccount.Trim();
        if (upn.Contains('@') && !State.Config.EmergencyAccounts.Contains(upn, StringComparer.OrdinalIgnoreCase))
        {
            Set(() => State.Config.EmergencyAccounts.Add(upn));
        }

        newEmergencyAccount = string.Empty;
    }

    private void AddOffice()
    {
        var name = newOffice.Trim();
        if (name.Length > 0 && !State.Config.Offices.Any(k => OrganisationConfig.Normalise(k) == OrganisationConfig.Normalise(name)))
        {
            Set(() => State.Config.Offices.Add(name));
        }

        newOffice = string.Empty;
    }

    /// <summary>Renaming a division also adjusts the departments that refer to it.</summary>
    private void RenameDivision(Division division, string? newName)
    {
        var name = (newName ?? string.Empty).Trim();
        if (name.Length == 0)
        {
            return;
        }

        Set(() =>
        {
            foreach (var d in State.Config.Departments.Where(d => string.Equals(d.Division, division.Name, StringComparison.OrdinalIgnoreCase)))
            {
                d.Division = name;
            }

            division.Name = name;
        });
    }

    /// <summary>Deleting a division makes the departments that referred to it unlinked again.</summary>
    private void RemoveDivision(Division division) => Set(() =>
    {
        foreach (var d in State.Config.Departments.Where(d => string.Equals(d.Division, division.Name, StringComparison.OrdinalIgnoreCase)))
        {
            d.Division = null;
        }

        State.Config.Divisions.Remove(division);
    });

    private void Save()
    {
        try
        {
            State.SaveConfig();
            message = "Bewaard.";
        }
        catch (Exception ex)
        {
            message = "Bewaren mislukt: " + ex.Message;
        }
    }

    private void Undone()
    {
        State.LoadConfig();
        message = "Wijzigingen ongedaan gemaakt.";
        Recompute();
    }

    private void Restore()
    {
        State.RestoreDefaultConfig();
        message = "Terug naar de meegeleverde lijst.";
        Recompute();
    }
}
