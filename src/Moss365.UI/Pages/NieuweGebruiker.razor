@page "/nieuw"
@inject BeheerState State

<h1>Nieuwe gebruiker</h1>

<p class="kb-zacht">
    Vul de gegevens in en kies <strong>Voorbeeld</strong>. De app leidt de namen af, controleert of ze al bestaan en toont wat er
    gebeurt. Het account wordt in AD aangemaakt; licentie en cloudgroepen volgen na de synchronisatie naar Entra (scherm
    <a href="opvolging">Opvolging</a>).
</p>

@if (State.Config.Populaties.Count == 0)
{
    <div class="kb-melding kb-fout">
        Er zijn geen soorten (gemeente, OCMW, vrijwilliger) in de organisatie, dus kan je nog geen gebruiker aanmaken.
        Bron: <code>@(State.ConfigBron ?? "geen organisatie.json gevonden")</code>. Zie <a href="organisatie">Organisatie</a>.
    </div>
}

<section class="kb-kaart">
    <h2>Gegevens</h2>
    <div class="kb-raster">
        <label>Soort
            <select class="kb-invoer" @bind="aanvraag.Populatie" @bind:after="Wis">
                <option value="">(kies)</option>
                @foreach (var p in State.Config.Populaties)
                {
                    <option value="@p.Naam">@p.Naam (@p.Ou)</option>
                }
            </select>
        </label>
        <label>Voornaam <input class="kb-invoer" @bind="aanvraag.Voornaam" @bind:after="Wis" /></label>
        <label>Achternaam <input class="kb-invoer" @bind="aanvraag.Achternaam" @bind:after="Wis" /></label>
        @if (!IsVrijwilliger)
        {
            <label>Dienst
                <select class="kb-invoer" @bind="aanvraag.Dienst" @bind:after="DienstGekozen">
                    <option value="">(kies)</option>
                    @foreach (var d in State.Config.Diensten.OrderBy(d => d.Department, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@d.Department">@d.Department@(string.IsNullOrWhiteSpace(d.Afdeling) ? null : $" ({d.Afdeling})")</option>
                    }
                </select>
            </label>
            <label>Kantoor
                <select class="kb-invoer" @bind="aanvraag.Kantoor" @bind:after="Wis">
                    <option value="">(kies)</option>
                    @foreach (var k in State.Config.Kantoren)
                    {
                        <option value="@k">@k</option>
                    }
                </select>
            </label>
        }
        <label>Functie <input class="kb-invoer" @bind="aanvraag.Functie" @bind:after="Wis" /></label>
        <label>Logonscript
            <select class="kb-invoer" @bind="aanvraag.Logonscript" @bind:after="Wis">
                <option value="">(geen)</option>
                @foreach (var s in Logonscripts)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </label>
        <label>Licentie
            <select class="kb-invoer" @bind="aanvraag.LicentieSku" @bind:after="Wis">
                <option value="">(geen)</option>
                @foreach (var l in State.Config.Licenties)
                {
                    <option value="@l.Sku">@l.Naam @VrijTekst(l.Sku)</option>
                }
            </select>
        </label>
    </div>
    <div class="kb-filters">
        <label><input type="checkbox" @bind="aanvraag.StandaardAdGroepen" @bind:after="Wis" /> Standaardgroepen van de soort toevoegen</label>
    </div>
    <PersoonKiezer Label="Groepen overnemen van (optioneel, spiegelgebruiker)" Gekozen="aanvraag.Spiegel" GekozenChanged="KiesSpiegel" />
    <div class="kb-filters">
        <button class="kb-knop kb-primair" @onclick="MaakVoorstel">Voorbeeld</button>
        <button class="kb-knop" @onclick="Leegmaken">Leegmaken</button>
    </div>
</section>

@if (voorstel is not null)
{
    <section class="kb-kaart">
        <h2>Voorstel</h2>
        @foreach (var f in voorstel.Fouten)
        {
            <div class="kb-melding kb-fout">@f</div>
        }
        @foreach (var w in voorstel.Waarschuwingen)
        {
            <div class="kb-melding">@w</div>
        }
        @if (voorstel.KanUitgevoerdWorden)
        {
            <table class="kb-tabel kb-naast">
                <tbody>
                    <tr><th>Weergavenaam</th><td>@voorstel.WeergaveNaam</td></tr>
                    <tr><th>Aanmeldnaam (UPN)</th><td>@voorstel.Upn</td></tr>
                    <tr><th>sAMAccountName</th><td>@voorstel.Sam</td></tr>
                    <tr><th>Locatie in AD</th><td>@voorstel.Dn</td></tr>
                </tbody>
            </table>
        }
    </section>

    @if (voorstel.KanUitgevoerdWorden)
    {
        <PlanWeergave Plan="voorstel.Nu" Context="@($"Nieuwe gebruiker {voorstel.Upn}")" Titel="Nu in AD" Uitgevoerd="NaUitvoeren" />

        @if (!wachtwoordTonen)
        {
            <details class="kb-later">
                <summary>Later uitvoeren (bv. op de eerste werkdag)</summary>
                <p class="kb-zacht">
                    Op het gekozen moment staat de instroom bij <a href="gepland">Gepland</a> klaar. Het startwachtwoord maakt de app
                    pas dan; het wachtwoord hierboven vervalt. Er gebeurt niets zonder jouw bevestiging.
                </p>
                <Inplannen Gekozen="PlanIn" />
                @if (ingepland is not null) { <div class="kb-melding kb-goed">Ingepland op @ingepland.Value.ToString("dd/MM/yyyy HH:mm").</div> }
            </details>
        }

        @if (wachtwoordTonen)
        {
            <section class="kb-kaart">
                <h2>Startwachtwoord</h2>
                <p><code class="kb-wachtwoord">@voorstel.Wachtwoord</code></p>
                <p class="kb-zacht">
                    Geef dit door aan de gebruiker; het moet gewijzigd worden bij de eerste aanmelding. De app bewaart het nergens en
                    toont het niet opnieuw.
                </p>
            </section>
        }

        <section class="kb-kaart">
            <h2>Na de synchronisatie naar Entra (@voorstel.NaSynchronisatie.Count)</h2>
            @if (voorstel.NaSynchronisatie.Count == 0)
            {
                <p class="kb-zacht">Geen licentie of cloudgroepen.</p>
            }
            else
            {
                <table class="kb-tabel">
                    <thead><tr><th>Systeem</th><th>Wijziging</th><th>Wordt</th></tr></thead>
                    <tbody>
                        @foreach (var w in voorstel.NaSynchronisatie)
                        {
                            <tr><td>@w.SysteemTekst</td><td>@w.Omschrijving</td><td>@w.NieuweWaarde</td></tr>
                        }
                    </tbody>
                </table>
                <p class="kb-zacht">
                    @if (opvolgingBewaard)
                    {
                        <span class="kb-ok">Bewaard als opvolgtaak.</span>
                    }
                    else
                    {
                        @("Deze stappen worden een opvolgtaak zodra het account in AD aangemaakt is.")
                    }
                    Entra Connect synchroniseert standaard om de 30 minuten; werk ze daarna af in <a href="opvolging">Opvolging</a>.
                </p>
            }
        </section>
    }
}

@code {
    // Het formulier blijft bewaard tot je het uitvoert, inplant of leegmaakt (nooit het startwachtwoord)
    private const string Formulier = "nieuw";
    private NieuweGebruikerAanvraag aanvraag = new();
    private NieuweGebruikerVoorstel? voorstel;
    private string? wachtwoord;
    private bool wachtwoordTonen;
    private bool opvolgingBewaard;

    protected override void OnInitialized() => aanvraag = Bewaard();

    private NieuweGebruikerAanvraag Bewaard() => State.Paginastatus.Formulier<NieuweGebruikerAanvraag>(Formulier, "nieuw", "Nieuwe gebruiker");

    // Ook het script van de dienst tonen als het niet in de lijst staat
    private IEnumerable<string> Logonscripts => string.IsNullOrWhiteSpace(aanvraag.Logonscript) || State.Config.Logonscripts.Contains(aanvraag.Logonscript, StringComparer.OrdinalIgnoreCase)
        ? State.Config.Logonscripts
        : State.Config.Logonscripts.Append(aanvraag.Logonscript);

    private bool IsVrijwilliger => State.Config.ZoekPopulatie(aanvraag.Populatie)?.City is not null;

    private string VrijTekst(string sku)
    {
        var l = State.Data.Licenties.FirstOrDefault(x => string.Equals(x.SkuPartNumber, sku, StringComparison.OrdinalIgnoreCase));
        return l is null ? string.Empty : $"({l.Vrij} vrij van {l.Totaal})";
    }

    private DateTimeOffset? ingepland;

    private void PlanIn(DateTimeOffset wanneer)
    {
        if (voorstel is null)
        {
            return;
        }

        State.Inplannen(GeplandPlannen.Instroom(voorstel, wanneer, State.Gebruiker));
        ingepland = wanneer;
        wachtwoord = null;
        State.Paginastatus.Vergeet(Formulier);
    }

    private void Wis()
    {
        ingepland = null;
        voorstel = null;
        wachtwoordTonen = false;
        opvolgingBewaard = false;
    }

    private void DienstGekozen()
    {
        // Het logonscript van de dienst als voorstel
        if (State.Config.ZoekDienst(aanvraag.Dienst)?.Logonscript is { Length: > 0 } script)
        {
            aanvraag.Logonscript = script;
        }

        Wis();
    }

    private void KiesSpiegel(Persoon? p)
    {
        aanvraag.Spiegel = p;
        Wis();
    }

    private void Leegmaken()
    {
        State.Paginastatus.Vergeet(Formulier);
        aanvraag = Bewaard();
        wachtwoord = null;
        Wis();
    }

    private void MaakVoorstel()
    {
        if (aanvraag.LicentieSku?.Length == 0) aanvraag.LicentieSku = null;
        if (aanvraag.Logonscript?.Length == 0) aanvraag.Logonscript = null;

        // Eén startwachtwoord per aanvraag, zodat het niet verandert bij elk voorbeeld
        voorstel = PlanBouwer.NieuweGebruiker(State.Data, State.Config, aanvraag, wachtwoord);
        wachtwoord = voorstel.Wachtwoord;
        wachtwoordTonen = false;
        opvolgingBewaard = false;
    }

    private void NaUitvoeren(IReadOnlyList<WijzigingResultaat> resultaten)
    {
        if (voorstel is null)
        {
            return;
        }

        var aanmaken = voorstel.Nu.First(w => w.Actie == Actie.AdGebruikerAanmaken);
        if (resultaten.Any(r => r.WijzigingId == aanmaken.Id && r.Status == ResultaatStatus.Gelukt))
        {
            wachtwoordTonen = true;
            State.Paginastatus.Vergeet(Formulier);
            if (voorstel.NaSynchronisatie.Count > 0)
            {
                State.VoegOpvolgingToe(new OpvolgTaak
                {
                    Upn = voorstel.Upn,
                    Omschrijving = $"Nieuwe gebruiker {voorstel.WeergaveNaam}",
                    Wijzigingen = voorstel.NaSynchronisatie.ToList(),
                });
                opvolgingBewaard = true;
            }

            // Een volgende aanvraag krijgt een nieuw wachtwoord
            wachtwoord = null;
        }
    }
}
