@page "/spiegel"
@inject BeheerState State
@inject NavigationManager Nav

<h1>Spiegelgebruiker</h1>

<p class="kb-zacht">
    Kies een referentiegebruiker (de spiegel) en een doelgebruiker. De app toont per groep, in AD en in de cloud, wat er zou
    moeten gebeuren en via welke weg. Met <strong>Plan maken</strong> zie je eerst de wijzigingen; er gebeurt pas iets na
    bevestiging. Bevoorrechte en dynamische groepen worden nooit gekopieerd.
</p>

<div class="kb-kolommen">
    <PersoonKiezer Label="Referentie (spiegel)" Gekozen="referentie" GekozenChanged="KiesReferentie" />
    <PersoonKiezer Label="Doel" Gekozen="doel" GekozenChanged="KiesDoel" />
</div>

@if (referentie is not null && doel is not null)
{
    @if (referentie.Sleutel == doel.Sleutel)
    {
        <div class="kb-melding">Referentie en doel zijn dezelfde gebruiker.</div>
    }
    else
    {
        <div class="kb-tegels">
            @foreach (var g in regels.GroupBy(r => r.StatusTekst))
            {
                <div class="kb-tegel"><div class="kb-tegel-getal">@g.Count()</div><div>@g.Key</div></div>
            }
        </div>

        <div class="kb-filters">
            <label><input type="checkbox" @bind="verbergReedsLid" /> Verberg "Reeds lid"</label>
            @if (State.Mag(Recht.Acties))
            {
                <button class="kb-knop kb-primair" disabled="@(!regels.Any(r => r.Status == SpiegelStatus.Toevoegen))" @onclick="MaakPlan">Plan maken</button>
            }
        </div>

        @foreach (var laag in new[] { "AD", "Cloud" })
        {
            <section class="kb-kaart">
                <h2>@(laag == "AD" ? "On-prem AD" : "Cloud (Entra en Exchange)")</h2>
                <table class="kb-tabel">
                    <thead><tr><th>Groep</th><th>Soort</th><th>Status</th><th>Via</th><th>Opmerking</th></tr></thead>
                    <tbody>
                        @foreach (var r in regels.Where(r => r.Laag == laag && (!verbergReedsLid || r.Status != SpiegelStatus.ReedsLid)))
                        {
                            <tr class="kb-status-@r.Status.ToString().ToLowerInvariant()">
                                <td><ObjectLink Id="@r.GroepId" Tekst="@r.Groep" /></td>
                                <td>@r.Type</td>
                                <td>@r.StatusTekst</td>
                                <td>@r.RouteTekst</td>
                                <td>@r.Opmerking</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        @if (plan is not null)
        {
            <PlanWeergave Plan="plan" Context="@($"Spiegel {referentie.Naam} naar {doel.Naam}")" Titel="Groepen toevoegen" />
        }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "referentie")] public string? ReferentieSleutel { get; set; }
    [SupplyParameterFromQuery(Name = "doel")] public string? DoelSleutel { get; set; }

    private Persoon? referentie;
    private Persoon? doel;
    private bool verbergReedsLid = true;
    private IReadOnlyList<SpiegelRegel> regels = Array.Empty<SpiegelRegel>();
    private IReadOnlyList<Wijziging>? plan;
    private string? planSleutel;

    protected override void OnParametersSet()
    {
        referentie = ReferentieSleutel is null ? referentie : State.Data.ZoekPersoon(ReferentieSleutel);
        doel = DoelSleutel is null ? doel : State.Data.ZoekPersoon(DoelSleutel);
        Bereken();
    }

    private void KiesReferentie(Persoon? p) => Naar(p, doel);

    private void KiesDoel(Persoon? p) => Naar(referentie, p);

    private void Naar(Persoon? r, Persoon? d)
    {
        var delen = new List<string>();
        if (r is not null) delen.Add("referentie=" + Uri.EscapeDataString(r.Sleutel));
        if (d is not null) delen.Add("doel=" + Uri.EscapeDataString(d.Sleutel));
        referentie = r;
        doel = d;
        Nav.NavigateTo("spiegel" + (delen.Count > 0 ? "?" + string.Join('&', delen) : string.Empty));
        Bereken();
    }

    private void MaakPlan() => plan = doel is null ? null : PlanBouwer.Spiegel(State.Data, regels, doel);

    private void Bereken()
    {
        // Het plan blijft staan zolang referentie en doel dezelfde zijn (ook na het uitvoeren)
        var sleutel = $"{referentie?.Sleutel}|{doel?.Sleutel}";
        if (sleutel != planSleutel)
        {
            plan = null;
            planSleutel = sleutel;
        }

        regels = referentie is not null && doel is not null && referentie.Sleutel != doel.Sleutel
            ? Spiegelgebruiker.Bereken(State.Data, State.Config, referentie, doel)
            : Array.Empty<SpiegelRegel>();
    }
}
