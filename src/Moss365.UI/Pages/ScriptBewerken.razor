@page "/scripts/bewerken"
@inject BeheerState State
@inject NavigationManager Nav

<h1>@Titel</h1>

@if (ingebouwdeBron is not null)
{
    <div class="kb-melding">Een ingebouwd script pas je niet aan: dit is een kopie van <strong>@ingebouwdeBron</strong>. Bij Opslaan wordt het een eigen script.</div>
}

@if (gewijzigdBuitenApp)
{
    <div class="kb-melding kb-fout">Dit script werd buiten de app gewijzigd sinds het laatst opgeslagen werd. Kijk het na; Opslaan keurt deze versie goed.</div>
}

<div class="kb-script-bewerken">
    <div class="kb-script-code">
        <CodeEditor Tekst="@tekst" TekstChanged="TekstGewijzigd" Fouten="syntaxfouten" />
    </div>
    <div class="kb-script-paneel">
        <section class="kb-kaart">
            <h2>Eigenschappen</h2>
            <label class="kb-veld"><span>Naam</span><input class="kb-invoer" value="@kop.Naam" @onchange="e => ZetKop(kop with { Naam = e.Value?.ToString() ?? string.Empty })" /></label>
            <label class="kb-veld"><span>Wat het doet</span><textarea class="kb-invoer" rows="2" @onchange="e => ZetKop(kop with { Omschrijving = e.Value?.ToString() ?? string.Empty })">@kop.Omschrijving</textarea></label>
            <div class="kb-veld">
                <span>Verbinding</span>
                <span class="kb-filters">
                    @foreach (var v in new[] { ScriptVerbinding.Exchange, ScriptVerbinding.Graph, ScriptVerbinding.Ad, ScriptVerbinding.Lokaal })
                    {
                        var vlag = v;
                        <label><input type="checkbox" checked="@kop.Verbinding.HasFlag(vlag)" @onchange="e => ZetVerbinding(vlag, e.Value is true)" /> @ScriptTekst.VerbindingTekst(vlag)</label>
                    }
                </span>
            </div>
            <label class="kb-veld"><span><input type="checkbox" checked="@kop.Schrijft" @onchange="e => ZetKop(kop with { Schrijft = e.Value is true })" /> Dit script wijzigt iets (dan eerst een voorbeeld met -WhatIf)</span></label>
            <div class="kb-rij">
                <label class="kb-veld">
                    <span>PowerShell</span>
                    <select class="kb-invoer" value="@kop.PowerShell" @onchange="e => ZetKop(kop with { PowerShell = e.Value?.ToString() ?? string.Empty })">
                        <option value="">7 als die er is</option>
                        <option value="7">7</option>
                        <option value="5.1">Windows PowerShell 5.1</option>
                    </select>
                </label>
                <label class="kb-veld"><span>Maximale duur (minuten)</span><input class="kb-invoer" type="number" min="1" value="@kop.DuurMinuten" @onchange="ZetDuur" /></label>
            </div>
        </section>
    </div>
</div>

<section class="kb-kaart">
    <h2>Variabelen</h2>
    <p class="kb-zacht">Wat het formulier vraagt bij het starten; de app geeft ze als parameters aan het script en onthoudt de laatst gebruikte waarden.</p>
    <VariabelenEditor Variabelen="kop.Variabelen" VariabelenChanged="v => ZetKop(kop with { Variabelen = v })" />
</section>

@foreach (var w in waarschuwingen)
{
    <div class="kb-melding">@w</div>
}

@if (syntaxfouten.Count > 0)
{
    <div class="kb-melding kb-fout">
        Syntaxfouten:
        <ul>@foreach (var f in syntaxfouten) { <li>regel @f.Regel: @f.Tekst</li> }</ul>
    </div>
}

@if (melding is not null)
{
    <div class="kb-melding">@melding</div>
}

<div class="kb-filters">
    <button class="kb-knop" disabled="@bezig" @onclick="Controleer">Controleren</button>
    @if (!eenmalig)
    {
        <button class="kb-knop kb-primair" disabled="@bezig" @onclick="() => Opslaan(false)">Opslaan</button>
        <button class="kb-knop" disabled="@bezig" @onclick="() => Opslaan(true)">Opslaan en starten</button>
    }
    <button class="kb-knop" disabled="@bezig" @onclick="Eenmalig">Eenmalig uitvoeren (niet opslaan)</button>
    <a class="kb-knop" href="scripts">Terug naar de scripts</a>
</div>

@if (eenmaligScript is not null)
{
    <ScriptRunPaneel @key="eenmaligScript.Vingerafdruk" Script="eenmaligScript" EenmaligeTekst="@eenmaligeTekst" />
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "sleutel")] public string? Sleutel { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "eenmalig")] public int? EenmaligVraag { get; set; }

    private string tekst = string.Empty;
    private ScriptKop kop = new();
    private string? pad;
    private string? ingebouwdeBron;
    private bool eenmalig;
    private bool gewijzigdBuitenApp;
    private bool bezig;
    private string? melding;
    private IReadOnlyList<string> waarschuwingen = Array.Empty<string>();
    private IReadOnlyList<ScriptGebeurtenis> syntaxfouten = Array.Empty<ScriptGebeurtenis>();
    private ScriptBestand? eenmaligScript;
    private string? eenmaligeTekst;
    private string? geladen;

    private string Titel => eenmalig ? "Eenmalig script" : ingebouwdeBron is not null ? $"Kopie van {ingebouwdeBron}" : pad is null ? "Nieuw script" : $"Script bewerken: {kop.Naam}";

    protected override void OnParametersSet()
    {
        var vraag = $"{Sleutel}|{EenmaligVraag}";
        if (geladen == vraag)
        {
            return;
        }

        geladen = vraag;
        eenmalig = EenmaligVraag == 1;
        if (Sleutel is { Length: > 0 } s && State.ZoekScript(s) is { } script)
        {
            tekst = File.ReadAllText(script.Pad);
            if (script.Ingebouwd)
            {
                ingebouwdeBron = script.Kop.Naam;
                tekst = ScriptTekst.Schrijf(script.Kop with { Naam = script.Kop.Naam + " (kopie)" }, tekst);
            }
            else
            {
                pad = script.Pad;
                gewijzigdBuitenApp = ScriptBibliotheek.IsGewijzigdBuitenApp(State.ScriptMappen, script);
            }
        }
        else
        {
            tekst = ScriptBibliotheek.NieuwScript(eenmalig ? "Eenmalig" : "Nieuw script");
        }

        kop = ScriptTekst.Lees(tekst, pad ?? "script.ps1");
    }

    private void TekstGewijzigd(string nieuw)
    {
        tekst = nieuw;
        var gelezen = ScriptTekst.Lees(tekst, pad ?? "script.ps1");
        if (gelezen.UitBlok)
        {
            kop = gelezen;
        }
    }

    private void ZetKop(ScriptKop nieuw)
    {
        kop = nieuw;
        tekst = ScriptTekst.Schrijf(kop, tekst);
    }

    private void ZetVerbinding(ScriptVerbinding vlag, bool aan)
        => ZetKop(kop with { Verbinding = aan ? kop.Verbinding | vlag : kop.Verbinding & ~vlag });

    private void ZetDuur(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var d) && d > 0)
        {
            ZetKop(kop with { DuurMinuten = d });
        }
    }

    private async Task<bool> Controleer()
    {
        bezig = true;
        melding = null;
        try
        {
            if (!kop.UitBlok)
            {
                ZetKop(kop);
            }

            waarschuwingen = ScriptTekst.Waarschuwingen(kop, tekst);
            syntaxfouten = await State.ControleerScriptAsync(tekst);
            if (syntaxfouten.Count == 0 && waarschuwingen.Count == 0)
            {
                melding = "Geen fouten gevonden.";
            }

            return syntaxfouten.Count == 0 && kop.Naam.Trim().Length > 0;
        }
        finally
        {
            bezig = false;
        }
    }

    private async Task Opslaan(bool starten)
    {
        if (kop.Naam.Trim().Length == 0)
        {
            melding = "Geef het script een naam.";
            return;
        }

        var zonderFouten = await Controleer();
        var bestand = ScriptBibliotheek.Opslaan(State.ScriptMappen, ScriptTekst.Schrijf(kop, tekst), pad);
        pad = bestand.Pad;
        ingebouwdeBron = null;
        gewijzigdBuitenApp = false;
        melding = zonderFouten ? $"Opgeslagen als {Path.GetFileName(bestand.Pad)}." : "Opgeslagen, maar met syntaxfouten: zo kan het niet draaien.";
        if (starten && zonderFouten)
        {
            Nav.NavigateTo($"scripts/starten/{Uri.EscapeDataString(bestand.Sleutel)}");
        }
    }

    private async Task Eenmalig()
    {
        if (!await Controleer())
        {
            melding = "Los eerst de syntaxfouten op.";
            return;
        }

        // De tekst die draait, ligt vast: wijzigen in de editor raakt deze run niet meer
        eenmaligeTekst = ScriptTekst.Schrijf(kop, tekst);
        var tijdelijk = Path.Combine(Path.GetTempPath(), "Moss365", "eenmalig.ps1");
        Directory.CreateDirectory(Path.GetDirectoryName(tijdelijk)!);
        File.WriteAllText(tijdelijk, eenmaligeTekst);
        eenmaligScript = ScriptBibliotheek.LeesBestand(tijdelijk, false);
    }
}
