@page "/groep/{Sleutel}"
@inherits VerversendePagina

@if (groep is null)
{
    <h1>Groep niet gevonden</h1>
    <p><a href="groepen">Terug naar de groepen</a></p>
}
else
{
    <h1>@groep.Naam</h1>
    <ObjectStatus Object="groep.Ref" />
    <p class="kb-zacht">
        @groep.SoortTekst &middot; @groep.Lagen &middot; wijzigen via @RouteTekst(groep)
        @if (groep.Dynamisch) { <span class="kb-label">dynamisch</span> }
        @if (groep.Ad is { } bev && Moss365.Core.Analyse.Spiegelgebruiker.IsBevoorrecht(bev)) { <span class="kb-label kb-rood">bevoorrecht</span> }
    </p>

    <div class="kb-kolommen">
        <section class="kb-kaart">
            <h2>Gegevens</h2>
            <table class="kb-tabel kb-naast">
                <tbody>
                    <tr><th>E-mailadres</th><td>@groep.Mail</td></tr>
                    <tr><th>Omschrijving</th><td>@groep.Omschrijving</td></tr>
                    @if (groep.Ad is { } ad)
                    {
                        <tr><th>sAMAccountName</th><td>@ad.SamAccountName</td></tr>
                        <tr><th>OU</th><td>@ad.OuPad</td></tr>
                        <tr><th>Soort in AD</th><td>@ad.Category, @ad.Scope</td></tr>
                    }
                    @if (groep.Cloud is { } cloud)
                    {
                        <tr><th>Soort in Entra</th><td>@cloud.TypeTekst @(cloud.UitAd ? "(uit AD)" : null)</td></tr>
                        @if (cloud.Dynamisch) { <tr><th>Regel</th><td><code>@cloud.Lidmaatschapsregel</code></td></tr> }
                        @if (cloud.GroepLicentie) { <tr><th>Licentie</th><td>Kent een licentie toe aan de leden</td></tr> }
                    }
                    @if (groep.Exo is { } exo)
                    {
                        <tr><th>Soort in Exchange</th><td>@exo.TypeTekst</td></tr>
                        <tr><th>Lid worden</th><td>@exo.MemberJoinRestriction</td></tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="kb-kaart">
            <h2>Beheerders en eigenaars</h2>
            @if (beheerders.Count == 0 && eigenaars is null)
            {
                <p class="kb-zacht">Geen beheerder gekend.</p>
            }
            <ul class="kb-lijst-plat">
                @foreach (var b in beheerders)
                {
                    <li><ObjectLink Object="b.Object" ToonSoort="true" /> <span class="kb-zacht">(@b.Laag)</span>
                        <button class="kb-knop kb-klein" @onclick="() => Plan(GroepPlannen.Beheerder(State.Data, groep, b.Object, false))">weghalen</button></li>
                }
                @foreach (var e in eigenaars ?? Array.Empty<GraphEigenaar>())
                {
                    var r = State.Data.Index.Ref(e.Id.Length > 0 ? e.Id : e.Upn);
                    <li><ObjectLink Object="r" Tekst="@(e.Naam.Length > 0 ? e.Naam : null)" /> <span class="kb-zacht">(eigenaar in Entra)</span>
                        <button class="kb-knop kb-klein" @onclick="() => Plan(GroepPlannen.Beheerder(State.Data, groep, r, false))">weghalen</button></li>
                }
            </ul>
            @if (groep.Cloud is { } c && groep.Ad is null && groep.Route == Moss365.Core.Analyse.SchrijfRoute.Graph)
            {
                <div class="kb-filters">
                    <button class="kb-knop" disabled="@(!State.KanVerbinden || bezig)" @onclick="() => LaadEigenaars(c.Id)">Eigenaars live laden</button>
                    @if (melding is not null) { <span class="kb-zacht">@melding</span> }
                </div>
            }
            <ObjectKiezer Label="Beheerder of eigenaar toevoegen" Soorten="Personen" Gekozen="r => Plan(GroepPlannen.Beheerder(State.Data, groep, r, true))" />
        </section>
    </div>

    <section class="kb-kaart">
        <h2>Leden (@leden.Count)</h2>
        @if (groep.Dynamisch)
        {
            <div class="kb-melding">Dynamische groep: de leden volgen uit de regel. Wijzig de gegevens van de gebruiker (bv. kantoor of dienst) in plaats van de groep.</div>
        }
        else if (State.Mag(Recht.GroepLeden))
        {
            <ObjectKiezer Label="Lid toevoegen" Soorten="LidSoorten" Gekozen="r => Plan(GroepPlannen.LidToevoegen(State.Data, groep, r))" />
        }
        @if (leden.Count > 0)
        {
            <table class="kb-tabel">
                <thead><tr>@if (!groep.Dynamisch) { <th></th> }<th>Lid</th><th>Soort</th><th>Waar</th><th>Details</th></tr></thead>
                <tbody>
                    @foreach (var l in leden)
                    {
                        <tr>
                            @if (!groep.Dynamisch)
                            {
                                <td><input type="checkbox" aria-label="@($"{l.Object.Naam} kiezen")" checked="@gekozen.Contains(l.Object)" @onchange="e => Kies(l.Object, e)" disabled="@(l.Object.Soort == ObjectSoort.Onbekend)" /></td>
                            }
                            <td><ObjectLink Object="l.Object" /></td>
                            <td>@l.Object.SoortTekst</td>
                            <td>@l.Laag</td>
                            <td class="kb-zacht">@l.Object.Detail</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!groep.Dynamisch && State.Mag(Recht.GroepLeden))
            {
                <div class="kb-filters">
                    <button class="kb-knop" disabled="@(gekozen.Count == 0)" @onclick="VerwijderGekozen">Gekozen leden verwijderen (@gekozen.Count)</button>
                </div>
            }
        }
    </section>

    <div class="kb-kolommen">
        <section class="kb-kaart">
            <h2>Lid van (@lidVan.Count)</h2>
            @if (lidVan.Count == 0) { <p class="kb-zacht">Deze groep is geen lid van andere groepen.</p> }
            <ul class="kb-lijst-plat">
                @foreach (var o in lidVan)
                {
                    <li><ObjectLink Object="o.Object" /> <span class="kb-zacht">(@o.Laag)</span></li>
                }
            </ul>
        </section>
        <section class="kb-kaart">
            <h2>Rechten op postvakken (@rechten.Count)</h2>
            @if (rechten.Count == 0) { <p class="kb-zacht">Geen FullAccess of SendAs op gedeelde postvakken.</p> }
            <ul class="kb-lijst-plat">
                @foreach (var r in rechten)
                {
                    <li><ObjectLink Id="@r.Postvak.Smtp" /> <span class="kb-soort">@r.Recht</span></li>
                }
            </ul>
        </section>
    </div>

    @if (!groep.Dynamisch && State.Mag(Recht.Beheren))
    {
        <section class="kb-kaart">
            <h2>Naam en omschrijving</h2>
            <div class="kb-raster">
                <label>Weergavenaam <input class="kb-invoer" @bind="gewenst.Weergavenaam" /></label>
                <label>Omschrijving <input class="kb-invoer" @bind="gewenst.Omschrijving" /></label>
                @if (groep.Route == Moss365.Core.Analyse.SchrijfRoute.Exchange)
                {
                    <label>E-mailadres <input class="kb-invoer" @bind="gewenst.Mail" /></label>
                }
            </div>
            <div class="kb-filters">
                <button class="kb-knop kb-primair" @onclick="() => Plan(GroepPlannen.Kenmerken(groep, gewenst))">Plan maken</button>
            </div>
        </section>
    }

    @foreach (var f in fouten)
    {
        <div class="kb-melding kb-fout">@f</div>
    }
    @if (plan is not null)
    {
        <PlanWeergave Plan="plan" Context="@($"Groep {groep.Naam}")" Titel="Wijzigingen aan de groep" Uitgevoerd="NaUitvoeren" />
    }
}

@code {
    [Parameter] public string Sleutel { get; set; } = string.Empty;

    private static readonly ObjectSoort[] Personen = { ObjectSoort.Gebruiker };
    private static readonly ObjectSoort[] LidSoorten = { ObjectSoort.Gebruiker, ObjectSoort.Groep, ObjectSoort.Postvak, ObjectSoort.Room };

    private Groep? groep;
    private IReadOnlyList<Relatie> leden = Array.Empty<Relatie>();
    private IReadOnlyList<Relatie> lidVan = Array.Empty<Relatie>();
    private IReadOnlyList<Relatie> beheerders = Array.Empty<Relatie>();
    private IReadOnlyList<RechtRegel> rechten = Array.Empty<RechtRegel>();
    private IReadOnlyList<GraphEigenaar>? eigenaars;
    private readonly HashSet<ObjectRef> gekozen = new();
    private GroepGewenst gewenst = new();
    private IReadOnlyList<Wijziging>? plan;
    private IReadOnlyList<string> fouten = Array.Empty<string>();
    private bool bezig;
    private string? melding;
    private string? geladen;

    private string Formulier => $"groepen/{geladen}/wijzigen";

    private void NaUitvoeren(IReadOnlyList<WijzigingResultaat> resultaten)
    {
        if (resultaten.Any(r => r.Status == ResultaatStatus.Gelukt))
        {
            State.Paginastatus.Vergeet(Formulier);
        }
    }

    protected override void OnParametersSet()
    {
        var index = State.Data.Index;
        var nieuw = index.Groep(Sleutel);
        if (nieuw?.Sleutel != geladen)
        {
            geladen = nieuw?.Sleutel;
            plan = null;
            fouten = Array.Empty<string>();
            gekozen.Clear();
            eigenaars = null;
            melding = null;
            // Wat je invulde blijft per groep bewaard tot het plan uitgevoerd is
            gewenst = nieuw is null ? new() : State.Paginastatus.Formulier(Formulier, "groep/" + nieuw.Sleutel, $"Groep {nieuw.Naam}", () => new GroepGewenst { Weergavenaam = nieuw.Naam, Omschrijving = nieuw.Omschrijving, Mail = nieuw.Mail });
        }

        groep = nieuw;
        if (groep is not null)
        {
            leden = index.UniekeLedenVan(groep);
            lidVan = index.LidVan(groep);
            beheerders = index.BeheerdersVan(groep);
            rechten = index.RechtenVan(groep.Ref);
        }
    }

    private static string RouteTekst(Groep g) => g.Route switch
    {
        Moss365.Core.Analyse.SchrijfRoute.ActiveDirectory => "AD",
        Moss365.Core.Analyse.SchrijfRoute.Graph => "Entra (Graph)",
        Moss365.Core.Analyse.SchrijfRoute.Exchange => "Exchange",
        _ => "niet (automatisch)",
    };

    private void Kies(ObjectRef r, ChangeEventArgs e)
    {
        if (e.Value is true) gekozen.Add(r); else gekozen.Remove(r);
    }

    private void VerwijderGekozen()
    {
        var uitkomsten = gekozen.Select(r => GroepPlannen.LidVerwijderen(State.Data, groep!, r)).ToList();
        Toon(uitkomsten.SelectMany(u => u.Plan).ToList(), uitkomsten.SelectMany(u => u.Fouten).ToList());
    }

    private void Plan(PlanUitkomst u) => Toon(u.Plan, u.Fouten);

    private void Toon(IReadOnlyList<Wijziging> p, IReadOnlyList<string> f)
    {
        fouten = f;
        plan = p.Count > 0 || f.Count == 0 ? p : null;
    }

    private async Task LaadEigenaars(string id)
    {
        bezig = true;
        melding = null;
        try
        {
            eigenaars = await State.LeesEigenaarsAsync(id);
            melding = eigenaars is null ? "Vul eerst de Entra-gegevens in (Verbindingen)." : eigenaars.Count == 0 ? "Geen eigenaars." : null;
        }
        catch (Exception ex)
        {
            melding = ex.Message;
        }
        finally
        {
            bezig = false;
        }
    }
}
