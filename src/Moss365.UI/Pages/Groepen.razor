@page "/groepen"
@inherits VerversendePagina
@inject NavigationManager Nav

<div class="kb-titelbalk">
    <h1>Groepen</h1>
    @if (State.Mag(Recht.Beheren)) { <a class="kb-knop kb-primair" href="groepen/nieuw">+ Nieuwe groep</a> }
</div>

<p class="kb-zacht">
    Alle groepen uit AD, Entra en Exchange. Een uit AD gesynchroniseerde groep staat er één keer, met zijn AD- en cloudkant samen.
</p>

<div class="kb-tegels">
    @foreach (var (label, aantal, filter) in Tegels())
    {
        <button class="kb-tegel @(z.Soort == filter ? "kb-actief" : null)" @onclick="() => { z.Kpi = null; z.Soort = z.Soort == filter ? null : filter; }">
            <div class="kb-tegel-getal">@aantal</div><div>@label</div>
        </button>
    }
</div>

<KpiFilter Kpi="ActieveKpi" Aantal="KpiRijen.Count" Getoond="Lijst.Count" Gewist="() => z.Kpi = null" />

<div class="kb-filters kb-plak">
    <input class="kb-invoer kb-breed" placeholder="Zoek op naam, adres of sAMAccountName" @bind="z.Zoek" @bind:event="oninput" aria-label="Zoeken" />
</div>

<KbTabel Id="groepen" Items="Lijst" Kolommen="kolommen" Selecteerbaar SleutelVan="g => g.Sleutel" SelectieGewijzigd="_ => { }" StandaardSortering="naam" Telling="@($"{Lijst.Count} groepen")" />

<BulkTaken Lijst="groepen" Aantal="AantalGekozen" />

@code {
    /// <summary>Zoekterm en filters, bewaard zolang de app open is (Terug, Vooruit, menu).</summary>
    private sealed class Zoeken { public string Zoek { get; set; } = string.Empty; public string? Soort { get; set; } public string? Kpi { get; set; } }
    private Zoeken? _z;
    private Zoeken z => _z ??= State.Paginastatus.Van<Zoeken>("groepen");

    /// <summary>Vanuit een KPI-tegel: groepen?kpi=zonder-leden (zie Core/Analyse/Kpis.cs).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "kpi")] public string? KpiVraag { get; set; }
    private string? verwerkteKpi;

    protected override void OnParametersSet()
    {
        if (KpiVraag != verwerkteKpi)
        {
            verwerkteKpi = KpiVraag;
            if (State.KpiAankomst(KpiVraag, Nav.Uri, "groepen", "groepen"))
            {
                _z = null;
                z.Kpi = KpiVraag;
            }
        }
    }

    private Kpi? ActieveKpi => Kpis.Zoek(z.Kpi) is { Lijst: KpiLijst.Groepen } k ? k : null;
    private IReadOnlyList<Groep> KpiRijen => ActieveKpi is { } k ? Kpis.Groepen(k, State.KpiBron) : Array.Empty<Groep>();
    private IReadOnlyList<Kolom<Groep>> kolommen = Array.Empty<Kolom<Groep>>();

    protected override void OnInitialized() => kolommen = new List<Kolom<Groep>>
    {
        new() { Sleutel = "naam", Titel = "Groep", Cel = g => @<ObjectLink Object="g.Ref" />, SorteerOp = g => g.Naam },
        new() { Sleutel = "soort", Titel = "Soort", Cel = g => @<text>@g.SoortTekst</text>, SorteerOp = g => g.SoortTekst },
        new() { Sleutel = "waar", Titel = "Waar", Cel = g => @<text>@g.Lagen</text>, SorteerOp = g => g.Lagen },
        new() { Sleutel = "mail", Titel = "E-mailadres", Cel = g => @<text>@g.Mail</text>, SorteerOp = g => g.Mail },
        new() { Sleutel = "leden", Titel = "Leden", Getal = true, Cel = g => @<text>@Leden(g)</text>, SorteerOp = g => Leden(g) },
        new() { Sleutel = "omschrijving", Titel = "Omschrijving", Cel = g => @<span class="kb-zacht">@g.Omschrijving</span>, SorteerOp = g => g.Omschrijving },
        new() { Sleutel = "sam", Titel = "sAMAccountName", Verborgen = true, Cel = g => @<text>@g.Ad?.SamAccountName</text>, SorteerOp = g => g.Ad?.SamAccountName },
        new() { Sleutel = "ou", Titel = "OU", Verborgen = true, Cel = g => @<text>@g.Ad?.OuPad</text>, SorteerOp = g => g.Ad?.OuPad },
        new() { Sleutel = "weg", Titel = "Wijzigen via", Verborgen = true, Cel = g => @<text>@g.Route</text>, SorteerOp = g => g.Route.ToString() },
        new() { Sleutel = "entraid", Titel = "Entra-ID", Verborgen = true, Cel = g => @<code>@(g.Cloud?.Id)</code>, SorteerOp = g => g.Cloud?.Id },
    };

    private static int? Leden(Groep g) => g.Cloud?.AantalLeden ?? g.Exo?.AantalLeden ?? g.Ad?.AantalLeden;

    private static string Categorie(Groep g) => g.Dynamisch ? "dynamisch"
        : g.Ad is not null ? (g.Cloud is not null ? "ad-sync" : "ad")
        : g.Cloud is { Type: CloudGroepType.Microsoft365 } ? "m365"
        : g.Route == Moss365.Core.Analyse.SchrijfRoute.Exchange ? "mail"
        : "cloud";

    private IEnumerable<(string Label, int Aantal, string Filter)> Tegels()
    {
        var alle = State.Data.Index.Groepen.ToList();
        foreach (var (label, filter) in new[] { ("Alleen AD", "ad"), ("AD, gesynchroniseerd", "ad-sync"), ("Microsoft 365", "m365"), ("Mailgroepen", "mail"), ("Cloudbeveiliging", "cloud"), ("Dynamisch", "dynamisch") })
        {
            yield return (label, alle.Count(g => Categorie(g) == filter), filter);
        }
    }

    private IReadOnlyList<Groep> Lijst
    {
        get
        {
            var term = z.Zoek.Trim();
            return (ActieveKpi is null ? State.Data.Index.Groepen : KpiRijen)
                .Where(g => z.Soort is null || Categorie(g) == z.Soort)
                .Where(g => term.Length == 0 || new[] { g.Naam, g.Mail, g.Ad?.SamAccountName, g.Ad?.Name, g.Omschrijving }.Any(v => v?.Contains(term, StringComparison.OrdinalIgnoreCase) == true))
                .OrderBy(g => g.Naam, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
    }

    private int AantalGekozen => State.TabelSessie("groepen").Gekozen.Count;
}
