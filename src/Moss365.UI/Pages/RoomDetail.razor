@page "/room/{Smtp}"
@inherits RefreshingPage

@if (room is null)
{
    <h1>Room niet gevonden</h1>
    <p><a href="rooms">Terug naar de rooms</a></p>
}
else
{
    <h1>@room.DisplayName</h1>
    <ObjectStatus Object="State.Data.Index.Ref(room.Smtp)" />
    <p class="kb-zacht">
        Vergaderruimte &middot; @room.Smtp
        @if (room.Hidden) { <span class="kb-label">verborgen in de adreslijst</span> }
    </p>

    @if (deviations.Count > 0)
    {
        <div class="kb-melding">Wijkt af van de standaard: @string.Join("; ", deviations)</div>
    }

    <div class="kb-kolommen">
        <section class="kb-kaart">
            <h2>Plaats</h2>
            <table class="kb-tabel kb-naast">
                <tbody>
                    <tr><th>Gebouw</th><td>@room.Building</td></tr>
                    <tr><th>Verdieping</th><td>@room.Floor @(room.FloorLabel.Length > 0 ? $"({room.FloorLabel})" : null)</td></tr>
                    <tr><th>Capaciteit</th><td>@room.Capacity</td></tr>
                </tbody>
            </table>
        </section>

        <section class="kb-kaart">
            <h2>Agendaverwerking</h2>
            <table class="kb-tabel kb-naast">
                <tbody>
                    <tr><th>Verwerking</th><td>@room.AutomateProcessing</td></tr>
                    <tr><th>Boekingsvenster</th><td>@room.BookingWindowInDays dagen</td></tr>
                    <tr><th>Maximale duur</th><td>@room.MaximumDurationInMinutes minuten</td></tr>
                    <tr><th>Conflicten toestaan</th><td>@YesNoText(room.AllowConflicts)</td></tr>
                    <tr><th>Terugkerend</th><td>@YesNoText(room.AllowRecurringMeetings)</td></tr>
                    <tr><th>Organisator in onderwerp</th><td>@YesNoText(room.AddOrganizerToSubject)</td></tr>
                    <tr><th>Onderwerp wissen</th><td>@YesNoText(room.DeleteSubject)</td></tr>
                    <tr><th>Iedereen mag boeken</th><td>@YesNoText(room.AllBookInPolicy)</td></tr>
                    <tr><th>Iedereen mag aanvragen</th><td>@YesNoText(room.AllRequestInPolicy)</td></tr>
                </tbody>
            </table>
        </section>
    </div>

    <div class="kb-kolommen">
        <section class="kb-kaart">
            <h2>Gedelegeerden en boekers</h2>
            <p class="kb-zacht">Gedelegeerden keuren aanvragen goed; "mag boeken" geldt als niet iedereen mag boeken.</p>
            <ul class="kb-lijst-plat">
                @foreach (var d in Items(room.ResourceDelegates))
                {
                    <li><ObjectLink Id="@d" ShowKind="true" /> <span class="kb-zacht">(gedelegeerde)</span></li>
                }
                @foreach (var d in Items(room.BookInPolicy))
                {
                    <li><ObjectLink Id="@d" ShowKind="true" /> <span class="kb-zacht">(mag boeken)</span></li>
                }
            </ul>
        </section>

        <section class="kb-kaart">
            <h2>Agendarechten</h2>
            <table class="kb-tabel">
                <thead><tr><th>Wie</th><th>Recht</th></tr></thead>
                <tbody>
                    @foreach (var (who, permission) in Permissions(room.CalendarPermissions))
                    {
                        <tr><td>@if (who is "Default" or "Anonymous" or "Standaard" or "Anoniem") { @who } else { <ObjectLink Id="@who" /> }</td><td>@permission</td></tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="kb-kaart">
            <h2>Lid van</h2>
            @if (groups.Count == 0) { <p class="kb-zacht">Geen room list of groep.</p> }
            <ul class="kb-lijst-plat">
                @foreach (var g in groups)
                {
                    <li><ObjectLink Object="g.Object" /> <span class="kb-zacht">(@g.Layer)</span></li>
                }
            </ul>
        </section>
    </div>

    <section class="kb-kaart">
        <h2>Agenda</h2>
        <p class="kb-zacht">
            Live uit Exchange (via Graph), enkel lezen. Je eigen account heeft minstens leesrecht (Reviewer of LimitedDetails) op de
            agenda van de room nodig. Wat je bekijkt, komt in het toegangslog.
        </p>
        <div class="kb-filters">
            <span class="kb-segment" role="group" aria-label="Periode">
                @foreach (var (k, text) in new[] { (CalendarChoice.ThisWeek, "Deze week"), (CalendarChoice.NextWeek, "Volgende week"), (CalendarChoice.Selected, "Gekozen periode") })
                {
                    <button class="kb-knop @(calendarChoice == k ? "kb-primair" : null)" @onclick="() => calendarChoice = k">@text</button>
                }
            </span>
            @if (calendarChoice == CalendarChoice.Selected)
            {
                <label>Van <input type="date" class="kb-invoer" @bind="calendarOf" /></label>
                <label>Tot en met <input type="date" class="kb-invoer" @bind="calendarUntil" /></label>
            }
            <button class="kb-knop" disabled="@calendarBusy" @onclick="LoadCalendar">Agenda laden</button>
            @if (calendarBusy) { <span class="kb-zacht">bezig...</span> }
        </div>
        @if (calendarMessage is not null)
        {
            <div class="kb-melding kb-fout">@calendarMessage</div>
        }
        else if (appointments is not null)
        {
            <p class="kb-zacht">@appointments.Count afspraken van @calendarPeriod.</p>
            <KbTable Id="room-agenda" ExportName="@($"Agenda-{room.Alias}")" Items="appointments" Columns="calendarColumns" DefaultSorting="begin"
                     RowClass="@(a => a.Cancelled ? "kb-zacht" : null)" />
        }
    </section>

    @if (State.Can(Permission.Manage))
    {
    <section class="kb-kaart">
        <h2>Wijzigen</h2>
        <p class="kb-zacht">Leeg laten = niet wijzigen. Alleen wat verschilt met de huidige waarde komt in het plan.</p>
        <div class="kb-filters">
            <button class="kb-knop" @onclick="() => { desired = RoomDesired.FromDefault(State.Config.Rooms.Default); plan = null; }">Standaard invullen</button>
            <button class="kb-knop" @onclick="() => { desired = new(); plan = null; }">Leegmaken</button>
        </div>
        <RoomForm Desired="desired" />
        <div class="kb-filters">
            <button class="kb-knop kb-primair" @onclick="() => plan = PlanBuilder.Room(room, RoomForm.Cleaned(desired))">Plan maken</button>
        </div>
    </section>
    }

    @if (plan is not null)
    {
        <PlanView Plan="plan" Context="@($"Room {room.DisplayName}")" Title="Wijzigingen aan de room" />
    }
}

@code {
    [Parameter] public string Smtp { get; set; } = string.Empty;

    private Room? room;
    private IReadOnlyList<string> deviations = Array.Empty<string>();
    private IReadOnlyList<Relation> groups = Array.Empty<Relation>();
    private RoomDesired desired = new();
    private IReadOnlyList<Change>? plan;
    private string? loaded;

    // Calendar: period, appointments (only in the memory of this page) and a message when it fails
    private CalendarChoice calendarChoice = CalendarChoice.ThisWeek;
    private DateOnly? calendarOf = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? calendarUntil = DateOnly.FromDateTime(DateTime.Today.AddDays(13));
    private bool calendarBusy;
    private string? calendarMessage;
    private string calendarPeriod = string.Empty;
    private IReadOnlyList<Appointment>? appointments;

    private static readonly IReadOnlyList<Column<Appointment>> calendarColumns = new List<Column<Appointment>>
    {
        new() { Key = "begin", Title = "Begin", Cell = a => b => b.AddContent(0, a.WholeDay ? a.Begin.ToString("ddd dd/MM/yyyy") : a.Begin.ToString("ddd dd/MM/yyyy HH:mm")), SortBy = a => a.Begin, Text = a => a.Begin.ToString("yyyy-MM-dd HH:mm") },
        new() { Key = "einde", Title = "Einde", Cell = a => b => b.AddContent(0, a.WholeDay ? "hele dag" : a.End.Date == a.Begin.Date ? a.End.ToString("HH:mm") : a.End.ToString("dd/MM HH:mm")), SortBy = a => a.End, Text = a => a.End.ToString("yyyy-MM-dd HH:mm") },
        new() { Key = "onderwerp", Title = "Onderwerp", Cell = a => b => b.AddContent(0, a.SubjectText + (a.Cancelled ? " (geannuleerd)" : string.Empty)), SortBy = a => a.SubjectText },
        new() { Key = "organisator", Title = "Organisator", Cell = a => b => b.AddContent(0, a.Organiser), SortBy = a => a.Organiser },
        new() { Key = "status", Title = "Status", Cell = a => b => b.AddContent(0, a.StatusText), SortBy = a => a.StatusText },
        new() { Key = "adres", Title = "Adres organisator", Hidden = true, Cell = a => b => b.AddContent(0, a.OrganiserAddress), SortBy = a => a.OrganiserAddress },
    };

    private async Task LoadCalendar()
    {
        if (room is null)
        {
            return;
        }

        var (start, until, error) = CalendarPeriod.Compute(calendarChoice, DateTime.Now, calendarOf, calendarUntil);
        appointments = null;
        calendarMessage = error;
        if (error is not null)
        {
            return;
        }

        calendarBusy = true;
        try
        {
            var (list, message) = await State.ReadCalendarAsync(room, start, until);
            appointments = list;
            calendarMessage = message;
            calendarPeriod = $"{start:dd/MM/yyyy} tot en met {until.AddDays(-1):dd/MM/yyyy}";
        }
        catch (Exception ex)
        {
            calendarMessage = "Agenda lezen mislukt: " + ex.Message;
        }
        finally
        {
            calendarBusy = false;
        }
    }

    protected override void OnParametersSet()
    {
        room = State.Data.Index.Room(Smtp);
        if (room?.Smtp != loaded)
        {
            loaded = room?.Smtp;
            desired = new();
            plan = null;
            appointments = null;
            calendarMessage = null;
        }

        if (room is not null)
        {
            deviations = PlanBuilder.RoomDeviations(room, State.Config.Rooms.Default);
            groups = State.Data.Index.GroupsOfAddress(room.Smtp);
        }
    }

    private static string YesNoText(bool b) => b ? "ja" : "nee";

    private static IEnumerable<string> Items(string text)
        => text.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static IEnumerable<(string Who, string Permission)> Permissions(string text)
        => Items(text).Select(d => d.IndexOf('=') is var i and > 0 ? (d[..i], d[(i + 1)..]) : (d, string.Empty));
}
