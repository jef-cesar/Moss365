@page "/room/{Smtp}"
@inherits RefreshingPage

@if (room is null)
{
    <h1>@T["room-detail.room-not-found"]</h1>
    <p><a href="rooms">@T["room-detail.back-to-the-rooms"]</a></p>
}
else
{
    <h1>@room.DisplayName</h1>
    <ObjectStatus Object="State.Data.Index.Ref(room.Smtp)" />
    <p class="kb-zacht">
        Vergaderruimte &middot; @room.Smtp
        @if (room.Hidden) { <span class="kb-label">@T["room-detail.hidden-in-the-address-list"]</span> }
    </p>

    @if (deviations.Count > 0)
    {
        <div class="kb-melding">@T.Format("room-detail.differs-from-the-standard-0", string.Join("; ", deviations))</div>
    }

    <div class="kb-kolommen">
        <section class="kb-kaart">
            <h2>@T["sign-in-list.location"]</h2>
            <table class="kb-tabel kb-naast">
                <tbody>
                    <tr><th>@T["room-form.building"]</th><td>@room.Building</td></tr>
                    <tr><th>@T["room-form.floor"]</th><td>@room.Floor @(room.FloorLabel.Length > 0 ? $"({room.FloorLabel})" : null)</td></tr>
                    <tr><th>@T["room-form.capacity"]</th><td>@room.Capacity</td></tr>
                </tbody>
            </table>
        </section>

        <section class="kb-kaart">
            <h2>@T["room-detail.calendar-processing"]</h2>
            <table class="kb-tabel kb-naast">
                <tbody>
                    <tr><th>@T["room-form.processing"]</th><td>@room.AutomateProcessing</td></tr>
                    <tr><th>@T["room-detail.booking-window"]</th><td>@T.Format("room-detail.0-days", room.BookingWindowInDays)</td></tr>
                    <tr><th>@T["room-detail.maximum-duration"]</th><td>@T.Format("room-detail.0-minutes", room.MaximumDurationInMinutes)</td></tr>
                    <tr><th>@T["room-form.allow-conflicts"]</th><td>@YesNoText(room.AllowConflicts)</td></tr>
                    <tr><th>@T["room-detail.recurring"]</th><td>@YesNoText(room.AllowRecurringMeetings)</td></tr>
                    <tr><th>@T["room-form.organiser-in-subject"]</th><td>@YesNoText(room.AddOrganizerToSubject)</td></tr>
                    <tr><th>@T["room-form.clear-subject"]</th><td>@YesNoText(room.DeleteSubject)</td></tr>
                    <tr><th>@T["room-detail.everyone-may-book"]</th><td>@YesNoText(room.AllBookInPolicy)</td></tr>
                    <tr><th>@T["room-detail.everyone-may-request"]</th><td>@YesNoText(room.AllRequestInPolicy)</td></tr>
                </tbody>
            </table>
        </section>
    </div>

    <div class="kb-kolommen">
        <section class="kb-kaart">
            <h2>@T["room-detail.delegates-and-bookers"]</h2>
            <p class="kb-zacht">@T["room-detail.delegates-approve-requests-may-book"]</p>
            <ul class="kb-lijst-plat">
                @foreach (var d in Items(room.ResourceDelegates))
                {
                    <li><ObjectLink Id="@d" ShowKind="true" /> <span class="kb-zacht">@T["room-detail.delegate"]</span></li>
                }
                @foreach (var d in Items(room.BookInPolicy))
                {
                    <li><ObjectLink Id="@d" ShowKind="true" /> <span class="kb-zacht">@T["room-detail.may-book"]</span></li>
                }
            </ul>
        </section>

        <section class="kb-kaart">
            <h2>@T["room-detail.calendar-permissions"]</h2>
            <table class="kb-tabel">
                <thead><tr><th>@T["script-result.who"]</th><th>@T["room-detail.permission"]</th></tr></thead>
                <tbody>
                    @foreach (var (who, permission) in Permissions(room.CalendarPermissions))
                    {
                        <tr><td>@if (who is "Default" or "Anonymous" or "Standaard" or "Anoniem") { @who } else { <ObjectLink Id="@who" /> }</td><td>@permission</td></tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="kb-kaart">
            <h2>@T["room-detail.member-of"]</h2>
            @if (groups.Count == 0) { <p class="kb-zacht">@T["room-detail.no-room-list-or-group"]</p> }
            <ul class="kb-lijst-plat">
                @foreach (var g in groups)
                {
                    <li><ObjectLink Object="g.Object" /> <span class="kb-zacht">(@g.Layer)</span></li>
                }
            </ul>
        </section>
    </div>

    <section class="kb-kaart">
        <h2>@T["room-detail.calendar"]</h2>
        <p class="kb-zacht">
            @T["room-detail.live-from-exchange-via-graph"]
        </p>
        <div class="kb-filters">
            <span class="kb-segment" role="group" aria-label="@T["security.period"]">
                @foreach (var (k, text) in new[] { (CalendarChoice.ThisWeek, "Deze week"), (CalendarChoice.NextWeek, "Volgende week"), (CalendarChoice.Selected, "Gekozen periode") })
                {
                    <button class="kb-knop @(calendarChoice == k ? "kb-primair" : null)" @onclick="() => calendarChoice = k">@text</button>
                }
            </span>
            @if (calendarChoice == CalendarChoice.Selected)
            {
                <label>@T["absence-card.from"] <input type="date" class="kb-invoer" @bind="calendarOf" /></label>
                <label>@T["manage-ca.up-to-and-including"] <input type="date" class="kb-invoer" @bind="calendarUntil" /></label>
            }
            <button class="kb-knop" disabled="@calendarBusy" @onclick="LoadCalendar">@T["room-detail.load-calendar"]</button>
            @if (calendarBusy) { <span class="kb-zacht">@T["message-trace-card.busy"]</span> }
        </div>
        @if (calendarMessage is not null)
        {
            <div class="kb-melding kb-fout">@calendarMessage</div>
        }
        else if (appointments is not null)
        {
            <p class="kb-zacht">@T.Format("room-detail.0-appointments-from-1", appointments.Count, calendarPeriod)</p>
            <KbTable Id="room-agenda" ExportName="@($"Agenda-{room.Alias}")" Items="appointments" Columns="calendarColumns" DefaultSorting="begin"
                     RowClass="@(a => a.Cancelled ? "kb-zacht" : null)" />
        }
    </section>

    @if (State.Can(Permission.Manage))
    {
    <section class="kb-kaart">
        <h2>@T["manage-ca.change"]</h2>
        <p class="kb-zacht">@T["rooms.leave-empty-do-not-change"]</p>
        <div class="kb-filters">
            <button class="kb-knop" @onclick="() => { desired = RoomDesired.FromDefault(State.Config.Rooms.Default); plan = null; }">@T["rooms.fill-in-the-standard"]</button>
            <button class="kb-knop" @onclick="() => { desired = new(); plan = null; }">@T["rooms.clear"]</button>
        </div>
        <RoomForm Desired="desired" />
        <div class="kb-filters">
            <button class="kb-knop kb-primair" @onclick="() => plan = PlanBuilder.Room(room, RoomForm.Cleaned(desired))">@T["bulk-tasks.make-plan"]</button>
        </div>
    </section>
    }

    @if (plan is not null)
    {
        <PlanView Plan="plan" Context="@($"Room {room.DisplayName}")" Title="@T["code.room-detail.changes-to-the-room"]" />
    }
}

@code {
    [Parameter] public string Smtp { get; set; } = string.Empty;

    private Room? room;
    private IReadOnlyList<string> deviations = Array.Empty<string>();
    private IReadOnlyList<Relation> groups = Array.Empty<Relation>();
    private RoomDesired desired = new();
    private IReadOnlyList<Change>? plan;
    private string? loaded;

    // Calendar: period, appointments (only in the memory of this page) and a message when it fails
    private CalendarChoice calendarChoice = CalendarChoice.ThisWeek;
    private DateOnly? calendarOf = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? calendarUntil = DateOnly.FromDateTime(DateTime.Today.AddDays(13));
    private bool calendarBusy;
    private string? calendarMessage;
    private string calendarPeriod = string.Empty;
    private IReadOnlyList<Appointment>? appointments;

    private static readonly IReadOnlyList<Column<Appointment>> calendarColumns = new List<Column<Appointment>>
    {
        new() { Key = "begin", Title = T["reports.start"], Cell = a => b => b.AddContent(0, a.WholeDay ? a.Begin.ToString("ddd dd/MM/yyyy") : a.Begin.ToString("ddd dd/MM/yyyy HH:mm")), SortBy = a => a.Begin, Text = a => a.Begin.ToString("yyyy-MM-dd HH:mm") },
        new() { Key = "einde", Title = T["reports.end"], Cell = a => b => b.AddContent(0, a.WholeDay ? "hele dag" : a.End.Date == a.Begin.Date ? a.End.ToString("HH:mm") : a.End.ToString("dd/MM HH:mm")), SortBy = a => a.End, Text = a => a.End.ToString("yyyy-MM-dd HH:mm") },
        new() { Key = "onderwerp", Title = T["message-trace-card.subject"], Cell = a => b => b.AddContent(0, a.SubjectText + (a.Cancelled ? " (geannuleerd)" : string.Empty)), SortBy = a => a.SubjectText },
        new() { Key = "organisator", Title = T["room-detail.organiser"], Cell = a => b => b.AddContent(0, a.Organiser), SortBy = a => a.Organiser },
        new() { Key = "status", Title = "Status", Cell = a => b => b.AddContent(0, a.StatusText), SortBy = a => a.StatusText },
        new() { Key = "adres", Title = T["room-detail.address-of-the-organiser"], Hidden = true, Cell = a => b => b.AddContent(0, a.OrganiserAddress), SortBy = a => a.OrganiserAddress },
    };

    private async Task LoadCalendar()
    {
        if (room is null)
        {
            return;
        }

        var (start, until, error) = CalendarPeriod.Compute(calendarChoice, DateTime.Now, calendarOf, calendarUntil);
        appointments = null;
        calendarMessage = error;
        if (error is not null)
        {
            return;
        }

        calendarBusy = true;
        try
        {
            var (list, message) = await State.ReadCalendarAsync(room, start, until);
            appointments = list;
            calendarMessage = message;
            calendarPeriod = T.Format("code.room-detail.up-to-and-including", start, until.AddDays(-1));
        }
        catch (Exception ex)
        {
            calendarMessage = (T["code.room-detail.reading-the-calendar-failed"] + " ") + ex.Message;
        }
        finally
        {
            calendarBusy = false;
        }
    }

    protected override void OnParametersSet()
    {
        room = State.Data.Index.Room(Smtp);
        if (room?.Smtp != loaded)
        {
            loaded = room?.Smtp;
            desired = new();
            plan = null;
            appointments = null;
            calendarMessage = null;
        }

        if (room is not null)
        {
            deviations = PlanBuilder.RoomDeviations(room, State.Config.Rooms.Default);
            groups = State.Data.Index.GroupsOfAddress(room.Smtp);
        }
    }

    private static string YesNoText(bool b) => b ? T["yesno.yes"] : T["yesno.no"];

    private static IEnumerable<string> Items(string text)
        => text.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static IEnumerable<(string Who, string Permission)> Permissions(string text)
        => Items(text).Select(d => d.IndexOf('=') is var i and > 0 ? (d[..i], d[(i + 1)..]) : (d, string.Empty));
}
