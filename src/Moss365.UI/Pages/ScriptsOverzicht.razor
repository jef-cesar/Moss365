@page "/scripts"
@inherits VerversendePagina
@inject NavigationManager Nav

<h1>Scripts</h1>

<p class="kb-zacht">
    PowerShell-scripts met de aanmelding van de app: je meldt niet opnieuw aan. Ingebouwde scripts komen met de app mee;
    eigen scripts blijven op deze pc (delen via Exporteren en Importeren). Elke run wordt @ScriptRuns.BewaarDagen dagen bewaard
    en staat in het logboek. Een script dat iets wijzigt, toont altijd eerst een voorbeeld.
</p>

@if (!State.ScriptsBeschikbaar)
{
    <div class="kb-melding">Scripts draaien enkel in de Windows-app (met PowerShell). Hier kan je ze wel bekijken.</div>
}

@if (State.ScriptRun is { Klaar: false } bezig)
{
    <div class="kb-melding">Er draait een script: <strong>@bezig.Run.Naam</strong>. <a href="@RunLink(bezig.Run)">Bekijken</a></div>
}

<div class="kb-filters">
    <a class="kb-knop kb-primair" href="scripts/bewerken">+ Nieuw script</a>
    <a class="kb-knop" href="scripts/bewerken?eenmalig=1">Eenmalig script</a>
    <label class="kb-knop kb-bestandknop">
        Importeren (.ps1)
        <InputFile OnChange="Importeer" accept=".ps1" />
    </label>
</div>

@if (melding is not null)
{
    <div class="kb-melding @(fout ? "kb-fout" : null)">@melding</div>
}

<KbTabel Id="scripts" ExportNaam="Scripts" Items="scripts" Kolommen="kolommen" StandaardSortering="naam" />

<section class="kb-kaart">
    <h2>Laatste runs</h2>
    @if (runs.Count == 0)
    {
        <p class="kb-zacht">Nog geen runs.</p>
    }
    else
    {
        <table class="kb-tabel">
            <thead><tr><th>Wanneer</th><th>Script</th><th>Wie</th><th>Resultaat</th></tr></thead>
            <tbody>
                @foreach (var r in runs.Take(15))
                {
                    <tr>
                        <td><a href="@RunLink(r)">@r.Start.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</a></td>
                        <td>@r.Naam @if (r.Eenmalig) { <span class="kb-label">eenmalig</span> }</td>
                        <td>@r.Wie</td>
                        <td><RunLabel Run="r" /></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private IReadOnlyList<ScriptBestand> scripts = Array.Empty<ScriptBestand>();
    private IReadOnlyList<ScriptRun> runs = Array.Empty<ScriptRun>();
    private IReadOnlyList<GeplandeActie> gepland = Array.Empty<GeplandeActie>();
    private IReadOnlyList<Kolom<ScriptBestand>> kolommen = Array.Empty<Kolom<ScriptBestand>>();
    private string? melding;
    private bool fout;
    private string? verwijderen;

    protected override void OnInitialized()
    {
        kolommen = new List<Kolom<ScriptBestand>>
        {
            new() { Sleutel = "naam", Titel = "Naam", Cel = s => @<a href="@StartLink(s)">@s.Kop.Naam</a>, SorteerOp = s => s.Kop.Naam },
            new() { Sleutel = "omschrijving", Titel = "Wat het doet", Cel = s => @<span class="kb-zacht">@s.Kop.Omschrijving</span>, SorteerOp = s => s.Kop.Omschrijving },
            new() { Sleutel = "verbinding", Titel = "Verbinding", Cel = s => @<text>@ScriptTekst.VerbindingTekst(s.Kop.Verbinding)</text>, SorteerOp = s => ScriptTekst.VerbindingTekst(s.Kop.Verbinding) },
            new() { Sleutel = "soort", Titel = "Soort", Cel = s => @<span class="kb-label @(s.Kop.Schrijft ? "kb-label-let" : null)">@(s.Kop.Schrijft ? "wijzigt" : "leest")</span>, SorteerOp = s => s.Kop.Schrijft, Tekst = s => s.Kop.Schrijft ? "wijzigt" : "leest" },
            new() { Sleutel = "herkomst", Titel = "Herkomst", Cel = s => @<text>@s.Herkomst<br /><span class="kb-zacht">@s.Map</span></text>, SorteerOp = s => s.Herkomst + s.Map, Tekst = s => s.Herkomst },
            new() { Sleutel = "laatste", Titel = "Laatste run", Cel = s => LaatsteRun(s), SorteerOp = s => Laatste(s)?.Start, Tekst = s => Laatste(s)?.Start.LocalDateTime.ToString("yyyy-MM-dd HH:mm") },
            new() { Sleutel = "gepland", Titel = "Gepland", Cel = s => @<text>@GeplandTekst(s)</text>, SorteerOp = s => GeplandTekst(s), Verborgen = false },
            new() { Sleutel = "acties", Titel = "", Cel = s => Acties(s) },
        };
    }

    protected override void OnParametersSet() => Laad();

    private void Laad()
    {
        scripts = State.LeesScripts();
        runs = ScriptRuns.Lijst(State.ScriptMappen);
        gepland = State.Gepland.Lees().Where(a => a.Soort == GeplandSoort.Script).ToList();
    }

    private ScriptRun? Laatste(ScriptBestand s) => runs.FirstOrDefault(r => r.Sleutel.Equals(s.Sleutel, StringComparison.OrdinalIgnoreCase));

    private RenderFragment LaatsteRun(ScriptBestand s) => Laatste(s) is { } r
        ? @<span><a href="@RunLink(r)">@r.Start.LocalDateTime.ToString("dd/MM HH:mm")</a> <RunLabel Run="r" /></span>
        : @<span class="kb-zacht">nooit</span>;

    private string GeplandTekst(ScriptBestand s)
        => gepland.Where(a => string.Equals(a.ScriptSleutel, s.Sleutel, StringComparison.OrdinalIgnoreCase)).OrderBy(a => a.Wanneer).FirstOrDefault() is { } a
            ? a.Wanneer.ToString("dd/MM HH:mm") + (a.Herhaling == Herhaling.Eenmalig ? string.Empty : " (" + a.Herhaling.ToString().ToLowerInvariant() + ")")
            : string.Empty;

    private RenderFragment Acties(ScriptBestand s) => @<span class="kb-acties-rij">
        <a class="kb-knop kb-klein" href="@StartLink(s)">Starten</a>
        <a class="kb-knop kb-klein" href="@($"scripts/bewerken?sleutel={Uri.EscapeDataString(s.Sleutel)}")">@(s.Ingebouwd ? "Kopie bewerken" : "Bewerken")</a>
        <button class="kb-knop kb-klein" @onclick="() => Exporteer(s)">Exporteren</button>
        @if (!s.Ingebouwd)
        {
            @if (verwijderen == s.Pad)
            {
                <button class="kb-knop kb-klein kb-gevaar" @onclick="() => Verwijder(s)">Ja, verwijderen</button>
                <button class="kb-knop kb-klein" @onclick="() => verwijderen = null">Nee</button>
            }
            else
            {
                <button class="kb-knop kb-klein" @onclick="() => verwijderen = s.Pad">Verwijderen</button>
            }
        }
    </span>;

    private static string StartLink(ScriptBestand s) => $"scripts/starten/{Uri.EscapeDataString(s.Sleutel)}";

    private static string RunLink(ScriptRun r) => $"scripts/run/{Uri.EscapeDataString(r.Sleutel)}/{Uri.EscapeDataString(Path.GetFileName(r.Map))}";

    private async Task Importeer(InputFileChangeEventArgs e)
    {
        melding = null;
        fout = false;
        try
        {
            var tijdelijk = Path.Combine(Path.GetTempPath(), "Moss365", "import-" + Guid.NewGuid().ToString("N"), Path.GetFileName(e.File.Name));
            Directory.CreateDirectory(Path.GetDirectoryName(tijdelijk)!);
            await using (var bron = e.File.OpenReadStream(2 * 1024 * 1024))
            await using (var doel = File.Create(tijdelijk))
            {
                await bron.CopyToAsync(doel);
            }

            var s = ScriptBibliotheek.Importeer(State.ScriptMappen, tijdelijk);
            Directory.Delete(Path.GetDirectoryName(tijdelijk)!, true);
            melding = $"Geimporteerd als eigen script: {s.Kop.Naam}. Kijk het na voor je het start.";
            Laad();
        }
        catch (Exception ex)
        {
            fout = true;
            melding = "Importeren mislukt: " + ex.Message;
        }
    }

    private void Exporteer(ScriptBestand s)
    {
        var map = Path.Combine(State.Omgeving.ExportMap, "Scripts");
        Directory.CreateDirectory(map);
        var doel = Path.Combine(map, Path.GetFileName(s.Pad));
        File.Copy(s.Pad, doel, overwrite: true);
        melding = $"Geexporteerd naar {doel}.";
        fout = false;
        State.Omgeving.ToonBestand(doel);
    }

    private void Verwijder(ScriptBestand s)
    {
        ScriptBibliotheek.Verwijder(State.ScriptMappen, s);
        verwijderen = null;
        melding = $"{s.Kop.Naam} is verwijderd. De runs blijven bewaard.";
        fout = false;
        Laad();
    }
}
