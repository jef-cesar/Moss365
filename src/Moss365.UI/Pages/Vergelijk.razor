@page "/vergelijk"
@inject BeheerState State

<h1>AD tegenover Entra</h1>

@if (!State.Data.HeeftAd || !State.Data.HeeftEntra)
{
    <div class="kb-melding">Voor deze vergelijking zijn zowel <code>ad-gebruikers.csv</code> als <code>entra-gebruikers.csv</code> nodig.</div>
}
else
{
    <p class="kb-zacht">
        Gesynchroniseerde OU's: @string.Join(", ", State.Config.GesynchroniseerdeOus).
        Verschillen in spaties vooraan of achteraan worden genegeerd: Entra schrapt die bij de synchronisatie.
    </p>

    <div class="kb-tegels">
        @foreach (var g in verschillen.GroupBy(v => v.SoortTekst))
        {
            <button class="kb-tegel @(z.Soort == g.Key ? "kb-actief" : null)" @onclick="() => z.Soort = z.Soort == g.Key ? string.Empty : g.Key">
                <div class="kb-tegel-getal">@g.Count()</div><div>@g.Key</div>
            </button>
        }
    </div>

    <div class="kb-filters">
        <input class="kb-invoer kb-breed" placeholder="Filter op naam of kenmerk" @bind="z.Zoek" @bind:event="oninput" />
    </div>

    <KbTabel Id="vergelijk" Items="Gefilterd" Kolommen="kolommen" StandaardSortering="gebruiker" />
    @foreach (var f in fouten)
    {
        <div class="kb-melding">@f</div>
    }
    @if (plan is not null)
    {
        <PlanWeergave Plan="plan" Context="Rechtzetten (AD tegenover Entra)" Titel="Rechtzetten in AD" />
    }
}

@code {
    private IReadOnlyList<Verschil> verschillen = Array.Empty<Verschil>();
    /// <summary>Zoekterm en filters, bewaard zolang de app open is (Terug, Vooruit, menu).</summary>
    private sealed class Zoeken { public string Soort { get; set; } = string.Empty; public string Zoek { get; set; } = string.Empty; }
    private Zoeken? _z;
    private Zoeken z => _z ??= State.Paginastatus.Van<Zoeken>("vergelijk");

    private IReadOnlyList<Kolom<Verschil>> kolommen = Array.Empty<Kolom<Verschil>>();

    protected override void OnInitialized()
    {
        verschillen = AdEntraVergelijking.Vergelijk(State.Data, State.Config);
        kolommen = new List<Kolom<Verschil>>
        {
            new() { Sleutel = "gebruiker", Titel = "Gebruiker", Cel = v => @<text><a href="@Zoeker.Link(v.Persoon)">@v.Persoon.Naam</a><div class="kb-zacht">@v.Persoon.Ad?.OuPad</div></text>, SorteerOp = v => v.Persoon.Naam },
            new() { Sleutel = "soort", Titel = "Soort", Cel = v => @<text>@v.SoortTekst</text>, SorteerOp = v => v.SoortTekst },
            new() { Sleutel = "kenmerk", Titel = "Kenmerk", Cel = v => @<text>@v.Kenmerk</text>, SorteerOp = v => v.Kenmerk },
            new() { Sleutel = "ad", Titel = "AD", Cel = v => @<text>@v.AdWaarde</text>, SorteerOp = v => v.AdWaarde },
            new() { Sleutel = "entra", Titel = "Entra", Cel = v => @<text>@v.EntraWaarde</text>, SorteerOp = v => v.EntraWaarde },
            new() { Sleutel = "toelichting", Titel = "Toelichting", Cel = v => @<text>@v.Toelichting</text>, SorteerOp = v => v.Toelichting },
            new() { Sleutel = "rechtzetten", Titel = "Rechtzetten", Filter = FilterSoort.Geen, Cel = v => @<text>@if (KanRechtzetten(v)) { <button class="kb-knop kb-klein" @onclick="() => Rechtzetten(v)" title="De waarde in AD rechtzetten; Entra volgt na de synchronisatie">Rechtzetten in AD</button> }</text> },
            new() { Sleutel = "ou", Titel = "OU", Verborgen = true, Cel = v => @<text>@v.Persoon.Ad?.OuPad</text>, SorteerOp = v => v.Persoon.Ad?.OuPad },
        };
    }

    private IEnumerable<Verschil> Gefilterd => verschillen
        .Where(v => z.Soort.Length == 0 || v.SoortTekst == z.Soort)
        .Where(v => z.Zoek.Trim().Length == 0
                    || v.Persoon.Naam.Contains(z.Zoek.Trim(), StringComparison.OrdinalIgnoreCase)
                    || v.Kenmerk.Contains(z.Zoek.Trim(), StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<Wijziging>? plan;
    private IReadOnlyList<string> fouten = Array.Empty<string>();

    private bool KanRechtzetten(Verschil v) => State.Mag(Recht.Beheren) && v.Soort == VerschilSoort.KenmerkVerschilt && v.Persoon.Ad is not null
        && v.Kenmerk.Split(" (")[0] is "Weergavenaam" or "Dienst" or "Functie" or "Kantoor";

    private void Rechtzetten(Verschil v)
    {
        var u = KenmerkPlannen.Rechtzetten(State.Data, State.Config, v);
        fouten = u.Fouten;
        plan = u.Plan.Count > 0 ? u.Plan : null;
    }
}
