@page "/conditional-access/{Id}"
@inherits RefreshingPage

@if (State.Data.ConditionalAccess is not { } ca || ca.Policies.FirstOrDefault(b => b.Id == Id) is not { } b)
{
    <h1>@T["ca-policy-detail.policy-not-found"]</h1>
    <p><a href="conditional-access">@T["ca-policy-detail.back-to-conditional-access"]</a></p>
}
else
{
    var name = CaReader.Names(State.Data);
    var u = CaReader.Explanation(b, ca, name);
    <div class="kb-titelbalk">
        <h1>@b.Name</h1>
        @if (State.Can(Permission.Manage) && !State.IsHistoric)
        {
            <span class="kb-filters">
                <a class="kb-knop kb-primair" href="@($"conditional-access/{Uri.EscapeDataString(b.Id)}/bewerken")">@T["edit-user.edit"]</a>
                <a class="kb-knop" href="@($"conditional-access/{Uri.EscapeDataString(b.Id)}/kopie")">@T["ca-policy-detail.make-a-copy"]</a>
            </span>
        }
    </div>
    <p class="kb-zacht">
        <CaLabel Status="b.Status" />
        @if (b.Created is { } a) { <span>aangemaakt @a.LocalDateTime.ToString("dd/MM/yyyy")</span> }
        @if (b.Changed is { } g) { <span>@T.Format("ca-policy-detail.changed", g.LocalDateTime.ToString("dd/MM/yyyy"))</span> }
        @if (b.Status == CaStatus.Report) { <span>@T["ca-policy-detail.reportonly"]</span> }
    </p>

    <section class="kb-kaart">
        <h2>@T["ca-policy-detail.what-the-policy-does"]</h2>
        <dl class="kb-uitleg">
            <dt>@T["script-result.who"]</dt><dd><ul>@foreach (var x in u.Who) { <li>@x</li> }</ul></dd>
            <dt>@T["ca-policy-detail.apps"]</dt><dd><ul>@foreach (var x in u.Apps) { <li>@x</li> }</ul></dd>
            <dt>@T["ca-policy-detail.conditions"]</dt><dd><ul>@foreach (var x in u.Conditions) { <li>@x</li> }</ul></dd>
            <dt>@T["what-if-table.effect"]</dt><dd><strong>@u.Consequence</strong></dd>
            @if (u.Session.Count > 0)
            {
                <dt>@T["ca-policy-detail.session"]</dt><dd><ul>@foreach (var x in u.Session) { <li>@x</li> }</ul></dd>
            }
        </dl>
    </section>

    @if (b.UsersIn.Concat(b.UsersOff).Concat(b.GroupsIn).Concat(b.GroupsOff).Any(Real))
    {
        <section class="kb-kaart">
            <h2>@T["ca-policy-detail.included-and-excluded"]</h2>
            <table class="kb-tabel">
                <thead><tr><th></th><th>@T["menu.gebruikers"]</th><th>@T["menu.groepen"]</th></tr></thead>
                <tbody>
                    <tr>
                        <th>@T["ca-policy-detail.included"]</th>
                        <td>@Links(b.UsersIn)</td>
                        <td>@Links(b.GroupsIn)</td>
                    </tr>
                    <tr>
                        <th>@T["ca-policy-detail.excluded"]</th>
                        <td>@Links(b.UsersOff)</td>
                        <td>@Links(b.GroupsOff)</td>
                    </tr>
                </tbody>
            </table>
        </section>
    }

    <section class="kb-kaart">
        <h2>Wie valt eronder (@Under.Count)</h2>
        <p class="kb-zacht">
            @T["ca-policy-detail.people-with-an-entra-account"]
        </p>
        <KbTable Id="ca-eronder" ExportName="@($"CA-{b.Name}")" Items="Under" Columns="columns" DefaultSorting="naam" />
    </section>

    @if (b.Json.Length > 0)
    {
        <details class="kb-kaart">
            <summary>@T["ca-policy-detail.json-as-entra-gives-the"]</summary>
            <pre class="kb-json">@PrettyJson(b.Json)</pre>
        </details>
    }

    <section class="kb-kaart">
        <h2>@T["ca-policy-detail.effect"]</h2>
        <div class="kb-filters">
            <button class="kb-knop" disabled="@busy" @onclick="LoadEffect">@T["ca-policy-detail.load-effect-sign-ins-of"]</button>
            @if (busy) { <span class="kb-zacht">@T["message-trace-card.busy"]</span> }
        </div>
        @if (error is not null)
        {
            <div class="kb-melding kb-fout">@error</div>
        }
        else if (State.CaEffect?.FirstOrDefault(e => e.PolicyId == b.Id) is { } e)
        {
            <p class="kb-zacht">@State.CaEffectExplanation</p>
            <table class="kb-tabel kb-naast">
                <tbody>
                    @if (b.Status == CaStatus.Report)
                    {
                        <tr><th>@T["ca-policy-detail.would-have-allowed"]</th><td class="kb-getal">@e.ReportSucceeded</td></tr>
                        <tr><th>@T["ca-policy-detail.would-have-blocked"]</th><td class="kb-getal">@e.ReportFailed</td></tr>
                        <tr><th>@T["ca-policy-detail.would-have-asked-for-an"]</th><td class="kb-getal">@e.ReportInterrupted</td></tr>
                    }
                    else
                    {
                        <tr><th>@T["ca-policy-detail.applied-met"]</th><td class="kb-getal">@e.Applied</td></tr>
                        <tr><th>@T["ca-policy-detail.blocked"]</th><td class="kb-getal">@e.Failed</td></tr>
                    }
                    <tr><th>@T["ca-policy-detail.not-applicable"]</th><td class="kb-getal">@e.NotApplicable</td></tr>
                </tbody>
            </table>
        }
    </section>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private bool busy;
    private string? error;
    private IReadOnlyList<Column<(Person Person, CaAnswer Answer)>> columns = Array.Empty<Column<(Person, CaAnswer)>>();

    private IReadOnlyList<(Person Person, CaAnswer Answer)> Under
        => State.Data.ConditionalAccess?.Policies.FirstOrDefault(b => b.Id == Id) is { } b ? CaReader.WhoFallsUnder(b, State.Data) : Array.Empty<(Person, CaAnswer)>();

    private static string PrettyJson(string json)
    {
        try
        {
            return System.Text.Json.Nodes.JsonNode.Parse(json)!.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }

    private static bool Real(string id) => id is not ("All" or "None" or "GuestsOrExternalUsers");

    protected override void OnInitialized()
    {
        columns = new List<Column<(Person Person, CaAnswer Answer)>>
        {
            new() { Key = "naam", Title = "Naam", Cell = x => @<ObjectLink Object="State.Data.Index.Ref(x.Person)" />, SortBy = x => x.Person.Name },
            new() { Key = "upn", Title = "UPN", Cell = x => @<text>@x.Person.Upn</text>, SortBy = x => x.Person.Upn },
            new() { Key = "bron", Title = "Bron", Cell = x => @<text>@x.Person.Source</text>, SortBy = x => x.Person.Source },
            new() { Key = "geldt", Title = "Geldt", Cell = x => @<CaLabel Applies="x.Answer.Applies" />, SortBy = x => (int)x.Answer.Applies, Text = x => x.Answer.Applies == CaApplies.Yes ? "ja" : "misschien" },
            new() { Key = "reden", Title = "Waarom", Cell = x => @<text>@x.Answer.Reason</text>, SortBy = x => x.Answer.Reason },
            new() { Key = "staat", Title = "Account", Cell = x => @<text>@(x.Person.Enabled ? "ingeschakeld" : "uitgeschakeld")</text>, SortBy = x => x.Person.Enabled, Text = x => x.Person.Enabled ? "ingeschakeld" : "uitgeschakeld" },
        };
    }

    private RenderFragment Links(IReadOnlyList<string> ids) => @<text>
        @foreach (var id in ids.Where(Real))
        {
            <div><ObjectLink Object="State.Data.Index.Ref(id)" /></div>
        }
        @if (!ids.Any(Real))
        {
            <span class="kb-zacht">&mdash;</span>
        }
    </text>;

    private async Task LoadEffect()
    {
        busy = true;
        error = null;
        try
        {
            await State.LoadCaEffectAsync(7);
        }
        catch (Exception ex)
        {
            error = (T["code.security-card.reading-sign-ins-failed"] + " ") + ex.Message + (" " + T["code.security-card.needed-role-reports-reader-or"]);
        }
        finally
        {
            busy = false;
        }
    }
}
