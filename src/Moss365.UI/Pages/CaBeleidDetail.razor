@page "/conditional-access/{Id}"
@inherits VerversendePagina

@if (State.Data.ConditionalAccess is not { } ca || ca.Beleiden.FirstOrDefault(b => b.Id == Id) is not { } b)
{
    <h1>Beleid niet gevonden</h1>
    <p><a href="conditional-access">Terug naar Conditional Access</a></p>
}
else
{
    var naam = CaLezer.Namen(State.Data);
    var u = CaLezer.Uitleg(b, ca, naam);
    <h1>@b.Naam</h1>
    <p class="kb-zacht">
        <CaLabel Status="b.Status" />
        @if (b.Aangemaakt is { } a) { <span>aangemaakt @a.LocalDateTime.ToString("dd/MM/yyyy")</span> }
        @if (b.Gewijzigd is { } g) { <span>&middot; gewijzigd @g.LocalDateTime.ToString("dd/MM/yyyy")</span> }
        @if (b.Status == CaStatus.Rapport) { <span>&middot; alleen rapport: Entra meet wat dit beleid zou doen, maar dwingt niets af.</span> }
    </p>

    <section class="kb-kaart">
        <h2>Wat het beleid doet</h2>
        <dl class="kb-uitleg">
            <dt>Wie</dt><dd><ul>@foreach (var x in u.Wie) { <li>@x</li> }</ul></dd>
            <dt>Apps</dt><dd><ul>@foreach (var x in u.Apps) { <li>@x</li> }</ul></dd>
            <dt>Voorwaarden</dt><dd><ul>@foreach (var x in u.Voorwaarden) { <li>@x</li> }</ul></dd>
            <dt>Gevolg</dt><dd><strong>@u.Gevolg</strong></dd>
            @if (u.Sessie.Count > 0)
            {
                <dt>Sessie</dt><dd><ul>@foreach (var x in u.Sessie) { <li>@x</li> }</ul></dd>
            }
        </dl>
    </section>

    @if (b.GebruikersIn.Concat(b.GebruikersUit).Concat(b.GroepenIn).Concat(b.GroepenUit).Any(Echt))
    {
        <section class="kb-kaart">
            <h2>Opgenomen en uitgezonderd</h2>
            <table class="kb-tabel">
                <thead><tr><th></th><th>Gebruikers</th><th>Groepen</th></tr></thead>
                <tbody>
                    <tr>
                        <th>Opgenomen</th>
                        <td>@Links(b.GebruikersIn)</td>
                        <td>@Links(b.GroepenIn)</td>
                    </tr>
                    <tr>
                        <th>Uitgezonderd</th>
                        <td>@Links(b.GebruikersUit)</td>
                        <td>@Links(b.GroepenUit)</td>
                    </tr>
                </tbody>
            </table>
        </section>
    }

    <section class="kb-kaart">
        <h2>Wie valt eronder (@Eronder.Count)</h2>
        <p class="kb-zacht">
            Personen met een Entra-account voor wie het deel "wie" klopt; of het beleid bij een aanmelding echt meespeelt, hangt ook af
            van de app en de voorwaarden.
        </p>
        <KbTabel Id="ca-eronder" ExportNaam="@($"CA-{b.Naam}")" Items="Eronder" Kolommen="kolommen" StandaardSortering="naam" />
    </section>

    <section class="kb-kaart">
        <h2>Effect</h2>
        <div class="kb-filters">
            <button class="kb-knop" disabled="@bezig" @onclick="LaadEffect">Effect laden (aanmeldingen van 7 dagen)</button>
            @if (bezig) { <span class="kb-zacht">bezig...</span> }
        </div>
        @if (fout is not null)
        {
            <div class="kb-melding kb-fout">@fout</div>
        }
        else if (State.CaEffect?.FirstOrDefault(e => e.BeleidId == b.Id) is { } e)
        {
            <p class="kb-zacht">@State.CaEffectUitleg</p>
            <table class="kb-tabel kb-naast">
                <tbody>
                    @if (b.Status == CaStatus.Rapport)
                    {
                        <tr><th>Zou toegestaan hebben</th><td class="kb-getal">@e.RapportGelukt</td></tr>
                        <tr><th>Zou tegengehouden hebben</th><td class="kb-getal">@e.RapportMislukt</td></tr>
                        <tr><th>Zou om een extra stap gevraagd hebben</th><td class="kb-getal">@e.RapportOnderbroken</td></tr>
                    }
                    else
                    {
                        <tr><th>Toegepast (voldaan)</th><td class="kb-getal">@e.Toegepast</td></tr>
                        <tr><th>Tegengehouden</th><td class="kb-getal">@e.Mislukt</td></tr>
                    }
                    <tr><th>Niet van toepassing</th><td class="kb-getal">@e.NietVanToepassing</td></tr>
                </tbody>
            </table>
        }
    </section>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private bool bezig;
    private string? fout;
    private IReadOnlyList<Kolom<(Persoon Persoon, CaAntwoord Antwoord)>> kolommen = Array.Empty<Kolom<(Persoon, CaAntwoord)>>();

    private IReadOnlyList<(Persoon Persoon, CaAntwoord Antwoord)> Eronder
        => State.Data.ConditionalAccess?.Beleiden.FirstOrDefault(b => b.Id == Id) is { } b ? CaLezer.WieValtEronder(b, State.Data) : Array.Empty<(Persoon, CaAntwoord)>();

    private static bool Echt(string id) => id is not ("All" or "None" or "GuestsOrExternalUsers");

    protected override void OnInitialized()
    {
        kolommen = new List<Kolom<(Persoon Persoon, CaAntwoord Antwoord)>>
        {
            new() { Sleutel = "naam", Titel = "Naam", Cel = x => @<ObjectLink Object="State.Data.Index.Ref(x.Persoon)" />, SorteerOp = x => x.Persoon.Naam },
            new() { Sleutel = "upn", Titel = "UPN", Cel = x => @<text>@x.Persoon.Upn</text>, SorteerOp = x => x.Persoon.Upn },
            new() { Sleutel = "bron", Titel = "Bron", Cel = x => @<text>@x.Persoon.Bron</text>, SorteerOp = x => x.Persoon.Bron },
            new() { Sleutel = "geldt", Titel = "Geldt", Cel = x => @<CaLabel Geldt="x.Antwoord.Geldt" />, SorteerOp = x => (int)x.Antwoord.Geldt, Tekst = x => x.Antwoord.Geldt == CaGeldt.Ja ? "ja" : "misschien" },
            new() { Sleutel = "reden", Titel = "Waarom", Cel = x => @<text>@x.Antwoord.Reden</text>, SorteerOp = x => x.Antwoord.Reden },
            new() { Sleutel = "staat", Titel = "Account", Cel = x => @<text>@(x.Persoon.Ingeschakeld ? "ingeschakeld" : "uitgeschakeld")</text>, SorteerOp = x => x.Persoon.Ingeschakeld, Tekst = x => x.Persoon.Ingeschakeld ? "ingeschakeld" : "uitgeschakeld" },
        };
    }

    private RenderFragment Links(IReadOnlyList<string> ids) => @<text>
        @foreach (var id in ids.Where(Echt))
        {
            <div><ObjectLink Object="State.Data.Index.Ref(id)" /></div>
        }
        @if (!ids.Any(Echt))
        {
            <span class="kb-zacht">&mdash;</span>
        }
    </text>;

    private async Task LaadEffect()
    {
        bezig = true;
        fout = null;
        try
        {
            await State.LaadCaEffectAsync(7);
        }
        catch (Exception ex)
        {
            fout = "Aanmeldingen lezen mislukt: " + ex.Message + " (nodig: rol Reports Reader of Security Reader, en Entra ID P1).";
        }
        finally
        {
            bezig = false;
        }
    }
}
