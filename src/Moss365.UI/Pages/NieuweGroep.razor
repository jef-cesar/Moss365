@page "/groepen/nieuw"
@inject BeheerState State

<h1>Nieuwe groep</h1>

<p class="kb-zacht">
    Kies eerst de soort: die bepaalt waar de groep komt. Het plan maakt de groep aan en daarna de beheerder of eigenaar en de
    eerste leden. Lukt het aanmaken niet, dan worden die stappen overgeslagen.
</p>

<section class="kb-kaart">
    <h2>Soort</h2>
    <div class="kb-keuzes">
        @foreach (var (soort, titel, uitleg) in Soorten)
        {
            <label class="kb-keuze @(aanvraag.Soort == soort ? "kb-actief" : null)">
                <input type="radio" name="soort" checked="@(aanvraag.Soort == soort)" @onchange="() => KiesSoort(soort)" />
                <strong>@titel</strong>
                <span class="kb-zacht">@uitleg</span>
            </label>
        }
    </div>
</section>

<section class="kb-kaart">
    <h2>Gegevens</h2>
    <div class="kb-raster">
        <label>Naam <input class="kb-invoer" placeholder="@($"bv. {NieuweGroepPlannen.Voorvoegsel(aanvraag.Soort)}...")" @bind="aanvraag.Naam" @bind:after="Wis" /></label>
        <label>Omschrijving <input class="kb-invoer" @bind="aanvraag.Omschrijving" @bind:after="Wis" /></label>
        @if (NieuweGroepPlannen.MetMail(aanvraag.Soort))
        {
            <label>E-mailadres <input class="kb-invoer" type="email" placeholder="naam@contoso.com" @bind="aanvraag.Mail" @bind:after="Wis" /></label>
        }
        @if (aanvraag.Soort == NieuweGroepSoort.AdBeveiliging)
        {
            <label>
                Bereik
                <select class="kb-invoer" @bind="aanvraag.Bereik" @bind:after="Wis">
                    <option value="Global">Global (standaard)</option>
                    <option value="Universal">Universal</option>
                </select>
            </label>
        }
    </div>
    @if (aanvraag.Soort == NieuweGroepSoort.AdBeveiliging)
    {
        <p class="kb-zacht">In de OU <strong>@(string.IsNullOrWhiteSpace(State.Config.GroepenOu) ? "(nog niet ingesteld bij Organisatie)" : State.Config.GroepenOu)</strong>.</p>
    }

    <PersoonKiezer Label="@(aanvraag.Soort is NieuweGroepSoort.CloudBeveiliging or NieuweGroepSoort.Microsoft365 ? "Eigenaar" : "Beheerder")"
                   Gekozen="@(aanvraag.Beheerder.Length == 0 ? null : State.Data.ZoekPersoon(aanvraag.Beheerder))" GekozenChanged="KiesBeheerder" />

    <ObjectKiezer Label="Eerste leden" Soorten="Personen" Gekozen="VoegLidToe" />
    @if (aanvraag.Leden.Count > 0)
    {
        <ul class="kb-lijst">
            @foreach (var l in aanvraag.Leden.ToList())
            {
                <li>@(State.Data.ZoekPersoon(l)?.Naam ?? l) <button class="kb-knop kb-klein" @onclick="() => { aanvraag.Leden.Remove(l); Wis(); }" aria-label="Weghalen">&times;</button></li>
            }
        </ul>
    }

    <div class="kb-filters">
        <button class="kb-knop kb-primair" @onclick="MaakPlan">Plan maken</button>
        <button class="kb-knop" @onclick="Leegmaken">Leegmaken</button>
    </div>
    @foreach (var f in fouten)
    {
        <div class="kb-melding kb-fout">@f</div>
    }
</section>

@if (plan is not null)
{
    <PlanWeergave Plan="plan" Context="@($"Nieuwe groep {aanvraag.Naam.Trim()}")" Titel="Nieuwe groep" Uitgevoerd="NaUitvoeren" />
}

@code {
    private static readonly ObjectSoort[] Personen = { ObjectSoort.Gebruiker };

    private static readonly (NieuweGroepSoort, string, string)[] Soorten =
    {
        (NieuweGroepSoort.AdBeveiliging, "AD-beveiligingsgroep", "Voor rechten op mappen, programma's en toestellen; gesynchroniseerd naar Entra."),
        (NieuweGroepSoort.CloudBeveiliging, "Beveiligingsgroep in de cloud", "Voor rechten en licenties in Microsoft 365, zonder AD."),
        (NieuweGroepSoort.Microsoft365, "Microsoft 365-groep", "Samenwerken: gedeelde mailbox, agenda, bestanden; Teams mogelijk."),
        (NieuweGroepSoort.MailBeveiliging, "Mail-beveiligingsgroep", "Rechten én mail, bv. toegang tot een gedeeld postvak (via Exchange)."),
        (NieuweGroepSoort.Distributie, "Distributielijst", "Enkel mail naar een groep mensen (via Exchange)."),
    };

    private const string Formulier = "groepen/nieuw";
    private NieuweGroepAanvraag aanvraag = new();
    private IReadOnlyList<Wijziging>? plan;
    private IReadOnlyList<string> fouten = Array.Empty<string>();

    // Het formulier blijft bewaard tot je het uitvoert of leegmaakt
    protected override void OnInitialized() => aanvraag = Bewaard();

    private NieuweGroepAanvraag Bewaard() => State.Paginastatus.Formulier<NieuweGroepAanvraag>(Formulier, Formulier, "Nieuwe groep",
        ingevuld: a => a.Naam.Trim().Length > 0 || a.Leden.Count > 0);

    private void Wis()
    {
        plan = null;
        fouten = Array.Empty<string>();
    }

    private void KiesSoort(NieuweGroepSoort soort)
    {
        aanvraag.Soort = soort;
        Wis();
    }

    private void KiesBeheerder(Persoon? p)
    {
        aanvraag.Beheerder = p?.Sleutel ?? string.Empty;
        Wis();
    }

    private void VoegLidToe(ObjectRef r)
    {
        if (!aanvraag.Leden.Contains(r.Sleutel, StringComparer.OrdinalIgnoreCase))
        {
            aanvraag.Leden.Add(r.Sleutel);
        }

        Wis();
    }

    private void Leegmaken()
    {
        State.Paginastatus.Vergeet(Formulier);
        aanvraag = Bewaard();
        Wis();
    }

    private void MaakPlan()
    {
        var u = NieuweGroepPlannen.Plan(State.Data, State.Config, aanvraag);
        fouten = u.Fouten;
        plan = u.Plan.Count > 0 ? u.Plan : null;
    }

    private void NaUitvoeren(IReadOnlyList<WijzigingResultaat> resultaten)
    {
        if (resultaten.Any(r => r.Status == ResultaatStatus.Gelukt))
        {
            State.Paginastatus.Vergeet(Formulier);
        }
    }
}
