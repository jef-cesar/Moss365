@page "/postvak/{Smtp}"
@inherits RefreshingPage

@if (mailbox is null)
{
    <h1>@T["mailbox-detail.mailbox-not-found"]</h1>
    <p><a href="postvakken">@T["mailbox-detail.back-to-the-mailboxes"]</a></p>
}
else
{
    <h1>@mailbox.DisplayName <PlatformLabel Platform="Platform.ExchangeOnline" /></h1>
    <ObjectStatus Object="State.Data.Index.Ref(mailbox.Smtp)" />
    <p class="kb-zacht">
        @mailbox.TypeText &middot; @mailbox.Smtp
        @if (mailbox.Hidden) { <span class="kb-label">@T["room-detail.hidden-in-the-address-list"]</span> }
        @if (mailbox.Forwarding.Length > 0) { <span class="kb-label">@T.Format("mailbox-detail.forwarding-0", mailbox.Forwarding)</span> }
    </p>

    <section class="kb-kaart">
        <h2>@T["mailbox-detail.signing-in-with-the-account"]</h2>
        @if (State.Data.Index.AccountOf(mailbox.Smtp, mailbox.Alias) is not { } account)
        {
            <p class="kb-zacht">@T["mailbox-detail.the-account-of-this-mailbox"]</p>
        }
        else
        {
            <table class="kb-tabel kb-naast">
                <tbody>
                    <tr>
                        <th>@T["mailbox-detail.can-sign-in"]</th>
                        <td>
                            @if (account.Enabled)
                            {
                                <span class="kb-label kb-label-let">@T["mailbox-detail.yes"]</span> <span class="kb-zacht">@T["mailbox-detail.nobody-should-sign-in-with"]</span>
                            }
                            else
                            {
                                <span class="kb-label kb-label-goed">@T["mailbox-detail.no-blocked"]</span> <span class="kb-zacht">@T["mailbox-detail.the-mailbox-simply-works"]</span>
                            }
                        </td>
                    </tr>
                    <tr><th>@T["security.account"]</th><td><ObjectLink Object="State.Data.Index.Ref(account)" /> <span class="kb-zacht">@account.Source</span></td></tr>
                    <tr><th>@T["statistics.last-sign-in"]</th><td>@(Statistic.LastSignIn(account)?.ToString("dd/MM/yyyy HH:mm") ?? T["code.mailbox-detail.never-or-unknown"])</td></tr>
                </tbody>
            </table>
            <div class="kb-filters" hidden="@(!State.Can(Permission.Manage))">
                @if (account.Enabled)
                {
                    <button class="kb-knop kb-primair" @onclick="@(() => Plan(MailboxPlans.SignIn(State.Data, mailbox, false), "Aanmelden blokkeren"))">@T["mailbox-detail.block-sign-in"]</button>
                }
                else
                {
                    <button class="kb-knop" @onclick="@(() => Plan(MailboxPlans.SignIn(State.Data, mailbox, true), "Aanmelden toestaan"))">@T["mailbox-detail.allow-sign-in"]</button>
                }
            </div>
        }
    </section>

    <div class="kb-kolommen">
        <section class="kb-kaart">
            <h2>@T["mailbox-detail.access"]</h2>
            @if (groupValue is null)
            {
                <div class="kb-melding">@Html("mailbox-detail.nogroup", ObjectIndex.ExpectedAccessGroup(mailbox))</div>
                <div class="kb-filters">
                    <button class="kb-knop kb-primair" @onclick="@(() => Plan(MailboxPlans.CreateAccessGroup(State.Data, mailbox), "Toegangsgroep aanmaken"))">@T["mailbox-detail.create-access-group"]</button>
                </div>
            }
            else
            {
                <p>@T["mirror.via"] <ObjectLink Object="groupValue.Ref" /> @T.Format("mailbox-detail.0-members", groupMembers.Count)</p>
                <ul class="kb-lijst-plat">
                    @foreach (var l in groupMembers)
                    {
                        <li><ObjectLink Object="l.Object" />
                            <button class="kb-knop kb-klein" @onclick="@(() => Plan(GroupPlans.RemoveMember(State.Data, groupValue, l.Object), "Toegang intrekken"))">@T["group-detail.remove"]</button></li>
                    }
                </ul>
                <ObjectPicker Label="@T["code.mailbox-detail.give-access-to"]" Kinds="Persons" Selected="@(r => Plan(GroupPlans.AddMember(State.Data, groupValue, r), "Toegang geven"))" />
            }
        </section>

        <section class="kb-kaart">
            <h2>@T.Format("group-detail.member-of-0", groups.Count)</h2>
            @if (groups.Count == 0) { <p class="kb-zacht">@T["mailbox-detail.no-groups"]</p> }
            <ul class="kb-lijst-plat">
                @foreach (var g in groups)
                {
                    <li><ObjectLink Object="g.Object" /> <span class="kb-zacht">(@g.Layer)</span></li>
                }
            </ul>
        </section>
    </div>

    <section class="kb-kaart">
        <h2>@T.Format("mailbox-detail.permissions-0", permissions.Count)</h2>
        @if (permissions.Count == 0)
        {
            <p class="kb-zacht">@T["mailbox-detail.no-explicit-permissions-known"]</p>
        }
        else
        {
            <table class="kb-tabel">
                <thead><tr><th>@T["script-result.who"]</th><th>@T["nested-groups.kind"]</th><th>@T["room-detail.permission"]</th><th>@T["mailbox-detail.how"]</th></tr></thead>
                <tbody>
                    @foreach (var r in permissions)
                    {
                        <tr class="@(r.Direct ? "kb-verschil" : null)">
                            <td><ObjectLink Object="r.Who" /></td>
                            <td>@r.Who.KindText</td>
                            <td>@r.Permission</td>
                            <td>@(r.Direct ? T["user-detail.direct"] : T["mailbox-detail.viagroup"])</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (permissions.Any(r => r.Direct))
        {
            <p class="kb-zacht">
                @T["mailbox-detail.clean-up-whoever-has-a"]
            </p>
            <div class="kb-filters">
                <button class="kb-knop kb-primair" @onclick="@(() => Plan(MailboxPlans.CleanupDirectPermissions(State.Data, mailbox), "Rechtstreekse rechten naar de groep"))">@T["mailbox-detail.clean-up-direct-permissions"]</button>
            </div>
        }
    </section>

    @if (State.Can(Permission.Manage))
    {
    <section class="kb-kaart">
        <h2>@T["nav.settings"]</h2>
        @if (mailbox.AutoReply.Length == 0)
        {
            <p class="kb-zacht">@T["mailbox-detail.forwarding-and-automatic-reply-are"] <a href="verbindingen">@T["mailbox-detail.load-mailboxes-from-exchange"]</a></p>
        }
        <div class="kb-raster">
            <label>@T["edit-user.display-name"] <input class="kb-invoer" @bind="desired.DisplayName" /></label>
            <label>@T["bulk-tasks.hide-in-the-address-list"] <YesNo @bind-Value="desired.Hidden" /></label>
            <label>@T["mailbox-detail.forward-to-empty-off"] <input class="kb-invoer" placeholder="@(mailbox.ForwardingTo.Length > 0 ? mailbox.ForwardingTo : "(niet wijzigen)")" @bind="extra.Forwarding" /></label>
            <label>@T["mailbox-detail.also-keep-when-forwarding"] <YesNo @bind-Value="desired.SaveForwardingAnd" /></label>
            <label>@T["absence-card.automatic-reply"]
                <select class="kb-invoer" @bind="extra.AutoReply">
                    <option value="">@T["yesno.nochange"]</option>
                    <option value="Enabled">@T["mailbox-detail.on"]</option>
                    <option value="Disabled">@T["mailbox-detail.off"]</option>
                </select>
            </label>
        </div>
        <label><input type="checkbox" @bind="extra.DisableForwarding" /> @T["mailbox-detail.turn-off-forwarding"]</label>
        @if (extra.AutoReply == "Enabled")
        {
            <div class="kb-raster kb-breed-raster">
                <label>@T["mailbox-detail.internal-text"] <textarea class="kb-invoer" rows="3" @bind="desired.AutoReplyInternal"></textarea></label>
                <label>@T["mailbox-detail.external-text"] <textarea class="kb-invoer" rows="3" @bind="desired.AutoReplyExternal"></textarea></label>
            </div>
        }
        <div class="kb-filters">
            <button class="kb-knop kb-primair" @onclick="SettingsPlan">@T["bulk-tasks.make-plan"]</button>
        </div>
    </section>
    }

    @foreach (var f in errors)
    {
        <div class="kb-melding kb-fout">@f</div>
    }
    @if (plan is not null)
    {
        <PlanView Plan="plan" Context="@($"Postvak {mailbox.DisplayName}")" Title="@planTitle" Executed="AfterExecute" />
    }
}

@code {
    [Parameter] public string Smtp { get; set; } = string.Empty;

    private static readonly ObjectKind[] Persons = { ObjectKind.User };

    private Mailbox? mailbox;
    private Group? groupValue;
    private IReadOnlyList<Relation> groupMembers = Array.Empty<Relation>();
    private IReadOnlyList<Relation> groups = Array.Empty<Relation>();
    private IReadOnlyList<PermissionRule> permissions = Array.Empty<PermissionRule>();
    private MailboxDesired desired = new();
    // What you filled in is kept per mailbox until the plan has run (Back, Forward, menu)
    private sealed class Extra { public string? Forwarding { get; set; } public bool DisableForwarding { get; set; } public string AutoReply { get; set; } = string.Empty; }
    private Extra extra = new();
    private string Form => $"postvakken/{loaded}/wijzigen";
    private IReadOnlyList<Change>? plan;
    private IReadOnlyList<string> errors = Array.Empty<string>();
    private string planTitle = string.Empty;
    private string? loaded;

    protected override void OnParametersSet()
    {
        var index = State.Data.Index;
        var newValue = index.Mailbox(Smtp);
        if (newValue?.Smtp != loaded)
        {
            loaded = newValue?.Smtp;
            plan = null;
            errors = Array.Empty<string>();
            desired = newValue is null ? new() : State.PageState.Form(Form, "postvak/" + newValue.Smtp, $"Postvak {newValue.DisplayName}", () => new MailboxDesired
            {
                DisplayName = newValue.DisplayName,
                AutoReplyInternal = newValue.AutoReplyInternal,
                AutoReplyExternal = newValue.AutoReplyExternal,
            });
            extra = newValue is null ? new() : State.PageState.Form<Extra>(Form + "/extra", "postvak/" + newValue.Smtp, $"Postvak {newValue.DisplayName}");
        }

        mailbox = newValue;
        if (mailbox is not null)
        {
            groupValue = index.AccessGroupOf(mailbox);
            groupMembers = groupValue is null ? Array.Empty<Relation>() : index.UniqueMembersOf(groupValue);
            groups = index.GroupsOfAddress(mailbox.Smtp);
            permissions = index.PermissionsOn(mailbox);
        }
    }

    private void AfterExecute(IReadOnlyList<ChangeResult> results)
    {
        if (results.Any(r => r.Status == ResultStatus.Succeeded))
        {
            State.PageState.Forget(Form);
            State.PageState.Forget(Form + "/extra");
        }
    }

    private void SettingsPlan()
    {
        desired.ForwardingTo = extra.DisableForwarding ? string.Empty : string.IsNullOrWhiteSpace(extra.Forwarding) ? null : extra.Forwarding;
        desired.AutoReply = extra.AutoReply.Length == 0 ? null : extra.AutoReply;
        Plan(MailboxPlans.Settings(mailbox!, desired), T["code.mailbox-detail.settings-of-the-mailbox"]);
    }

    private void Plan(PlanOutcome u, string title)
    {
        planTitle = title;
        errors = u.Errors;
        plan = u.Plan.Count > 0 || u.Errors.Count == 0 ? u.Plan : null;
    }
}
