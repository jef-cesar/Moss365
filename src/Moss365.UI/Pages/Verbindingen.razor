@page "/verbindingen"
@implements IDisposable
@inject BeheerState State

<h1>Verbindingen</h1>

<WeggaanBevestigen Actief="State.InstellingenGewijzigd" Bewaren="Bewaar" Verwerpen="State.VerwerpInstellingen"
                   Tekst="Je hebt de verbindingsinstellingen aangepast maar nog niet bewaard. Het AD-wachtwoord wordt nooit bewaard." />

<p class="kb-zacht">
    Met deze gegevens leest de app live uit AD, Entra en Exchange, en voert hij goedgekeurde wijzigingen uit.
    Wachtwoorden worden nooit bewaard. De instellingen staan in de databank <code>@State.Databank.Pad</code>.
</p>

@if (!State.KanVerbinden)
{
    <div class="kb-melding">Live verbinden is enkel beschikbaar in de Windows-app.</div>
}

<section class="kb-kaart">
    <h2>On-prem AD</h2>
    <div class="kb-rij">
        <label>Domeincontroller</label>
        <input class="kb-invoer kb-breed" placeholder="naam of IP-adres, bv. 10.103.17.3" @bind="State.Instellingen.AdServer" />
    </div>
    <div class="kb-rij">
        <label>AD-account</label>
        <input class="kb-invoer kb-breed" placeholder="bv. CONTOSO\naam (leeg = Windows-aanmelding, enkel op een domein-pc)" @bind="State.Instellingen.AdGebruiker" />
    </div>
    <div class="kb-rij">
        <label>Wachtwoord</label>
        <input class="kb-invoer" type="password" autocomplete="off" @bind="State.AdWachtwoord" />
        <span class="kb-zacht">alleen voor deze sessie</span>
    </div>
    <p class="kb-zacht">
        De app praat via LDAP (ondertekend en versleuteld) met de domeincontroller. Voor wijzigingen heeft het account rechten nodig
        op de OU's en groepen; om te lezen volstaan gewone leesrechten.
    </p>
</section>

<section class="kb-kaart">
    <h2>Entra ID en Exchange Online</h2>
    <div class="kb-rij">
        <label>Tenant ID</label>
        <input class="kb-invoer kb-breed" @bind="State.Instellingen.TenantId" />
    </div>
    <div class="kb-rij">
        <label>Client ID</label>
        <input class="kb-invoer kb-breed" placeholder="Application (client) ID van de app-registratie" @bind="State.Instellingen.ClientId" />
    </div>
    <div class="kb-rij">
        <label>Beheeraccount</label>
        <input class="kb-invoer kb-breed" placeholder="bv. naam@contoso.com" @bind="State.Instellingen.BeheerUpn" />
    </div>
    <p class="kb-zacht">
        Tenant ID en Client ID krijg je met <code>Registreer-App.ps1</code> (eenmalig, als Global Administrator). Dat maakt de
        app-registratie "Moss365" aan met enkel gedelegeerde rechten en alleen toegewezen beheerders.
        Bij de eerste actie verschijnt bovenaan een aanmeldlink: kopieer hem naar de browser van je keuze. Exchange gebruikt
        dezelfde aanmelding (module ExchangeOnlineManagement nodig).
    </p>
</section>

<div class="kb-filters">
    <button class="kb-knop" @onclick="Bewaar">Instellingen bewaren</button>
    <button class="kb-knop kb-primair" disabled="@(State.TaakBezig || !State.KanVerbinden)" @onclick="() => Laad(LaadSoort.Alles)">Alles live laden</button>
    <button class="kb-knop" disabled="@(State.TaakBezig || !State.KanVerbinden)" @onclick="() => Laad(LaadSoort.AdEnEntra)">Live laden (AD en Entra)</button>
    <button class="kb-knop" disabled="@(State.TaakBezig || !State.KanVerbinden)" @onclick="() => Laad(LaadSoort.Rooms)">Rooms laden uit Exchange</button>
    <button class="kb-knop" disabled="@(State.TaakBezig || !State.KanVerbinden)" @onclick="() => Laad(LaadSoort.Postvakken)">Postvakken en groepen laden uit Exchange</button>
    @if (melding is not null) { <span class="kb-ok">@melding</span> }
</div>
<p class="kb-zacht">Het laden loopt op de achtergrond: je kan intussen andere schermen gebruiken. Onderaan het menu zie je de status. Na het laden bewaart de app de gegevens als inventaris, zodat hij de volgende keer al met recente gegevens start.</p>
<label>
    <input type="checkbox" @bind="State.Instellingen.AutoVernieuwen" @bind:after="State.BewaarInstellingen" />
    Elke 15 minuten vernieuwen (AD en Entra) zolang de app open is
    <span class="kb-zacht">(enkel als je aangemeld bent; er verschijnt nooit vanzelf een aanmeldlink)</span>
</label>
<label>
    <input type="checkbox" @bind="State.Instellingen.SnelLaden" @bind:after="State.BewaarInstellingen" />
    Snel laden: enkel wat veranderde sinds de vorige keer
    <span class="kb-zacht">
        (AD: @(State.AdKanSnel ? "kan" : "volgende keer alles"); Entra-groepen: @(State.EntraKanSnel ? "kan" : "volgende keer alles").
        Gebruikers in Entra en Exchange lezen altijd alles; minstens één keer per week leest de app alles.)
    </span>
</label>
@if (State.Fout is not null) { <div class="kb-melding kb-fout">@State.Fout</div> }
@if (State.ExchangeMelding is { } exo) { <div class="kb-melding">@exo</div> }

<TaakVoortgang />

<section class="kb-kaart">
    <h2>Huidige gegevens</h2>
    <p>Aangemeld als: @State.Gebruiker</p>
    <ul class="kb-lijst-plat">
        @foreach (var deel in new[] { "AD", "Entra", "Rooms", "Postvakken" })
        {
            <li><strong>@deel</strong>: @(State.LiveOp.TryGetValue(deel, out var t) ? $"live geladen om {t:HH:mm}" : "uit de inventaris")</li>
        }
        @if (State.BewaardeInventaris is { } map) { <li class="kb-zacht">Laatst bewaard als inventaris: @System.IO.Path.GetFileName(map)</li> }
    </ul>
    <table class="kb-tabel">
        <thead><tr><th>Bron</th><th>Uit</th><th class="kb-getal">Rijen</th></tr></thead>
        <tbody>
            @foreach (var b in State.Data.Bronnen)
            {
                <tr><td>@b.Bestand</td><td>@(b.Map is null ? "niet gevonden" : System.IO.Path.GetFileName(b.Map))</td><td class="kb-getal">@b.Rijen</td></tr>
            }
        </tbody>
    </table>
</section>

@code {
    private string? melding;

    protected override void OnInitialized() => State.Gewijzigd += Ververs;

    private void Ververs() => _ = InvokeAsync(StateHasChanged);

    // Na elke aanpassing in een veld: de aanduiding bovenaan en in het menu bijwerken
    private bool vorigGewijzigd;

    protected override void OnAfterRender(bool firstRender)
    {
        if (State.InstellingenGewijzigd != vorigGewijzigd)
        {
            vorigGewijzigd = State.InstellingenGewijzigd;
            State.Openstaand.Ververs();
        }
    }

    public void Dispose() => State.Gewijzigd -= Ververs;

    private void Bewaar()
    {
        State.BewaarInstellingen();
        melding = "Bewaard (zonder wachtwoord).";
    }

    private void Laad(LaadSoort soort)
    {
        State.BewaarInstellingen();
        melding = State.StartLaden(soort) ? null : State.TaakBezig ? "Er loopt al een taak." : null;
    }
}
