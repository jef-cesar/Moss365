@page "/databank"
@layout SettingsLayout
@using Moss365.Core.Storage
@* The database of the open tenant (R6): how big each part is, how long it is kept, and cleaning up with a preview first.
   The change log and the access log go to a CSV before anything is removed. *@
@inherits RefreshingPage

<h1>@T["database-maintenance.database"]</h1>

<p class="kb-zacht">
    @Html("database.intro", State.Tenant.Name, $"tenants\\{State.Tenant.Id}\\tenant.db", Size(State.Database.FileSize))
</p>

<section class="kb-kaart">
    <h2>@T["database-maintenance.size-per-part"]</h2>
    <table class="kb-tabel">
        <thead><tr><th>@T["database-maintenance.part"]</th><th>@T["start.rows"]</th><th>@T["database-maintenance.content"]</th></tr></thead>
        <tbody>
            @foreach (var p in sizes)
            {
                <tr><td>@p.Part</td><td>@p.Rows</td><td>@Size(p.Bytes)</td></tr>
            }
        </tbody>
    </table>
    <div class="kb-rij">
        <button class="kb-knop" disabled="@busy" @onclick="Check">@T["database-maintenance.check-integrity"]</button>
        <button class="kb-knop" disabled="@busy" @onclick="Compact">@T["database-maintenance.compact"]</button>
        @if (checkResult is not null)
        {
            <span class="@(checkResult == "ok" ? "kb-ok" : "kb-waarschuwing")">@(checkResult == "ok" ? T["code.database-maintenance.the-database-is-in-order"] : (T["code.database-maintenance.problems"] + " ") + checkResult)</span>
        }
        @if (compacted is not null) { <span class="kb-ok">@compacted</span> }
    </div>
    <p class="kb-zacht">
        @T.Format("database-maintenance.copies", State.Database.MigrationCopies().Count, Size(State.Database.MigrationCopies().Sum(f => f.Length)))
    </p>
</section>

<EncryptionPanel />

<section class="kb-kaart">
    <h2>@T["database-maintenance.retention-periods"]</h2>
    <p class="kb-zacht">@T["database-maintenance.default-choice-u9-snapshots-daily"]</p>
    <div class="kb-formulier">
        <label>@T["database-maintenance.change-log-years"] <input type="number" min="1" class="kb-invoer" @bind="State.Config.ChangeLogSaveYears" @bind:after="Modified" /></label>
        <label>@T["database-maintenance.daily-snapshots-days"] <input type="number" min="1" class="kb-invoer" @bind="State.Config.Retention.SnapshotsDailyDays" @bind:after="Modified" /></label>
        <label>@T["database-maintenance.access-log-years"] <input type="number" min="1" class="kb-invoer" @bind="State.Config.Retention.AccessLogYears" @bind:after="Modified" /></label>
        <label>@T["database-maintenance.technical-log-days"] <input type="number" min="1" class="kb-invoer" @bind="State.Config.Retention.TechnicalLogDays" @bind:after="Modified" /></label>
        <label>@T["database-maintenance.script-runs-days"] <input type="number" min="1" class="kb-invoer" @bind="State.Config.Retention.ScriptRunDays" @bind:after="Modified" /></label>
        <label>@T["database-maintenance.copies-before-an-update-days"] <input type="number" min="1" class="kb-invoer" @bind="State.Config.Retention.MigrationCopyDays" @bind:after="Modified" /></label>
        <label>@T["local-logs.days"] <input type="number" min="1" class="kb-invoer" @bind="State.Config.Retention.LocalLogDays" @bind:after="Modified" /></label>
    </div>
    <p><label><input type="checkbox" @bind="State.Config.Retention.KeepLocalLogs" @bind:after="Modified" /> @T["local-logs.keep"]</label></p>
    <p class="kb-zacht">@T["local-logs.keep.help"]</p>
    <button class="kb-knop kb-primair" disabled="@(!modified)" @onclick="SaveRetention">@T["action.save"]</button>
    @if (saved) { <span class="kb-ok">@T["database-maintenance.saved"]</span> }
</section>

<section class="kb-kaart">
    <h2>@T["database-maintenance.clean-up"]</h2>
    @if (State.IsHistoric)
    {
        <div class="kb-melding">@T["database-maintenance.you-are-looking-at-a"]</div>
    }
    else
    {
        <table class="kb-tabel">
            <thead><tr><th></th><th>@T["database-maintenance.part"]</th><th>@T["database-maintenance.to-remove"]</th><th>@T["service-health-card.what"]</th></tr></thead>
            <tbody>
                @foreach (var i in preview)
                {
                    <tr>
                        <td>
                            @if (i.Count > 0)
                            {
                                <input type="checkbox" aria-label="@PartText(i.Part)" checked="@chosen.Contains(i.Part)" @onchange="e => Toggle(i.Part, e.Value is true)" />
                            }
                        </td>
                        <td>@PartText(i.Part)</td>
                        <td>@(i.Count == 0 ? "niets" : i.Count.ToString())</td>
                        <td>@i.Explanation</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (preview.All(i => i.Count == 0))
        {
            <p class="kb-ok">@T["database-maintenance.nothing-is-older-than-the"]</p>
        }
        else if (confirm)
        {
            <div class="kb-rij">
                <span>@Html("database.confirm", chosen.Count, State.Tenant.Name)</span>
                <button class="kb-knop kb-gevaar" disabled="@busy" @onclick="Clean">@T.Format("database.yes", State.Tenant.Name)</button>
                <button class="kb-knop" @onclick="() => confirm = false">@T["action.cancel"]</button>
            </div>
        }
        else
        {
            <button class="kb-knop kb-primair" disabled="@(chosen.Count == 0 || busy)" @onclick="() => confirm = true">@T.Format("database-maintenance.clean-up-0", chosen.Count)</button>
        }
        @if (results is not null)
        {
            <ul>
                @foreach (var r in results)
                {
                    <li>@(r.Archive is { } a ? T.Format("database-maintenance.removed.archive", PartText(r.Part), r.Removed, a) : T.Format("database-maintenance.removed", PartText(r.Part), r.Removed))</li>
                }
            </ul>
        }
    }
</section>

@code {
    private IReadOnlyList<PartSize> sizes = Array.Empty<PartSize>();
    private IReadOnlyList<CleanupItem> preview = Array.Empty<CleanupItem>();
    private readonly HashSet<CleanupPart> chosen = new();
    private IReadOnlyList<CleanupResult>? results;
    private bool confirm;
    private bool busy;
    private bool modified;
    private bool saved;
    private string? checkResult;
    private string? compacted;

    protected override void OnParametersSet() => Recompute();

    private void Recompute()
    {
        sizes = State.Database.Sizes();
        preview = State.CleanupPreview(DateTimeOffset.Now);
        chosen.RemoveWhere(p => preview.Any(i => i.Part == p && i.Count == 0));
    }

    private void Modified()
    {
        modified = true;
        saved = false;
    }

    private void SaveRetention()
    {
        State.SaveConfig();
        modified = false;
        saved = true;
        Recompute();
    }

    private void Toggle(CleanupPart part, bool on)
    {
        if (on) { chosen.Add(part); } else { chosen.Remove(part); }
        confirm = false;
    }

    private void Clean()
    {
        busy = true;
        try
        {
            results = State.Cleanup(chosen.ToList(), DateTimeOffset.Now);
            chosen.Clear();
        }
        finally
        {
            busy = false;
            confirm = false;
        }

        Recompute();
    }

    private void Check() => checkResult = State.IntegrityCheck();

    private void Compact()
    {
        var before = State.Database.FileSize;
        State.Compact();
        compacted = $"Gecomprimeerd: {Size(before)} → {Size(State.Database.FileSize)}.";
        Recompute();
    }

    private static string PartText(CleanupPart p) => p switch
    {
        CleanupPart.Snapshots => T["organisation-history.snapshots"],
        CleanupPart.ChangeLog => T["menu.logboek"],
        CleanupPart.AccessLog => T["change-log.access-log"],
        CleanupPart.TechnicalLog => T["word.technical-log"],
        CleanupPart.ScriptRuns => T["word.script-runs"],
        CleanupPart.LocalLogs => T["maintenance.part.local-logs"],
        _ => T["code.database-maintenance.copies-before-an-update"],
    };

    private static string Size(long bytes)
    {
        const double K = 1024;
        if (bytes < K) { return $"{bytes} B"; }
        if (bytes < K * K) { return $"{bytes / K:0.#} kB"; }
        return bytes < K * K * K ? $"{bytes / K / K:0.#} MB" : $"{bytes / K / K / K:0.##} GB";
    }
}
