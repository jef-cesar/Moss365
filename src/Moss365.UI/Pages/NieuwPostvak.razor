@page "/postvakken/nieuw"
@inject BeheerState State

<h1>Nieuw gedeeld postvak</h1>

<p class="kb-zacht">
    Het plan maakt het postvak aan (zonder licentie), dan de toegangsgroep <code>SG-SM-&lt;adres&gt;-Full</code>, geeft die groep
    FullAccess en SendAs en maakt de gekozen mensen lid. Lukt een stap niet, dan worden de stappen die erop wachten overgeslagen.
</p>

<section class="kb-kaart">
    <h2>Gegevens</h2>
    <div class="kb-raster">
        <label>Weergavenaam <input class="kb-invoer" placeholder="bv. Jeugddienst" @bind="aanvraag.Weergavenaam" @bind:after="Wis" /></label>
        <label>Adres (voor de @@) <input class="kb-invoer" placeholder="bv. jeugddienst" @bind="aanvraag.LokaalDeel" @bind:after="Wis" /></label>
        <label>Domein
            <select class="kb-invoer" @bind="aanvraag.Domein" @bind:after="Wis">
                @foreach (var d in Domeinen)
                {
                    <option value="@d">@d</option>
                }
            </select>
        </label>
    </div>
    @if (aanvraag.LokaalDeel.Trim().Length > 0)
    {
        <p class="kb-zacht">Adres <strong>@($"{aanvraag.LokaalDeel.Trim().ToLowerInvariant()}@{aanvraag.Domein}")</strong>, toegangsgroep <strong>@($"SG-SM-{aanvraag.LokaalDeel.Trim().ToLowerInvariant()}-Full")</strong>.</p>
    }

    <ObjectKiezer Label="Wie krijgt toegang?" Soorten="Personen" Gekozen="VoegToe" />
    @if (aanvraag.Leden.Count > 0)
    {
        <ul class="kb-lijst">
            @foreach (var l in aanvraag.Leden)
            {
                <li>@l.Naam <button class="kb-knop kb-klein" @onclick="() => { aanvraag.Leden.Remove(l); Wis(); }" aria-label="@($"{l.Naam} weghalen")">&times;</button></li>
            }
        </ul>
    }

    <div class="kb-filters">
        <button class="kb-knop kb-primair" @onclick="MaakPlan">Plan maken</button>
    </div>
</section>

@foreach (var f in fouten)
{
    <div class="kb-melding kb-fout">@f</div>
}
@if (plan is not null)
{
    <PlanWeergave Plan="plan" Context="@($"Nieuw gedeeld postvak {aanvraag.LokaalDeel}")" Titel="Nieuw gedeeld postvak" />
}

@code {
    private static readonly ObjectSoort[] Personen = { ObjectSoort.Gebruiker };

    private readonly NieuwPostvakAanvraag aanvraag = new();
    private IReadOnlyList<Wijziging>? plan;
    private IReadOnlyList<string> fouten = Array.Empty<string>();

    /// <summary>Domeinen van de bestaande gedeelde postvakken en van de populaties, meest gebruikte eerst.</summary>
    private IReadOnlyList<string> Domeinen
    {
        get
        {
            var uitPostvakken = State.Data.Postvakken.Where(p => p.IsGedeeld && p.Smtp.Contains('@'))
                .Select(p => p.Smtp[(p.Smtp.IndexOf('@') + 1)..].ToLowerInvariant());
            var uitConfig = State.Config.Populaties.Select(p => p.UpnDomein.ToLowerInvariant()).Where(d => d.Length > 0);
            var lijst = uitPostvakken.Concat(uitConfig).GroupBy(d => d).OrderByDescending(g => g.Count()).Select(g => g.Key).ToList();
            return lijst.Count > 0 ? lijst : new[] { "contoso.com" };
        }
    }

    protected override void OnInitialized() => aanvraag.Domein = Domeinen[0];

    private void VoegToe(ObjectRef r)
    {
        if (!aanvraag.Leden.Any(l => l.IsZelfde(r)))
        {
            aanvraag.Leden.Add(r);
        }

        Wis();
    }

    private void Wis()
    {
        plan = null;
        fouten = Array.Empty<string>();
    }

    private void MaakPlan()
    {
        var u = PostvakPlannen.NieuwPostvak(State.Data, aanvraag);
        fouten = u.Fouten;
        plan = u.Plan.Count > 0 ? u.Plan : null;
    }
}
