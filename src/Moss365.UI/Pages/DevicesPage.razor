@page "/toestellen"
@inherits RefreshingPage
@using Moss365.Core.Devices
@* Devices (R13, 0.36): computers in AD (no longer signed in, systems, OU) and devices in Intune (not compliant,
   not seen). Disabling stale computers is a plan; nothing is deleted. *@

<h1>@T["menu.toestellen"]</h1>

<p class="kb-zacht">
    @T["devices.computers-in-ad-that-no"]
</p>

<button class="kb-knop kb-primair" disabled="@(busy || State.IsHistoric)" @onclick="Read">@(busy ? T["code.collaboration.reading"] : T["code.devices.read-devices"])</button>
@if (State.DevicesNote is { } note)
{
    <div class="kb-melding">@note</div>
}

@if (State.AdComputers is { } computers)
{
    <section class="kb-kaart">
        <h2>@T.Format("devices.computers-in-ad", computers.Count(c => c.Enabled)) <PlatformLabel Platform="Platform.ActiveDirectory" /></h2>
        <div class="kb-kolommen">
            <div>
                <h3>@T["devices.systems"]</h3>
                <table class="kb-tabel">
                    <thead><tr><th>@T["plan.system"]</th><th class="kb-getal">@T["suggestions-panel.number"]</th></tr></thead>
                    <tbody>
                        @foreach (var (system, count) in DeviceAnalysis.Systems(computers))
                        {
                            <tr><td>@system @SupportLabel(system, string.Empty)</td><td class="kb-getal">@count</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div>
                <h3>@T["devices.per-ou"]</h3>
                <table class="kb-tabel">
                    <thead><tr><th>@T["devices.ou"]</th><th class="kb-getal">@T["suggestions-panel.number"]</th></tr></thead>
                    <tbody>
                        @foreach (var g in computers.Where(c => c.Enabled).GroupBy(c => c.OuPath).OrderByDescending(g => g.Count()).Take(20))
                        {
                            <tr><td>@(g.Key.Length > 0 ? g.Key : "(container Computers)")</td><td class="kb-getal">@g.Count()</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <h3>@T["devices.no-longer-signed-in"]</h3>
        <label>@T["devices.longer"] <input class="kb-invoer kb-smal" type="number" min="30" max="730" @bind="days" aria-label="@T["devices.longer"]" /></label>
        <table class="kb-tabel">
            <thead><tr><th></th><th>@T["devices.computer"]</th><th>@T["plan.system"]</th><th>@T["devices.ou"]</th><th>@T["devices.last-signed-in"]</th></tr></thead>
            <tbody>
                @foreach (var c in Stale)
                {
                    <tr>
                        <td><input type="checkbox" checked="@chosen.Contains(c.DistinguishedName)" aria-label="@c.Name" @onchange="e => Toggle(c.DistinguishedName, e.Value is true)" /></td>
                        <td>@c.Name</td><td>@c.OperatingSystem</td><td class="kb-zacht">@c.OuPath</td>
                        <td>@(c.LastLogon?.LocalDateTime.ToString("dd/MM/yyyy") ?? T["word.never"])</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (State.Can(Permission.Manage) && !State.IsHistoric)
        {
            <button class="kb-knop" disabled="@(chosen.Count == 0)" @onclick="MakePlan">@T.Format("devices.disable-computers-0", chosen.Count)</button>
        }
    </section>
}

@if (State.IntuneDevices is { } devices)
{
    <section class="kb-kaart">
        <h2>@T.Format("devices.devices-in-intune-0", devices.Count) <PlatformLabel Platform="Platform.Intune" /></h2>
        <div class="kb-kolommen">
            <div>
                <h3>@T.Format("devices.not-compliant-0", DeviceAnalysis.NotCompliant(devices).Count)</h3>
                @DeviceTable(DeviceAnalysis.NotCompliant(devices))
            </div>
            <div>
                <h3>@T.Format("devices.not-seen-in-30-days", DeviceAnalysis.NotSeen(devices, DateTimeOffset.Now).Count)</h3>
                @DeviceTable(DeviceAnalysis.NotSeen(devices, DateTimeOffset.Now))
            </div>
        </div>
        <h3>@T["devices.systems"]</h3>
        <table class="kb-tabel">
            <thead><tr><th>@T["plan.system"]</th><th>@T["update-panel.version"]</th><th class="kb-getal">@T["suggestions-panel.number"]</th></tr></thead>
            <tbody>
                @foreach (var g in devices.GroupBy(d => (d.OperatingSystem, d.Version)).OrderByDescending(g => g.Count()).Take(25))
                {
                    <tr><td>@g.Key.OperatingSystem @SupportLabel(g.Key.OperatingSystem, g.Key.Version)</td><td>@g.Key.Version</td><td class="kb-getal">@g.Count()</td></tr>
                }
            </tbody>
        </table>
    </section>
}

@if (State.HasMicrosoft365 && (State.IntuneDevices is not null || State.Compliance is not null))
{
    <ComplianceCard />
}

@if (State.AdComputers is not null || State.IntuneDevices is not null || State.EntraDevices is not null)
{
    var list = State.DeviceList;
    <section class="kb-kaart" id="een-lijst">
        <h2>@T.Format("devices.combined", list.Count)</h2>
        <p class="kb-zacht">@T["devices.combined.help"]</p>
        <div class="kb-filters">
            <button class="kb-knop kb-klein" aria-pressed="@(finding is null ? "true" : "false")" @onclick="() => finding = null">@T["devices.combined.all"]</button>
            @foreach (var f in DeviceAnalysis.Findings)
            {
                var n = list.Count(r => r.Findings.Contains(f));
                @if (n > 0)
                {
                    <button class="kb-knop kb-klein" aria-pressed="@(finding == f ? "true" : "false")" @onclick="() => finding = f">@FindingText(f) (@n)</button>
                }
            }
        </div>
        <table class="kb-tabel">
            <thead><tr><th>@T["keys.device"]</th><th>@T["devices.col.ad"]</th><th>@T["devices.col.entra"]</th><th>@T["devices.col.intune"]</th><th>@T["keys.last-seen"]</th><th>@T["devices.col.points"]</th></tr></thead>
            <tbody>
                @foreach (var r in list.Where(r => finding is null || r.Findings.Contains(finding)).Take(200))
                {
                    <tr>
                        <td><button class="kb-knop kb-klein" aria-label="@T.Format("device.open", r.Name)" @onclick="() => Select(r)">@r.Name</button></td>
                        <td>@(r.Ad is null ? string.Empty : r.Ad.Enabled ? "✓" : T["device.disabled"])</td>
                        <td>@(r.Entra is null ? string.Empty : TrustText(r.Entra.TrustType))</td>
                        <td>@(r.Intune?.Compliance ?? string.Empty)</td>
                        <td>@(r.LastSeen?.LocalDateTime.ToString("dd/MM/yyyy") ?? T["word.never"])</td>
                        <td>@string.Join(", ", r.Findings.Select(FindingText))</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@if (selected is { } sel)
{
    <section class="kb-kaart" id="toestel">
        <h2>@sel.Name</h2>
        <table class="kb-tabel kb-naast">
            <tbody>
                @if (sel.Intune is { } i)
                {
                    <tr><th>@T["sign-in-list.user"]</th><td>@i.Owner</td></tr>
                    <tr><th>@T["plan.system"]</th><td>@i.OperatingSystem @i.Version @SupportLabel(i.OperatingSystem, i.Version)</td></tr>
                    <tr><th>@T["device.info.compliance"]</th><td>@i.Compliance</td></tr>
                    <tr><th>@T["device.info.ownership"]</th><td>@(i.Personal ? T["device.info.personal"] : T["device.info.company"])</td></tr>
                    <tr><th>@T["device.info.model"]</th><td>@i.Manufacturer @i.Model</td></tr>
                    <tr><th>@T["device.info.serial"]</th><td>@i.Serial</td></tr>
                    <tr><th>@T["device.info.encrypted"]</th><td>@(i.Encrypted is null ? T["word.unknown"] : i.Encrypted.Value ? T["device.info.yes"] : T["device.info.no"])</td></tr>
                    <tr><th>@T["device.info.enrolled"]</th><td>@i.Enrolled?.LocalDateTime.ToString("dd/MM/yyyy")</td></tr>
                    <tr><th>@T["keys.last-seen"]</th><td>@i.LastSync?.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td></tr>
                }
                @if (sel.Ad is { } c)
                {
                    <tr><th>@T["devices.col.ad"]</th><td>@c.OuPath · @(c.LastLogon?.LocalDateTime.ToString("dd/MM/yyyy") ?? T["word.never"])</td></tr>
                }
                @if (sel.Entra is { } e)
                {
                    <tr><th>@T["devices.col.entra"]</th><td>@TrustText(e.TrustType) · @(e.LastSignIn?.LocalDateTime.ToString("dd/MM/yyyy") ?? T["word.never"])</td></tr>
                }
            </tbody>
        </table>
        @if (sel.Ad is { } adComputer)
        {
            <ComputerEditor Computer="adComputer" />
        }
        @if (sel.Intune is { } compliance)
        {
            <h3>@T["device.compliance"]</h3>
            @if (ComplianceAnalysis.FailedBy(State.Compliance, sel.Name) is { Count: > 0 } failed)
            {
                <p>@T.Format("device.compliance.fails", string.Join(", ", failed.Select(p => p.Name)))</p>
            }
            else if (State.Compliance is not null)
            {
                <p class="kb-zacht">@T["device.compliance.no-failing-policy"]</p>
            }
            @if (!State.IsHistoric && State.Can(Permission.Helpdesk))
            {
                <button class="kb-knop kb-klein" disabled="@readingCompliance" @onclick="() => ReadCompliance(compliance)">@T["device.compliance.read"]</button>
            }
            @if (complianceNote is { } cn)
            {
                <p class="kb-zacht">@cn</p>
            }
            @if (deviceCompliance is { } states)
            {
                <table class="kb-tabel" id="toestel-naleving">
                    <thead><tr><th>@T["compliance.policy"]</th><th>@T["compliance.status"]</th><th>@T["device.compliance.failing-settings"]</th></tr></thead>
                    <tbody>
                        @foreach (var st in states)
                        {
                            <tr><td>@st.Policy</td><td>@st.State</td><td>@(st.Failing.Count == 0 ? "-" : string.Join(", ", st.Failing.Select(f => f.Setting)))</td></tr>
                        }
                    </tbody>
                </table>
            }
        }
        @if (!State.IsHistoric && State.Can(Permission.Helpdesk) && (sel.Entra is not null || sel.Ad is not null))
        {
            <p><a href="@($"sleutels?toestel={Uri.EscapeDataString(sel.Name)}")">@T["device.keys-link"]</a> <span class="kb-zacht">@T["device.keys-link.help"]</span></p>
        }
        @if (sel.Intune is { } device && !State.IsHistoric)
        {
            <h3>@T["device.actions"]</h3>
            @if (State.Can(Permission.Helpdesk))
            {
                <div class="kb-filters">
                    @foreach (var a in DevicePlans.Actions.Where(a => a.Level == DeviceActionLevel.Safe))
                    {
                        <button class="kb-knop kb-klein" disabled="@(!DevicePlans.Fits(device, a))" @onclick="() => DeviceAction(device, a.Key)">@T[$"device.button.{a.Key}"]</button>
                    }
                </div>
            }
            @if (State.Can(Permission.Manage))
            {
                <div class="kb-filters">
                    <label>@T["device.new-name"] <input class="kb-invoer kb-smal" @bind="newName" @bind:event="oninput" aria-label="@T["device.new-name"]" /></label>
                    <button class="kb-knop kb-klein" @onclick='() => DeviceAction(device, "rename")'>@T["device.button.rename"]</button>
                    <button class="kb-knop kb-klein" @onclick='() => DeviceAction(device, "retire")'>@T["device.button.retire"]</button>
                </div>
                <PersonPicker Label="@T["device.new-primary-user"]" Selected="null" SelectedChanged="p => PrimaryUser(device, p)" />
                @if (device.Personal)
                {
                    <p class="kb-zacht">@T["device.personal-only-retire"]</p>
                }
                else
                {
                    <div class="kb-melding">
                        <p>@T["device.destructive.help"]</p>
                        <label>@T["device.type-name"] <input class="kb-invoer kb-smal" @bind="typedName" @bind:event="oninput" aria-label="@T["device.type-name"]" /></label>
                        @foreach (var a in DevicePlans.Actions.Where(a => a.Level == DeviceActionLevel.Destructive && DevicePlans.Fits(device, a)))
                        {
                            <button class="kb-knop kb-klein kb-gevaar" disabled="@(!string.Equals(typedName.Trim(), device.Name, StringComparison.OrdinalIgnoreCase))" @onclick="() => DeviceAction(device, a.Key)">@T[$"device.button.{a.Key}"]</button>
                        }
                    </div>
                }
            }
            @if (deviceOutcome is not null)
            {
                @foreach (var err in deviceOutcome.Errors) { <div class="kb-melding kb-fout">@err</div> }
                @if (deviceOutcome.Plan.Count > 0)
                {
                    <PlanView Plan="deviceOutcome.Plan" Context="@T.Format("device.context", device.Name)" Title="@T["device.actions"]" />
                }
            }
        }
    </section>
}

@if (outcome is not null && outcome.Plan.Count > 0)
{
    <PlanView Plan="outcome.Plan" Context="@T["devices.old-computers"]" Title="@T["devices.disable-computers"]" />
}

@if (State.EntraDevices is not null || State.IntuneDevices is not null)
{
    <DeviceCleanupCard />
}

@code {
    // The life cycle data (R17): no longer supported, or support that ends within half a year
    private RenderFragment SupportLabel(string os, string version)
    {
        var support = Lifecycle.Of(os, version, DateTimeOffset.Now);
        return support.Status switch
        {
            SupportStatus.Ended => @<span class="kb-label kb-fout">@T["devices.no-longer-supported"]</span>,
            SupportStatus.EndingSoon => @<span class="kb-label kb-let">@T.Format("devices.support-ends", support.End!.Value.ToString("d", T.Culture))</span>,
            _ => @<text></text>,
        };
    }

    private string? finding;

    // The panel of one device (R17): its details and the actions, as plans
    private DeviceRecord? selected;
    private string newName = string.Empty;
    private string typedName = string.Empty;
    private Moss365.Core.Changes.PlanOutcome? deviceOutcome;

    private void Select(DeviceRecord r) => (selected, newName, typedName, deviceOutcome, deviceCompliance, complianceNote) = (r, string.Empty, string.Empty, null, null, null);

    // The compliance of the device shown, with the settings it fails (read live, on request)
    private IReadOnlyList<DeviceComplianceState>? deviceCompliance;
    private string? complianceNote;
    private bool readingCompliance;

    private async Task ReadCompliance(IntuneDevice device)
    {
        readingCompliance = true;
        try
        {
            (deviceCompliance, complianceNote) = await State.ReadDeviceComplianceAsync(device);
            if (deviceCompliance is { Count: 0 })
            {
                complianceNote = T["device.compliance.none"];
            }
        }
        finally
        {
            readingCompliance = false;
        }
    }

    private void DeviceAction(IntuneDevice device, string action) => deviceOutcome = DevicePlans.Action(device, action, newName, typedName);

    // A new primary user (R17): someone with an Entra account; the previous one is kept for undo
    private void PrimaryUser(IntuneDevice device, Person? person)
    {
        if (person is null)
        {
            return;
        }

        var previous = State.Data.EntraUsers.FirstOrDefault(u => string.Equals(u.UserPrincipalName, device.Owner, StringComparison.OrdinalIgnoreCase))?.Id;
        deviceOutcome = person.Entra is { } user
            ? DevicePlans.PrimaryUser(device, user, previous)
            : Moss365.Core.Changes.PlanOutcome.Of(Array.Empty<Moss365.Core.Changes.Change>(), new[] { T["device.primary-user-cloud"] });
    }

    private static string FindingText(string f) => T[$"devices.finding.{f}"];

    private static string TrustText(string trust) => trust switch
    {
        "AzureAd" => T["devices.trust.joined"],
        "ServerAd" => T["devices.trust.hybrid"],
        "Workplace" => T["devices.trust.registered"],
        _ => trust,
    };

    private bool busy;
    private int days = 90;
    private readonly HashSet<string> chosen = new(StringComparer.OrdinalIgnoreCase);
    private Moss365.Core.Changes.PlanOutcome? outcome;

    private IReadOnlyList<AdComputer> Stale => DeviceAnalysis.StaleComputers(State.AdComputers ?? Array.Empty<AdComputer>(), DateTimeOffset.Now, Math.Max(30, days));

    private async Task Read()
    {
        busy = true;
        try { await State.ReadDevicesAsync(); }
        finally { busy = false; }
    }

    private void Toggle(string dn, bool on)
    {
        if (on) { chosen.Add(dn); } else { chosen.Remove(dn); }
        outcome = null;
    }

    private void MakePlan() => outcome = DeviceAnalysis.DisableComputers(Stale.Where(c => chosen.Contains(c.DistinguishedName)), DateOnly.FromDateTime(DateTime.Today));

    private static RenderFragment DeviceTable(IReadOnlyList<IntuneDevice> list) => __builder =>
    {
        <table class="kb-tabel">
            <thead><tr><th>@T["keys.device"]</th><th>@T["sign-in-list.user"]</th><th>@T["plan.system"]</th><th>Status</th><th>@T["keys.last-seen"]</th></tr></thead>
            <tbody>
                @foreach (var d in list.Take(100))
                {
                    <tr><td>@d.Name</td><td>@d.Owner</td><td>@d.OperatingSystem @d.Version</td><td>@d.Compliance</td><td>@(d.LastSync?.LocalDateTime.ToString("dd/MM/yyyy") ?? T["word.never"])</td></tr>
                }
            </tbody>
        </table>
    };
}
