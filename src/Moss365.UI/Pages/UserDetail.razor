@page "/gebruiker/{Key}"
@inherits RefreshingPage

@if (person is null)
{
    <h1>@T["user-detail.user-not-found"]</h1>
    <p><a href="gebruikers">@T["logon-scripts.back-to-the-list"]</a></p>
}
else
{
    var mail = State.MailOf(person);
    <h1>@person.Name</h1>
    <ObjectStatus Object="State.Data.Index.Ref(person)" />
    <p class="kb-zacht">
        @person.Source &middot; @(person.Enabled ? T["word.enabled"] : T["word.disabled"])
        @if (!person.IsGuest) { <text> &middot; @T["mail.person"] </text><MailSystemText System="@mail.System" /> }
        @if (person.Ad?.LockedOut == true) { <span class="kb-label kb-rood">@T["helpdesk.locked"]</span> }
        &middot; <a href="@($"spiegel?referentie={Uri.EscapeDataString(person.Key)}")">@T["user-detail.asmirror"]</a>
        &middot; <a href="@($"spiegel?doel={Uri.EscapeDataString(person.Key)}")">@T["user-detail.astarget"]</a>
        @if (State.Can(Permission.Actions)) { <text> &middot; <a href="@($"uitstroom/{Uri.EscapeDataString(person.Key)}")">@T["user-detail.offboarding"]</a></text> }
    </p>
    @if (ProfileOf(person) is { } jp)
    {
        <p class="kb-zacht">
            @T["requests.job-profile"] <a href="@($"functieprofielen?profiel={Uri.EscapeDataString(jp.Profile.Id)}&gebruiker={Uri.EscapeDataString(person.Key)}")">@jp.Profile.Name</a>
            (@jp.How)@(jp.Missing > 0 ? T.Format("code.user-detail.missing", jp.Missing) : null)@(jp.Extra > 0 ? T.Format("code.user-detail.more-than-the-profile", jp.Extra) : null).
        </p>
    }

    @if (State.Can(Permission.Helpdesk)) { <Helpdesk Person="person" /> }
    @if (State.Can(Permission.Manage) && State.HasMicrosoft365 && person.Entra is not null && !person.IsGuest && !State.IsHistoric && mail.System == Moss365.Core.Mail.MailSystem.ExchangeOnline) { <AbsenceCard Person="person" /> }
    @if (State.Can(Permission.Helpdesk) && State.HasMicrosoft365 && person.Entra is not null && !State.IsHistoric && mail.System == Moss365.Core.Mail.MailSystem.ExchangeOnline) { <MessageTraceCard Person="person" /> }
    @if (!person.IsGuest && mail.System is Moss365.Core.Mail.MailSystem.Gmail or Moss365.Core.Mail.MailSystem.ExchangeOnPremises or Moss365.Core.Mail.MailSystem.Other)
    {
        <p class="kb-zacht">@T.Format("mail.person.elsewhere", Moss365.Core.Mail.MailLocations.Name(mail.System)) <a href="postlocatie">@T["menu.postlocatie"]</a></p>
    }
    @if (State.Can(Permission.Manage) && !State.IsHistoric && (person.Ad is not null || person.Entra is not null) && !person.IsGuest) { <CompromisedCard Person="person" /> }
    @if (State.Can(Permission.Helpdesk) && State.HasMicrosoft365 && person.Entra is not null && !person.IsGuest) { <UserDevicesCard Person="person" /> }
    @if (State.Can(Permission.Security) && State.HasMicrosoft365)
    {
        <SecurityCard Person="person" />
        <CaUserCard Person="person" />
    }

    <section class="kb-kaart">
        <h2>@T["user-detail.attributes"]</h2>
        <table class="kb-tabel kb-naast">
            <thead><tr><th>@T["bulk-tasks.attribute"]</th>@if (State.HasAd) { <th>@T["user-detail.on-premises-ad"] <PlatformLabel Platform="Platform.ActiveDirectory" /></th> }@if (State.HasMicrosoft365) { <th>@T["user-detail.entra-id"] <PlatformLabel Platform="Platform.EntraId" />@if (person.Entra?.OnPremisesSyncEnabled == true && person.Ad is not null) { <span class="kb-zacht"> @T.Format("source.follows-from", "AD")</span> }</th> }</tr></thead>
            <tbody>
                @foreach (var r in Rows().Where(r => (State.HasAd && r.Ad.Length > 0) || (State.HasMicrosoft365 && r.Entra.Length > 0) || (State.HasAd && State.HasMicrosoft365)))
                {
                    <tr class="@(r.Difference ? "kb-verschil" : null)">
                        <th>@r.Attribute</th>
                        @if (State.HasAd) { <td>@r.Ad</td> }
                        @if (State.HasMicrosoft365) { <td>@r.Entra</td> }
                    </tr>
                }
            </tbody>
        </table>
        @if (State.HasAd && State.HasMicrosoft365)
        {
            <p class="kb-zacht">@T["user-detail.marked-rows-differ-between-ad"]</p>
        }
    </section>

    @if (State.Can(Permission.Manage) && !person.IsGuest)
    {
        <EditUser Person="person" />
    }

    @if (State.Can(Permission.GroupMembers) && !State.IsHistoric)
    {
        <UserMemberships Person="person" />
    }

    <NestedGroups Person="person" />

    <div class="kb-kolommen">
        @if (State.HasAd)
        {
        <section class="kb-kaart">
            <h2>@T.Format("user-detail.ad-groups-0", adGroups.Count) <PlatformLabel Platform="Platform.ActiveDirectory" /></h2>
            @if (person.Ad is null)
            {
                <p class="kb-zacht">@T["user-detail.no-ad-account"]</p>
            }
            else
            {
                <table class="kb-tabel">
                    <thead><tr><th>@T["nested-groups.group"]</th><th>@T["nested-groups.kind"]</th><th>@T["devices.ou"]</th></tr></thead>
                    <tbody>
                        @foreach (var g in adGroups)
                        {
                            <tr>
                                <td><ObjectLink Id="@g.DistinguishedName" Text="@g.Name" /> @if (MirrorUser.IsPrivileged(g)) { <span class="kb-label kb-rood">@T["group-detail.privileged"]</span> }</td>
                                <td>@g.Scope</td>
                                <td>@g.OuPath</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
        }
        @if (State.HasMicrosoft365)
        {
        <section class="kb-kaart">
            <h2>@T.Format("user-detail.cloud-groups-0", cloudGroups.Count) <PlatformLabel Platform="Platform.EntraId" /></h2>
            @if (person.Entra is null)
            {
                <p class="kb-zacht">@T["user-detail.no-entra-account"]</p>
            }
            else
            {
                <table class="kb-tabel">
                    <thead><tr><th>@T["nested-groups.group"]</th><th>@T["nested-groups.kind"]</th></tr></thead>
                    <tbody>
                        @foreach (var g in cloudGroups)
                        {
                            <tr>
                                <td><ObjectLink Id="@g.Id" Text="@g.DisplayName" /> @if (g.Dynamic) { <span class="kb-label" title="@g.MembershipRule">@T["user-detail.automatic"]</span> }</td>
                                <td>@g.TypeText</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
        }
    </div>

    @if (State.HasMicrosoft365)
    {
    <div class="kb-kolommen">
        <section class="kb-kaart">
            <h2>@T.Format("user-detail.only-in-exchange-0", exoGroups.Count) <PlatformLabel Platform="Platform.ExchangeOnline" /></h2>
            @if (exoGroups.Count == 0) { <p class="kb-zacht">@T["user-detail.no-groups-that-exist-only"]</p> }
            <ul class="kb-lijst-plat">
                @foreach (var g in exoGroups)
                {
                    <li><ObjectLink Object="g.Ref" /> <span class="kb-zacht">@g.KindText</span></li>
                }
            </ul>
        </section>
        <section class="kb-kaart">
            <h2>@T.Format("user-detail.shared-mailboxes", mailboxPermissions.Select(r => r.Mailbox).Distinct().Count()) <PlatformLabel Platform="Platform.ExchangeOnline" /></h2>
            @if (mailboxPermissions.Count == 0) { <p class="kb-zacht">@T["user-detail.no-permissions-on-shared-mailboxes"]</p> }
            <table class="kb-tabel">
                <tbody>
                    @foreach (var r in mailboxPermissions)
                    {
                        <tr class="@(r.ViaGroup is null ? "kb-verschil" : null)">
                            <td><ObjectLink Id="@r.Mailbox.Smtp" /></td>
                            <td>@r.Permission</td>
                            <td>@if (r.ViaGroup is { } via) { @T["user-detail.via"] <ObjectLink Object="via" /> } else { <span>@T["user-detail.direct"]</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </div>
    }

    <section class="kb-kaart">
        <h2>@T["user-detail.timeline"]</h2>
        @if (!showTimeline)
        {
            <button class="kb-knop" @onclick="LoadTimeline">@T["user-detail.show-timeline"]</button>
            <span class="kb-zacht">@T["user-detail.what-changed-in-this-account"]</span>
        }
        else if (timeline.Count == 0)
        {
            <p class="kb-zacht">@T["user-detail.no-snapshots-of-this-account"]</p>
        }
        else
        {
            <table class="kb-tabel">
                <thead><tr><th>@T["message-trace-card.when"]</th><th>@T["service-health-card.what"]</th><th>@T["organisation-history.changed"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in timeline)
                    {
                        <tr class="@(e.What == "Moss365" ? "kb-zacht" : null)">
                            <td>@e.Time.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@e.What</td>
                            <td>@e.Details</td>
                            <td>
                                @if (e.Version is { } v && e.What == "AD-account" && State.Can(Permission.Actions))
                                {
                                    <button class="kb-knop kb-klein" @onclick="() => Restore(v)">@T["user-detail.put-back-as-it-was"]</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="kb-zacht">@T["user-detail.a-change-without-a-line"]</p>
        }
        @if (restoreErrors.Count > 0)
        {
            <ul class="kb-fouten">@foreach (var f in restoreErrors) { <li>@f</li> }</ul>
        }
        @if (restorePlan is not null)
        {
            <PlanView Plan="restorePlan" Context="@($"Terugzetten {person.Name}")" Title="@T["user-detail.put-back-as-it-was"]" />
        }
    </section>
}

@code {
    /// <summary>The job profile of this person (0.22): the one it got in the app, otherwise the one with its job title.</summary>
    private (JobProfile Profile, string How, int Missing, int Extra)? ProfileOf(Person p)
    {
        if (State.Config.JobProfiles.Count == 0)
        {
            return null;
        }

        var assigned = State.ProfileAssignments().GetValueOrDefault(p.Key);
        var profile = JobProfiles.Find(State.Config, assigned?.ProfileId);
        var how = assigned is { } a && profile is not null ? T.Format("code.user-detail.version-received-on", a.Version, a.Applied.LocalDateTime) : T["code.user-detail.by-job-title"];
        profile ??= State.Config.JobProfiles.FirstOrDefault(jp => !string.IsNullOrWhiteSpace(jp.JobTitle)
            && string.Equals(jp.JobTitle.Trim(), UserDesired.Of(p).JobTitle?.Trim(), StringComparison.OrdinalIgnoreCase));
        if (profile is null)
        {
            return null;
        }

        var items = JobProfilePlans.Compare(State.Data, State.Config, profile, p);
        return (profile, how, items.Count(i => i.Status == ProfileStatus.Missing), items.Count(i => i.Status == ProfileStatus.Extra));
    }

    [Parameter] public string Key { get; set; } = string.Empty;

    private Person? person;
    private List<AdGroup> adGroups = new();
    private List<CloudGroup> cloudGroups = new();
    private List<Group> exoGroups = new();
    private IReadOnlyList<PermissionRule> mailboxPermissions = Array.Empty<PermissionRule>();

    private sealed record Row(string Attribute, string Ad, string Entra, bool Difference);

    private bool showTimeline;
    private IReadOnlyList<TimelineEntry> timeline = Array.Empty<TimelineEntry>();
    private IReadOnlyList<Change>? restorePlan;
    private IReadOnlyList<string> restoreErrors = Array.Empty<string>();

    private void LoadTimeline()
    {
        showTimeline = true;
        timeline = person is null ? Array.Empty<TimelineEntry>() : State.Timeline(person);
    }

    private void Restore(Moss365.Core.Storage.ObjectVersion v)
    {
        var u = State.RestorePlan(person!, v);
        restorePlan = u.Plan.Count > 0 ? u.Plan : null;
        restoreErrors = u.Errors;
    }

    protected override void OnParametersSet()
    {
        person = State.Data.SearchPerson(Uri.UnescapeDataString(Key));
        adGroups = person is null ? new() : State.Data.AdGroupsOf(person).OrderBy(g => g.Name).ToList();
        cloudGroups = person is null ? new() : State.Data.CloudGroupsOf(person).OrderBy(g => g.DisplayName).ToList();
        exoGroups = person is null ? new() : State.Data.Index.GroupsOf(person).Where(g => g.Exo is not null && g.Ad is null && g.Cloud is null).ToList();
        mailboxPermissions = person is null ? Array.Empty<PermissionRule>() : State.Data.Index.MailboxPermissionsOf(person);
    }

    private IEnumerable<Row> Rows()
    {
        var a = person!.Ad;
        var e = person.Entra;
        bool both = a is not null && e is not null;
        Row R(string k, string? ad, string? andValue, bool compare = true)
            => new(k, ad ?? string.Empty, andValue ?? string.Empty,
                compare && both && !string.Equals((ad ?? string.Empty).Trim(), (andValue ?? string.Empty).Trim(), StringComparison.Ordinal));

        yield return R("sAMAccountName", a?.SamAccountName, e?.OnPremisesSamAccountName);
        yield return R("UPN", a?.UserPrincipalName, e?.UserPrincipalName);
        yield return R(T["edit-user.display-name"], a?.DisplayName, e?.DisplayName);
        yield return R(T["edit-user.first-name"], a?.GivenName, e?.GivenName);
        yield return R(T["edit-user.last-name"], a?.Surname, e?.Surname);
        yield return R(T["users.e-mail"], a?.EmailAddress, e?.Mail);
        yield return R(T["organisation.department"], a?.Department, e?.Department);
        yield return R(T["word.division-derived"], State.Config.DivisionFor(a?.Department)?.Name, State.Config.DivisionFor(e?.Department)?.Name);
        yield return R(T["bulk-tasks.job-title"], a?.Title, e?.JobTitle);
        yield return R(T["organisation.company"], a?.Company, e?.CompanyName);
        yield return R(T["bulk-tasks.office"], a?.Office, e?.OfficeLocation);
        yield return R(T["bulk-tasks.city"], a?.City, e?.City);
        yield return R(T["edit-user.phone"], a?.Phone, e?.Phone);
        yield return R(T["edit-user.mobile"], a?.Mobile, e?.Mobile);
        yield return R(T["reports.manager"], a is null ? null : ManagerName(a.Manager, null), e is null ? null : ManagerName(null, e.ManagerId));
        yield return R(T["edit-user.description"], a?.Description, null, compare: false);
        yield return R("OU", a?.OuPath, e is null ? null : DnHelp.OuPathOfObject(e.OnPremisesDistinguishedName), compare: false);
        yield return R(T["word.enabled-2"], a is null ? null : (a.Enabled ? T["compare.yes"] : T["compare.no"]), e is null ? null : (e.AccountEnabled ? T["compare.yes"] : T["compare.no"]));
        yield return R(T["statistics.last-sign-in"], a?.LastLogonDate, e?.LastSignIn, compare: false);
        yield return R(T["cleanup.created"], a?.WhenCreated, e?.CreatedDateTime, compare: false);
        yield return R(T["word.password-never-expires"], a is null ? null : (a.PasswordNeverExpires ? T["compare.yes"] : T["compare.no"]), null, compare: false);
        yield return R(T["edit-user.logon-script"], a?.ScriptPath, null, compare: false);
        yield return R(T["job-profile-editor.licences"], null, e is null ? null : string.Join(", ", e.Licences), compare: false);
        yield return R(T["word.kind-of-account"], null, e?.UserType, compare: false);
    }

    private string? ManagerName(string? dn, string? id)
    {
        if (!string.IsNullOrEmpty(dn))
        {
            return State.Data.Persons.FirstOrDefault(x => string.Equals(x.Ad?.DistinguishedName, dn, StringComparison.OrdinalIgnoreCase))?.Name ?? DnHelp.Name(dn);
        }

        return string.IsNullOrEmpty(id) ? null : State.Data.Persons.FirstOrDefault(x => string.Equals(x.Entra?.Id, id, StringComparison.OrdinalIgnoreCase))?.Name ?? id;
    }
}
