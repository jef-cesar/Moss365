@page "/scripts/run/{Sleutel}/{Id}"
@inherits RefreshingPage
@inject NavigationManager Nav

@if (run is null)
{
    <h1>Run niet gevonden</h1>
    <p class="kb-zacht">Runs worden @ScriptRuns.SaveDays dagen bewaard. <a href="scripts">Terug naar de scripts</a></p>
}
else
{
    <h1>@run.Name <span class="kb-zacht">@run.Start.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span></h1>
    <p>
        <RunLabel Run="run" /> <span class="kb-zacht">@run.Message</span>
        @if (!run.Once && State.SearchScript(run.Key) is not null)
        {
            <button class="kb-knop kb-klein" @onclick="Again">Opnieuw starten met dezelfde waarden</button>
        }
    </p>

    @if (Live is { } s)
    {
        <ScriptOutputList Events="s.Events" Progress="s.Voortgang" Percent="s.Percent" Follow="true" EmptyText="Starten..." />
        <div class="kb-filters"><button class="kb-knop" @onclick="State.CancelScript">Annuleren</button></div>
    }
    else
    {
        <ScriptResult @key="run.Folder" Run="run" Events="events" />
    }

    @if (run.Once && File.Exists(Path.Combine(run.Folder, "script.ps1")))
    {
        <details class="kb-kaart">
            <summary>Het script van deze eenmalige run</summary>
            <pre class="kb-uitvoer">@File.ReadAllText(Path.Combine(run.Folder, "script.ps1"))</pre>
        </details>
    }
}

@code {
    [Parameter] public string Key { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = string.Empty;

    private ScriptRun? run;
    private IReadOnlyList<ScriptEvent> events = Array.Empty<ScriptEvent>();

    /// <summary>This run is still running: show the live output.</summary>
    private ScriptRunStatus? Live => State.ScriptRun is { Done: false } s && run is not null && s.Run.Folder == run.Folder ? s : null;

    protected override void OnParametersSet() => Load();

    protected override void OnAfterRender(bool firstTime)
    {
        // Just finished: read the saved run again
        if (run is { Result: RunResult.Busy } && Live is null)
        {
            Load();
            StateHasChanged();
        }
    }

    private void Load()
    {
        run = ScriptRuns.Items(State.ScriptFolders, Key).FirstOrDefault(r => Path.GetFileName(r.Folder) == Id);
        events = run is null ? Array.Empty<ScriptEvent>() : ScriptOutput.ReadFile(Path.Combine(run.Folder, "uitvoer.jsonl"));
    }

    private void Again()
    {
        State.ScriptPrefill = run!.Values;
        Nav.NavigateTo($"scripts/starten/{Uri.EscapeDataString(run.Key)}");
    }
}
