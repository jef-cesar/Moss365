@page "/scripts/run/{Key}/{Id}"
@inherits RefreshingPage
@inject NavigationManager Nav

@if (run is null)
{
    <h1>@T["script-run-detail.run-not-found"]</h1>
    <p class="kb-zacht">@T.Format("script-run-detail.runs-are-kept-0-days", ScriptRuns.SaveDays) <a href="scripts">@T["script-run-detail.back-to-the-scripts"]</a></p>
}
else
{
    <h1>@run.Name <span class="kb-zacht">@run.Start.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span></h1>
    <p>
        <RunLabel Run="run" /> <span class="kb-zacht">@run.Message</span>
        @if (!run.Once && State.SearchScript(run.Key) is not null)
        {
            <button class="kb-knop kb-klein" @onclick="Again">@T["script-run-detail.start-again-with-the-same"]</button>
        }
    </p>

    @if (Live is { } s)
    {
        <ScriptOutputList Events="s.Events" Progress="s.Voortgang" Percent="s.Percent" Follow="true" EmptyText="@T["script-run-detail.starting"]" />
        <div class="kb-filters"><button class="kb-knop" @onclick="State.CancelScript">@T["action.cancel"]</button></div>
    }
    else
    {
        <ScriptResult @key="run.Folder" Run="run" Events="events" />
    }

    @if (run.Once && State.Files.ReadText(run.Folder + "/script.ps1") is { } oneTime)
    {
        <details class="kb-kaart">
            <summary>@T["script-run-detail.the-script-of-this-one"]</summary>
            <pre class="kb-uitvoer">@oneTime</pre>
        </details>
    }
}

@code {
    [Parameter] public string Key { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = string.Empty;

    private ScriptRun? run;
    private IReadOnlyList<ScriptEvent> events = Array.Empty<ScriptEvent>();

    /// <summary>This run is still running: show the live output.</summary>
    private ScriptRunStatus? Live => State.ScriptRun is { Done: false } s && run is not null && s.Run.Folder == run.Folder ? s : null;

    protected override void OnParametersSet() => Load();

    protected override void OnAfterRender(bool firstTime)
    {
        // Just finished: read the saved run again
        if (run is { Result: RunResult.Busy } && Live is null)
        {
            Load();
            StateHasChanged();
        }
    }

    private void Load()
    {
        run = ScriptRuns.Items(State.ScriptFolders, Key).FirstOrDefault(r => r.FolderName == Id)
              ?? (State.ScriptRun is { } s && s.Run.Key == Key && s.Run.FolderName == Id ? s.Run : null);
        events = run is null ? Array.Empty<ScriptEvent>()
            : run.WorkFolder.Length > 0 ? ScriptOutput.ReadFile(Path.Combine(run.WorkFolder, "uitvoer.jsonl"))
            : ScriptOutput.ReadStored(State.Files, run.Folder + "/uitvoer.jsonl");
    }

    private void Again()
    {
        State.ScriptPrefill = run!.Values;
        Nav.NavigateTo($"scripts/starten/{Uri.EscapeDataString(run.Key)}");
    }
}
