@page "/conditional-access/nieuw-beleid"
@page "/conditional-access/{Id}/bewerken"
@page "/conditional-access/{Id}/kopie"
@inherits RefreshingPage
@inject NavigationManager Nav
@* The Conditional Access editor (0.30): every condition of a policy, a new policy or a copy. The preview shows the
   differences, the safety check (emergency accounts, not locking yourself out) and who comes under the policy or no
   longer; the plan goes through CaSafety again in the engine. A new policy never starts switched on; nothing is deleted. *@

@if (State.Data.ConditionalAccess is not { Message: null } ca)
{
    <h1>@T["menu.conditional-access"]</h1>
    <div class="kb-melding">@Html("ca-editor.notloaded")</div>
}
else if (!State.Can(Permission.Manage) || State.IsHistoric)
{
    <h1>@T["menu.conditional-access"]</h1>
    <div class="kb-melding">@(State.IsHistoric ? T["code.ca-policy-editor.you-are-looking-at-the"] : "Een beleid bewerken kan enkel wie mag beheren.")</div>
}
else if (edit is null)
{
    <h1>@T["ca-policy-detail.policy-not-found"]</h1>
    <p><a href="conditional-access">@T["ca-policy-detail.back-to-conditional-access"]</a></p>
}
else
{
    <div class="kb-titelbalk">
        <h1>@Title</h1>
        @if (current is not null) { <a class="kb-knop" href="@($"conditional-access/{Uri.EscapeDataString(current.Id)}")">@T["ca-policy-editor.back-to-the-policy"]</a> }
    </div>
    <p class="kb-zacht">
        @Html("ca-editor.intro")
    </p>

    <section class="kb-kaart">
        <h2>@T["ca-policy-editor.name-and-state"]</h2>
        <div class="kb-raster">
            <label>@T["variables-editor.name"] <input class="kb-invoer" value="@edit.Name" @onchange="e => Set(() => edit.Name = e.Value?.ToString() ?? string.Empty)" aria-label="@T["variables-editor.name"]" /></label>
        </div>
        <div class="kb-keuzes">
            @foreach (var (s, text, explanation) in Statuses)
            {
                var disabled = s == CaStatus.On && current is null;
                <label class="kb-keuze @(edit.Status == s ? "kb-actief" : null)">
                    <input type="radio" name="status" checked="@(edit.Status == s)" disabled="@disabled" @onchange="() => Set(() => edit.Status = s)" aria-label="@text" />
                    <strong>@text</strong>
                    <span class="kb-zacht">@(disabled ? T["code.ca-policy-editor.a-new-policy-starts-in"] : explanation)</span>
                </label>
            }
        </div>
    </section>

    <section class="kb-kaart">
        <h2>@T["script-result.who"]</h2>
        <div class="kb-filters">
            @foreach (var (m, text) in new[] { (CaUsersMode.All, T["word.allusers"]), (CaUsersMode.Selected, T["code.ca-policy-editor.chosen-users-groups-or-roles"]), (CaUsersMode.None, T["word.nobody"]) })
            {
                <label><input type="radio" name="wie" checked="@(edit.UsersMode == m)" @onchange="() => Set(() => edit.UsersMode = m)" aria-label="@text" /> @text</label>
            }
        </div>
        @if (edit.UsersMode == CaUsersMode.Selected)
        {
            <h3>@T["ca-policy-detail.included"]</h3>
            @(Chips(edit.UsersIn, Name, T["word.user"]))
            @(Chips(edit.GroupsIn, Name, T["word.group"]))
            @(Chips(edit.RolesIn, RoleName, T["word.role"]))
            <label><input type="checkbox" checked="@edit.GuestsIn" @onchange="e => Set(() => edit.GuestsIn = e.Value is true)" /> @T["ca-policy-editor.guests-and-external-users"]</label>
            <div class="kb-kolommen">
                <ObjectPicker Label="@T["ca-policy-editor.include-user"]" Kinds="UserKinds" Selected="r => AddUser(edit.UsersIn, r)" />
                <ObjectPicker Label="@T["ca-policy-editor.include-group"]" Kinds="GroupKinds" Selected="r => AddGroup(edit.GroupsIn, r)" />
            </div>
            @(RolePicker(edit.RolesIn, "Rol opnemen"))
        }
        <h3>@T["ca-policy-detail.excluded"]</h3>
        @if (MissingEmergency > 0)
        {
            <div class="kb-melding">
                @T.Format("ca-policy-editor.0-emergency-account-s-are", MissingEmergency)
                <button class="kb-knop kb-klein kb-primair" @onclick="() => Set(() => CaEditor.ExcludeEmergencyAccounts(edit, State.Data, State.Config))">@T["ca-policy-editor.exclude-emergency-accounts"]</button>
            </div>
        }
        @(Chips(edit.UsersOff, Name, T["word.user"]))
        @(Chips(edit.GroupsOff, Name, T["word.group"]))
        @(Chips(edit.RolesOff, RoleName, T["word.role"]))
        <label><input type="checkbox" checked="@edit.GuestsOff" @onchange="e => Set(() => edit.GuestsOff = e.Value is true)" /> @T["ca-policy-editor.exclude-guests-and-external-users"]</label>
        <div class="kb-kolommen">
            <ObjectPicker Label="@T["ca-policy-editor.exclude-user"]" Kinds="UserKinds" Selected="r => AddUser(edit.UsersOff, r)" />
            <ObjectPicker Label="@T["ca-policy-editor.exclude-group"]" Kinds="GroupKinds" Selected="r => AddGroup(edit.GroupsOff, r)" />
        </div>
        @(RolePicker(edit.RolesOff, "Rol uitzonderen"))
    </section>

    <section class="kb-kaart">
        <h2>@T["ca-policy-detail.apps"]</h2>
        @if (edit.AppsMode == CaAppsMode.Other)
        {
            <p class="kb-zacht">@T["ca-policy-editor.this-policy-uses-an-authentication"]</p>
        }
        else
        {
            <div class="kb-filters">
                @foreach (var (m, text) in AppModes)
                {
                    <label><input type="radio" name="apps" checked="@(edit.AppsMode == m)" @onchange="() => Set(() => edit.AppsMode = m)" aria-label="@text" /> @text</label>
                }
            </div>
            @if (edit.AppsMode == CaAppsMode.Selected)
            {
                @(Chips(edit.AppsIn, CaReader.AppName, T["word.app"]))
                @(AppPicker(edit.AppsIn, "App opnemen"))
            }
            @if (edit.AppsMode == CaAppsMode.UserAction)
            {
                <div class="kb-filters">
                    <label><input type="radio" name="actie" checked="@(edit.UserAction == CaEditor.RegisterSecurityInfo)" @onchange="() => Set(() => edit.UserAction = CaEditor.RegisterSecurityInfo)" /> @T["ca-policy-editor.register-security-info-mfa"]</label>
                    <label><input type="radio" name="actie" checked="@(edit.UserAction == CaEditor.RegisterDevice)" @onchange="() => Set(() => edit.UserAction = CaEditor.RegisterDevice)" /> @T["ca-policy-editor.register-or-join-devices"]</label>
                </div>
            }
            else
            {
                <h3>@T["ca-policy-editor.excluded-apps"]</h3>
                @(Chips(edit.AppsOff, CaReader.AppName, T["word.app"]))
                @(AppPicker(edit.AppsOff, "App uitzonderen"))
            }
        }
    </section>

    <section class="kb-kaart">
        <h2>@T["ca-policy-detail.conditions"]</h2>
        <div class="kb-raster">
            <fieldset class="kb-veldgroep">
                <legend>@T["ca-policy-editor.client-apps-nothing-ticked-all"]</legend>
                @(Checks(edit.ClientApps, CaEditor.ClientAppChoices, CaReader.ClientName))
            </fieldset>
            <fieldset class="kb-veldgroep">
                <legend>@T["ca-policy-editor.platforms-nothing-ticked-not-set"]</legend>
                <label><input type="checkbox" checked="@AllPlatforms" @onchange="SetAllPlatforms" /> @T["ca-policy-editor.all-platforms"]</label>
                @(Checks(edit.PlatformsIn, CaEditor.PlatformChoices, CaReader.PlatformName))
                <span class="kb-zacht">@T["ca-editor.excluded"]</span>
                @(Checks(edit.PlatformsOff, CaEditor.PlatformChoices, CaReader.PlatformName))
            </fieldset>
            <fieldset class="kb-veldgroep">
                <legend>@T["ca-policy-editor.locations-nothing-chosen-not-set"]</legend>
                @(Checks(edit.LocationsIn, LocationIds(ca), id => CaReader.LocationName(id, ca)))
                <span class="kb-zacht">@T["ca-editor.excluded"]</span>
                @(Checks(edit.LocationsOff, LocationIds(ca).Where(l => l != "All").ToList(), id => CaReader.LocationName(id, ca)))
            </fieldset>
            <fieldset class="kb-veldgroep">
                <legend>@T["ca-policy-editor.risk-entra-id-p2"]</legend>
                <span class="kb-zacht">@T["ca-editor.signinrisk"]</span>
                @(Checks(edit.SignInRisk, CaEditor.RiskChoices, CaReader.RiskName))
                <span class="kb-zacht">@T["ca-editor.userrisk"]</span>
                @(Checks(edit.UserRisk, CaEditor.RiskChoices, CaReader.RiskName))
            </fieldset>
            <fieldset class="kb-veldgroep">
                <legend>@T["ca-policy-editor.authentication-transfer"]</legend>
                @(Checks(edit.Transfer, CaEditor.TransferChoices, t => t == "deviceCodeFlow" ? T["code.ca-policy-editor.sign-in-with-a-device"] : T["word.authtransfer"]))
            </fieldset>
            <fieldset class="kb-veldgroep">
                <legend>@T["ca-policy-editor.device-filter"]</legend>
                <select class="kb-invoer" aria-label="@T["ca-policy-editor.include-or-exclude-device-filter"]" @onchange="SetDeviceMode">
                    <option value="exclude" selected="@(edit.DeviceFilterMode == "exclude")">@T["ca-policy-editor.exclude-devices-that-match"]</option>
                    <option value="include" selected="@(edit.DeviceFilterMode == "include")">@T["ca-policy-editor.only-devices-that-match"]</option>
                </select>
                <input class="kb-invoer" placeholder='bv. device.trustType -eq "ServerAD"' value="@edit.DeviceFilterRule" aria-label="@T["ca-policy-editor.rule-of-the-device-filter"]"
                       @onchange="e => Set(() => edit.DeviceFilterRule = e.Value?.ToString() ?? string.Empty)" />
            </fieldset>
        </div>
    </section>

    <section class="kb-kaart">
        <h2>@T["what-if-table.effect"]</h2>
        <div class="kb-filters">
            <label><input type="radio" name="gevolg" checked="@edit.Block" @onchange="() => Set(() => edit.Block = true)" aria-label="@T["ca-policy-editor.block-access"]" /> @T["ca-policy-editor.block-access"]</label>
            <label><input type="radio" name="gevolg" checked="@(!edit.Block)" @onchange="() => Set(() => edit.Block = false)" aria-label="@T["ca-policy-editor.grant-access-when"]" /> @T["ca-policy-editor.grant-access-when-2"]</label>
        </div>
        @if (!edit.Block)
        {
            @(Checks(edit.Checks, CaEditor.CheckChoices, CaReader.CheckName))
            <div class="kb-rij">
                <label>@T["ca-policy-editor.authentication-strength"]
                    <select class="kb-invoer" aria-label="@T["ca-policy-editor.authentication-strength"]" @onchange="e => Set(() => edit.StrengthId = Opt(e.Value))">
                        <option value="" selected="@(edit.StrengthId is null)">@T["edit-user.none"]</option>
                        @foreach (var s in ca.Strengths)
                        {
                            <option value="@s.Id" selected="@(edit.StrengthId == s.Id)">@s.Name</option>
                        }
                    </select>
                </label>
                <label>@T["ca-policy-editor.with-more-than-one-requirement"]
                    <select class="kb-invoer" aria-label="@T["ca-policy-editor.operator"]" @onchange="SetOperator">
                        <option value="OR" selected="@(edit.Operator != "AND")">@T["ca-policy-editor.one-of-them-is-enough"]</option>
                        <option value="AND" selected="@(edit.Operator == "AND")">@T["ca-policy-editor.all-together"]</option>
                    </select>
                </label>
            </div>
        }
        <h3>@T["ca-policy-detail.session"]</h3>
        <div class="kb-rij">
            <label>@T["ca-policy-editor.sign-in-frequency"]
                <select class="kb-invoer" aria-label="@T["ca-policy-editor.sign-in-frequency"]" @onchange="e => Set(() => edit.FrequencyType = Opt(e.Value))">
                    <option value="" selected="@(edit.FrequencyType is null)">@T["ca-policy-editor.not-set"]</option>
                    <option value="hours" selected="@(edit.FrequencyType == "hours")">@T["ca-policy-editor.every-so-many-hours"]</option>
                    <option value="days" selected="@(edit.FrequencyType == "days")">@T["ca-policy-editor.every-so-many-days"]</option>
                    <option value="everyTime" selected="@(edit.FrequencyType == "everyTime")">@T["ca-policy-editor.every-time"]</option>
                </select>
            </label>
            @if (edit.FrequencyType is "hours" or "days")
            {
                <label>@T["suggestions-panel.number"] <input class="kb-invoer" type="number" min="1" max="365" value="@edit.FrequencyValue" aria-label="@T["suggestions-panel.number"]"
                                     @onchange="e => Set(() => edit.FrequencyValue = int.TryParse(e.Value?.ToString(), out var n) ? n : edit.FrequencyValue)" /></label>
            }
            <label>@T["ca-policy-editor.stay-signed-in-in-the"]
                <select class="kb-invoer" aria-label="@T["connections.stay-signed-in"]" @onchange="e => Set(() => edit.Browser = Opt(e.Value))">
                    <option value="" selected="@(edit.Browser is null)">@T["ca-policy-editor.not-set"]</option>
                    <option value="always" selected="@(edit.Browser == "always")">@T["ca-policy-editor.always"]</option>
                    <option value="never" selected="@(edit.Browser == "never")">@T["ca-policy-editor.never"]</option>
                </select>
            </label>
        </div>
    </section>

    <section class="kb-kaart kb-ca-voorbeeld">
        <h2>@T["new-user.preview"]</h2>
        @foreach (var f in Errors)
        {
            <div class="kb-melding kb-fout">@f</div>
        }
        @foreach (var w in Warnings)
        {
            <div class="kb-melding">@w</div>
        }
        @if (Preview is { } after)
        {
            var u = CaReader.Explanation(after, ca, CaReader.Names(State.Data));
            <dl class="kb-uitleg">
                <dt>@T["script-result.who"]</dt><dd><ul>@foreach (var x in u.Who) { <li>@x</li> }</ul></dd>
                <dt>@T["ca-policy-detail.apps"]</dt><dd><ul>@foreach (var x in u.Apps) { <li>@x</li> }</ul></dd>
                <dt>@T["ca-policy-detail.conditions"]</dt><dd><ul>@foreach (var x in u.Conditions) { <li>@x</li> }</ul></dd>
                <dt>@T["what-if-table.effect"]</dt><dd><strong>@u.Consequence</strong></dd>
                @if (u.Session.Count > 0) { <dt>@T["ca-policy-detail.session"]</dt><dd><ul>@foreach (var x in u.Session) { <li>@x</li> }</ul></dd> }
            </dl>
            @if (current is not null)
            {
                <h3>@T["ca-policy-editor.what-changes"]</h3>
                @if (Differences.Count == 0) { <p class="kb-zacht">@T["change-log.nothing-yet"]</p> }
                else { <ul class="kb-ca-verschil">@foreach (var v in Differences) { <li>@v</li> }</ul> }
            }
            <h3>@T["ca-policy-editor.who-comes-under-it"]</h3>
            <p>
                @T["ca-policy-editor.after-the-change"] <strong>@impact.After</strong> personen
                @if (current is not null) { <text>(<span class="kb-ca-erbij">+@impact.Added.Count</span>, <span class="kb-ca-eraf">−@impact.Removed.Count</span>)</text> }.
            </p>
            @if (impact.Added.Count > 0) { <p class="kb-zacht">Komen erbij: @string.Join(", ", impact.Added.Take(15).Select(p => p.Name))@(impact.Added.Count > 15 ? " ..." : null)</p> }
            @if (impact.Removed.Count > 0) { <p class="kb-zacht">Vallen weg: @string.Join(", ", impact.Removed.Take(15).Select(p => p.Name))@(impact.Removed.Count > 15 ? " ..." : null)</p> }
            <details>
                <summary>@T["ca-policy-editor.json-for-graph"]</summary>
                <pre class="kb-json">@(current is null ? CaEditor.ToJson(edit) : CaEditor.Patch(current, edit) is { Length: > 0 } patch ? patch : T["code.ca-policy-editor.no-change"])</pre>
            </details>
        }
        <div class="kb-filters">
            <button class="kb-knop kb-primair" disabled="@(Errors.Count > 0)" @onclick="MakePlan">@T["bulk-tasks.make-plan"]</button>
            <button class="kb-knop" @onclick="Reset">@T["ca-policy-editor.start-again"]</button>
        </div>
    </section>

    @if (outcome is not null)
    {
        @foreach (var f in outcome.Errors)
        {
            <div class="kb-melding kb-fout">@f</div>
        }
        @if (outcome.Plan.Count > 0)
        {
            <PlanView Plan="outcome.Plan" Context="@($"Conditional Access: {(current is null ? "nieuw beleid" : "beleid wijzigen")} {edit.Name.Trim()}")" Title="@T["code.manage-ca.change-to-conditional-access"]" Executed="AfterExecute" />
        }
    }
    @if (done is not null) { <div class="kb-melding kb-goed">@done</div> }
}

@code {
    [Parameter] public string? Id { get; set; }

    private static readonly ObjectKind[] UserKinds = { ObjectKind.User };
    private static readonly ObjectKind[] GroupKinds = { ObjectKind.Group };

    private static (CaStatus, string, string)[] Statuses => new[]
    {
        (CaStatus.Report, T["word.reportonly"], T["ca-editor.state.report.help"]),
        (CaStatus.On, T["ca-editor.state.on"], T["ca-editor.state.on.help"]),
        (CaStatus.Off, T["word.off"], T["ca-editor.state.off.help"]),
    };

    private static (CaAppsMode, string)[] AppModes => new[]
    {
        (CaAppsMode.All, T["ca-editor.apps.all"]), (CaAppsMode.Office365, "Office 365"), (CaAppsMode.AdminPortals, T["ca-overview.microsoft-admin-portals"]),
        (CaAppsMode.Selected, T["ca-editor.apps.selected"]), (CaAppsMode.UserAction, T["ca-editor.apps.useraction"]),
    };

    private CaPolicy? current;
    private CaEdit? edit;
    private string? loadedKey;
    private PlanOutcome? outcome;
    private string? done;
    private string appId = string.Empty;
    private IReadOnlyList<string> Errors = Array.Empty<string>();
    private IReadOnlyList<string> Warnings = Array.Empty<string>();
    private IReadOnlyList<string> Differences = Array.Empty<string>();
    private CaPolicy? Preview;
    private (IReadOnlyList<Person> Added, IReadOnlyList<Person> Removed, int After) impact = (Array.Empty<Person>(), Array.Empty<Person>(), 0);

    private bool IsCopy => Nav.Uri.Split('?')[0].EndsWith("/kopie", StringComparison.OrdinalIgnoreCase);

    private string Title => current is null ? (IsCopy ? T["code.ca-policy-editor.copy-of-a-policy"] : "Nieuw beleid") : $"{current.Name} bewerken";

    protected override void OnParametersSet()
    {
        var ca = State.Data.ConditionalAccess;
        var source = Id is null ? null : ca?.Policies.FirstOrDefault(b => b.Id == Id);
        var key = $"{Id}|{IsCopy}";
        if (key != loadedKey && ca is not null)
        {
            loadedKey = key;
            outcome = null;
            done = null;
            edit = Id is null ? CaEditor.New(State.Data, State.Config) : source is null ? null : IsCopy ? CaEditor.Duplicate(source) : CaEdit.Of(source);
        }

        current = IsCopy ? null : source;
        Compute();
    }

    private void Set(Action change)
    {
        change();
        outcome = null;
        done = null;
        Compute();
    }

    private void Set(Func<int> change) => Set(() => { change(); });

    private void Compute()
    {
        if (edit is null || State.Data.ConditionalAccess is not { } ca)
        {
            return;
        }

        var errors = CaEditor.Validate(edit, ca, current?.Id).ToList();
        var warnings = new List<string>();
        Preview = null;
        Differences = Array.Empty<string>();
        try
        {
            Preview = current is null ? CaEditor.Preview(edit, null) : CaJson.AfterPatch(current, CaEditor.Patch(current, edit) is { Length: > 0 } p ? p : "{}");
            var check = CaSafety.Check(Preview, State.Data, State.Config, State.OwnUpn);
            errors.AddRange(check.Errors);
            warnings.AddRange(check.Warnings);
            if (current is not null)
            {
                Differences = CaEditor.Differences(current, Preview, State.Data);
            }

            impact = CaEditor.Impact(current, Preview, State.Data);
        }
        catch (System.Text.Json.JsonException ex)
        {
            errors.Add((T["code.ca-policy-editor.the-settings-do-not-give"] + " ") + ex.Message);
        }

        Errors = errors.Distinct().ToList();
        Warnings = warnings.Distinct().ToList();
    }

    private int MissingEmergency => edit is null ? 0
        : CaSafety.EmergencyAccounts(State.Data, State.Config).Accounts.Count(p => !edit.UsersOff.Contains(p.Entra!.Id, StringComparer.OrdinalIgnoreCase));

    private string Name(string id) => CaReader.Names(State.Data)(id);

    private string RoleName(string id) => State.Data.ConditionalAccess?.Roles.ContainsKey(id) == true
        ? State.Data.ConditionalAccess.RoleName(id)
        : CaTemplates.CriticalRoles.TryGetValue(id, out var n) ? n : id;

    private IEnumerable<(string Id, string Name)> Roles
        => CaTemplates.CriticalRoles.Select(r => (r.Key, r.Value))
            .Concat(State.Data.ConditionalAccess?.Roles.Select(r => (r.Key, r.Value)) ?? Enumerable.Empty<(string, string)>())
            .DistinctBy(r => r.Item1).OrderBy(r => r.Item2, StringComparer.CurrentCultureIgnoreCase);

    private static IReadOnlyList<string> LocationIds(CaData ca) => new[] { "All", "AllTrusted" }.Concat(ca.Locations.Select(l => l.Id)).ToList();

    private bool AllPlatforms => edit?.PlatformsIn.Contains("all") == true;

    private void SetAllPlatforms(ChangeEventArgs e) => Set(() => Toggle(edit!.PlatformsIn, "all", e.Value is true));

    private void SetDeviceMode(ChangeEventArgs e) => Set(() => edit!.DeviceFilterMode = e.Value?.ToString() == "include" ? "include" : "exclude");

    private void SetOperator(ChangeEventArgs e) => Set(() => edit!.Operator = e.Value?.ToString() == "AND" ? "AND" : "OR");

    private static string? Opt(object? value) => string.IsNullOrWhiteSpace(value?.ToString()) ? null : value.ToString();

    private static void Toggle(List<string> list, string value, bool on)
    {
        list.RemoveAll(x => string.Equals(x, value, StringComparison.OrdinalIgnoreCase));
        if (on)
        {
            list.Add(value);
        }
    }

    private void AddUser(List<string> list, ObjectRef r)
    {
        if (State.Data.SearchPerson(r.Key)?.Entra?.Id is { } id)
        {
            Set(() => { if (!list.Contains(id, StringComparer.OrdinalIgnoreCase)) list.Add(id); });
        }
        else
        {
            outcome = PlanOutcome.Error(T.Format("code.ca-policy-editor.has-no-entra-account-conditional", r.Name));
        }
    }

    private void AddGroup(List<string> list, ObjectRef r)
    {
        if (State.Data.Index.Group(r.Key)?.Cloud?.Id is { } id)
        {
            Set(() => { if (!list.Contains(id, StringComparer.OrdinalIgnoreCase)) list.Add(id); });
        }
        else
        {
            outcome = PlanOutcome.Error(T.Format("code.ca-policy-editor.does-not-exist-in-entra", r.Name));
        }
    }

    private RenderFragment Chips(List<string> list, Func<string, string> name, string kind) => __builder =>
    {
        if (list.Count == 0 || (kind != "App" && list.All(id => string.IsNullOrEmpty(id))))
        {
            return;
        }

        <ul class="kb-lijst">
            @foreach (var id in list.ToList())
            {
                <li><span class="kb-soort">@kind</span> @name(id) <button class="kb-knop kb-klein" aria-label="@($"{name(id)} weghalen")" @onclick="() => Set(() => list.Remove(id))">&times;</button></li>
            }
        </ul>
    };

    private RenderFragment Checks(List<string> list, IReadOnlyList<string> choices, Func<string, string> name) => __builder =>
    {
        <div class="kb-keuzelijst">
            @foreach (var c in choices)
            {
                <label><input type="checkbox" checked="@list.Contains(c, StringComparer.OrdinalIgnoreCase)" aria-label="@name(c)" @onchange="e => Set(() => Toggle(list, c, e.Value is true))" /> @name(c)</label>
            }
        </div>
    };

    private RenderFragment RolePicker(List<string> list, string label) => __builder =>
    {
        <div class="kb-rij">
            <select class="kb-invoer" aria-label="@label" @onchange="e => { if (Opt(e.Value) is string id) Set(() => Toggle(list, id, true)); }">
                <option value="">(@label.ToLowerInvariant())</option>
                @foreach (var (id, name) in Roles.Where(r => !list.Contains(r.Id)))
                {
                    <option value="@id">@name</option>
                }
            </select>
        </div>
    };

    private RenderFragment AppPicker(List<string> list, string label) => __builder =>
    {
        <div class="kb-rij">
            <select class="kb-invoer" aria-label="@label" @onchange="e => { if (Opt(e.Value) is string id) Set(() => Toggle(list, id, true)); }">
                <option value="">(@label.ToLowerInvariant())</option>
                @foreach (var id in CaReader.KnownApps.Where(a => a is not ("All" or "None") && !list.Contains(a)))
                {
                    <option value="@id">@CaReader.AppName(id)</option>
                }
            </select>
            <input class="kb-invoer" placeholder="@T["code.ca-policy-editor.or-the-app-id-guid"]" @bind="appId" aria-label="App-id" />
            <button class="kb-knop kb-klein" disabled="@(!Guid.TryParse(appId.Trim(), out _))" @onclick="() => Set(() => { Toggle(list, appId.Trim(), true); appId = string.Empty; })">@T["tenants.add"]</button>
        </div>
    };

    private void MakePlan()
    {
        if (edit is null)
        {
            return;
        }

        outcome = current is null
            ? CaEditor.Create(edit, State.Data, State.Config, State.OwnUpn)
            : CaEditor.Update(current, edit, State.Data, State.Config, State.OwnUpn);
    }

    private void Reset()
    {
        loadedKey = null;
        OnParametersSet();
    }

    private void AfterExecute(IReadOnlyList<ChangeResult> results)
    {
        if (results.Any(r => r.Status == ResultStatus.Succeeded))
        {
            done = current is null
                ? T["code.ca-policy-editor.the-policy-has-been-created"]
                : T["code.ca-policy-editor.the-policy-has-been-changed"];
        }
    }
}
