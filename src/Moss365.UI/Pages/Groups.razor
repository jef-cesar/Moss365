@page "/groepen"
@inherits RefreshingPage
@inject NavigationManager Nav

<div class="kb-titelbalk">
    <h1>@T["menu.groepen"]</h1>
    @if (State.Can(Permission.Manage)) { <a class="kb-knop kb-primair" href="groepen/nieuw">@T["groups.new-group"]</a> }
</div>

<p class="kb-zacht">
    @if (State.HasAd && State.HasMicrosoft365)
    {
        <text>@T["groups.all-groups-from-ad-entra"]</text>
    }
    else if (State.HasAd)
    {
        <text>@T["groups.all-groups-from-active-directory"]</text>
    }
    else
    {
        <text>@T["groups.all-groups-from-entra-and"]</text>
    }
</p>

<div class="kb-tegels">
    @foreach (var (label, count, filter) in Tiles())
    {
        <button class="kb-tegel @(z.Kind == filter ? "kb-actief" : null)" @onclick="() => { z.Kpi = null; z.Kind = z.Kind == filter ? null : filter; }">
            <div class="kb-tegel-getal">@count</div><div>@label</div>
        </button>
    }
</div>

<KpiFilter Kpi="ActiveKpi" Count="KpiRows.Count" Shown="Items.Count" Cleared="() => z.Kpi = null" />

<div class="kb-filters kb-plak">
    <input class="kb-invoer kb-breed" placeholder="@(State.HasAd ? "Zoek op naam, adres of sAMAccountName" : "Zoek op naam of adres")" @bind="z.Find" @bind:event="oninput" aria-label="@T["nav.search"]" />
</div>

<KbTable Id="groepen" Items="Items" Columns="columns" Selectable KeyOf="g => g.Key" SelectionChanged="_ => { }" DefaultSorting="naam" CountText="@T.Format("count.groups", Items.Count)" />

<BulkTasks Items="groepen" Count="CountSelected" />

@code {
    /// <summary>Search term and filters, kept while the app is open (Back, Forward, menu).</summary>
    private sealed class Search { public string Find { get; set; } = string.Empty; public string? Kind { get; set; } public string? Kpi { get; set; } }
    private Search? _z;
    private Search z => _z ??= State.PageState.Of<Search>("groepen");

    /// <summary>From a KPI tile: groepen?kpi=zonder-leden (see Core/Analysis/Kpis.cs).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "kpi")] public string? KpiQuestion { get; set; }
    private string? processedKpi;

    protected override void OnParametersSet()
    {
        if (KpiQuestion != processedKpi)
        {
            processedKpi = KpiQuestion;
            if (State.KpiArrival(KpiQuestion, Nav.Uri, "groepen", "groepen"))
            {
                _z = null;
                z.Kpi = KpiQuestion;
            }
        }
    }

    private Kpi? ActiveKpi => Kpis.Find(z.Kpi) is { Items: KpiList.Groups } k ? k : null;
    private IReadOnlyList<Group> KpiRows => ActiveKpi is { } k ? Kpis.Groups(k, State.KpiSource) : Array.Empty<Group>();
    private IReadOnlyList<Column<Group>> columns = Array.Empty<Column<Group>>();

    protected override void OnInitialized() => columns = new List<Column<Group>>
    {
        new() { Key = "naam", Title = T["nested-groups.group"], Cell = g => @<ObjectLink Object="g.Ref" />, SortBy = g => g.Name },
        new() { Key = "soort", Title = T["nested-groups.kind"], Cell = g => @<text>@g.KindText</text>, SortBy = g => g.KindText },
        new() { Key = "waar", Title = T["group-detail.where"], Cell = g => @<text>@g.Layers</text>, SortBy = g => g.Layers },
        new() { Key = "mail", Title = T["guests.e-mail-address"], Cell = g => @<text>@g.Mail</text>, SortBy = g => g.Mail },
        new() { Key = "leden", Title = T["collaboration.members"], Number = true, Cell = g => @<text>@Members(g)</text>, SortBy = g => Members(g) },
        new() { Key = "omschrijving", Title = T["edit-user.description"], Cell = g => @<span class="kb-zacht">@g.Description</span>, SortBy = g => g.Description },
        new() { Key = "sam", Title = T["group-detail.samaccountname"], Hidden = true, Cell = g => @<text>@g.Ad?.SamAccountName</text>, SortBy = g => g.Ad?.SamAccountName },
        new() { Key = "ou", Title = "OU", Hidden = true, Cell = g => @<text>@g.Ad?.OuPath</text>, SortBy = g => g.Ad?.OuPath },
        new() { Key = "weg", Title = T["groups.change-through"], Hidden = true, Cell = g => @<text>@g.Route</text>, SortBy = g => g.Route.ToString() },
        new() { Key = "entraid", Title = T["object-status.entra-id"], Hidden = true, Cell = g => @<code>@(g.Cloud?.Id)</code>, SortBy = g => g.Cloud?.Id },
    }.Where(c => c.Key switch { "sam" or "ou" => State.HasAd, "entraid" => State.HasMicrosoft365, "waar" => State.HasAd && State.HasMicrosoft365, _ => true }).ToList();

    private static int? Members(Group g) => g.Cloud?.CountMembers ?? g.Exo?.CountMembers ?? g.Ad?.CountMembers;

    private static string Category(Group g) => g.Dynamic ? "dynamisch"
        : g.Ad is not null ? (g.Cloud is not null ? "ad-sync" : "ad")
        : g.Cloud is { Type: CloudGroupType.Microsoft365 } ? "m365"
        : g.Route == Moss365.Core.Analysis.WriteRoute.Exchange ? "mail"
        : "cloud";

    private IEnumerable<(string Label, int Count, string Filter)> Tiles()
    {
        var all = State.Data.Index.Groups.ToList();
        foreach (var (label, filter) in new[] { (T["users.only-ad"], "ad"), (T["groups.tile.adsync"], "ad-sync"), ("Microsoft 365", "m365"), (T["groups.tile.mail"], "mail"), (T["groups.tile.cloud"], "cloud"), (T["groups.tile.dynamic"], "dynamisch") })
        {
            // Tiles of a system the tenant does not have are left out (0.21.1)
            var fits = filter switch { "ad" => State.HasAd, "ad-sync" => State.HasAd && State.HasMicrosoft365, _ => State.HasMicrosoft365 };
            if (!fits)
            {
                continue;
            }

            yield return (label, all.Count(g => Category(g) == filter), filter);
        }
    }

    private IReadOnlyList<Group> Items
    {
        get
        {
            var term = z.Find.Trim();
            return (ActiveKpi is null ? State.Data.Index.Groups : KpiRows)
                .Where(g => z.Kind is null || Category(g) == z.Kind)
                .Where(g => term.Length == 0 || new[] { g.Name, g.Mail, g.Ad?.SamAccountName, g.Ad?.Name, g.Description }.Any(v => v?.Contains(term, StringComparison.OrdinalIgnoreCase) == true))
                .OrderBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
    }

    private int CountSelected => State.TableSession("groepen").Selected.Count;
}
