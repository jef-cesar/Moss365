@page "/nieuw"
@inject ManagementState State

<h1>@T["menu.nieuw"]</h1>

<p class="kb-zacht">
    @Html("new-user.intro")
    @if (InCloud)
    {
        @Html("new-user.cloud")
    }
    else
    {
        @Html("new-user.ad")
    }
</p>

@if (State.HasAd && State.HasMicrosoft365)
{
    <div class="kb-filters">
        <label><input type="radio" name="waar" checked="@(!request.InCloud)" @onchange="() => SetInCloud(false)" aria-label="@T["new-user.in-ad"]" /> @T["new-user.in-ad-synchronised-to-entra"]</label>
        <label><input type="radio" name="waar" checked="@request.InCloud" @onchange="() => SetInCloud(true)" aria-label="@T["new-user.only-in-the-cloud"]" /> @T["new-user.only-in-the-cloud-entra"]</label>
    </div>
}

@if (!InCloud && State.Config.Populations.Count == 0)
{
    <div class="kb-melding kb-fout">
        @Html("new-user.nokinds", State.ConfigSourceText ?? T["start.noconfig"])
    </div>
}

<section class="kb-kaart">
    <h2>@T["new-mailbox.details"]</h2>
    @if (State.Config.JobProfiles.Count > 0)
    {
        <div class="kb-rij">
            <label>@T["requests.job-profile"]
                <select class="kb-invoer" @bind="request.JobProfile" @bind:after="ProfileSelected" aria-label="@T["requests.job-profile"]">
                    <option value="">@T["edit-user.none"]</option>
                    @foreach (var jp in State.Config.JobProfiles.OrderBy(x => x.Name, StringComparer.CurrentCultureIgnoreCase))
                    {
                        <option value="@jp.Id">@jp.Name</option>
                    }
                </select>
            </label>
            @if (JobProfiles.Find(State.Config, request.JobProfile) is { } chosen)
            {
                <span class="kb-zacht">
                    @T.Format("new-user.profile.comes", chosen.Groups.Count, chosen.Mailboxes.Count, chosen.Licences.Count > 0 ? T.Format("new-user.profile.licence", string.Join(", ", chosen.Licences)) : string.Empty, chosen.Version)
                </span>
            }
        </div>
    }
    <div class="kb-raster">
        <label>@T["nested-groups.kind"]
            <select class="kb-invoer" @bind="request.Population" @bind:after="Clear">
                <option value="">@(InCloud ? T["plan.none"] : T["script-form.choose"])</option>
                @foreach (var p in State.Config.Populations)
                {
                    <option value="@p.Name">@p.Name (@(InCloud ? p.UpnDomain : p.Ou))</option>
                }
            </select>
        </label>
        @if (InCloud && State.Config.SearchPopulation(request.Population) is null)
        {
            <label>@T["new-mailbox.domain"]
                <select class="kb-invoer" @bind="request.Domain" @bind:after="Clear" aria-label="@T["new-mailbox.domain"]">
                    @foreach (var d in Domains)
                    {
                        <option value="@d">@d</option>
                    }
                </select>
            </label>
        }
        <label>@T["edit-user.first-name"] <input class="kb-invoer" @bind="request.GivenName" @bind:after="Clear" /></label>
        <label>@T["edit-user.last-name"] <input class="kb-invoer" @bind="request.Surname" @bind:after="Clear" /></label>
        @if (!IsVolunteer)
        {
            <label>@T["service-health-card.service"]
                <select class="kb-invoer" @bind="request.Department" @bind:after="DepartmentSelected">
                    <option value="">@T["script-form.choose"]</option>
                    @foreach (var d in State.Config.Departments.OrderBy(d => d.Department, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@d.Department">@d.Department@(string.IsNullOrWhiteSpace(d.Division) ? null : $" ({d.Division})")</option>
                    }
                </select>
            </label>
            <label>@T["bulk-tasks.office"]
                <select class="kb-invoer" @bind="request.Office" @bind:after="Clear">
                    <option value="">@T["script-form.choose"]</option>
                    @foreach (var k in State.Config.Offices)
                    {
                        <option value="@k">@k</option>
                    }
                </select>
            </label>
        }
        <label>@T["bulk-tasks.job-title"] <input class="kb-invoer" @bind="request.JobTitle" @bind:after="Clear" /></label>
        @if (!InCloud)
        {
        <label>@T["edit-user.logon-script"]
            <select class="kb-invoer" @bind="request.LogonScript" @bind:after="Clear">
                <option value="">@T["edit-user.none"]</option>
                @foreach (var s in LogonScripts)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </label>
        }
        <label>@T["licences.licence"]
            <select class="kb-invoer" @bind="request.LicenceSku" @bind:after="Clear">
                <option value="">@T["edit-user.none"]</option>
                @foreach (var l in State.Config.Licences)
                {
                    <option value="@l.Sku">@l.Name @FreeText(l.Sku)</option>
                }
            </select>
        </label>
    </div>
    @if (!InCloud)
    {
        <div class="kb-filters">
            <label><input type="checkbox" @bind="request.DefaultAdGroups" @bind:after="Clear" /> @T["new-user.add-the-default-groups-of"]</label>
        </div>
    }
    <PersonPicker Label="@T["code.new-user.take-over-groups-from-optional"]" Selected="request.Mirror" SelectedChanged="ChooseMirror" />
    <div class="kb-filters">
        <button class="kb-knop kb-primair" @onclick="MakeProposal">@T["new-user.preview"]</button>
        <button class="kb-knop" @onclick="Empty">@T["rooms.clear"]</button>
    </div>
</section>

@if (proposal is not null)
{
    <section class="kb-kaart">
        <h2>@T["new-user.suggestion"]</h2>
        @foreach (var f in proposal.Errors)
        {
            <div class="kb-melding kb-fout">@f</div>
        }
        @foreach (var w in proposal.Warnings)
        {
            <div class="kb-melding">@w</div>
        }
        @if (proposal.CanBeExecuted)
        {
            <table class="kb-tabel kb-naast">
                <tbody>
                    <tr><th>@T["edit-user.display-name"]</th><td>@proposal.ViewName</td></tr>
                    <tr><th>@T["new-user.sign-in-name-upn"]</th><td>@proposal.Upn</td></tr>
                    @if (!InCloud)
                    {
                        <tr><th>@T["group-detail.samaccountname"]</th><td>@proposal.Sam</td></tr>
                        <tr><th>@T["new-user.location-in-ad"]</th><td>@proposal.Dn</td></tr>
                    }
                    else
                    {
                        <tr><th>@T["group-detail.where"]</th><td>@T["new-user.entra-cloud-account"]</td></tr>
                    }
                </tbody>
            </table>
        }
    </section>

    @if (proposal.CanBeExecuted)
    {
        <PlanView Plan="proposal.Now" Context="@($"Nieuwe gebruiker {proposal.Upn}")" Title="@(InCloud ? "Nu in Entra" : "Nu in AD")" Executed="AfterExecute" />

        @if (!showPassword)
        {
            <details class="kb-later">
                <summary>@T["new-user.run-later-e-g-on"]</summary>
                <p class="kb-zacht">
                    @Html("new-user.scheduled")
                </p>
                <Schedule Selected="PlanIn" />
                @if (scheduled is not null) { <div class="kb-melding kb-goed">@T.Format("new-user.scheduled-on-0", scheduled.Value.ToString("dd/MM/yyyy HH:mm"))</div> }
            </details>
        }

        @if (showPassword)
        {
            <section class="kb-kaart">
                <h2>@T["scheduled.initial-password"]</h2>
                <p><code class="kb-wachtwoord">@proposal.Password</code></p>
                <p class="kb-zacht">
                    @T["new-user.pass-this-on-to-the"]
                </p>
            </section>
        }

        <section class="kb-kaart">
            <h2>@(InCloud ? T["code.new-user.as-soon-as-the-mailbox"] : T["code.new-user.after-the-synchronisation-to-entra"]) (@proposal.AfterSynchronisation.Count)</h2>
            @if (proposal.AfterSynchronisation.Count == 0)
            {
                <p class="kb-zacht">@(InCloud ? T["code.new-user.no-mail-groups-or-access"] : T["code.new-user.no-licence-or-cloud-groups"])</p>
            }
            else
            {
                <table class="kb-tabel">
                    <thead><tr><th>@T["plan.system"]</th><th>@T["plan.change"]</th><th>@T["plan.becomes"]</th></tr></thead>
                    <tbody>
                        @foreach (var w in proposal.AfterSynchronisation)
                        {
                            <tr><td>@w.SystemText</td><td>@w.Description</td><td>@w.NewValue</td></tr>
                        }
                    </tbody>
                </table>
                <p class="kb-zacht">
                    @if (followUpSaved)
                    {
                        <span class="kb-ok">@T["new-user.saved-as-a-follow-up"]</span>
                    }
                    else
                    {
                        @(InCloud ? T["code.new-user.these-steps-become-a-follow"] : T["code.new-user.these-steps-become-a-follow-2"])
                    }
                    @(InCloud ? T["code.new-user.exchange-creates-the-mailbox-a"] : T["code.new-user.entra-connect-synchronises-every-30"]) @Html("new-user.finish-in-follow-up")
                </p>
            }
        </section>
    }
}

@code {
    // The form is kept until you run, schedule or clear it (never the initial password)
    private const string Form = "nieuw";
    private NewUserRequest request = new();
    private NewUserProposal? proposal;
    private string? password;
    private bool showPassword;
    private bool followUpSaved;

    protected override void OnInitialized() => request = Saved();

    private NewUserRequest Saved() => State.PageState.Form<NewUserRequest>(Form, "nieuw", "Nieuwe gebruiker");

    // Also show the script of the department when it is not in the list
    private IEnumerable<string> LogonScripts => string.IsNullOrWhiteSpace(request.LogonScript) || State.Config.LogonScripts.Contains(request.LogonScript, StringComparer.OrdinalIgnoreCase)
        ? State.Config.LogonScripts
        : State.Config.LogonScripts.Append(request.LogonScript);

    /// <summary>In the cloud: always for a tenant without AD, by choice for a hybrid tenant (0.31).</summary>
    private bool InCloud => !State.HasAd || (State.HasMicrosoft365 && request.InCloud);

    private IReadOnlyList<string> Domains => CloudUserPlans.Domains(State.Data);

    private void SetInCloud(bool value)
    {
        request.InCloud = value;
        Clear();
    }

    private bool IsVolunteer => State.Config.SearchPopulation(request.Population)?.City is not null;

    private string FreeText(string sku)
    {
        var l = State.Data.Licences.FirstOrDefault(x => string.Equals(x.SkuPartNumber, sku, StringComparison.OrdinalIgnoreCase));
        return l is null ? string.Empty : T.Format("code.new-user.free-of", l.Free, l.Total);
    }

    private DateTimeOffset? scheduled;

    private void PlanIn(DateTimeOffset whenValue)
    {
        if (proposal is null)
        {
            return;
        }

        State.Schedule(ScheduledPlans.Onboarding(proposal, whenValue, State.User));
        scheduled = whenValue;
        password = null;
        State.PageState.Forget(Form);
    }

    private void Clear()
    {
        scheduled = null;
        proposal = null;
        showPassword = false;
        followUpSaved = false;
    }

    private void DepartmentSelected()
    {
        // The logon script of the department as a suggestion
        if (State.Config.SearchDepartment(request.Department)?.LogonScript is { Length: > 0 } script)
        {
            request.LogonScript = script;
        }

        Clear();
    }

    /// <summary>A job profile fills in what is still empty; its groups, mailboxes and licences come along in the plan.</summary>
    private void ProfileSelected()
    {
        if (request.JobProfile?.Length == 0) request.JobProfile = null;
        if (JobProfiles.Find(State.Config, request.JobProfile) is { } jp)
        {
            if (string.IsNullOrWhiteSpace(request.Department) && jp.Department is { Length: > 0 } d) request.Department = State.Config.SearchDepartment(d)?.Department ?? d;
            if (string.IsNullOrWhiteSpace(request.Office) && jp.Office is { Length: > 0 } o) request.Office = o;
            if (string.IsNullOrWhiteSpace(request.JobTitle) && jp.JobTitle is { Length: > 0 } t) request.JobTitle = t;
            if (string.IsNullOrWhiteSpace(request.LogonScript) && jp.LogonScript is { Length: > 0 } s) request.LogonScript = s;
        }

        Clear();
    }

    private void ChooseMirror(Person? p)
    {
        request.Mirror = p;
        Clear();
    }

    private void Empty()
    {
        State.PageState.Forget(Form);
        request = Saved();
        password = null;
        Clear();
    }

    private void MakeProposal()
    {
        if (request.LicenceSku?.Length == 0) request.LicenceSku = null;
        if (request.LogonScript?.Length == 0) request.LogonScript = null;

        // One initial password per request, so that it does not change with every preview
        if (InCloud && State.Config.SearchPopulation(request.Population) is null && string.IsNullOrWhiteSpace(request.Domain))
        {
            request.Domain = Domains.FirstOrDefault();
        }

        proposal = InCloud
            ? CloudUserPlans.NewUser(State.Data, State.Config, request, password)
            : PlanBuilder.NewUser(State.Data, State.Config, request, password);
        password = proposal.Password;
        showPassword = false;
        followUpSaved = false;
    }

    private void AfterExecute(IReadOnlyList<ChangeResult> results)
    {
        if (proposal is null)
        {
            return;
        }

        var create = proposal.Now.First(w => w.ChangeAction is ChangeAction.AdCreateUser or ChangeAction.GraphCreateUser);
        if (results.Any(r => r.ChangeId == create.Id && r.Status == ResultStatus.Succeeded))
        {
            showPassword = true;
            State.PageState.Forget(Form);
            if (proposal.AfterSynchronisation.Count > 0)
            {
                State.AddFollowUp(new FollowUpTask
                {
                    Upn = proposal.Upn,
                    Description = $"Nieuwe gebruiker {proposal.ViewName}",
                    Changes = proposal.AfterSynchronisation.ToList(),
                });
                followUpSaved = true;
            }

            // A next request gets a new password
            password = null;
        }
    }
}
