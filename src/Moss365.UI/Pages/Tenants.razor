@page "/tenants"
@layout SettingsLayout
@using Moss365.Core.Storage
@* The tenants of this installation (R3): each with its own database, connections, sign-in and colour. Removing a tenant
   never deletes its data: its folder moves to tenants\removed. *@
@inject ManagementState State
@inject IServiceProvider Services
@inject NavigationManager Nav

<h1>@T["menu.tenants"]</h1>

<p class="kb-zacht">
    @T["tenants.every-organisation-tenant-has-its"]
</p>

@if (Hub is not { } hub)
{
    <div class="kb-melding">@T["tenants.managing-tenants-is-only-possible"]</div>
}
else
{
    @foreach (var m in hub.Messages)
    {
        <div class="kb-melding">@m</div>
    }

    <table class="kb-tabel">
        <thead><tr><th>@T["variables-editor.name"]</th><th>@T["tenants.colour"]</th><th>@T["devices.systems"]</th><th>@T["set-up-tenant.tenant-id"]</th><th>@T["tenants.folder"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in hub.Tenants)
            {
                var current = t.Id == State.Tenant.Id;
                <tr>
                    <td>
                        @if (editing == t.Id)
                        {
                            <input class="kb-invoer" @bind="editName" aria-label="@T["variables-editor.name"]" />
                        }
                        else
                        {
                            <strong style="color: @t.Colour">@t.Name</strong> @if (current) { <span class="kb-label">@T["tenants.open"]</span> }
                        }
                    </td>
                    <td>
                        @if (editing == t.Id)
                        {
                            @foreach (var c in TenantColours.All)
                            {
                                <button class="kb-tenant-staal" style="--kb-tenant: @c" aria-pressed="@(c == editColour)" aria-label="Kleur @c" @onclick="() => editColour = c"></button>
                            }
                        }
                        else
                        {
                            <span class="kb-tenant-staal" style="--kb-tenant: @t.Colour"></span>
                        }
                    </td>
                    <td>
                        @if (editing == t.Id)
                        {
                            <SystemsChoice @bind-Value="editSystems" />
                        }
                        else
                        {
                            @SystemsText(t.Systems)
                        }
                    </td>
                    <td><code>@(t.TenantId ?? "(nog niet gekend)")</code></td>
                    <td class="kb-zacht"><code>tenants\@t.Id</code></td>
                    <td>
                        <span class="kb-filters">
                            @if (editing == t.Id)
                            {
                                <button class="kb-knop kb-klein kb-primair" @onclick="() => Save(hub, t)">@T["action.save"]</button>
                                <button class="kb-knop kb-klein" @onclick="() => editing = null">@T["action.cancel"]</button>
                            }
                            else
                            {
                                @if (!current)
                                {
                                    <button class="kb-knop kb-klein kb-primair" @onclick="() => Open(hub, t)">@T["script-result.open"]</button>
                                }
                                else
                                {
                                    <a class="kb-knop kb-klein kb-primair" href="inrichten">@T["tenants.set-up"]</a>
                                }
                                <button class="kb-knop kb-klein" @onclick="() => Edit(t)">@T["tenants.change"]</button>
                                <button class="kb-knop kb-klein" @onclick="() => Backup(hub, t)">@T["manage-ca.backup"]</button>
                                @if (!current)
                                {
                                    <button class="kb-knop kb-klein kb-gevaar" @onclick="() => { removing = t.Id; confirmName = string.Empty; }">@T["tenants.remove-from-the-list"]</button>
                                }
                            }
                        </span>
                        @if (unlocking == t.Id)
                        {
                            <div class="kb-melding">
                                @Html("tenants.locked", t.Name)
                                <input type="password" class="kb-invoer" @bind="secret" aria-label="@T["tenants.password-or-recovery-key"]" />
                                <button class="kb-knop kb-klein kb-primair" disabled="@(secret.Length == 0)" @onclick="() => Unlock(hub, t)">@T["script-result.open"]</button>
                                <button class="kb-knop kb-klein" @onclick="() => { unlocking = null; secret = string.Empty; }">@T["action.cancel"]</button>
                            </div>
                        }
                        @if (removing == t.Id)
                        {
                            <div class="kb-melding kb-fout">
                                @Html("tenants.remove", t.Name)
                                <input class="kb-invoer" @bind="confirmName" @bind:event="oninput" aria-label="@T["tenants.name-to-confirm"]" />
                                <button class="kb-knop kb-klein kb-gevaar" disabled="@(confirmName.Trim() != t.Name)" @onclick="() => Remove(hub, t)">@T["tenants.remove-from-the-list"]</button>
                                <button class="kb-knop kb-klein" @onclick="() => removing = null">@T["action.cancel"]</button>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <section class="kb-kaart">
        <h2>@T["tenants.add-tenant"]</h2>
        <div class="kb-rij">
            <label>@T["variables-editor.name"] <input class="kb-invoer" @bind="newName" placeholder="@T["tenants.e-g-contoso"]" /></label>
        </div>
        <SystemsChoice @bind-Value="newSystems" Legend="Wat heeft deze tenant?" />
        <div class="kb-rij">
            <button class="kb-knop kb-primair" disabled="@(newName.Trim().Length == 0)" @onclick="() => Add(hub)">@T["tenants.add"]</button>
        </div>
        <p class="kb-zacht">
            @T["tenants.a-new-tenant-starts-empty"]
        </p>
    </section>

    <section class="kb-kaart">
        <h2>@T["tenants.restore-backup"]</h2>
        <p class="kb-zacht">
            @T["tenants.a-backup-is-the-full"]
        </p>
        <div class="kb-rij">
            <label>@T["start.file"] <input class="kb-invoer" @bind="restoreFile" placeholder="@T["tenants.full-path-to-moss365-db"]" /></label>
            <label>@T["variables-editor.name"] <input class="kb-invoer" @bind="restoreName" placeholder="@T["tenants.e-g-contoso-restored"]" /></label>
            <label>@T["tenants.recovery-key-encrypted-backup"] <input class="kb-invoer" @bind="restoreKey" aria-label="@T["tenants.recovery-key"]" /></label>
            @if (!hub.CanProtect(Moss365.Core.Storage.EncryptionMethod.WindowsAccount))
            {
                <label>@T["tenants.new-password"] <input type="password" class="kb-invoer" @bind="restorePassword" aria-label="@T["tenants.new-password"]" /></label>
            }
            <button class="kb-knop" disabled="@(restoreFile.Trim().Length == 0 || restoreName.Trim().Length == 0)" @onclick="() => Restore(hub)">@T["tenants.restore-as-new-tenant"]</button>
        </div>
    </section>

    @if (message is not null)
    {
        <div class="kb-melding @(error ? "kb-fout" : null)">@message</div>
    }
}

@code {
    private TenantHub? Hub => Services.GetService(typeof(TenantHub)) as TenantHub;

    private string newName = string.Empty;
    private string? editing;
    private string editName = string.Empty;
    private string editColour = TenantColours.All[0];
    private string? removing;
    private string confirmName = string.Empty;
    private string? message;
    private bool error;
    private string restoreFile = string.Empty;
    private string restoreName = string.Empty;

    private void Backup(TenantHub hub, TenantInfo t)
    {
        try
        {
            var path = hub.Backup(t, Path.Combine(State.AppEnvironment.ExportFolder, "Back-ups"));
            (message, error) = ($"Back-up van \"{t.Name}\" bewaard: {path}", false);
            State.AppEnvironment.ShowFile(path);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or Microsoft.Data.Sqlite.SqliteException)
        {
            (message, error) = ("Back-up mislukt: " + ex.Message, true);
        }
    }

    private void Restore(TenantHub hub)
    {
        try
        {
            var t = hub.Restore(restoreFile.Trim().Trim('"'), restoreName, restoreKey.Length > 0 ? restoreKey : null, restorePassword.Length > 0 ? restorePassword : null);
            (message, error) = ($"Teruggezet als \"{t.Name}\". Open de tenant om hem te gebruiken.", false);
            restoreFile = restoreName = restoreKey = restorePassword = string.Empty;
        }
        catch (Exception ex) when (ex is IOException or ArgumentException or InvalidDataException or UnauthorizedAccessException)
        {
            (message, error) = (ex.Message.Split(" (Parameter")[0], true);
        }
    }

    private void Add(TenantHub hub)
    {
        try
        {
            var t = hub.Add(newName, systems: newSystems);
            newName = string.Empty;
            newSystems = TenantSystems.Both;
            (message, error) = ($"Tenant \"{t.Name}\" toegevoegd. Open hem om te verbinden.", false);
        }
        catch (ArgumentException ex)
        {
            (message, error) = (ex.Message.Split(" (Parameter")[0], true);
        }
    }

    private TenantSystems editSystems = TenantSystems.Both;
    private TenantSystems newSystems = TenantSystems.Both;

    private void Edit(TenantInfo t) => (editing, editName, editColour, editSystems) = (t.Id, t.Name, t.Colour, t.Systems == TenantSystems.None ? TenantSystems.Both : t.Systems);

    private static string SystemsText(TenantSystems s) => s switch
    {
        TenantSystems.ActiveDirectory => "Active Directory",
        TenantSystems.Microsoft365 => "Microsoft 365",
        _ => "Active Directory en Microsoft 365",
    };

    private void Save(TenantHub hub, TenantInfo t)
    {
        try
        {
            hub.Update(t with { Name = editName, Colour = editColour, Systems = editSystems });
            editing = null;
            (message, error) = (null, false);
            if (t.Id == State.Tenant.Id)
            {
                Nav.NavigateTo("tenants", forceLoad: true);
            }
        }
        catch (ArgumentException ex)
        {
            (message, error) = (ex.Message.Split(" (Parameter")[0], true);
        }
    }

    private string? unlocking;
    private string secret = string.Empty;
    private string restoreKey = string.Empty;
    private string restorePassword = string.Empty;

    /// <summary>From the bar: a tenant that is locked comes here to be unlocked first.</summary>
    [SupplyParameterFromQuery(Name = "openen")] public string? OpenId { get; set; }

    protected override void OnInitialized()
    {
        if (OpenId is { Length: > 0 } id && Hub is { } hub && hub.Tenants.FirstOrDefault(x => x.Id == id) is { } tenant)
        {
            Open(hub, tenant);
        }
    }

    private void Unlock(TenantHub hub, TenantInfo t)
    {
        if (hub.Unlock(t.Id, secret))
        {
            secret = string.Empty;
            unlocking = null;
            Open(hub, t);
        }
        else
        {
            (message, error) = ("Dat wachtwoord of die herstelsleutel past niet.", true);
        }
    }

    private void Open(TenantHub hub, TenantInfo t)
    {
        if (hub.NeedsUnlock(t))
        {
            unlocking = t.Id;
            return;
        }

        hub.Switch(t.Id);
        Nav.NavigateTo(string.Empty, forceLoad: true);
    }

    private void Remove(TenantHub hub, TenantInfo t)
    {
        try
        {
            var folder = hub.Remove(t.Id);
            removing = null;
            (message, error) = ($"\"{t.Name}\" staat niet meer in de lijst." + (folder is null ? string.Empty : $" De gegevens staan in {folder}."), false);
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or UnauthorizedAccessException)
        {
            (message, error) = (ex.Message, true);
        }
    }
}
