@page "/verbindingen"
@layout SettingsLayout
@implements IDisposable
@inject ManagementState State

<h1>@T["menu.verbindingen"]</h1>

<LeaveConfirm Active="State.SettingsChanged" Saving="Save" Discard="State.DiscardSettings"
                   Text="@T["code.connections.you-changed-the-connection-settings"]" />

<p class="kb-zacht">
    @Html("connections.intro", State.Database.FilePath)
</p>

@if (!State.CanConnect)
{
    <div class="kb-melding">@T["connections.connecting-live-is-only-available"]</div>
}

<section class="kb-kaart">
    <h2>@T["connections.what-does-this-tenant-have"]</h2>
    @if (Hub is { } hub && State.Can(Permission.Settings) && !State.IsHistoric)
    {
        <SystemsChoice @bind-Value="systems" Legend="@T.Format("connections.systems-of", State.Tenant.Name)" />
        <div class="kb-rij">
            <button class="kb-knop kb-primair" disabled="@(systems == Current)" @onclick="() => SaveSystems(hub)">@T["action.save"]</button>
            @if (systems != Current) { <span class="kb-label">@T["connections.not-saved"]</span> }
        </div>
    }
    else
    {
        <p>@Html("connections.systems", SystemsChoice.Text(State.Tenant.Systems))</p>
    }
    <p class="kb-zacht">
        @T["connections.what-the-tenant-does-not"]
    </p>
    <p class="kb-zacht">
        @Html("connections.roles", State.Config.RolesModeEffective switch { RolesMode.Off => T["connections.roles.off"], RolesMode.Required => T["connections.roles.required"], _ => T["connections.roles.transition"] })
    </p>
</section>

@if (State.HasAd)
{
<section class="kb-kaart">
    <h2>@T["user-detail.on-premises-ad"]</h2>
    <div class="kb-rij">
        <label>@T["connections.domain-controller"]</label>
        <input class="kb-invoer kb-breed" placeholder="@T["connections.name-or-ip-address-e"]" @bind="State.Settings.AdServer" />
    </div>
    <div class="kb-rij">
        <label>@T["connections.ad-account"]</label>
        <input class="kb-invoer kb-breed" placeholder="@T["connections.e-g-contoso-name-empty"]" @bind="State.Settings.AdUser" />
    </div>
    <div class="kb-rij">
        <label>@T["encryption-panel.password"]</label>
        <input class="kb-invoer" type="password" autocomplete="off" @bind="State.AdPassword" />
        <span class="kb-zacht">@T["connections.only-for-this-session"]</span>
    </div>
    <div class="kb-rij">
        <label>@T["connections.netlogon"]</label>
        <input class="kb-invoer kb-breed" placeholder="@T["connections.empty-domaincontroller-netlogon"]" @bind="State.Settings.NetlogonPath" aria-label="@T["connections.netlogon"]" />
        <span class="kb-zacht">@T["connections.for-the-logon-scripts-with"]</span>
    </div>
    <p class="kb-zacht">
        @T["connections.the-app-talks-to-the"]
    </p>
</section>
}

@if (State.HasMicrosoft365)
{
<section class="kb-kaart">
    <h2>@T["connections.entra-id-and-exchange-online"]</h2>
    <div class="kb-rij">
        <label>@T["set-up-tenant.tenant-id"]</label>
        <input class="kb-invoer kb-breed" @bind="State.Settings.TenantId" />
    </div>
    <div class="kb-rij">
        <label>@T["set-up-tenant.client-id"]</label>
        <input class="kb-invoer kb-breed" placeholder="@T["connections.application-client-id-of-the"]" @bind="State.Settings.ClientId" />
    </div>
    <div class="kb-rij">
        <label>@T["connections.admin-account"]</label>
        <input class="kb-invoer kb-breed" placeholder="bv. naam@contoso.com" @bind="State.Settings.ManagementUpn" />
    </div>
    <label>
        <input type="checkbox" checked="@State.Settings.RememberSignIn" @onchange="e => State.RememberSignIn(e.Value is true)" aria-label="@T["connections.stay-signed-in"]" />
        @T["connections.stay-signed-in-on-this"]
    </label>
    <p class="kb-zacht">
        @T["connections.then-you-do-not-have"]
    </p>
    <p class="kb-zacht">
        @Html("connections.entra.help")
    </p>
</section>
}

@if (State.HasGoogle)
{
<section class="kb-kaart">
    <h2>@T["systems.google.name"] <PlatformLabel Platform="Platform.GoogleWorkspace" /></h2>
    <div class="kb-rij">
        <label>@T["connections.google.domain"]</label>
        <input class="kb-invoer kb-breed" placeholder="@T["connections.google.domain.example"]" @bind="State.Settings.GoogleDomain" aria-label="@T["connections.google.domain"]" />
    </div>
    <div class="kb-rij">
        <label>@T["connections.google.client-id"]</label>
        <input class="kb-invoer kb-breed" @bind="State.Settings.GoogleClientId" aria-label="@T["connections.google.client-id"]" autocomplete="off" spellcheck="false" />
    </div>
    <div class="kb-rij">
        <label>@T["connections.google.client-secret"]</label>
        <input class="kb-invoer kb-breed" type="password" @bind="State.Settings.GoogleClientSecret" aria-label="@T["connections.google.client-secret"]" autocomplete="off" />
    </div>
    <p class="kb-zacht">@Html("connections.google.help")</p>
    <button class="kb-knop" disabled="@(State.TaskBusy || !State.CanConnect || !State.Settings.GoogleFilled)" @onclick="() => Load(LoadKind.Google)">@T["connections.google.read"]</button>
</section>
}

<div class="kb-filters">
    <button class="kb-knop" @onclick="Save">@T["connections.save-settings"]</button>
    @if (State.HasAd || State.HasMicrosoft365)
    {
        <button class="kb-knop kb-primair" disabled="@(State.TaskBusy || !State.CanConnect)" @onclick="() => Load(LoadKind.Everything)">@T["set-up-tenant.load-everything-live"]</button>
        <button class="kb-knop" disabled="@(State.TaskBusy || !State.CanConnect)" @onclick="() => Load(LoadKind.AdAndEntra)">@T.Format("connections.load-live-0", State.HasAd && State.HasMicrosoft365 ? T["code.connections.ad-and-entra"] : State.HasAd ? "AD" : "Entra")</button>
    }
    @if (State.HasMicrosoft365)
    {
        <button class="kb-knop" disabled="@(State.TaskBusy || !State.CanConnect)" @onclick="() => Load(LoadKind.Rooms)">@T["connections.load-rooms-from-exchange"]</button>
        <button class="kb-knop" disabled="@(State.TaskBusy || !State.CanConnect)" @onclick="() => Load(LoadKind.Mailboxes)">@T["connections.load-mailboxes-and-groups-from"]</button>
    }
    @if (message is not null) { <span class="kb-ok">@message</span> }
</div>
<p class="kb-zacht">@T["connections.loading-runs-in-the-background"]</p>
<label>
    <input type="checkbox" @bind="State.Settings.RefreshAuto" @bind:after="State.SaveSettings" />
    @T["connections.refresh-every-15-minutes-ad"]
    <span class="kb-zacht">@T["connections.only-when-you-are-signed"]</span>
</label>
<label>
    <input type="checkbox" @bind="State.Settings.QuickLoad" @bind:after="State.SaveSettings" />
    @T["connections.quick-load-only-what-changed"]
    <span class="kb-zacht">
        @T.Format("connections.ad-0-entra-groups-1", State.AdCanQuick ? T["word.can"] : T["code.connections.everything-next-time"], State.EntraCanQuick ? T["word.can"] : T["code.connections.everything-next-time"])
    </span>
</label>
@if (State.Error is not null) { <div class="kb-melding kb-fout">@State.Error</div> }
@if (State.ExchangeMessage is { } exo) { <div class="kb-melding">@exo</div> }

<TaskProgress />

<section class="kb-kaart">
    <h2>@T["connections.current-data"]</h2>
    <p>@T.Format("connections.signed-in-as-0", State.User)</p>
    <ul class="kb-lijst-plat">
        @foreach (var part in new[] { "AD", "Entra", "Rooms", "Postvakken" })
        {
            <li><strong>@part</strong>: @(State.LiveOn.TryGetValue(part, out var t) ? T.Format("code.connections.loaded-live-at", t) : T["code.connections.from-the-inventory"])</li>
        }
        @if (State.SavedInventory is { } folder) { <li class="kb-zacht">@T.Format("connections.last-saved-as-inventory-0", System.IO.Path.GetFileName(folder))</li> }
    </ul>
    <table class="kb-tabel">
        <thead><tr><th>@T["organisation-history.source"]</th><th>@T["connections.from"]</th><th class="kb-getal">@T["start.rows"]</th></tr></thead>
        <tbody>
            @foreach (var b in State.Data.Sources)
            {
                <tr><td>@b.File</td><td>@(b.Folder is null ? T["start.notfound"] : System.IO.Path.GetFileName(b.Folder))</td><td class="kb-getal">@b.Rows</td></tr>
            }
        </tbody>
    </table>
</section>

@code {
    [Inject] private IServiceProvider Services { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private TenantHub? Hub => Services.GetService(typeof(TenantHub)) as TenantHub;
    private Moss365.Core.Storage.TenantSystems Current => State.Systems;
    private Moss365.Core.Storage.TenantSystems? _systems;
    private Moss365.Core.Storage.TenantSystems systems { get => _systems ?? Current; set => _systems = value; }

    /// <summary>Saves the choice and reloads, so that the menu, the screens and the data follow it.</summary>
    private void SaveSystems(TenantHub hub)
    {
        hub.Update(State.Tenant with { Systems = systems });
        Nav.NavigateTo("verbindingen", forceLoad: true);
    }

    private string? message;

    protected override void OnInitialized() => State.Changed += Reload;

    private void Reload() => _ = InvokeAsync(StateHasChanged);

    // After every change in a field: update the indication at the top and in the menu
    private bool previousChanged;

    protected override void OnAfterRender(bool firstRender)
    {
        if (State.SettingsChanged != previousChanged)
        {
            previousChanged = State.SettingsChanged;
            State.Pending.Reload();
        }
    }

    public void Dispose() => State.Changed -= Reload;

    private void Save()
    {
        State.SaveSettings();
        message = T["code.connections.saved-without-password"];
    }

    private void Load(LoadKind kind)
    {
        State.SaveSettings();
        message = State.StartLoading(kind) ? null : State.TaskBusy ? T["code.connections.a-task-is-already-running"] : null;
    }
}
