@page "/rooms"
@inherits VerversendePagina
@inject NavigationManager Nav

<h1>Rooms</h1>

<p class="kb-zacht">
    @State.Data.Rooms.Count vergaderruimtes uit
    @(State.Data.Bronnen.FirstOrDefault(b => b.Bestand.Contains("rooms", StringComparison.OrdinalIgnoreCase))?.Map is { } m ? System.IO.Path.GetFileName(m) : "geen bron").
    Voor actuele waarden: <a href="verbindingen">Rooms laden uit Exchange</a>. Gemarkeerd = wijkt af van de standaard in de organisatie.
</p>

@if (State.Data.Rooms.Count == 0)
{
    <div class="kb-melding">Geen rooms geladen. Laad ze uit Exchange of uit een inventaris met <code>exo-rooms-overzicht.csv</code>.</div>
}
else
{
    <KpiFilter Kpi="ActieveKpi" Aantal="Lijst.Count" Gewist="() => k.Kpi = null" />

    <KbTabel Id="rooms" Items="Lijst" Kolommen="kolommen" StandaardSortering="naam" Selecteerbaar SleutelVan="r => r.Smtp"
             SelectieGewijzigd="_ => plan = null" RijKlasse="@(r => Afwijkingen(r).Count > 0 ? "kb-verschil" : null)" />

    @if (State.Mag(Recht.Beheren))
    {
    <section class="kb-kaart">
        <h2>Wijzigen (@gekozen.Count geselecteerd)</h2>
        <p class="kb-zacht">Leeg laten = niet wijzigen. Alleen wat verschilt met de huidige waarde komt in het plan.</p>
        <div class="kb-filters">
            <button class="kb-knop" @onclick="StandaardInvullen">Standaard invullen</button>
            <button class="kb-knop" @onclick="Leegmaken">Leegmaken</button>
        </div>
        <RoomFormulier Gewenst="gewenst" />
        <div class="kb-filters">
            <button class="kb-knop kb-primair" disabled="@(gekozen.Count == 0)" @onclick="MaakPlan">Plan maken</button>
        </div>
    </section>
    }

    @if (plan is not null)
    {
        <PlanWeergave Plan="plan" Context="@($"Rooms ({gekozen.Count})")" Titel="Wijzigingen aan de rooms" Uitgevoerd="NaUitvoeren" />
    }
}

@code {
    // De gekozen rooms (ook na Terug of Vooruit) en het formulier, zolang de app open is
    private HashSet<string> gekozen => State.TabelSessie("rooms").Gekozen;

    /// <summary>Vanuit een KPI-tegel: rooms?kpi=afwijkend (zie Core/Analyse/Kpis.cs).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "kpi")] public string? KpiVraag { get; set; }
    private string? verwerkteKpi;
    private KpiKeuze? _k;
    private KpiKeuze k => _k ??= State.Paginastatus.Van<KpiKeuze>("rooms");

    protected override void OnParametersSet()
    {
        if (KpiVraag != verwerkteKpi)
        {
            verwerkteKpi = KpiVraag;
            if (State.KpiAankomst(KpiVraag, Nav.Uri, "rooms", "rooms"))
            {
                _k = null;
                k.Kpi = KpiVraag;
            }
        }
    }

    private Kpi? ActieveKpi => Kpis.Zoek(k.Kpi) is { Lijst: KpiLijst.Rooms } x ? x : null;
    private IReadOnlyList<Room> Lijst => ActieveKpi is { } x ? Kpis.Rooms(x, State.KpiBron) : State.Data.Rooms;
    private const string Formulier = "rooms/wijzigen";
    private IReadOnlyList<Kolom<Room>> kolommen = Array.Empty<Kolom<Room>>();

    protected override void OnInitialized() => kolommen = new List<Kolom<Room>>
    {
        new() { Sleutel = "naam", Titel = "Room", Cel = r => @<text><ObjectLink Id="@r.Smtp" /><div class="kb-zacht">@r.Smtp</div></text>, SorteerOp = r => r.DisplayName, Tekst = r => $"{r.DisplayName} ({r.Smtp})" },
        new() { Sleutel = "gebouw", Titel = "Gebouw", Cel = r => @<text>@r.Gebouw</text>, SorteerOp = r => r.Gebouw },
        new() { Sleutel = "verdieping", Titel = "Verd.", Cel = r => @<text>@r.Verdieping</text>, SorteerOp = r => r.Verdieping },
        new() { Sleutel = "capaciteit", Titel = "Cap.", Getal = true, Cel = r => @<text>@r.Capaciteit</text>, SorteerOp = r => r.Capaciteit },
        new() { Sleutel = "verwerking", Titel = "Verwerking", Cel = r => @<text>@r.AutomateProcessing</text>, SorteerOp = r => r.AutomateProcessing },
        new() { Sleutel = "venster", Titel = "Venster", Getal = true, Cel = r => @<text>@r.BookingWindowInDays</text>, SorteerOp = r => r.BookingWindowInDays },
        new() { Sleutel = "recht", Titel = "Standaardrecht", Cel = r => @<text>@r.StandaardAgendaRecht</text>, SorteerOp = r => r.StandaardAgendaRecht },
        new() { Sleutel = "afwijkingen", Titel = "Afwijkingen", Cel = r => @<span class="kb-zacht">@string.Join("; ", Afwijkingen(r))</span>, SorteerOp = r => Afwijkingen(r).Count, Tekst = r => string.Join("; ", Afwijkingen(r)) },
        new() { Sleutel = "duur", Titel = "Max. duur", Verborgen = true, Getal = true, Cel = r => @<text>@r.MaximumDurationInMinutes</text>, SorteerOp = r => r.MaximumDurationInMinutes },
        new() { Sleutel = "gedelegeerden", Titel = "Gedelegeerden", Verborgen = true, Cel = r => @<text>@r.ResourceDelegates.Replace("|", ", ")</text>, SorteerOp = r => r.ResourceDelegates, Tekst = r => r.ResourceDelegates.Replace("|", ", ") },
        new() { Sleutel = "verborgen", Titel = "Verborgen", Verborgen = true, Cel = r => @<text>@(r.Verborgen ? "ja" : "")</text>, SorteerOp = r => r.Verborgen ? "ja" : "" },
        new() { Sleutel = "entraid", Titel = "Entra-ID", Verborgen = true, Cel = r => @<code>@(State.Data.Index.AccountVan(r.Smtp, r.Alias)?.Entra?.Id)</code>, SorteerOp = r => State.Data.Index.AccountVan(r.Smtp, r.Alias)?.Entra?.Id },
    };

    private IReadOnlyList<string> Afwijkingen(Room r) => PlanBouwer.RoomAfwijkingen(r, State.Config.Rooms.Standaard);
    private RoomGewenst? _gewenst;
    private RoomGewenst gewenst => _gewenst ??= State.Paginastatus.Formulier<RoomGewenst>(Formulier, "rooms", "Rooms", ingevuld: IsIngevuld);

    // Ook de standaard invullen telt als een ingevuld formulier: er staat iets klaar om toe te passen
    private static bool IsIngevuld(RoomGewenst g) => typeof(RoomGewenst).GetProperties().Any(p => p.GetValue(g) is not null);
    private List<Wijziging>? plan;

    private void Leegmaken()
    {
        State.Paginastatus.Vergeet(Formulier);
        _gewenst = null;
        plan = null;
    }

    private void StandaardInvullen()
    {
        State.Paginastatus.Vergeet(Formulier);
        _gewenst = State.Paginastatus.Formulier(Formulier, "rooms", "Rooms", () => RoomGewenst.UitStandaard(State.Config.Rooms.Standaard), IsIngevuld);
        plan = null;
    }

    private void NaUitvoeren(IReadOnlyList<WijzigingResultaat> resultaten)
    {
        if (resultaten.Any(r => r.Status == ResultaatStatus.Gelukt))
        {
            State.Paginastatus.Vergeet(Formulier);
        }
    }

    private void MaakPlan()
    {
        var g = RoomFormulier.Opgeschoond(gewenst);
        plan = State.Data.Rooms.Where(r => gekozen.Contains(r.Smtp)).SelectMany(r => PlanBouwer.Room(r, g)).ToList();
    }
}
