@page "/rooms"
@inherits RefreshingPage
@inject NavigationManager Nav

<h1>Rooms</h1>

<p class="kb-zacht">
    @State.Data.Rooms.Count vergaderruimtes uit
    @(State.Data.Sources.FirstOrDefault(b => b.File.Contains("rooms", StringComparison.OrdinalIgnoreCase))?.Folder is { } m ? System.IO.Path.GetFileName(m) : "geen bron").
    Voor actuele waarden: <a href="verbindingen">Rooms laden uit Exchange</a>. Gemarkeerd = wijkt af van de standaard in de organisatie.
</p>

@if (State.Data.Rooms.Count == 0)
{
    <div class="kb-melding">Geen rooms geladen. Laad ze uit Exchange of uit een inventaris met <code>exo-rooms-overzicht.csv</code>.</div>
}
else
{
    <KpiFilter Kpi="ActiveKpi" Count="Items.Count" Cleared="() => k.Kpi = null" />

    <KbTable Id="rooms" Items="Items" Columns="columns" DefaultSorting="naam" Selectable KeyOf="r => r.Smtp"
             SelectionChanged="_ => plan = null" RowClass="@(r => Deviations(r).Count > 0 ? "kb-verschil" : null)" />

    @if (State.Can(Permission.Manage))
    {
    <section class="kb-kaart">
        <h2>Wijzigen (@selected.Count geselecteerd)</h2>
        <p class="kb-zacht">Leeg laten = niet wijzigen. Alleen wat verschilt met de huidige waarde komt in het plan.</p>
        <div class="kb-filters">
            <button class="kb-knop" @onclick="DefaultFill">Standaard invullen</button>
            <button class="kb-knop" @onclick="Empty">Leegmaken</button>
        </div>
        <RoomForm Desired="desired" />
        <div class="kb-filters">
            <button class="kb-knop kb-primair" disabled="@(selected.Count == 0)" @onclick="MakePlan">Plan maken</button>
        </div>
    </section>
    }

    @if (plan is not null)
    {
        <PlanView Plan="plan" Context="@($"Rooms ({selected.Count})")" Title="Wijzigingen aan de rooms" Executed="AfterExecute" />
    }
}

@code {
    // The chosen rooms (also after Back or Forward) and the form, while the app is open
    private HashSet<string> selected => State.TableSession("rooms").Selected;

    /// <summary>From a KPI tile: rooms?kpi=afwijkend (see Core/Analysis/Kpis.cs).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "kpi")] public string? KpiQuestion { get; set; }
    private string? processedKpi;
    private KpiChoice? _k;
    private KpiChoice k => _k ??= State.PageState.Of<KpiChoice>("rooms");

    protected override void OnParametersSet()
    {
        if (KpiQuestion != processedKpi)
        {
            processedKpi = KpiQuestion;
            if (State.KpiArrival(KpiQuestion, Nav.Uri, "rooms", "rooms"))
            {
                _k = null;
                k.Kpi = KpiQuestion;
            }
        }
    }

    private Kpi? ActiveKpi => Kpis.Find(k.Kpi) is { Items: KpiList.Rooms } x ? x : null;
    private IReadOnlyList<Room> Items => ActiveKpi is { } x ? Kpis.Rooms(x, State.KpiSource) : State.Data.Rooms;
    private const string Form = "rooms/wijzigen";
    private IReadOnlyList<Column<Room>> columns = Array.Empty<Column<Room>>();

    protected override void OnInitialized() => columns = new List<Column<Room>>
    {
        new() { Key = "naam", Title = "Room", Cell = r => @<text><ObjectLink Id="@r.Smtp" /><div class="kb-zacht">@r.Smtp</div></text>, SortBy = r => r.DisplayName, Text = r => $"{r.DisplayName} ({r.Smtp})" },
        new() { Key = "gebouw", Title = "Gebouw", Cell = r => @<text>@r.Building</text>, SortBy = r => r.Building },
        new() { Key = "verdieping", Title = "Verd.", Cell = r => @<text>@r.Floor</text>, SortBy = r => r.Floor },
        new() { Key = "capaciteit", Title = "Cap.", Number = true, Cell = r => @<text>@r.Capacity</text>, SortBy = r => r.Capacity },
        new() { Key = "verwerking", Title = "Verwerking", Cell = r => @<text>@r.AutomateProcessing</text>, SortBy = r => r.AutomateProcessing },
        new() { Key = "venster", Title = "Venster", Number = true, Cell = r => @<text>@r.BookingWindowInDays</text>, SortBy = r => r.BookingWindowInDays },
        new() { Key = "recht", Title = "Standaardrecht", Cell = r => @<text>@r.DefaultCalendarPermission</text>, SortBy = r => r.DefaultCalendarPermission },
        new() { Key = "afwijkingen", Title = "Afwijkingen", Cell = r => @<span class="kb-zacht">@string.Join("; ", Deviations(r))</span>, SortBy = r => Deviations(r).Count, Text = r => string.Join("; ", Deviations(r)) },
        new() { Key = "duur", Title = "Max. duur", Hidden = true, Number = true, Cell = r => @<text>@r.MaximumDurationInMinutes</text>, SortBy = r => r.MaximumDurationInMinutes },
        new() { Key = "gedelegeerden", Title = "Gedelegeerden", Hidden = true, Cell = r => @<text>@r.ResourceDelegates.Replace("|", ", ")</text>, SortBy = r => r.ResourceDelegates, Text = r => r.ResourceDelegates.Replace("|", ", ") },
        new() { Key = "verborgen", Title = "Verborgen", Hidden = true, Cell = r => @<text>@(r.Hidden ? "ja" : "")</text>, SortBy = r => r.Hidden ? "ja" : "" },
        new() { Key = "entraid", Title = "Entra-ID", Hidden = true, Cell = r => @<code>@(State.Data.Index.AccountOf(r.Smtp, r.Alias)?.Entra?.Id)</code>, SortBy = r => State.Data.Index.AccountOf(r.Smtp, r.Alias)?.Entra?.Id },
    };

    private IReadOnlyList<string> Deviations(Room r) => PlanBuilder.RoomDeviations(r, State.Config.Rooms.Default);
    private RoomDesired? _desired;
    private RoomDesired desired => _desired ??= State.PageState.Form<RoomDesired>(Form, "rooms", "Rooms", filled: IsFilled);

    // Filling in the default also counts as a filled-in form: something is ready to apply
    private static bool IsFilled(RoomDesired g) => typeof(RoomDesired).GetProperties().Any(p => p.GetValue(g) is not null);
    private List<Change>? plan;

    private void Empty()
    {
        State.PageState.Forget(Form);
        _desired = null;
        plan = null;
    }

    private void DefaultFill()
    {
        State.PageState.Forget(Form);
        _desired = State.PageState.Form(Form, "rooms", "Rooms", () => RoomDesired.FromDefault(State.Config.Rooms.Default), IsFilled);
        plan = null;
    }

    private void AfterExecute(IReadOnlyList<ChangeResult> results)
    {
        if (results.Any(r => r.Status == ResultStatus.Succeeded))
        {
            State.PageState.Forget(Form);
        }
    }

    private void MakePlan()
    {
        var g = RoomForm.Cleaned(desired);
        plan = State.Data.Rooms.Where(r => selected.Contains(r.Smtp)).SelectMany(r => PlanBuilder.Room(r, g)).ToList();
    }
}
