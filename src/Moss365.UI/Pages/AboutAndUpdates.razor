@page "/updates"
@layout SettingsLayout
@* The version of Moss365 and its updates (0.21: its own page in the settings). *@
@inject ManagementState State

<h1>@T["menu.updates"]</h1>

<section class="kb-kaart" id="over">
    <h2>@T["about-and-updates.about-moss365"]</h2>
    <p>@T["update-panel.version"] <strong>@ManagementState.AppVersion</strong>.
        @if (State.UpdateAvailable)
        {
            <span class="kb-label kb-label-let">@T.Format("about-and-updates.version-0-available", State.Update!.NewestVersion)</span>
        }
        else if (State.Update is { NewestVersion: not null })
        {
            <span class="kb-zacht">@T["about-and-updates.this-is-the-newest-version"]</span>
        }
        else if (State.Update?.Message is { } message)
        {
            <span class="kb-zacht">@message</span>
        }
    </p>
    <p class="kb-zacht">
        @Html("about.releases")
    </p>
    <div class="kb-filters">
        <CopyField Value="@(State.Update?.Link ?? State.ReleasesLink)" Label="@T["code.about-and-updates.link-to-the-releases"]" />
        <button class="kb-knop" disabled="@searches" @onclick="SearchUpdate">@T["update-panel.search-now"]</button>
    </div>
    <label><input type="checkbox" checked="@State.Settings.SearchUpdates" @onchange="SetUpdateSearch" /> @T["about-and-updates.search-for-a-new-version"]</label>
    <p>
        @T["about.organisation"] <code>@(State.ConfigSourceText ?? T["start.notfound"])</code>
        @T.Format("about.counts", State.Config.Populations.Count, State.Config.Departments.Count, State.Config.Offices.Count)
        @if (State.ConfigWarning is { } w) { <span class="kb-label kb-rood">@w</span> }
    </p>
</section>

<UpdatePanel />

@code {
    private bool searches;

    private async Task SearchUpdate()
    {
        searches = true;
        await State.SearchUpdateAsync();
        searches = false;
    }

    private void SetUpdateSearch(ChangeEventArgs e)
    {
        State.Settings.SearchUpdates = e.Value is true;
        State.SaveSettings();
    }
}
