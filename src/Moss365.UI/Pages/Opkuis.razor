@page "/opkuis"
@inherits VerversendePagina

<h1>Opkuisronde</h1>

<p class="kb-zacht">
    Accounts die lang niet aangemeld zijn, om na te kijken. Vink aan wat weg mag: medewerkers worden <strong>uitgeschakeld</strong>
    (met de reden in de omschrijving, nooit verwijderd; voor een volledige uitstroom gebruik je Uitstroom), gasten worden
    <strong>verwijderd</strong>. Na het uitvoeren bewaart de app een rapport met elk nagekeken account en de beslissing, als
    bewijs van de controle. Laatste aanmelding: de recentste uit AD en Entra.
</p>

@if (!State.IsLive)
{
    <div class="kb-melding">De gegevens zijn niet live. <a href="verbindingen">Laad eerst live</a>, zodat de laatste aanmeldingen kloppen.</div>
}

<div class="kb-filters">
    <span class="kb-segment" role="group" aria-label="Soort">
        <button class="kb-knop @(keuze.Soort == OpkuisSoort.Medewerkers ? "kb-primair" : null)" @onclick="() => Zet(OpkuisSoort.Medewerkers, keuze.Dagen)">Medewerkers</button>
        <button class="kb-knop @(keuze.Soort == OpkuisSoort.Gasten ? "kb-primair" : null)" @onclick="() => Zet(OpkuisSoort.Gasten, keuze.Dagen)">Gasten</button>
    </span>
    <label>
        Niet aangemeld in
        <select class="kb-invoer" value="@keuze.Dagen" @onchange="@(e => Zet(keuze.Soort, int.Parse(e.Value?.ToString() ?? "180")))">
            @foreach (var d in new[] { 90, 180, 365, keuze.Dagen }.Distinct().Order())
            {
                <option value="@d">@d @(d == 1 ? "dag" : "dagen")</option>
            }
        </select>
    </label>
    <button class="kb-knop" @onclick="AllesKiezen">Alles aanvinken</button>
    <button class="kb-knop" disabled="@(keuze.Gekozen.Count == 0)" @onclick="() => { keuze.Gekozen.Clear(); plan = null; }">Niets</button>
    <button class="kb-knop kb-primair" disabled="@(keuze.Gekozen.Count == 0)" @onclick="MaakPlan">
        @(keuze.Soort == OpkuisSoort.Gasten ? "Plan: verwijderen" : "Plan: uitschakelen") (@keuze.Gekozen.Count)
    </button>
</div>

<KbTabel Id="@($"opkuis-{keuze.Soort.ToString().ToLowerInvariant()}")" ExportNaam="@($"Opkuis-{keuze.Soort}-{keuze.Dagen}d")" Items="kandidaten" Kolommen="kolommen"
         StandaardSortering="aanmelding" Telling="@($"{kandidaten.Count} accounts niet aangemeld in {keuze.Dagen} {(keuze.Dagen == 1 ? "dag" : "dagen")}")"
         Selecteerbaar SleutelVan="k => k.Persoon.Sleutel" Gekozen="keuze.Gekozen" SelectieGewijzigd="_ => plan = null" />

@foreach (var f in fouten)
{
    <div class="kb-melding kb-fout">@f</div>
}

@if (plan is not null)
{
    <PlanWeergave Plan="plan" Context="@($"Opkuisronde {keuze.Soort.ToString().ToLowerInvariant()} ({keuze.Dagen} dagen)")" Titel="Opkuisronde" Uitgevoerd="NaUitvoeren" />
}

@if (rapport is not null)
{
    <div class="kb-melding kb-goed kb-export">
        <span>Rapport bewaard: <code>@rapport</code></span>
        <button class="kb-knop kb-klein" @onclick="() => State.Omgeving.ToonBestand(rapport)">Tonen in Verkenner</button>
    </div>
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "soort")] public string? SoortVraag { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "dagen")] public int? DagenVraag { get; set; }

    /// <summary>Soort, dagen en de gekozen accounts, bewaard zolang de app open is (Terug, Vooruit, menu).</summary>
    private sealed class Keuzes { public OpkuisSoort Soort { get; set; } = OpkuisSoort.Medewerkers; public int Dagen { get; set; } = 180; public HashSet<string> Gekozen { get; } = new(StringComparer.OrdinalIgnoreCase); }
    private Keuzes? _keuze;
    private Keuzes keuze => _keuze ??= State.Paginastatus.Formulier<Keuzes>("opkuis", "opkuis", "Opkuisronde", ingevuld: k => k.Gekozen.Count > 0);
    private List<OpkuisKandidaat> kandidaten = new();
    private IReadOnlyList<Wijziging>? plan;
    private IReadOnlyList<string> fouten = Array.Empty<string>();
    private IReadOnlyList<OpkuisKandidaat> nagekeken = Array.Empty<OpkuisKandidaat>();
    private HashSet<string> gekozenBijPlan = new(StringComparer.OrdinalIgnoreCase);
    private string? rapport;
    private bool vraagGelezen;
    private IReadOnlyList<Kolom<OpkuisKandidaat>> kolommen = Array.Empty<Kolom<OpkuisKandidaat>>();

    protected override void OnInitialized() => kolommen = new List<Kolom<OpkuisKandidaat>>
    {
        new() { Sleutel = "naam", Titel = "Naam", Cel = k => @<text><ObjectLink Object="State.Data.Index.Ref(k.Persoon)" /> @if (k.Bevoorrecht) { <span class="kb-label kb-rood">bevoorrecht</span> }</text>, SorteerOp = k => k.Persoon.Naam },
        new() { Sleutel = "upn", Titel = "UPN", Cel = k => @<text>@k.Persoon.Upn</text>, SorteerOp = k => k.Persoon.Upn },
        new() { Sleutel = "bron", Titel = "Bron", Cel = k => @<text>@k.Persoon.Bron</text>, SorteerOp = k => k.Persoon.Bron },
        new() { Sleutel = "dienst", Titel = "Dienst", Cel = k => @<text>@k.Persoon.Dienst</text>, SorteerOp = k => k.Persoon.Dienst },
        new() { Sleutel = "aanmelding", Titel = "Laatste aanmelding", Cel = k => @<text>@(k.LaatsteAanmelding?.ToString("dd/MM/yyyy") ?? "nooit")</text>, SorteerOp = k => k.LaatsteAanmelding ?? DateTime.MinValue, Tekst = k => k.LaatsteAanmelding?.ToString("yyyy-MM-dd") ?? "nooit" },
        new() { Sleutel = "aangemaakt", Titel = "Aangemaakt", Cel = k => @<text>@k.Aangemaakt?.ToString("dd/MM/yyyy")</text>, SorteerOp = k => k.Aangemaakt, Tekst = k => k.Aangemaakt?.ToString("yyyy-MM-dd") },
        new() { Sleutel = "ou", Titel = "OU", Verborgen = true, Cel = k => @<text>@k.Persoon.Ad?.OuPad</text>, SorteerOp = k => k.Persoon.Ad?.OuPad },
        new() { Sleutel = "omschrijving", Titel = "Omschrijving", Verborgen = true, Cel = k => @<text>@k.Persoon.Ad?.Description</text>, SorteerOp = k => k.Persoon.Ad?.Description },
    };

    protected override void OnParametersSet()
    {
        if (!vraagGelezen)
        {
            vraagGelezen = true;
            if (string.Equals(SoortVraag, "gasten", StringComparison.OrdinalIgnoreCase)) keuze.Soort = OpkuisSoort.Gasten;
            if (DagenVraag is > 0) keuze.Dagen = DagenVraag.Value;
        }

        kandidaten = OpkuisPlannen.Kandidaten(State.Data, State.Config, keuze.Soort, keuze.Dagen, DateTime.Now).ToList();
        keuze.Gekozen.IntersectWith(kandidaten.Select(k => k.Persoon.Sleutel));
    }

    private void Zet(OpkuisSoort s, int d)
    {
        if (s != keuze.Soort)
        {
            keuze.Gekozen.Clear();
        }

        keuze.Soort = s;
        keuze.Dagen = d;
        plan = null;
        rapport = null;
        OnParametersSet();
    }


    private void AllesKiezen()
    {
        keuze.Gekozen.UnionWith(kandidaten.Select(k => k.Persoon.Sleutel));
        plan = null;
    }

    private void MaakPlan()
    {
        var u = OpkuisPlannen.Plan(State.Data, keuze.Soort, kandidaten.Where(k => keuze.Gekozen.Contains(k.Persoon.Sleutel)).Select(k => k.Persoon), DateOnly.FromDateTime(DateTime.Today));
        fouten = u.Fouten;
        plan = u.Plan.Count > 0 ? u.Plan : null;
        nagekeken = kandidaten.ToList();
        gekozenBijPlan = keuze.Gekozen.ToHashSet(StringComparer.OrdinalIgnoreCase);
        rapport = null;
    }

    private void NaUitvoeren(IReadOnlyList<WijzigingResultaat> resultaten)
    {
        try
        {
            rapport = OpkuisPlannen.BewaarRapport(State.Omgeving.ExportMap, keuze.Soort, keuze.Dagen, nagekeken, gekozenBijPlan,
                plan ?? Array.Empty<Wijziging>(), resultaten, State.Gebruiker, DateTime.Now);
        }
        catch (Exception ex)
        {
            fouten = new[] { "Rapport bewaren mislukt: " + ex.Message };
        }
    }
}
