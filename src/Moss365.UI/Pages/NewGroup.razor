@page "/groepen/nieuw"
@inject ManagementState State

<h1>@T["new-group.new-group"]</h1>

<p class="kb-zacht">
    @T["new-group.choose-the-kind-first-it"]
</p>

<section class="kb-kaart">
    <h2>@T["nested-groups.kind"]</h2>
    <div class="kb-keuzes">
        @foreach (var (kind, title, explanation) in Kinds.Where(k => Fits(k.Item1)))
        {
            <label class="kb-keuze @(request.Kind == kind ? "kb-actief" : null)">
                <input type="radio" name="soort" checked="@(request.Kind == kind)" @onchange="() => ChooseKind(kind)" />
                <strong>@title</strong>
                <span class="kb-zacht">@explanation</span>
            </label>
        }
    </div>
</section>

<section class="kb-kaart">
    <h2>@T["new-mailbox.details"]</h2>
    <div class="kb-raster">
        <label>@T["variables-editor.name"] <input class="kb-invoer" placeholder="@($"bv. {NewGroupPlans.Prefix(request.Kind)}...")" @bind="request.Name" @bind:after="Clear" /></label>
        <label>@T["edit-user.description"] <input class="kb-invoer" @bind="request.Description" @bind:after="Clear" /></label>
        @if (NewGroupPlans.WithMail(request.Kind))
        {
            <label>@T["guests.e-mail-address"] <input class="kb-invoer" type="email" placeholder="naam@contoso.com" @bind="request.Mail" @bind:after="Clear" /></label>
        }
        @if (request.Kind == NewGroupKind.AdSecurity)
        {
            <label>
                @T["new-group.scope"]
                <select class="kb-invoer" @bind="request.Scope" @bind:after="Clear">
                    <option value="Global">@T["new-group.global-default"]</option>
                    <option value="Universal">@T["new-group.universal"]</option>
                </select>
            </label>
        }
    </div>
    @if (request.Kind == NewGroupKind.AdSecurity)
    {
        <p class="kb-zacht">@T["new-group.in-the-ou"] <strong>@(string.IsNullOrWhiteSpace(State.Config.GroupsOu) ? T["code.new-group.not-set-yet-under-organisation"] : State.Config.GroupsOu)</strong>.</p>
    }

    <PersonPicker Label="@(request.Kind is NewGroupKind.CloudSecurity or NewGroupKind.Microsoft365 ? "Eigenaar" : "Beheerder")"
                   Selected="@(request.Administrator.Length == 0 ? null : State.Data.SearchPerson(request.Administrator))" SelectedChanged="ChooseAdministrator" />

    <ObjectPicker Label="@T["new-group.first-members"]" Kinds="Persons" Selected="AddMember" />
    @if (request.Members.Count > 0)
    {
        <ul class="kb-lijst">
            @foreach (var l in request.Members.ToList())
            {
                <li>@(State.Data.SearchPerson(l)?.Name ?? l) <button class="kb-knop kb-klein" @onclick="() => { request.Members.Remove(l); Clear(); }" aria-label="@T["manage-ca.remove"]">&times;</button></li>
            }
        </ul>
    }

    <div class="kb-filters">
        <button class="kb-knop kb-primair" @onclick="MakePlan">@T["bulk-tasks.make-plan"]</button>
        <button class="kb-knop" @onclick="Empty">@T["rooms.clear"]</button>
    </div>
    @foreach (var f in errors)
    {
        <div class="kb-melding kb-fout">@f</div>
    }
</section>

@if (plan is not null)
{
    <PlanView Plan="plan" Context="@($"Nieuwe groep {request.Name.Trim()}")" Title="@T["new-group.new-group"]" Executed="AfterExecute" />
}

@code {
    private static readonly ObjectKind[] Persons = { ObjectKind.User };

    private static (NewGroupKind, string, string)[] Kinds => new[]
    {
        (NewGroupKind.AdSecurity, T["new-group.ad"], T["new-group.ad.help"]),
        (NewGroupKind.CloudSecurity, T["code.new-group.security-group-in-the-cloud"], T["code.new-group.for-permissions-and-licences-in"]),
        (NewGroupKind.Microsoft365, T["new-group.m365"], T["new-group.m365.help"]),
        (NewGroupKind.MailSecurity, T["new-group.mailsecurity"], T["code.new-group.permissions-and-mail-e-g"]),
        (NewGroupKind.Distribution, T["new-group.distribution"], T["code.new-group.only-mail-to-a-group"]),
    };

    private const string Form = "groepen/nieuw";
    private NewGroupRequest request = new();
    private IReadOnlyList<Change>? plan;
    private IReadOnlyList<string> errors = Array.Empty<string>();

    // The form is kept until you run or clear it
    protected override void OnInitialized()
    {
        request = Saved();
        if (!Fits(request.Kind))
        {
            request.Kind = State.HasMicrosoft365 ? NewGroupKind.CloudSecurity : NewGroupKind.AdSecurity;
        }
    }

    /// <summary>Kinds of a system the tenant does not have are left out (0.21.1).</summary>
    private bool Fits(NewGroupKind kind) => kind == NewGroupKind.AdSecurity ? State.HasAd : State.HasMicrosoft365;

    private NewGroupRequest Saved() => State.PageState.Form<NewGroupRequest>(Form, Form, "Nieuwe groep",
        filled: a => a.Name.Trim().Length > 0 || a.Members.Count > 0);

    private void Clear()
    {
        plan = null;
        errors = Array.Empty<string>();
    }

    private void ChooseKind(NewGroupKind kind)
    {
        request.Kind = kind;
        Clear();
    }

    private void ChooseAdministrator(Person? p)
    {
        request.Administrator = p?.Key ?? string.Empty;
        Clear();
    }

    private void AddMember(ObjectRef r)
    {
        if (!request.Members.Contains(r.Key, StringComparer.OrdinalIgnoreCase))
        {
            request.Members.Add(r.Key);
        }

        Clear();
    }

    private void Empty()
    {
        State.PageState.Forget(Form);
        request = Saved();
        Clear();
    }

    private void MakePlan()
    {
        var u = NewGroupPlans.Plan(State.Data, State.Config, request);
        errors = u.Errors;
        plan = u.Plan.Count > 0 ? u.Plan : null;
    }

    private void AfterExecute(IReadOnlyList<ChangeResult> results)
    {
        if (results.Any(r => r.Status == ResultStatus.Succeeded))
        {
            State.PageState.Forget(Form);
        }
    }
}
