@page "/conditional-access"
@inherits RefreshingPage
@inject NavigationManager Nav

<h1>@T["menu.conditional-access"]</h1>

<p class="kb-zacht">
    @Html("ca.intro")
</p>

@if (State.Data.ConditionalAccess is not { } ca)
{
    <div class="kb-melding">
        @Html("ca.notloaded")
    </div>
}
else if (ca.Message is not null)
{
    <div class="kb-melding kb-fout">@ca.Message</div>
}
else
{
    <div class="kb-tegels">
        <Tile Kpi="Kpis.CaOn" />
        <Tile Kpi="Kpis.CaReport" />
        <Tile Kpi="Kpis.CaOff" />
        <Tile Kpi="Kpis.CaProblems" />
        <Tile Kpi="Kpis.CaAttention" />
        <Tile Kpi="Kpis.OutsideMfaPolicy" />
    </div>

    <div class="kb-filters">
        <span class="kb-segment" role="group" aria-label="@T["tenant-compare.area"]">
            @foreach (var (d, text) in Share)
            {
                <button class="kb-knop @(part == d ? "kb-primair" : null)" @onclick="() => { k.Kpi = null; part = d; }">@text</button>
            }
        </span>
    </div>

    @switch (part)
    {
        case Part.Check:
            <section class="kb-kaart">
                <h2>@T["security-checks.check"]</h2>
                <p class="kb-zacht">
                    @Html("ca.checked")
                </p>
                <KpiFilter Kpi="CheckKpi" Count="CheckRows.Count" Cleared="() => k.Kpi = null" />
                <KbTable Id="ca-controle" ExportName="Conditional-Access-controle" Items="CheckRows" Columns="checkColumns" DefaultSorting="oordeel" />
            </section>
            break;

        case Part.Policies:
            <section class="kb-kaart">
                <h2>@T.Format("ca-overview.policies-0", ca.Policies.Count)</h2>
                <div class="kb-filters">
                    <button class="kb-knop" disabled="@effectBusy" @onclick="LoadEffect">@T["ca-policy-detail.load-effect-sign-ins-of"]</button>
                    @if (effectBusy) { <span class="kb-zacht">@T["message-trace-card.busy"]</span> }
                    @if (State.CaEffectExplanation is { } effectTekst) { <span class="kb-zacht">@effectTekst</span> }
                </div>
                @if (effectError is not null) { <div class="kb-melding kb-fout">@effectError</div> }
                <KpiFilter Kpi="PolicyKpi" Count="PolicyRows(ca).Count" Cleared="() => k.Kpi = null" />
                <KbTable Id="ca-beleiden" ExportName="Conditional-Access-beleiden" Items="PolicyRows(ca)" Columns="policyColumns" DefaultSorting="naam" />
            </section>
            break;

        case Part.WhatIf:
            <section class="kb-kaart">
                <h2>@T["ca-overview.what-if"]</h2>
                <p class="kb-zacht">@T["ca-overview.choose-a-person-and-a"]</p>
                <PersonPicker Label="@T["code.ca-overview.who-signs-in"]" @bind-Selected="whatIfPerson" />
                <div class="kb-filters">
                    <label>@T["sign-in-list.app"]
                        <select class="kb-invoer" @bind="scenarioApp">
                            <option value="@CaApp.Office365">@T["ca-overview.office-365-mail-teams-sharepoint"]</option>
                            <option value="@CaApp.AdminPortals">@T["ca-overview.microsoft-admin-portals"]</option>
                            <option value="@CaApp.Other">@T["ca-overview.another-app"]</option>
                        </select>
                    </label>
                    <label>@T["group-detail.where"]
                        <select class="kb-invoer" @bind="scenarioPlace">
                            <option value="@CaPlace.Office">@T["ca-overview.at-the-office-trusted-location"]</option>
                            <option value="@CaPlace.Belgium">@T["ca-overview.elsewhere-in-the-country-home"]</option>
                            <option value="@CaPlace.Abroad">@T["ca-overview.abroad"]</option>
                        </select>
                    </label>
                    <label>@T["ca-overview.platform"]
                        <select class="kb-invoer" @bind="scenarioPlatform">
                            @foreach (var p in new[] { "windows", "macOS", "iOS", "android", "linux" })
                            {
                                <option value="@p">@CaReader.PlatformName(p)</option>
                            }
                        </select>
                    </label>
                    <label>@T["ca-overview.with"]
                        <select class="kb-invoer" @bind="scenarioClient">
                            <option value="@CaClient.Browser">@T["ca-overview.the-browser"]</option>
                            <option value="@CaClient.Desktop">@T["ca-overview.an-app-or-desktop-program"]</option>
                            <option value="@CaClient.Outdated">@T["ca-overview.an-outdated-program-imap-pop"]</option>
                        </select>
                    </label>
                    <label><input type="checkbox" @bind="scenarioManaged" /> @T["ca-overview.managed-device-intune"]</label>
                </div>
                @if (whatIfPerson is not null)
                {
                    @if (CaUser.Of(whatIfPerson, State.Data) is not { } g)
                    {
                        <div class="kb-melding">@T.Format("ca-overview.0-has-no-entra-account", whatIfPerson.Name)</div>
                    }
                    else
                    {
                        var u = CaReader.WhatIf(g, new CaScenario(scenarioApp, scenarioPlace, scenarioPlatform, scenarioClient, scenarioManaged), ca, CaReader.Names(State.Data));
                        <div class="kb-melding @(u.Blocked ? "kb-fout" : null)"><strong>@u.Summary</strong></div>
                        <h3>@T["ca-overview.policies-that-are-on"]</h3>
                        <WhatIfTable Rules="u.Enforced.ToList()" />
                        @if (u.OnlyReport.Any())
                        {
                            <h3>@T["ca-overview.report-only-enforce-nothing"]</h3>
                            <WhatIfTable Rules="u.OnlyReport.ToList()" />
                        }
                        @if (!g.GroupsFull)
                        {
                            <p class="kb-zacht">@T["ca-overview.groups-in-groups-were-not"]</p>
                        }
                    }
                }
            </section>
            break;

        default:
            <section class="kb-kaart">
                <h2>@T.Format("ca-overview.named-locations-0", ca.Locations.Count)</h2>
                @if (ca.Locations.Count == 0)
                {
                    <p class="kb-zacht">@T["ca-overview.no-named-locations-with-the"]</p>
                }
                else
                {
                    <table class="kb-tabel">
                        <thead><tr><th>@T["variables-editor.name"]</th><th>@T["nested-groups.kind"]</th><th>@T["ca-overview.trusted"]</th><th>@T["script-result.values"]</th><th>@T["ca-overview.used-in"]</th></tr></thead>
                        <tbody>
                            @foreach (var l in ca.Locations.OrderBy(l => l.Name))
                            {
                                <tr>
                                    <td>@l.Name</td>
                                    <td>@(l.IsIp ? "IP-bereiken" : "landen")</td>
                                    <td>@(l.Trusted ? "ja" : "nee")</td>
                                    <td>@string.Join(", ", l.Values) @if (l.UnknownCountries) { <span class="kb-zacht">@T["ca-overview.unknown-countries"]</span> }</td>
                                    <td>@string.Join(", ", ca.Policies.Where(b => b.LocationsIn.Contains(l.Id) || b.LocationsOff.Contains(l.Id)).Select(b => b.Name))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
            <section class="kb-kaart">
                <h2>@T.Format("ca-overview.authentication-strengths-0", ca.Strengths.Count)</h2>
                <table class="kb-tabel">
                    <thead><tr><th>@T["variables-editor.name"]</th><th>@T["nested-groups.kind"]</th><th>@T["ca-overview.allowed-methods"]</th><th>@T["ca-overview.used-in"]</th></tr></thead>
                    <tbody>
                        @foreach (var s in ca.Strengths)
                        {
                            <tr>
                                <td>@s.Name</td>
                                <td>@(s.BuiltIn ? T["code.ca-overview.from-microsoft"] : "eigen")</td>
                                <td class="kb-zacht">@string.Join(", ", s.Combinations)</td>
                                <td>@string.Join(", ", ca.Policies.Where(b => b.StrengthId == s.Id).Select(b => b.Name))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
            <section class="kb-kaart">
                <h2>@T["ca-overview.security-defaults"]</h2>
                <p>@(ca.SecurityDefaults switch { true => T["code.ca-overview.are-on"], false => T["code.ca-overview.are-off-normal-when-you"], _ => "Onbekend." })</p>
            </section>
            break;

        case Part.Manage:
            <ManageCa Ca="ca" />
            break;
    }
}

@code {
    private enum Part { Check, Policies, WhatIf, Locations, Manage }

    /// <summary>Manage only for whoever may change things (profile Administrator); the engine checks it again.</summary>
    private IEnumerable<(Part, string)> Share
    {
        get
        {
            yield return (Part.Check, "Controle");
            yield return (Part.Policies, "Beleiden");
            yield return (Part.WhatIf, "Wat als");
            yield return (Part.Locations, T["code.ca-overview.locations-and-strengths"]);
            if (State.Can(Permission.Manage))
            {
                yield return (Part.Manage, "Beheren");
            }
        }
    }

    [Parameter, SupplyParameterFromQuery(Name = "persoon")] public string? PersonQuestion { get; set; }

    private Part part = Part.Check;
    private Person? whatIfPerson;
    private CaApp scenarioApp = CaApp.Office365;
    private CaPlace scenarioPlace = CaPlace.Belgium;
    private string scenarioPlatform = "windows";
    private CaClient scenarioClient = CaClient.Browser;
    private bool scenarioManaged;
    private bool effectBusy;
    private string? effectError;
    private IReadOnlyList<Column<CaFinding>> checkColumns = Array.Empty<Column<CaFinding>>();
    private IReadOnlyList<Column<CaPolicy>> policyColumns = Array.Empty<Column<CaPolicy>>();

    // Compute once per loaded data (the list and the tiles ask for them on every render)
    private InventoryData? findingsOf;
    private IReadOnlyList<CaFinding> findings = Array.Empty<CaFinding>();

    private IReadOnlyList<CaFinding> Findings
    {
        get
        {
            if (!ReferenceEquals(findingsOf, State.Data))
            {
                findings = CaCheck.Check(State.Data, State.Config, DateTime.Now);
                findingsOf = State.Data;
            }

            return findings;
        }
    }

    private string? processedQuestion;

    /// <summary>From a KPI tile: conditional-access?kpi=ca-uit (see Core/Analysis/Kpis.cs).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "kpi")] public string? KpiQuestion { get; set; }
    private string? processedKpi;
    private KpiChoice? _k;
    private KpiChoice k => _k ??= State.PageState.Of<KpiChoice>("conditional-access");

    private Kpi? PolicyKpi => Kpis.Find(k.Kpi) is { Items: KpiList.CaPolicies } x ? x : null;
    private Kpi? CheckKpi => Kpis.Find(k.Kpi) is { Items: KpiList.CaCheck } x ? x : null;
    private IReadOnlyList<CaPolicy> PolicyRows(CaData ca) => PolicyKpi is { } x ? Kpis.Policies(x, State.KpiSource) : ca.Policies;
    private IReadOnlyList<CaFinding> CheckRows => CheckKpi is { } x ? Kpis.Findings(x, State.KpiSource) : Findings;

    protected override void OnParametersSet()
    {
        if (KpiQuestion != processedKpi)
        {
            processedKpi = KpiQuestion;
            if (State.KpiArrival(KpiQuestion, Nav.Uri, "conditional-access", "ca-beleiden", "ca-controle"))
            {
                _k = null;
                k.Kpi = KpiQuestion;
            }

            if (PolicyKpi is not null)
            {
                part = Part.Policies;
            }
            else if (CheckKpi is not null)
            {
                part = Part.Check;
            }
        }

        if (PersonQuestion is { Length: > 0 } key && key != processedQuestion && State.Data.SearchPerson(key) is { } p)
        {
            processedQuestion = key;
            whatIfPerson = p;
            part = Part.WhatIf;
        }
    }

    protected override void OnInitialized()
    {
        checkColumns = new List<Column<CaFinding>>
        {
            new() { Key = "oordeel", Title = T["ca-overview.verdict"], Cell = b => @<CaLabel Verdict="b.Verdict" />, SortBy = b => -(int)b.Verdict, Text = b => b.VerdictText },
            new() { Key = "onderwerp", Title = T["message-trace-card.subject"], Cell = b => @<strong>@b.Subject</strong>, SortBy = b => b.Subject },
            new() { Key = "uitleg", Title = T["code.ca-overview.what-the-app-sees"], Cell = b => @<text>@b.Explanation</text>, SortBy = b => b.Explanation },
            new() { Key = "advies", Title = T["ca-overview.advice"], Cell = b => @<span class="kb-zacht">@b.Advice</span>, SortBy = b => b.Advice },
            new() { Key = "betreft", Title = T["ca-overview.concerns"], Cell = b => Concerns(b), Text = b => string.Join(", ", b.Policies.Select(x => x.Name).Concat(b.Persons.Select(p => p.Upn))) },
        };
        policyColumns = new List<Column<CaPolicy>>
        {
            new() { Key = "naam", Title = T["variables-editor.name"], Cell = b => @<a href="@($"conditional-access/{Uri.EscapeDataString(b.Id)}")">@b.Name</a>, SortBy = b => b.Name },
            new() { Key = "staat", Title = T["ca-user-card.state"], Cell = b => @<CaLabel Status="b.Status" />, SortBy = b => (int)b.Status, Text = b => CaReader.StatusName(b.Status) },
            new() { Key = "wie", Title = T["script-result.who"], Cell = b => @<text>@string.Join("; ", Explanation(b).Who)</text>, SortBy = b => string.Join("; ", Explanation(b).Who) },
            new() { Key = "apps", Title = T["ca-policy-detail.apps"], Cell = b => @<text>@string.Join("; ", Explanation(b).Apps)</text>, SortBy = b => string.Join("; ", Explanation(b).Apps) },
            new() { Key = "voorwaarden", Title = T["ca-policy-detail.conditions"], Cell = b => @<text>@string.Join("; ", Explanation(b).Conditions)</text>, SortBy = b => string.Join("; ", Explanation(b).Conditions) },
            new() { Key = "gevolg", Title = T["what-if-table.effect"], Cell = b => @<text>@Explanation(b).Consequence</text>, SortBy = b => Explanation(b).Consequence },
            new() { Key = "gewijzigd", Title = T["logon-scripts.changed"], Cell = b => @<text>@b.Changed?.LocalDateTime.ToString("dd/MM/yyyy")</text>, SortBy = b => b.Changed, Hidden = true },
            new() { Key = "toegepast", Title = T["ca-overview.applied"], Number = true, Cell = b => @<text>@Effect(b)?.Applied</text>, SortBy = b => Effect(b)?.Applied },
            new() { Key = "tegen", Title = T["ca-overview.blocked-would-block"], Number = true, Cell = b => @<text>@(Effect(b) is { } e ? (b.Status == CaStatus.Report ? e.WouldBlock : e.Failed) : null)</text>, SortBy = b => Effect(b) is { } e ? (b.Status == CaStatus.Report ? e.WouldBlock : e.Failed) : null },
        };
    }

    private CaExplanation Explanation(CaPolicy b) => CaReader.Explanation(b, State.Data.ConditionalAccess!, CaReader.Names(State.Data));

    private CaEffectRow? Effect(CaPolicy b) => State.CaEffect?.FirstOrDefault(e => e.PolicyId == b.Id);

    private RenderFragment Concerns(CaFinding b) => @<text>
        @foreach (var x in b.Policies)
        {
            <a class="kb-tag" href="@($"conditional-access/{Uri.EscapeDataString(x.Id)}")">@x.Name</a>
        }
        @foreach (var p in b.Persons.Take(5))
        {
            <div><ObjectLink Object="State.Data.Index.Ref(p)" /></div>
        }
        @if (b.Persons.Count > 5)
        {
            <details>
                <summary>@T.Format("ca-overview.and-0-others", b.Persons.Count - 5)</summary>
                @foreach (var p in b.Persons.Skip(5))
                {
                    <div><ObjectLink Object="State.Data.Index.Ref(p)" /></div>
                }
            </details>
        }
    </text>;

    private async Task LoadEffect()
    {
        effectBusy = true;
        effectError = null;
        try
        {
            await State.LoadCaEffectAsync(7);
        }
        catch (Exception ex)
        {
            effectError = (T["code.security-card.reading-sign-ins-failed"] + " ") + ex.Message + (" " + T["code.security-card.needed-role-reports-reader-or"]);
        }
        finally
        {
            effectBusy = false;
        }
    }
}
