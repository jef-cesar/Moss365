@page "/gasten"
@inherits VerversendePagina

<div class="kb-titelbalk">
    <h1>Gastgebruikers</h1>
    @if (State.Mag(Recht.GastenUitnodigen)) { <a class="kb-knop kb-primair" href="gasten#uitnodigen">+ Gast uitnodigen</a> }
</div>

<p class="kb-zacht">
    Externe gebruikers (B2B-gasten) in Entra. Uitnodigen en verwijderen gaan, zoals elke wijziging, via een plan met
    bevestiging. Een verwijderde gast staat nog 30 dagen bij de verwijderde gebruikers in Entra en kan daar teruggezet worden.
</p>

<div class="kb-tegels">
    <div class="kb-tegel"><div class="kb-tegel-getal">@Alle.Count</div><div>gasten</div></div>
    <div class="kb-tegel"><div class="kb-tegel-getal">@Alle.Count(p => !p.Ingeschakeld)</div><div>geblokkeerd</div></div>
    <a class="kb-tegel" href="opkuis?soort=gasten&amp;dagen=180"><div class="kb-tegel-getal">@Alle.Count(p => Inactief(p))</div><div>niet aangemeld in 180 dagen</div></a>
</div>

@if (State.Mag(Recht.GastenUitnodigen))
{
<section class="kb-kaart" id="uitnodigen">
    <h2>Gast uitnodigen</h2>
    <div class="kb-raster">
        <label>E-mailadres <input class="kb-invoer" type="email" placeholder="naam@example.com" @bind="invoer.Adres" /></label>
        <label>Naam <input class="kb-invoer" placeholder="Voornaam Achternaam (Bedrijf)" @bind="invoer.Naam" /></label>
    </div>
    <label><input type="checkbox" @bind="invoer.Bericht" /> Uitnodiging per e-mail sturen</label>
    <div class="kb-filters">
        <button class="kb-knop kb-primair" @onclick="Uitnodigen">Plan maken</button>
    </div>
</section>
}

<div class="kb-filters kb-plak">
    <input class="kb-invoer kb-breed" placeholder="Zoek op naam of adres" @bind="invoer.Zoek" @bind:event="oninput" aria-label="Zoeken" />
    <button class="kb-knop" hidden="@(!State.Mag(Recht.Beheren))" disabled="@(gekozen.Count == 0)" @onclick="Verwijderen">Gekozen gasten verwijderen (@gekozen.Count)</button>
</div>

<KbTabel Id="gasten" Items="Lijst" Kolommen="kolommen" StandaardSortering="naam" Telling="@($"{Lijst.Count} gasten")"
         Selecteerbaar SleutelVan="p => p.Sleutel" Gekozen="gekozen" SelectieGewijzigd="_ => { }"
         RijKlasse="@(p => Inactief(p) ? "kb-verschil" : null)" />

@foreach (var f in fouten)
{
    <div class="kb-melding kb-fout">@f</div>
}
@if (plan is not null)
{
    <PlanWeergave Plan="plan" Context="Gastgebruikers" Titel="Gastgebruikers" Uitgevoerd="NaUitvoeren" />
}

@code {
    /// <summary>Zoekterm en de uitnodiging in invulling, bewaard zolang de app open is (Terug, Vooruit, menu).</summary>
    private sealed class Invoer { public string Zoek { get; set; } = string.Empty; public string Adres { get; set; } = string.Empty; public string Naam { get; set; } = string.Empty; public bool Bericht { get; set; } = true; }
    private Invoer? _invoer;
    private Invoer invoer => _invoer ??= State.Paginastatus.Formulier<Invoer>("gasten", "gasten", "Gast uitnodigen", ingevuld: i => i.Adres.Trim().Length > 0 || i.Naam.Trim().Length > 0);
    private readonly HashSet<string> gekozen = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<Wijziging>? plan;
    private IReadOnlyList<string> fouten = Array.Empty<string>();
    private IReadOnlyList<Kolom<Persoon>> kolommen = Array.Empty<Kolom<Persoon>>();

    private List<Persoon> Alle => State.Data.Personen.Where(p => p.IsGast).ToList();

    private List<Persoon> Lijst
    {
        get
        {
            var z = invoer.Zoek.Trim();
            return Alle.Where(p => z.Length == 0 || p.Naam.Contains(z, StringComparison.OrdinalIgnoreCase)
                                   || (p.Entra?.Mail.Contains(z, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        }
    }

    protected override void OnInitialized() => kolommen = new List<Kolom<Persoon>>
    {
        new() { Sleutel = "naam", Titel = "Naam", Cel = p => @<ObjectLink Object="State.Data.Index.Ref(p)" />, SorteerOp = p => p.Naam },
        new() { Sleutel = "mail", Titel = "E-mailadres", Cel = p => @<text>@p.Entra?.Mail</text>, SorteerOp = p => p.Entra?.Mail },
        new() { Sleutel = "domein", Titel = "Domein", Cel = p => @<text>@Domein(p)</text>, SorteerOp = p => Domein(p) },
        new() { Sleutel = "status", Titel = "Status", Cel = p => @<text>@(p.Ingeschakeld ? "actief" : "geblokkeerd")</text>, SorteerOp = p => p.Ingeschakeld ? "actief" : "geblokkeerd" },
        new() { Sleutel = "aangemaakt", Titel = "Uitgenodigd", Cel = p => @<text>@Datum(p.Entra?.CreatedDateTime)</text>, SorteerOp = p => p.Entra?.CreatedDateTime },
        new() { Sleutel = "aanmelding", Titel = "Laatste aanmelding", Cel = p => @<text>@Datum(p.Entra?.LaatsteAanmelding)</text>, SorteerOp = p => p.Entra?.LaatsteAanmelding },
        new() { Sleutel = "groepen", Titel = "Groepen", Getal = true, Cel = p => @<text>@State.Data.CloudGroepenVan(p).Count()</text>, SorteerOp = p => State.Data.CloudGroepenVan(p).Count() },
        new() { Sleutel = "upn", Titel = "UPN", Verborgen = true, Cel = p => @<text>@p.Upn</text>, SorteerOp = p => p.Upn },
        new() { Sleutel = "entraid", Titel = "Entra-ID", Verborgen = true, Cel = p => @<code>@(p.Entra?.Id)</code>, SorteerOp = p => p.Entra?.Id },
    };

    private static string Domein(Persoon p) => p.Entra?.Mail is { } m && m.Contains('@') ? m[(m.IndexOf('@') + 1)..] : string.Empty;

    private static string Datum(string? d) => string.IsNullOrEmpty(d) ? string.Empty : d.Length >= 10 ? d[..10] : d;

    /// <summary>Niet aangemeld in 180 dagen (of nooit, als de uitnodiging ouder is dan 180 dagen).</summary>
    private static bool Inactief(Persoon p)
    {
        var grens = DateTime.Now.AddDays(-180);
        if (DateTime.TryParse(p.Entra?.LaatsteAanmelding, out var laatste))
        {
            return laatste < grens;
        }

        return DateTime.TryParse(p.Entra?.CreatedDateTime, out var aangemaakt) && aangemaakt < grens;
    }

    private void Uitnodigen() => Toon(GastPlannen.Uitnodigen(State.Data, invoer.Adres, invoer.Naam, invoer.Bericht));

    private void Verwijderen() => Toon(GastPlannen.Verwijderen(State.Data, Alle.Where(p => gekozen.Contains(p.Sleutel))));

    // Na een gelukte uitnodiging is het formulier weer leeg (de zoekterm blijft)
    private void NaUitvoeren(IReadOnlyList<WijzigingResultaat> resultaten)
    {
        if (resultaten.Any(r => r.Status == ResultaatStatus.Gelukt))
        {
            invoer.Adres = string.Empty;
            invoer.Naam = string.Empty;
        }
    }

    private void Toon(PlanUitkomst u)
    {
        fouten = u.Fouten;
        plan = u.Plan.Count > 0 ? u.Plan : null;
    }
}
