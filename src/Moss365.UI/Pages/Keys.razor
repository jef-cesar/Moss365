@page "/sleutels"
@inject ManagementState State
@using Moss365.Core.Helpdesk
@* BitLocker recovery keys and LAPS passwords (R10, 0.33): from Entra and AD, each lookup in the access log. Nothing is
   stored; the values disappear when you leave the page. *@

<h1>@T["menu.sleutels"]</h1>

<p class="kb-zacht">
    @T["keys.search-for-a-device-the"]
</p>

<div class="kb-rij">
    <input class="kb-invoer" placeholder="@T["keys.name-of-the-device-e"]" @bind="name" aria-label="@T["keys.name-of-the-device"]" />
    <button class="kb-knop kb-primair" disabled="@(busy || name.Trim().Length < 2)" @onclick="Search">@T["nav.search"]</button>
    <span class="kb-zacht">@T["keys.or"]</span>
    <input class="kb-invoer" placeholder="@T["keys.key-id-the-first-8"]" @bind="keyId" aria-label="@T["keys.key-id"]" />
    <button class="kb-knop" disabled="@(busy || keyId.Trim().Length < 8)" @onclick="() => ShowBitLocker(null)">@T["keys.show-bitlocker-key"]</button>
</div>

@if (error is not null) { <div class="kb-melding kb-fout">@error</div> }

@if (devices is not null)
{
    <section class="kb-kaart">
        <h2>Toestellen in Entra (@devices.Count)</h2>
        @if (devices.Count == 0) { <p class="kb-zacht">Geen toestel gevonden in Entra@(State.HasAd ? T["code.keys.the-buttons-below-also-search"] : null).</p> }
        <table class="kb-tabel">
            <thead><tr><th>@T["keys.device"]</th><th>@T["plan.system"]</th><th>@T["nested-groups.kind"]</th><th>@T["keys.last-seen"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in devices)
                {
                    <tr>
                        <td>@d.Name</td><td>@d.OperatingSystem</td><td>@d.TrustType</td><td>@d.LastSignIn?.LocalDateTime.ToString("dd/MM/yyyy")</td>
                        <td><span class="kb-filters">
                            <button class="kb-knop kb-klein" @onclick="() => ShowBitLocker(d)">@T["keys.bitlocker"]</button>
                            <button class="kb-knop kb-klein" @onclick="() => ShowLaps(d)">@T["keys.laps"]</button>
                        </span></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (State.HasAd && devices.All(d => !string.Equals(d.Name, name.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            <div class="kb-filters">
                <button class="kb-knop kb-klein" @onclick="() => ShowBitLocker(null, name.Trim())">BitLocker in AD (@name.Trim())</button>
                <button class="kb-knop kb-klein" @onclick="() => ShowLaps(null, name.Trim())">LAPS in AD (@name.Trim())</button>
            </div>
        }
    </section>
}

@if (keys is not null)
{
    <section class="kb-kaart kb-geheim">
        <h2>BitLocker-herstelsleutels @shownFor</h2>
        @if (keys.Count == 0) { <p>@T["keys.no-key-found"]</p> }
        @foreach (var k in keys)
        {
            <div class="kb-rij">
                <span class="kb-zacht">ID @k.Id[..Math.Min(8, k.Id.Length)] &middot; @k.VolumeType &middot; @k.Created?.LocalDateTime.ToString("dd/MM/yyyy")</span>
                <CopyField Value="@(k.Key ?? "(niet leesbaar)")" Label="Herstelsleutel" Secret="false" />
            </div>
        }
        @if (note is not null) { <p class="kb-zacht">@note</p> }
    </section>
}

@if (laps is not null || lapsNone)
{
    <section class="kb-kaart kb-geheim">
        <h2>LAPS @shownFor</h2>
        @if (laps is { } l)
        {
            <p class="kb-zacht">Account @l.Account &middot; @l.Source @(l.Backup is { } b ? "· bewaard " + b.LocalDateTime.ToString("dd/MM/yyyy HH:mm") : null)</p>
            <CopyField Value="@(l.Password ?? "(niet leesbaar)")" Label="LAPS-wachtwoord" Secret="true" />
        }
        else { <p>@T["keys.no-laps-password-found"]</p> }
        @if (note is not null) { <p class="kb-zacht">@note</p> }
    </section>
}

@code {
    private string name = string.Empty;
    private string keyId = string.Empty;
    private bool busy;
    private string? error;
    private IReadOnlyList<DeviceInfo>? devices;
    private IReadOnlyList<BitLockerKey>? keys;
    private LapsPassword? laps;
    private bool lapsNone;
    private string? note;
    private string shownFor = string.Empty;

    private void Clear()
    {
        keys = null;
        laps = null;
        lapsNone = false;
        note = null;
        error = null;
    }

    private async Task Search()
    {
        Clear();
        busy = true;
        try
        {
            devices = await State.FindDevicesAsync(name);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ShowBitLocker(DeviceInfo? device, string? computer = null)
    {
        Clear();
        busy = true;
        try
        {
            (keys, note) = await State.BitLockerAsync(device, device is null && computer is null ? keyId : null, computer ?? device?.Name);
            shownFor = device?.Name ?? computer ?? string.Empty;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ShowLaps(DeviceInfo? device, string? computer = null)
    {
        Clear();
        busy = true;
        try
        {
            (laps, note) = await State.LapsAsync(device, computer);
            lapsNone = laps is null;
            shownFor = device?.Name ?? computer ?? string.Empty;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
