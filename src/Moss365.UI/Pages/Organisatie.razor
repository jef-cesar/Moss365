@page "/organisatie"
@implements IDisposable
@inject BeheerState State

<h1>Organisatie</h1>

<p class="kb-zacht">
    Keuzelijsten voor nieuwe gebruikers. Bewaren schrijft naar <code>@State.Omgeving.ConfigGebruikersPad</code>;
    de meegeleverde lijst blijft ongewijzigd. Stuur dat bestand door om het in de repo op te nemen.
</p>

<WeggaanBevestigen Actief="gewijzigd" KanBewaren="@(Fouten.Count == 0)" Bewaren="Bewaar" Verwerpen="Ongedaan"
                   Tekst="Je hebt de organisatie aangepast maar nog niet bewaard." />

<div class="kb-filters kb-plak">
    <button class="kb-knop kb-primair" disabled="@(!gewijzigd || Fouten.Count > 0)" @onclick="Bewaar">Bewaren</button>
    <button class="kb-knop" disabled="@(!gewijzigd)" @onclick="Ongedaan">Wijzigingen ongedaan maken</button>
    @if (State.ConfigIsAangepast)
    {
        <button class="kb-knop" @onclick="Herstel">Terug naar de meegeleverde lijst</button>
    }
    @if (melding is not null)
    {
        <span class="kb-ok">@melding</span>
    }
    @if (gewijzigd)
    {
        <span class="kb-label">niet bewaard</span>
    }
</div>

@foreach (var f in Fouten)
{
    <div class="kb-melding kb-fout">@f</div>
}

<section class="kb-kaart">
    <h2>Bedrijf</h2>
    <div class="kb-rij">
        <label>Company</label>
        <input class="kb-invoer" value="@State.Config.Company" @onchange="e => Zet(() => State.Config.Company = e.Value?.ToString() ?? string.Empty)" />
    </div>
</section>

<section class="kb-kaart">
    <h2>Diensten en afdelingen</h2>
    <p class="kb-zacht">
        Department bevat de dienst; de app leidt de afdeling af uit deze koppeling.
        @Ongekoppeld van de @State.Config.Diensten.Count diensten hebben nog geen afdeling.
    </p>
    <div class="kb-filters">
        <label><input type="checkbox" @bind="alleenOngekoppeld" /> Alleen diensten zonder afdeling</label>
    </div>
    <table class="kb-tabel">
        <thead><tr><th>Dienst (Department)</th><th>Afdeling</th><th class="kb-getal">Gebruikers</th><th>Opmerking</th><th></th></tr></thead>
        <tbody>
            @foreach (var d in State.Config.Diensten.Where(d => !alleenOngekoppeld || string.IsNullOrWhiteSpace(d.Afdeling)).ToList())
            {
                <tr class="@(string.IsNullOrWhiteSpace(d.Afdeling) ? "kb-ontbreekt" : null)">
                    <td><input class="kb-invoer" value="@d.Department" @onchange="e => Zet(() => d.Department = e.Value?.ToString() ?? string.Empty)" /></td>
                    <td>
                        <select class="kb-invoer" aria-label="@($"Afdeling voor {d.Department}")" @onchange="e => Zet(() => d.Afdeling = LeegIsNull(e.Value))">
                            <option value="" selected="@string.IsNullOrWhiteSpace(d.Afdeling)">(nog niet gekoppeld)</option>
                            @foreach (var a in State.Config.Afdelingen)
                            {
                                <option value="@a.Naam" selected="@(string.Equals(a.Naam, d.Afdeling, StringComparison.OrdinalIgnoreCase))">@a.Naam</option>
                            }
                        </select>
                    </td>
                    <td class="kb-getal">@(aantallen.TryGetValue(d.Department, out var n) ? n : 0)</td>
                    <td><input class="kb-invoer" value="@d.Opmerking" @onchange="e => Zet(() => d.Opmerking = LeegIsNull(e.Value))" /></td>
                    <td><button class="kb-knop kb-klein" title="Verwijderen" @onclick="() => Zet(() => State.Config.Diensten.Remove(d))">&times;</button></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="Nieuwe dienst" @bind="nieuweDienst" />
        <button class="kb-knop" @onclick="VoegDienstToe">Dienst toevoegen</button>
    </div>

    @if (dienstenInData.Any(x => !x.InConfig || x.IsSchrijfvariant))
    {
        <h3>In de data, maar niet (exact) in de lijst</h3>
        <p class="kb-zacht">Department-waarden van ingeschakelde gebruikers. Een schrijfvariant hoort bij een dienst uit de lijst, maar met andere hoofdletters of spaties.</p>
        <table class="kb-tabel">
            <thead><tr><th>Waarde</th><th class="kb-getal">Gebruikers</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in dienstenInData.Where(x => !x.InConfig || x.IsSchrijfvariant))
                {
                    <tr>
                        <td><code>"@x.Waarde"</code></td>
                        <td class="kb-getal">@x.Aantal</td>
                        <td>@(x.InConfig ? $"schrijfvariant van \"{State.Config.ZoekDienst(x.Waarde)?.Department}\"" : "niet in de lijst")</td>
                        <td>
                            @if (!x.InConfig)
                            {
                                <button class="kb-knop kb-klein" @onclick="() => VoegToe(x.Waarde.Trim())">Toevoegen</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="kb-kaart">
    <h2>Afdelingen</h2>
    <table class="kb-tabel">
        <thead><tr><th>Afdeling</th><th>Cloudgroep</th><th class="kb-getal">Diensten</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in State.Config.Afdelingen.ToList())
            {
                <tr>
                    <td><input class="kb-invoer" value="@a.Naam" @onchange="e => HernoemAfdeling(a, e.Value?.ToString())" /></td>
                    <td><input class="kb-invoer" value="@a.Groep" @onchange="e => Zet(() => a.Groep = LeegIsNull(e.Value))" /></td>
                    <td class="kb-getal">@State.Config.Diensten.Count(d => string.Equals(d.Afdeling, a.Naam, StringComparison.OrdinalIgnoreCase))</td>
                    <td><button class="kb-knop kb-klein" title="Verwijderen" @onclick="() => VerwijderAfdeling(a)">&times;</button></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="Nieuwe afdeling" @bind="nieuweAfdeling" />
        <button class="kb-knop" @onclick="VoegAfdelingToe">Afdeling toevoegen</button>
    </div>
</section>

<section class="kb-kaart">
    <h2>Kantoren</h2>
    <p class="kb-zacht">
        Verplichte keuze bij een nieuwe gebruiker. Let op: <code>SG-INTRANET-SHAREPOINT-Gemeentehuis</code> sluit kantoren uit die
        beginnen met "bib" of "Visit".
    </p>
    <ul class="kb-lijst">
        @foreach (var k in State.Config.Kantoren.ToList())
        {
            <li>@k <button class="kb-knop kb-klein" title="Verwijderen" @onclick="() => Zet(() => State.Config.Kantoren.Remove(k))">&times;</button></li>
        }
    </ul>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="Nieuw kantoor" @bind="nieuwKantoor" />
        <button class="kb-knop" @onclick="VoegKantoorToe">Kantoor toevoegen</button>
    </div>
    @if (kantorenInData.Any(x => !x.InConfig))
    {
        <h3>Kantoren in de data die niet in de lijst staan</h3>
        <table class="kb-tabel">
            <thead><tr><th>Waarde</th><th class="kb-getal">Gebruikers</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in kantorenInData.Where(x => !x.InConfig))
                {
                    <tr>
                        <td><code>"@x.Waarde"</code></td>
                        <td class="kb-getal">@x.Aantal</td>
                        <td><button class="kb-knop kb-klein" @onclick="() => Zet(() => State.Config.Kantoren.Add(x.Waarde.Trim()))">Toevoegen</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="kb-kaart">
    <h2>Nieuwe groepen</h2>
    <div class="kb-raster">
        <label>OU voor nieuwe AD-groepen
            <input class="kb-invoer" placeholder="bv. GEMEENTEBESTUUR/GROEPEN" value="@State.Config.GroepenOu"
                   @onchange="e => Zet(() => State.Config.GroepenOu = LeegIsNull(e.Value))" />
        </label>
        <label>Voorvoegsels (naamgeving, gescheiden door komma's)
            <input class="kb-invoer" placeholder="gg_, AFD_, DNST_, SG-, WKG_" value="@string.Join(", ", State.Config.GroepVoorvoegsels)"
                   @onchange="e => Zet(() => State.Config.GroepVoorvoegsels = (e.Value?.ToString() ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList())" />
        </label>
    </div>
    <p class="kb-zacht">Een naam die niet met een van de voorvoegsels begint, geeft een waarschuwing in het plan.</p>
</section>

<section class="kb-kaart">
    <h2>Profielen</h2>
    <p class="kb-zacht">
        Wie wat mag in Moss365 volgt uit de app-rollen in Entra (Lezer, Helpdesk, Beheerder, Auditor, Appbeheer), toegekend via
        de groepen <code>GG-Moss365-...</code> (zie <code>docs/voorbereiding-0.8.md</code>). Zolang dit uit staat, mag wie zich
        aanmeldt zonder rol alles, zoals vroeger.
    </p>
    <label><input type="checkbox" checked="@State.Config.ProfielenVerplicht" @onchange="e => Zet(() => State.Config.ProfielenVerplicht = e.Value is true)" />
        Profielen verplicht: zonder rol enkel lezen</label>
</section>

<section class="kb-kaart">
    <h2>Noodaccounts</h2>
    <p class="kb-zacht">
        De UPN's van de noodaccounts (break glass): cloud-only accounts met de rol Global Administrator, buiten alle Conditional
        Access-beleiden, voor als niemand zich nog kan aanmelden. De controle bij Conditional Access kijkt ze na.
    </p>
    <ul class="kb-lijst">
        @foreach (var n in State.Config.Noodaccounts.ToList())
        {
            <li>@n <button class="kb-knop kb-klein" title="Verwijderen" @onclick="() => Zet(() => State.Config.Noodaccounts.Remove(n))">&times;</button></li>
        }
    </ul>
    <div class="kb-rij">
        <input class="kb-invoer" placeholder="bv. nood1@contoso.onmicrosoft.com" @bind="nieuwNoodaccount" />
        <button class="kb-knop" @onclick="VoegNoodaccountToe">Noodaccount toevoegen</button>
    </div>
</section>

@code {
    private string nieuwNoodaccount = string.Empty;
    private bool alleenOngekoppeld;
    private string? melding;
    private string nieuweDienst = string.Empty;
    private string nieuweAfdeling = string.Empty;
    private string nieuwKantoor = string.Empty;
    private IReadOnlyDictionary<string, int> aantallen = new Dictionary<string, int>();
    private IReadOnlyList<DienstGebruik> dienstenInData = Array.Empty<DienstGebruik>();
    private IReadOnlyList<DienstGebruik> kantorenInData = Array.Empty<DienstGebruik>();

    private int Ongekoppeld => State.Config.Diensten.Count(d => string.IsNullOrWhiteSpace(d.Afdeling));

    /// <summary>Fouten die bewaren blokkeren.</summary>
    private List<string> Fouten => BeheerState.ConfigFouten(State.Config);

    // Niet bewaard: telt in BeheerState, zodat de aanduiding (tint, balk, menu) ook buiten dit scherm klopt
    private bool gewijzigd => State.ConfigAanpassingen > 0;

    protected override void OnInitialized()
    {
        Herbereken();
        State.Gewijzigd += Ververs;
    }

    // Bewaren of verwerpen kan ook via de balk bovenaan
    private void Ververs() => _ = InvokeAsync(() =>
    {
        Herbereken();
        StateHasChanged();
    });

    public void Dispose() => State.Gewijzigd -= Ververs;

    private void Herbereken()
    {
        aantallen = OrganisatieAnalyse.AantalPerDienst(State.Data, State.Config);
        dienstenInData = OrganisatieAnalyse.DienstenInData(State.Data, State.Config);
        kantorenInData = OrganisatieAnalyse.KantorenInData(State.Data, State.Config);
    }

    private void Zet(Action wijziging)
    {
        wijziging();
        State.ConfigAangepast();
        melding = null;
        Herbereken();
    }

    private static string? LeegIsNull(object? waarde)
    {
        var tekst = waarde?.ToString()?.Trim();
        return string.IsNullOrEmpty(tekst) ? null : tekst;
    }

    private void VoegToe(string department)
    {
        if (department.Length > 0 && State.Config.ZoekDienst(department) is null)
        {
            Zet(() => State.Config.Diensten.Add(new Dienst { Department = department }));
        }
    }

    private void VoegDienstToe()
    {
        VoegToe(nieuweDienst.Trim());
        nieuweDienst = string.Empty;
    }

    private void VoegAfdelingToe()
    {
        var naam = nieuweAfdeling.Trim();
        if (naam.Length > 0)
        {
            Zet(() => State.Config.Afdelingen.Add(new Afdeling { Naam = naam }));
        }

        nieuweAfdeling = string.Empty;
    }

    private void VoegNoodaccountToe()
    {
        var upn = nieuwNoodaccount.Trim();
        if (upn.Contains('@') && !State.Config.Noodaccounts.Contains(upn, StringComparer.OrdinalIgnoreCase))
        {
            Zet(() => State.Config.Noodaccounts.Add(upn));
        }

        nieuwNoodaccount = string.Empty;
    }

    private void VoegKantoorToe()
    {
        var naam = nieuwKantoor.Trim();
        if (naam.Length > 0 && !State.Config.Kantoren.Any(k => OrganisatieConfig.Normaliseer(k) == OrganisatieConfig.Normaliseer(naam)))
        {
            Zet(() => State.Config.Kantoren.Add(naam));
        }

        nieuwKantoor = string.Empty;
    }

    /// <summary>Een afdeling hernoemen past ook de diensten aan die ernaar verwijzen.</summary>
    private void HernoemAfdeling(Afdeling afdeling, string? nieuweNaam)
    {
        var naam = (nieuweNaam ?? string.Empty).Trim();
        if (naam.Length == 0)
        {
            return;
        }

        Zet(() =>
        {
            foreach (var d in State.Config.Diensten.Where(d => string.Equals(d.Afdeling, afdeling.Naam, StringComparison.OrdinalIgnoreCase)))
            {
                d.Afdeling = naam;
            }

            afdeling.Naam = naam;
        });
    }

    /// <summary>Een afdeling verwijderen maakt de diensten die ernaar verwezen terug ongekoppeld.</summary>
    private void VerwijderAfdeling(Afdeling afdeling) => Zet(() =>
    {
        foreach (var d in State.Config.Diensten.Where(d => string.Equals(d.Afdeling, afdeling.Naam, StringComparison.OrdinalIgnoreCase)))
        {
            d.Afdeling = null;
        }

        State.Config.Afdelingen.Remove(afdeling);
    });

    private void Bewaar()
    {
        try
        {
            State.BewaarConfig();
            melding = "Bewaard.";
        }
        catch (Exception ex)
        {
            melding = "Bewaren mislukt: " + ex.Message;
        }
    }

    private void Ongedaan()
    {
        State.LaadConfig();
        melding = "Wijzigingen ongedaan gemaakt.";
        Herbereken();
    }

    private void Herstel()
    {
        State.HerstelStandaardConfig();
        melding = "Terug naar de meegeleverde lijst.";
        Herbereken();
    }
}
