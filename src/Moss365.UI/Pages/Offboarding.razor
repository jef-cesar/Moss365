@page "/uitstroom"
@page "/uitstroom/{Key}"
@inject ManagementState State
@inject NavigationManager Nav

<h1>@T["menu.uitstroom"]</h1>

<p class="kb-zacht">
    @if (State.HasAd)
    {
        @Html("offboarding.moved", State.Config.Offboarding?.Ou ?? T["offboarding.noou"])
    }
    else
    {
        <text>@T["offboarding.the-account-is-disabled-sign"]</text>
    } Bevoorrechte groepen worden altijd verwijderd. Kies hieronder wat er verder moet gebeuren; in het plan
    kan je elke stap nog aan- of uitvinken.
</p>

<PersonPicker Label="@T["word.user"]" Selected="person" SelectedChanged="Choose" />

@if (person is not null)
{
    @if (!person.Enabled)
    {
        <div class="kb-melding">@T["offboarding.this-account-is-already-disabled"]</div>
    }

    <section class="kb-kaart">
        <h2>@T["variables-editor.options"]</h2>
        <div class="kb-raster">
            <label>@T["offboarding.leaving-date"] <input class="kb-invoer" type="date" @bind="options.Date" @bind:after="Clear" /></label>
        </div>
        <div class="kb-keuzelijst">
            <label><input type="checkbox" @bind="options.Disable" @bind:after="Clear" /> @T["offboarding.disable-account"]</label>
            @if (State.HasAd)
            {
                <label><input type="checkbox" @bind="options.CompleteDescription" @bind:after="Clear" /> @T["offboarding.put-the-date-in-the"]</label>
                <label><input type="checkbox" @bind="options.Move" @bind:after="Clear" /> @T["offboarding.move-to-the-offboarding-ou"]</label>
            }
            <label><input type="checkbox" @bind="options.RevokeSessions" @bind:after="Clear" /> @T["offboarding.revoke-sign-in-sessions"]</label>
            @if (State.HasAd) { <label><input type="checkbox" @bind="options.AdRemoveGroups" @bind:after="Clear" /> @T["offboarding.remove-from-all-ad-groups"]</label> }
            <label><input type="checkbox" @bind="options.RemoveCloudGroups" @bind:after="Clear" /> @T["offboarding.remove-from-all-cloud-groups"]</label>
            <label><input type="checkbox" @bind="options.ToSharedMailbox" @bind:after="Clear" /> @T["offboarding.convert-mailbox-to-a-shared"]</label>
            <label><input type="checkbox" @bind="options.RemoveLicences" @bind:after="Clear" /> @T["offboarding.remove-licences"]</label>
        </div>
        <div class="kb-filters">
            <button class="kb-knop kb-primair" @onclick="MakePlan">@T["bulk-tasks.make-plan"]</button>
        </div>
        <details class="kb-later">
            <summary>@T["offboarding.run-later-e-g-on"]</summary>
            <p class="kb-zacht">
                @Html("offboarding.scheduled")
            </p>
            <Schedule Default="options.Date" Selected="PlanIn" />
            @if (scheduled is not null) { <div class="kb-melding kb-goed">@T.Format("new-user.scheduled-on-0", scheduled.Value.ToString("dd/MM/yyyy HH:mm"))</div> }
        </details>
    </section>

    @if (plan is not null)
    {
        <PlanView Plan="plan" Context="@($"Uitstroom {person.Name}")" Title="@T["menu.uitstroom"]" Executed="AfterExecute" />
    }
}

@code {
    [Parameter] public string? Key { get; set; }

    private Person? person;
    private OffboardingOptions options = new();
    private IReadOnlyList<Change>? plan;

    protected override void OnParametersSet()
    {
        var newValue = Key is null ? null : State.Data.SearchPerson(Key);
        if (newValue?.Key != person?.Key)
        {
            person = newValue;
            options = person is null ? new() : State.PageState.Form<OffboardingOptions>(Form, Form, $"Uitstroom {person.Name}");
            plan = null;
        }
    }

    private void Choose(Person? p) => Nav.NavigateTo(p is null ? "uitstroom" : "uitstroom/" + Uri.EscapeDataString(p.Key));

    private DateTimeOffset? scheduled;

    private void Clear()
    {
        plan = null;
        scheduled = null;
    }

    private void PlanIn(DateTimeOffset whenValue)
    {
        if (person is null)
        {
            return;
        }

        State.Schedule(ScheduledPlans.Offboarding(person, options, whenValue, State.User));
        scheduled = whenValue;
        var date = options.Date;
        State.PageState.Forget(Form);
        options = State.PageState.Form(Form, Form, $"Uitstroom {person.Name}", () => new OffboardingOptions { Date = date });
    }

    // The options are kept per person until you run or schedule the offboarding
    private string Form => "uitstroom/" + person?.Key;

    private void AfterExecute(IReadOnlyList<ChangeResult> results)
    {
        if (results.Any(r => r.Status == ResultStatus.Succeeded))
        {
            State.PageState.Forget(Form);
        }
    }

    private void MakePlan() => plan = person is null ? null : PlanBuilder.Offboarding(State.Data, State.Config, person, options);
}
