@page "/gepland"
@inherits VerversendePagina

<h1>Gepland</h1>

<p class="kb-zacht">
    Uit- en instroom, scripts en het einde van een tijdelijke uitzondering op een Conditional Access-beleid, klaargezet voor later. De app voert niets vanzelf uit: is het moment voorbij, dan staat de actie
    hier klaar en verschijnt er een melding onderaan het menu. Kies <strong>Plan tonen</strong>, kijk het na en voer het uit.
    Een uitstroom wordt dan opnieuw berekend uit de gegevens van dat moment; laad daarom eerst live.
</p>

@if (!State.IsLive && acties.Any(a => a.IsVervallen(DateTimeOffset.Now)))
{
    <div class="kb-melding">De gegevens zijn niet live. <a href="verbindingen">Laad eerst live</a>, zodat het plan klopt met de huidige toestand.</div>
}

@if (acties.Count == 0)
{
    <div class="kb-melding">Niets gepland. Inplannen doe je bij <a href="uitstroom">Uitstroom</a>, <a href="nieuw">Nieuwe gebruiker</a> of <a href="scripts">Scripts</a>.</div>
}
else
{
    <table class="kb-tabel">
        <thead><tr><th>Wanneer</th><th>Wat</th><th>Ingepland door</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in acties)
            {
                var klaar = a.IsVervallen(DateTimeOffset.Now);
                <tr class="@(klaar ? "kb-vervallen" : null)">
                    <td>@a.Wanneer.ToString("ddd dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.GetCultureInfo("nl-BE")) @if (klaar) { <span class="kb-label kb-label-let">klaar om uit te voeren</span> }</td>
                    <td>
                        @if (a.Soort == GeplandSoort.Script)
                        {
                            @a.Titel <span class="kb-zacht">@HerhalingTekst(a.Herhaling)</span>
                        }
                        else if (a.Soort == GeplandSoort.Uitstroom && a.PersoonSleutel is { } sleutel && State.Data.ZoekPersoon(sleutel) is { } p)
                        {
                            <text>Uitstroom van </text><ObjectLink Object="State.Data.Index.Ref(p)" />
                        }
                        else
                        {
                            @a.Titel
                        }
                    </td>
                    <td class="kb-zacht">@a.AangemaaktDoor, @a.Aangemaakt.ToString("dd/MM HH:mm")</td>
                    <td>
                        <span class="kb-filters">
                            @if (a.Soort == GeplandSoort.Script)
                            {
                                <a class="kb-knop kb-klein @(klaar ? "kb-primair" : null)" href="@($"scripts/starten/{Uri.EscapeDataString(a.ScriptSleutel ?? string.Empty)}?gepland={a.Id}")">Starten</a>
                            }
                            else
                            {
                                <button class="kb-knop kb-klein @(klaar ? "kb-primair" : null)" @onclick="() => Toon(a)">Plan tonen</button>
                            }
                            @if (verwijderen == a.Id)
                            {
                                <button class="kb-knop kb-klein kb-gevaar" @onclick="() => Verwijder(a)">Ja, schrappen</button>
                                <button class="kb-knop kb-klein" @onclick="() => verwijderen = null">Nee</button>
                            }
                            else
                            {
                                <button class="kb-knop kb-klein" @onclick="() => verwijderen = a.Id">Schrappen</button>
                            }
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (gekozen is not null && uitkomst is not null)
{
    @if (!gekozen.IsVervallen(DateTimeOffset.Now))
    {
        <div class="kb-melding">Het geplande moment (@gekozen.Wanneer.ToString("dd/MM/yyyy HH:mm")) is nog niet voorbij. Je kan het plan nu al bekijken, of vervroegd uitvoeren.</div>
    }

    @foreach (var f in uitkomst.Fouten)
    {
        <div class="kb-melding kb-fout">@f</div>
    }

    @if (uitkomst.Plan.Count > 0)
    {
        <PlanWeergave Plan="uitkomst.Plan" Context="@($"{gekozen.Titel} (gepland)")" Titel="@gekozen.Titel" Uitgevoerd="NaUitvoeren" />
    }

    @if (wachtwoord is not null)
    {
        <section class="kb-kaart kb-geheim">
            <h2>Startwachtwoord</h2>
            <KopieerVeld Waarde="@wachtwoord" Label="Startwachtwoord" Geheim="true" />
            <p class="kb-zacht">Geef dit door aan de gebruiker; het moet gewijzigd worden bij de eerste aanmelding. De app bewaart het nergens.</p>
        </section>
    }

    @if (melding is not null)
    {
        <div class="kb-melding kb-goed">@melding</div>
    }
}

@code {
    private List<GeplandeActie> acties = new();
    private GeplandeActie? gekozen;
    private GeplandPlan? uitkomst;
    private string? wachtwoord;
    private string? melding;
    private Guid? verwijderen;

    protected override void OnParametersSet()
    {
        try
        {
            acties = State.Gepland.Lees().OrderBy(a => a.Wanneer).ToList();
        }
        catch (Exception ex)
        {
            acties = new();
            melding = "Gepland lezen mislukt: " + ex.Message;
        }
    }

    private void Toon(GeplandeActie a)
    {
        gekozen = a;
        uitkomst = GeplandPlannen.PlanVoor(a, State.Data, State.Config);
        wachtwoord = null;
        melding = null;
    }

    private void Verwijder(GeplandeActie a)
    {
        State.VerwijderGepland(a.Id);
        verwijderen = null;
        if (gekozen?.Id == a.Id)
        {
            gekozen = null;
            uitkomst = null;
        }

        OnParametersSet();
    }

    private void NaUitvoeren(IReadOnlyList<WijzigingResultaat> resultaten)
    {
        if (gekozen is null || uitkomst is null)
        {
            return;
        }

        var gelukt = resultaten.Count(r => r.Status == ResultaatStatus.Gelukt);
        if (gelukt == 0)
        {
            melding = "Niets gelukt; de actie blijft gepland.";
            return;
        }

        if (gekozen.Soort == GeplandSoort.Instroom)
        {
            var aanmaken = uitkomst.Plan.FirstOrDefault(w => w.Actie == Actie.AdGebruikerAanmaken);
            if (aanmaken is not null && resultaten.Any(r => r.WijzigingId == aanmaken.Id && r.Status == ResultaatStatus.Gelukt))
            {
                wachtwoord = aanmaken.Geheim;
                if (gekozen.NaSynchronisatie.Count > 0 && gekozen.Upn is { } upn)
                {
                    State.VoegOpvolgingToe(new OpvolgTaak { Upn = upn, Omschrijving = gekozen.Titel, Wijzigingen = gekozen.NaSynchronisatie.ToList() });
                }
            }

            foreach (var w in uitkomst.Plan)
            {
                w.Geheim = null;
            }
        }

        State.VerwijderGepland(gekozen.Id);
        melding = gekozen.NaSynchronisatie.Count > 0 && gekozen.Soort == GeplandSoort.Instroom
            ? "Uitgevoerd en uit Gepland gehaald. De stappen na de synchronisatie staan bij Opvolging."
            : "Uitgevoerd en uit Gepland gehaald.";
        OnParametersSet();
    }

    private static string HerhalingTekst(Herhaling h) => h switch
    {
        Herhaling.Dagelijks => "(elke dag)",
        Herhaling.Wekelijks => "(elke week)",
        Herhaling.Maandelijks => "(elke maand)",
        _ => string.Empty,
    };
}
