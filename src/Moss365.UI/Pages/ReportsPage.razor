@page "/rapporten"
@inherits RefreshingPage
@using Moss365.Core.Reporting
@using CheckStatus = Moss365.Core.Security.CheckStatus
@* Reports (R14, 0.37): the monthly or quarterly report from the stored history (also for a period in the past), data
   quality per department and the checks mapped to standards. Saved as HTML (print as PDF) or CSV (Excel). *@

<h1>@T["menu.rapporten"]</h1>

<p class="kb-zacht">
    @T["reports.a-report-per-month-or"]
</p>

<section class="kb-kaart">
    <h2>@T["security.period"]</h2>
    <div class="kb-filters">
        <button class="kb-knop kb-klein @(choice == "maand" ? "kb-primair" : null)" @onclick="@(() => Choose("maand"))">@T["reports.last-month"]</button>
        <button class="kb-knop kb-klein @(choice == "kwartaal" ? "kb-primair" : null)" @onclick="@(() => Choose("kwartaal"))">@T["reports.last-quarter"]</button>
        <button class="kb-knop kb-klein @(choice == "zelf" ? "kb-primair" : null)" @onclick="@(() => Choose("zelf"))">@T["reports.choose-yourself"]</button>
    </div>
    @if (choice == "zelf")
    {
        <label>@T["absence-card.from"] <input class="kb-invoer kb-smal" type="date" @bind="from" aria-label="@T["absence-card.from"]" /></label>
        <label>@T["absence-card.until"] <input class="kb-invoer kb-smal" type="date" @bind="to" aria-label="@T["absence-card.until"]" /></label>
    }
    <p>@Html("reports.period", Period.Name, Period.From.ToString("dd/MM/yyyy"), Period.To.ToString("dd/MM/yyyy"))</p>
    <button class="kb-knop kb-primair" @onclick="Make">@T["reports.make-report"]</button>
    @if (State.Can(Permission.Security) && State.SecurityCheckResults.Count < State.SecurityCheckList().Count)
    {
        <button class="kb-knop" disabled="@busy" @onclick="RunChecks">@(busy ? T["reports.checksbusy"] : T["reports.checksfirst"])</button>
    }
</section>

@if (report is not null)
{
    <section class="kb-kaart">
        <h2>@T.Format("reports.title", report.Period.Name)</h2>
        @foreach (var n in report.Notes) { <div class="kb-melding">@n</div> }
        @if (State.Can(Permission.Export))
        {
            <button class="kb-knop" @onclick="() => Save(false)">@T["reports.save-as-html-print-as"]</button>
            <button class="kb-knop" @onclick="() => Save(true)">@T["reports.save-as-csv-excel"]</button>
        }
        @if (saved is not null) { <p class="kb-zacht">@T.Format("reports.saved", saved)</p> }

        <h3>@T["reports.indicators"]</h3>
        <table class="kb-tabel">
            <thead><tr><th>@T["reports.indicator"]</th><th class="kb-getal">@T["reports.start"]</th><th class="kb-getal">@T["reports.end"]</th><th class="kb-getal">@T["library-panel.difference"]</th></tr></thead>
            <tbody>
                @foreach (var k in report.Kpis)
                {
                    <tr><td>@k.Title</td><td class="kb-getal">@k.Start</td><td class="kb-getal">@k.End</td>
                        <td class="kb-getal @(k.Attention && k.Difference > 0 ? "kb-fout" : null)">@(k.Difference?.ToString("+0;-0;0"))</td></tr>
                }
            </tbody>
        </table>

        <h3>@T.Format("reports.changes", report.Changes.Sum(c => c.Succeeded), report.Changes.Sum(c => c.Failed))</h3>
        <table class="kb-tabel">
            <thead><tr><th>@T["nested-groups.kind"]</th><th class="kb-getal">@T["reports.succeeded"]</th><th class="kb-getal">@T["reports.failed"]</th></tr></thead>
            <tbody>@foreach (var c in report.Changes) { <tr><td>@c.Action</td><td class="kb-getal">@c.Succeeded</td><td class="kb-getal">@c.Failed</td></tr> }</tbody>
        </table>

        <h3>@T["reports.standards"]</h3>
        <table class="kb-tabel">
            <thead><tr><th>@T["reports.standard"]</th><th>@T["reports.measure"]</th><th>@T["plan.result"]</th><th>@T["reports.checks"]</th></tr></thead>
            <tbody>
                @foreach (var s in report.Standards)
                {
                    <tr><td>@s.Control.Standard @s.Control.Id</td><td>@s.Control.Title</td><td class="@Class(s.Status)">@PeriodReport.StatusText(s.Status)</td>
                        <td class="kb-zacht">@string.Join(", ", s.Results.Select(r => $"{r.Check}: {PeriodReport.StatusText(r.Status)}"))</td></tr>
                }
            </tbody>
        </table>
        <p class="kb-zacht">@T["reports.the-checks-are-evidence-for"]</p>
    </section>
}

<section class="kb-kaart">
    <h2>@T["reports.data-quality"]</h2>
    <p class="kb-zacht">@T["reports.per-department-how-many-active"]</p>
    <table class="kb-tabel">
        <thead><tr><th>@T["service-health-card.service"]</th><th class="kb-getal">@T["group.mensen"]</th><th class="kb-getal">@T["bulk-tasks.job-title"]</th><th class="kb-getal">@T["bulk-tasks.office"]</th><th class="kb-getal">@T["reports.manager"]</th><th class="kb-getal">@T["edit-user.phone"]</th><th class="kb-getal">@T["reports.score"]</th></tr></thead>
        <tbody>
            @foreach (var q in DataQuality.PerDepartment(State.KpiSource))
            {
                <tr class="@(q.Department == "Totaal" ? "kb-vet" : null)">
                    <td><button class="kb-link" @onclick="() => department = department == q.Department ? null : q.Department">@q.Department</button></td>
                    <td class="kb-getal">@q.People</td><td class="kb-getal">@QualityRow.Percent(q.JobTitle, q.People)%</td><td class="kb-getal">@QualityRow.Percent(q.Office, q.People)%</td>
                    <td class="kb-getal">@QualityRow.Percent(q.Manager, q.People)%</td><td class="kb-getal">@QualityRow.Percent(q.Phone, q.People)%</td><td class="kb-getal">@q.Score%</td>
                </tr>
            }
        </tbody>
    </table>
    @if (department is not null)
    {
        <h3>@T.Format("reports.missing", department)</h3>
        <ul>
            @foreach (var p in State.KpiSource.Active.Where(p => department == "Totaal" || (p.Department.Length > 0 ? p.Department : DataQuality.NoDepartment).Equals(department, StringComparison.CurrentCultureIgnoreCase))
                         .Select(p => (Person: p, Missing: DataQuality.Missing(p))).Where(x => x.Missing.Count > 0).Take(200))
            {
                <li><a href="@Searcher.Link(p.Person)">@p.Person.Name</a> <span class="kb-zacht">@string.Join(", ", p.Missing)</span></li>
            }
        </ul>
    }
</section>

@code {
    private string choice = "kwartaal";
    private DateOnly from = DateOnly.FromDateTime(DateTime.Today.AddMonths(-1));
    private DateOnly to = DateOnly.FromDateTime(DateTime.Today);
    private PeriodReport? report;
    private string? saved;
    private string? department;
    private bool busy;

    private ReportPeriod Period => choice switch
    {
        "maand" => ReportPeriod.LastMonth(DateOnly.FromDateTime(DateTime.Today)),
        "zelf" => new ReportPeriod(from <= to ? from : to, from <= to ? to : from, $"{(from <= to ? from : to):dd-MM-yyyy} tot {(from <= to ? to : from):dd-MM-yyyy}"),
        _ => ReportPeriod.LastQuarter(DateOnly.FromDateTime(DateTime.Today)),
    };

    private void Choose(string value)
    {
        choice = value;
        report = null;
        saved = null;
    }

    private void Make()
    {
        report = State.BuildReport(Period);
        saved = null;
    }

    private async Task RunChecks()
    {
        busy = true;
        try { await State.RunAllSecurityChecksAsync(); }
        finally { busy = false; }
        if (report is not null) Make();
    }

    private void Save(bool csv)
    {
        if (report is null) return;
        saved = State.SaveReport(report, csv);
        State.AppEnvironment.ShowFile(saved);
    }

    private static string? Class(CheckStatus s) => s switch { CheckStatus.Problem => "kb-fout", CheckStatus.Attention => "kb-let-op", _ => null };
}
