@page "/inrichten"
@layout SettingsLayout
@using Moss365.Core.Setup
@* The wizard (R5): sets up the open tenant. You only fill in what the app cannot find itself; every change in Entra is a
   plan with a preview and goes to the change log. *@
@inherits RefreshingPage

<h1>@T["menu.inrichten"]</h1>

<p class="kb-zacht">
    @Html("setup.intro", AppManifest.Name, State.Tenant.Name)
</p>

@if (State.IsHistoric)
{
    <div class="kb-melding">@T["set-up-tenant.you-are-looking-at-a"]</div>
    return;
}

@* U41: the Google side of the tenant, with gcloud on this PC *@
@if (State.HasGoogle)
{
    <GoogleSetupPanel />
}

@if (State.HasMicrosoft365)
{
<section class="kb-kaart">
    <h2>@T["set-up-tenant.1-tenant"]</h2>
    <div class="kb-rij">
        <label>@T["set-up-tenant.domain-or-tenant-id"] <input class="kb-invoer" @bind="domain" placeholder="@T["set-up-tenant.contoso-com"]" aria-label="@T["set-up-tenant.domain-or-tenant-id"]" /></label>
        <button class="kb-knop kb-primair" disabled="@busy" @onclick="Find">@T["message-trace-card.look-up"]</button>
    </div>
    @if (State.Settings.TenantId.Length > 0)
    {
        <p>@T["set-up-tenant.tenant-id"] <code>@State.Settings.TenantId</code></p>
    }
    else
    {
        <p class="kb-zacht">@T["set-up-tenant.microsoft-says-which-tenant-belongs"]</p>
    }
    @if (findError is not null) { <div class="kb-melding kb-fout">@findError</div> }
</section>

<section class="kb-kaart">
    <h2>@T["set-up-tenant.2-sign-in-and-check"]</h2>
    <p class="kb-zacht">
        @T["set-up-tenant.sign-in-with-an-administrator"]
    </p>
    <div class="kb-rij">
        <button class="kb-knop kb-primair" disabled="@(busy || !State.SetupAvailable)" @onclick="Read">@(State.SetupReading is null ? T["code.set-up-tenant.sign-in-and-check"] : T["code.set-up-tenant.check-again"])</button>
        @if (busy && progress is not null) { <span class="kb-zacht">@progress</span> }
        @if (State.SetupSignedInAs is { } who) { <span class="kb-zacht">@T.Format("set-up-tenant.signed-in-as-0", who)</span> }
    </div>
    @if (!State.SetupAvailable && State.Settings.TenantId.Length > 0)
    {
        <div class="kb-melding">@T["set-up-tenant.the-wizard-only-works-in"]</div>
    }
    @if (readError is not null) { <div class="kb-melding kb-fout">@readError</div> }
</section>

@if (State.SetupAssessment is { } a)
{
    <section class="kb-kaart">
        <h2>@T["set-up-tenant.3-app-registration-permissions-and"]</h2>
        <table class="kb-tabel">
            <thead><tr><th></th><th>@T["tenant-compare.area"]</th><th>@T["service-health-card.what"]</th><th>@T["this-computer.found"]</th></tr></thead>
            <tbody>
                @foreach (var i in a.Items)
                {
                    <tr class="kb-controle-@Css(i.Status)">
                        <td aria-label="@i.Status">@(i.Status switch { SetupStatus.InOrder => "✓", SetupStatus.Missing => "✗", SetupStatus.Unknown => "?", _ => "!" })</td>
                        <td>@i.Step</td>
                        <td>@i.Name</td>
                        <td>@i.Explanation</td>
                    </tr>
                }
            </tbody>
        </table>
        <label><input type="checkbox" checked="@State.SetupChoices.CreateGroups" @onchange="e => Choose(c => c with { CreateGroups = e.Value is true })" />
            @T["set-up-tenant.make-a-group-per-profile"]</label>
        <label><input type="checkbox" checked="@State.SetupChoices.AssignSignedIn" @onchange="e => Choose(c => c with { AssignSignedIn = e.Value is true })" />
            @T["set-up-tenant.give-myself-the-profiles-administrator"]</label>
        <fieldset class="kb-kaart" id="onderdelen">
            <legend>@T["setup.parts"]</legend>
            <p class="kb-zacht">@T["setup.parts.help"]</p>
            @foreach (var part in Moss365.Core.Setup.PermissionParts.All)
            {
                var key = part.Key;
                <label><input type="checkbox" checked="@Moss365.Core.Setup.PermissionParts.IsOn(State.Config.PermissionParts, key)" disabled="@(!State.Can(Permission.Settings) || State.IsHistoric)"
                              @onchange="e => SetPart(key, e.Value is true)" /> @part.Name <span class="kb-zacht">(@string.Join(", ", part.GraphScopes))</span></label>
                <p class="kb-zacht">@part.Explanation</p>
            }
        </fieldset>
        @if (a.Plan.Count > 0)
        {
            <PlanView @key="planKey" Plan="a.Plan" Title="@T["code.set-up-tenant.what-the-wizard-does-in"]" Context="@($"Tenant inrichten {State.Tenant.Name}")" Run="(p, c, r) => State.ExecuteSetupAsync(p, c, r)" Executed="AfterPlan" />
        }
        else
        {
            <p class="kb-ok">@T["set-up-tenant.the-app-registration-is-in"]</p>
        }
        @if (a.ClientId is { } clientId)
        {
            <p>
                @T["set-up-tenant.client-id"] <code>@clientId</code>
                @if (!string.Equals(State.Settings.ClientId.Trim(), clientId, StringComparison.OrdinalIgnoreCase))
                {
                    <button class="kb-knop kb-klein kb-primair" @onclick="() => State.TakeOverClientId()">@T["set-up-tenant.take-over-in-connections"]</button>
                }
                else
                {
                    <span class="kb-zacht">@T["setup.inconnections"]</span>
                }
            </p>
        }
    </section>
}
}

@if (State.HasAd)
{
<section class="kb-kaart">
    <h2>@T["set-up-tenant.4-active-directory"]</h2>
    @if (State.LocalDomain is { } d)
    {
        <p>@Html("setup.domain", d.Domain, d.Controller is { } dc ? T.Format("setup.via", dc) : string.Empty)</p>
        @if (d.Controller is not null && !string.Equals(State.Settings.AdServer.Trim(), d.Controller, StringComparison.OrdinalIgnoreCase))
        {
            <button class="kb-knop kb-primair" @onclick="() => State.TakeOverLocalDomain(d)">@T["set-up-tenant.take-over"]</button>
            @if (State.Settings.AdServer.Length > 0) { <span class="kb-zacht">@T.Format("set-up-tenant.filled-in-now-0", State.Settings.AdServer)</span> }
        }
        else if (State.Settings.AdFilled)
        {
            <p class="kb-ok">@T.Format("setup.dcset", State.Settings.AdServer)</p>
        }
    }
    else
    {
        <p class="kb-zacht">
            @Html("setup.nodomain")
        </p>
    }
    @if (State.SetupReading is { SyncEnabled: true } && State.LocalDomain is null && !State.Settings.AdFilled)
    {
        <div class="kb-melding">@T["set-up-tenant.the-tenant-synchronises-with-ad"]</div>
    }
</section>
}

@if (State.HasMicrosoft365)
{
<section class="kb-kaart">
    <h2>@T["set-up-tenant.5-exchange-online"]</h2>
    <p class="kb-zacht">
        @Html("setup.exchange")
    </p>
    @if (State.SetupReading?.SignedIn.Upn is { Length: > 0 } upn && State.Settings.ManagementUpn.Trim().Length == 0)
    {
        <button class="kb-knop" @onclick="() => State.TakeOverManagementUpn()">@T.Format("set-up-tenant.use-0-as-the-admin", upn)</button>
    }
    else if (State.Settings.ManagementUpn.Length > 0)
    {
        <p>@T.Format("set-up-tenant.admin-account-0", State.Settings.ManagementUpn)</p>
    }
</section>
}

@if (State.HasAd || State.HasMicrosoft365)
{
<section class="kb-kaart">
    <h2>@T["set-up-tenant.6-first-read"]</h2>
    <p class="kb-zacht">@T["set-up-tenant.reads-ad-entra-rooms-and"]</p>
    <button class="kb-knop kb-primair" disabled="@(State.TaskBusy || !State.CanConnect)" @onclick="Load">@T["set-up-tenant.load-everything-live"]</button>
    @if (!State.CanConnect) { <span class="kb-zacht">@T["set-up-tenant.fill-in-the-client-id"]</span> }
</section>
}

@if (State.Data.Persons.Count > 0)
{
    <SuggestionsPanel Title="@T["code.set-up-tenant.7-suggestions-for-the-organisation"]" />
}

@code {
    private string domain = string.Empty;
    private bool busy;
    private string? progress;
    private string? findError;
    private string? readError;
    private int planKey;

    protected override void OnInitialized()
    {
        domain = State.Tenant.Domain ?? State.Settings.TenantId;
    }

    private async Task Find()
    {
        busy = true;
        findError = await State.FindTenantAsync(domain);
        busy = false;
    }

    private async Task Read()
    {
        busy = true;
        var p = new Progress<string>(t => { progress = t; _ = InvokeAsync(StateHasChanged); });
        readError = await State.ReadSetupAsync(p);
        planKey++;
        busy = false;
        progress = null;
    }

    private void SetPart(string key, bool on)
    {
        State.SetPermissionPart(key, on);
        planKey++;
    }

    private void Choose(Func<SetupChoices, SetupChoices> change)
    {
        State.SetupChoices = change(State.SetupChoices);
        planKey++;
    }

    private void AfterPlan(IReadOnlyList<Moss365.Core.Changes.ChangeResult> results) => planKey++;

    private void Load() => State.StartLoading(LoadKind.Everything);

    private static string Css(SetupStatus s) => s switch
    {
        SetupStatus.InOrder => "good",
        SetupStatus.Missing => "error",
        _ => "warning",
    };
}
