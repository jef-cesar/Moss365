@page "/uitstroom"
@page "/uitstroom/{Sleutel}"
@inject BeheerState State
@inject NavigationManager Nav

<h1>Uitstroom</h1>

<p class="kb-zacht">
    Het account wordt uitgeschakeld en naar <code>@(State.Config.Uitstroom?.Ou ?? "(geen OU ingesteld)")</code> verplaatst,
    nooit verwijderd. Bevoorrechte groepen worden altijd verwijderd. Kies hieronder wat er verder moet gebeuren; in het plan
    kan je elke stap nog aan- of uitvinken.
</p>

<PersoonKiezer Label="Gebruiker" Gekozen="persoon" GekozenChanged="Kies" />

@if (persoon is not null)
{
    @if (!persoon.Ingeschakeld)
    {
        <div class="kb-melding">Dit account is al uitgeschakeld.</div>
    }

    <section class="kb-kaart">
        <h2>Opties</h2>
        <div class="kb-raster">
            <label>Datum uit dienst <input class="kb-invoer" type="date" @bind="opties.Datum" @bind:after="Wis" /></label>
        </div>
        <div class="kb-keuzelijst">
            <label><input type="checkbox" @bind="opties.Uitschakelen" @bind:after="Wis" /> Account uitschakelen</label>
            <label><input type="checkbox" @bind="opties.OmschrijvingAanvullen" @bind:after="Wis" /> Datum in de omschrijving zetten</label>
            <label><input type="checkbox" @bind="opties.Verplaatsen" @bind:after="Wis" /> Verplaatsen naar de uitstroom-OU</label>
            <label><input type="checkbox" @bind="opties.SessiesIntrekken" @bind:after="Wis" /> Aanmeldsessies intrekken</label>
            <label><input type="checkbox" @bind="opties.AdGroepenVerwijderen" @bind:after="Wis" /> Uit alle AD-groepen halen</label>
            <label><input type="checkbox" @bind="opties.CloudGroepenVerwijderen" @bind:after="Wis" /> Uit alle cloudgroepen halen</label>
            <label><input type="checkbox" @bind="opties.NaarGedeeldPostvak" @bind:after="Wis" /> Postvak omzetten naar een gedeeld postvak</label>
            <label><input type="checkbox" @bind="opties.LicentiesVerwijderen" @bind:after="Wis" /> Licenties verwijderen</label>
        </div>
        <div class="kb-filters">
            <button class="kb-knop kb-primair" @onclick="MaakPlan">Plan maken</button>
        </div>
        <details class="kb-later">
            <summary>Later uitvoeren (bv. op de laatste werkdag)</summary>
            <p class="kb-zacht">
                Op het gekozen moment staat de uitstroom bij <a href="gepland">Gepland</a> klaar. De app berekent het plan dan
                opnieuw uit de gegevens van dat moment (laad eerst live) en voert niets uit zonder jouw bevestiging.
            </p>
            <Inplannen Standaard="opties.Datum" Gekozen="PlanIn" />
            @if (ingepland is not null) { <div class="kb-melding kb-goed">Ingepland op @ingepland.Value.ToString("dd/MM/yyyy HH:mm").</div> }
        </details>
    </section>

    @if (plan is not null)
    {
        <PlanWeergave Plan="plan" Context="@($"Uitstroom {persoon.Naam}")" Titel="Uitstroom" Uitgevoerd="NaUitvoeren" />
    }
}

@code {
    [Parameter] public string? Sleutel { get; set; }

    private Persoon? persoon;
    private UitstroomOpties opties = new();
    private IReadOnlyList<Wijziging>? plan;

    protected override void OnParametersSet()
    {
        var nieuw = Sleutel is null ? null : State.Data.ZoekPersoon(Sleutel);
        if (nieuw?.Sleutel != persoon?.Sleutel)
        {
            persoon = nieuw;
            opties = persoon is null ? new() : State.Paginastatus.Formulier<UitstroomOpties>(Formulier, Formulier, $"Uitstroom {persoon.Naam}");
            plan = null;
        }
    }

    private void Kies(Persoon? p) => Nav.NavigateTo(p is null ? "uitstroom" : "uitstroom/" + Uri.EscapeDataString(p.Sleutel));

    private DateTimeOffset? ingepland;

    private void Wis()
    {
        plan = null;
        ingepland = null;
    }

    private void PlanIn(DateTimeOffset wanneer)
    {
        if (persoon is null)
        {
            return;
        }

        State.Inplannen(GeplandPlannen.Uitstroom(persoon, opties, wanneer, State.Gebruiker));
        ingepland = wanneer;
        var datum = opties.Datum;
        State.Paginastatus.Vergeet(Formulier);
        opties = State.Paginastatus.Formulier(Formulier, Formulier, $"Uitstroom {persoon.Naam}", () => new UitstroomOpties { Datum = datum });
    }

    // De opties blijven per persoon bewaard tot je de uitstroom uitvoert of inplant
    private string Formulier => "uitstroom/" + persoon?.Sleutel;

    private void NaUitvoeren(IReadOnlyList<WijzigingResultaat> resultaten)
    {
        if (resultaten.Any(r => r.Status == ResultaatStatus.Gelukt))
        {
            State.Paginastatus.Vergeet(Formulier);
        }
    }

    private void MaakPlan() => plan = persoon is null ? null : PlanBouwer.Uitstroom(State.Data, State.Config, persoon, opties);
}
