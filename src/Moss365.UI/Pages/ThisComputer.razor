@page "/controle"
@inject ManagementState State
@inject IServiceProvider Services

<h1>Controle van deze pc</h1>

<p class="kb-zacht">
    Kijkt na of alles aanwezig is wat de app en de scripts nodig hebben: PowerShell, de modules (in Windows PowerShell en
    PowerShell 7 apart, want elk heeft zijn eigen modules), de klok, de verbinding met de domeincontroller en met Microsoft
    365. Ontbreekt iets, dan kan je het hier installeren, enkel uit officiële bronnen (PowerShell Gallery, winget,
    Windows) en altijd na bevestiging; elke installatie komt in het logboek. Modules installeren voor jouw account vraagt
    geen beheerdersrechten; PowerShell 7 en de AD-module (RSAT) wel: Windows vraagt dan om bevestiging.
</p>

<section class="kb-kaart" id="over">
    <h2>Over Moss365</h2>
    <p>Versie <strong>@ManagementState.AppVersion</strong>.
        @if (State.UpdateAvailable)
        {
            <span class="kb-label kb-label-let">versie @State.Update!.NewestVersion beschikbaar</span>
        }
        else if (State.Update is { NewestVersion: not null })
        {
            <span class="kb-zacht">Dit is de nieuwste versie.</span>
        }
        else if (State.Update?.Message is { } message)
        {
            <span class="kb-zacht">@message</span>
        }
    </p>
    <p class="kb-zacht">
        Elke versie staat als release op GitHub (zip met Moss365.exe en de scripts). Pak een nieuwe versie uit over de oude
        map: je instellingen, logboek en inventarissen staan apart en blijven bewaard.
    </p>
    <div class="kb-filters">
        <CopyField Value="@(State.Update?.Link ?? State.ReleasesLink)" Label="Link naar de releases" />
        <button class="kb-knop" disabled="@searches" @onclick="SearchUpdate">Nu zoeken</button>
    </div>
    <label><input type="checkbox" checked="@State.Settings.SearchUpdates" @onchange="SetUpdateSearch" /> Bij het starten zoeken naar een nieuwe versie</label>
    <p>
        Organisatie: <code>@(State.ConfigSource ?? "niet gevonden")</code>
        (@State.Config.Populations.Count soorten, @State.Config.Departments.Count diensten, @State.Config.Offices.Count kantoren)
        @if (State.ConfigWarning is { } w) { <span class="kb-label kb-rood">@w</span> }
    </p>
</section>

@if (State.Check is null)
{
    <div class="kb-melding">Deze controle werkt enkel in de Windows-app.</div>
}
else
{
    <div class="kb-filters">
        <button class="kb-knop kb-primair" disabled="@busy" @onclick="Check">@(rules is null ? "Controleren" : "Opnieuw controleren")</button>
        @if (busy && progress is not null) { <span class="kb-zacht">@progress</span> }
        @if (rules is not null && Installable.Count > 0)
        {
            @if (confirmAll)
            {
                <span>@Installable.Count onderdeel(en) installeren: @string.Join(", ", Installable.Select(r => r.Section))?</span>
                <button class="kb-knop kb-gevaar" disabled="@busy" @onclick="InstallAll">Ja, alles installeren</button>
                <button class="kb-knop" @onclick="() => confirmAll = false">Annuleren</button>
            }
            else
            {
                <button class="kb-knop" disabled="@busy" @onclick="() => confirmAll = true">Alles installeren wat ontbreekt (@Installable.Count)</button>
            }
        }
    </div>
    <label><input type="checkbox" checked="@askAtOnce" @onchange="SetAskAtOnce" /> Ontbrekende onderdelen meteen voorstellen na het nakijken (de app vraagt één keer)</label>

    @if (rules is not null)
    {
        <div class="kb-tegels">
            @foreach (var (status, label) in new[] { (CheckStatus.Good, "in orde"), (CheckStatus.Warning, "aandacht"), (CheckStatus.Error, "probleem") })
            {
                <div class="kb-tegel kb-controle-@status.ToString().ToLowerInvariant()"><div class="kb-tegel-getal">@rules.Count(r => r.Status == status)</div><div>@label</div></div>
            }
        </div>

        @foreach (var groupValue in rules.GroupBy(r => r.Group))
        {
            <section class="kb-kaart">
                <h2>@groupValue.Key</h2>
                <table class="kb-tabel">
                    <thead><tr><th></th><th>Onderdeel</th><th>Gevonden</th><th>Uitleg</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in groupValue)
                        {
                            <tr class="kb-controle-@r.Status.ToString().ToLowerInvariant()">
                                <td aria-label="@r.Status">@(r.Status switch { CheckStatus.Good => "✓", CheckStatus.Warning => "!", _ => "✗" })</td>
                                <td>@r.Section</td>
                                <td>@r.Value</td>
                                <td>
                                    @r.Explanation
                                    @if (r.Status != CheckStatus.Good && r.Solution is not null) { <div><code>@r.Solution</code></div> }
                                    @if (messages.TryGetValue(Key(r), out var m)) { <div class="@(m == "Gelukt" ? "kb-ok" : "kb-waarschuwing")">@m</div> }
                                </td>
                                <td>
                                    @if (r.Status != CheckStatus.Good && r.Module is not null && r.PowerShell is not null)
                                    {
                                        @if (confirm == Key(r))
                                        {
                                            <button class="kb-knop kb-klein kb-gevaar" disabled="@busy" @onclick="() => Install(r)">Ja, installeren</button>
                                            <button class="kb-knop kb-klein" @onclick="() => confirm = null">Annuleren</button>
                                        }
                                        else
                                        {
                                            <button class="kb-knop kb-klein" disabled="@busy" @onclick="() => confirm = Key(r)"
                                                    title="@InstallText(r)">Installeren</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    }
}

@code {
    private bool searches;

    private async Task SearchUpdate()
    {
        searches = true;
        await State.SearchUpdateAsync();
        searches = false;
    }

    private void SetUpdateSearch(ChangeEventArgs e)
    {
        State.Settings.SearchUpdates = e.Value is true;
        State.SaveSettings();
    }

    private IReadOnlyList<CheckRule>? rules;
    private bool busy;
    private string? progress;
    private string? confirm;
    private readonly Dictionary<string, string> messages = new();

    private static string Key(CheckRule r) => $"{r.PowerShell}|{r.Module ?? r.Section}";

    private async Task Check()
    {
        busy = true;
        try
        {
            var p = new Progress<string>(t => { progress = t; _ = InvokeAsync(StateHasChanged); });
            rules = await State.Check!.CheckAsync(State.Settings, p, CancellationToken.None);
            confirmAll = askAtOnce && Installable.Count > 0;
        }
        catch (Exception ex)
        {
            rules = new[] { new CheckRule("Controle", "Controle", CheckStatus.Error, "mislukt", ex.Message) };
        }
        finally
        {
            busy = false;
            progress = null;
        }
    }

    private async Task Install(CheckRule r)
    {
        busy = true;
        confirm = null;
        progress = $"{r.Module} installeren...";
        try
        {
            messages[Key(r)] = await State.InstallAsync(r);
        }
        finally
        {
            busy = false;
        }

        await Check();
    }

    private bool confirmAll;
    private bool askAtOnce;
    private const string AskAtOnceSetting = "installeren-meteen-voorstellen";

    private TenantHub? Hub => Services.GetService(typeof(TenantHub)) as TenantHub;

    protected override void OnInitialized() => askAtOnce = Hub?.App.Setting(AskAtOnceSetting) == "1";

    private void SetAskAtOnce(ChangeEventArgs e)
    {
        askAtOnce = e.Value is true;
        Hub?.App.SetSetting(AskAtOnceSetting, askAtOnce ? "1" : "0");
    }

    private IReadOnlyList<CheckRule> Installable => rules?.Where(r => r.Status != CheckStatus.Good && r.Module is not null && r.PowerShell is not null)
        .DistinctBy(r => (r.Module, r.PowerShell)).ToList() ?? new List<CheckRule>();

    private async Task InstallAll()
    {
        busy = true;
        confirmAll = false;
        try
        {
            foreach (var r in Installable)
            {
                progress = $"{r.Section} installeren...";
                StateHasChanged();
                messages[Key(r)] = await State.InstallAsync(r);
            }
        }
        finally
        {
            busy = false;
        }

        await Check();
    }

    private static string InstallText(CheckRule r) => r.Module switch
    {
        "PowerShell7" => "Installeert PowerShell 7 via winget (Microsoft); Windows vraagt om bevestiging",
        "RSAT" => "Installeert de AD-module als Windows-onderdeel; Windows vraagt beheerdersrechten",
        _ => $"Installeert {r.Module} voor jouw account uit de PowerShell Gallery",
    };
}
