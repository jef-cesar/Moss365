@page "/"
@inherits RefreshingPage

<div class="kb-banner">
    <img src="_content/Moss365.UI/moss365-logo.webp" alt="Moss365 - Have you tried turning the user off and on again?" />
</div>

<h1>Overzicht</h1>

<p class="kb-zacht">
    Moss365 (The Moss Directory) beheert gebruikers, groepen en rooms over on-prem AD, Entra ID en Exchange Online heen.
    De app start met de inventaris van <code>Export-Inventaris.ps1</code> (per bestand de nieuwste map). Via
    <a href="verbindingen">Verbindingen</a> laad je live gegevens uit AD, Entra en Exchange. Wijzigingen gebeuren altijd als
    plan: eerst een voorbeeld, dan bevestigen, dan uitvoeren, en alles komt in het <a href="logboek">logboek</a>.
</p>

<p>Huidige gegevens: <strong>@State.Data.Origin</strong>@if (State.LoadedOn is { } t) { <text>, geladen om @t.ToString("HH:mm")</text> }</p>

<section class="kb-kaart">
    <h2>Inventaris</h2>
    @if (State.Folders.Count == 0 && State.PreferenceFolder is null)
    {
        <div class="kb-melding">
            Geen inventaris gevonden in <code>@State.AppEnvironment.InventoryBase</code>.
            Draai eerst <code>Export-Inventaris.ps1</code> of geef hieronder een andere map op.
        </div>
    }

    <div class="kb-rij">
        <label>Map met voorrang</label>
        <select class="kb-invoer" @onchange="ChooseFolder">
            <option value="" selected="@(State.PreferenceFolder is null)">Automatisch (per bestand de nieuwste)</option>
            @foreach (var m in State.Folders)
            {
                <option value="@m" selected="@(m == State.PreferenceFolder)">@Path.GetFileName(m)</option>
            }
        </select>
        <button class="kb-knop" @onclick="State.LoadInventory">Opnieuw laden</button>
    </div>
    <div class="kb-rij">
        <label>Andere map</label>
        <input class="kb-invoer" placeholder="Volledig pad naar een inventarismap" @bind="otherFolder" />
        <button class="kb-knop" @onclick="() => State.ChooseFolder(otherFolder)">Gebruiken</button>
    </div>

    <table class="kb-tabel">
        <thead><tr><th>Bestand</th><th>Uit map</th><th class="kb-getal">Rijen</th></tr></thead>
        <tbody>
            @foreach (var b in State.Data.Sources)
            {
                <tr class="@(b.Folder is null ? "kb-ontbreekt" : null)">
                    <td><code>@b.File</code></td>
                    <td>@(b.Folder is null ? "niet gevonden" : Path.GetFileName(b.Folder))</td>
                    <td class="kb-getal">@b.Rows</td>
                </tr>
            }
        </tbody>
    </table>
</section>

<section class="kb-kaart">
    <h2>Accounts</h2>
    <div class="kb-tegels">
        @foreach (var g in State.Data.Persons.GroupBy(p => p.Source).OrderByDescending(g => g.Count()))
        {
            <Tile Kpi="Kpis.Source(g.Key)" />
        }
    </div>
    <p class="kb-zacht">
        "AD + Entra" zijn gesynchroniseerde accounts. "Alleen Entra" zijn vooral de accounts achter gedeelde, room- en
        planningspostvakken. "Alleen AD" zijn uitgeschakelde, technische en niet-gesynchroniseerde accounts.
    </p>
</section>

<section class="kb-kaart">
    <h2>Organisatie</h2>
    <p>
        Bron: <code>@(State.ConfigSource ?? "geen organisatie.json gevonden")</code>
        @if (State.ConfigIsModified)
        {
            <span class="kb-label">eigen wijzigingen</span>
        }
    </p>
    <p>
        @State.Config.Departments.Count diensten, waarvan
        <strong>@State.Config.Departments.Count(d => string.IsNullOrWhiteSpace(d.Division))</strong> nog zonder afdeling.
        <a href="organisatie">Koppelen</a>
    </p>
</section>

@code {
    private string otherFolder = string.Empty;

    private void ChooseFolder(ChangeEventArgs e) => State.ChooseFolder(e.Value?.ToString());
}
