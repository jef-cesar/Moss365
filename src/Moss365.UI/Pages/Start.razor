@page "/"
@inherits RefreshingPage
@using Moss365.Core.Reporting

<div class="kb-banner">
    <img src="_content/Moss365.UI/moss365-logo.webp" alt="Moss365 - Have you tried turning the user off and on again?" />
</div>

<h1>@T["menu.start"]</h1>

<p class="kb-zacht">
    @Html("start.intro", Systems)
</p>

<p>@T["start.current"] <strong>@State.Data.Origin</strong>@if (State.LoadedOn is { } t) { @T.Format("start.loadedat", t) }</p>

@if (State.Can(Permission.Security))
{
    <SinceLastVisitCard />
}

<div class="kb-filters" id="periode">
    <span>@T["overview.compare-with"]</span>
    @foreach (var p in Overview.Periods)
    {
        var value = p;
        <button class="kb-knop kb-klein" aria-pressed="@(days == value ? "true" : "false")" @onclick="() => days = value">@T.Format("overview.days-ago", value)</button>
    }
    <button class="kb-knop kb-klein" aria-expanded="@(arranging ? "true" : "false")" @onclick="() => arranging = !arranging">@T["overview.arrange"]</button>
    @if (State.Can(Permission.Export))
    {
        <button class="kb-knop kb-klein" @onclick="SaveBoard">@T["board.save"]</button>
    }
</div>
@if (board is not null)
{
    <div class="kb-melding" role="status">
        @T.Format("board.saved", board)
        <button class="kb-knop kb-klein" @onclick="() => State.AppEnvironment.ShowFile(board)">@T["kb-table.show-in-explorer"]</button>
    </div>
}

@if (arranging)
{
    <section class="kb-kaart" id="indeling">
        <h2>@T["overview.arrange"]</h2>
        <p class="kb-zacht">@T["overview.arrange.help"]</p>
        <ul>
            @foreach (var (block, i) in Layout.Order.Select((b, i) => (b, i)))
            {
                var b = block;
                <li>
                    <label><input type="checkbox" checked="@(!Layout.Hidden.Contains(b))" @onchange="() => State.SaveOverviewLayout(Overview.Toggle(Layout, b))" /> @T[$"overview.block.{b}"]</label>
                    <button class="kb-knop kb-klein" disabled="@(i == 0)" aria-label="@T.Format("overview.up", T[$"overview.block.{b}"])" @onclick="() => State.SaveOverviewLayout(Overview.Move(Layout, b, -1))">&uarr;</button>
                    <button class="kb-knop kb-klein" disabled="@(i == Layout.Order.Count - 1)" aria-label="@T.Format("overview.down", T[$"overview.block.{b}"])" @onclick="() => State.SaveOverviewLayout(Overview.Move(Layout, b, 1))">&darr;</button>
                </li>
            }
        </ul>
        <button class="kb-knop kb-klein" @onclick="() => State.SaveOverviewLayout(null)">@T["overview.arrange.default"]</button>
    </section>
}

@foreach (var block in Layout.Order.Where(b => !Layout.Hidden.Contains(b)))
{
    var tiles = Tiles.Where(t => t.Block == block).ToList();
    <section class="kb-kaart" id="@($"blok-{block.ToString().ToLowerInvariant()}")">
        <h2>@T[$"overview.block.{block}"]</h2>
        @if (tiles.Count == 0)
        {
            <p class="kb-zacht">@T["overview.block.empty"]</p>
        }
        else
        {
            <div class="kb-tegels">
                @foreach (var tile in tiles)
                {
                    <OverviewTileView Tile="tile" Days="days" />
                }
            </div>
        }
        @if (block == OverviewBlock.Devices && State.IntuneDevices is null && State.AdComputers is null)
        {
            <p class="kb-zacht">@T["overview.devices.read"] <a href="toestellen">@T["menu.toestellen"]</a></p>
        }
        @if (block == OverviewBlock.Work && State.HasMicrosoft365)
        {
            <ServiceHealthCard />
        }
    </section>
}

<section class="kb-kaart">
    <h2>@T["start.accounts"]</h2>
    <div class="kb-tegels">
        @foreach (var g in State.Data.Persons.GroupBy(p => p.Source).OrderByDescending(g => g.Count()))
        {
            <Tile Kpi="Kpis.Source(g.Key)" />
        }
    </div>
    @if (State.HasAd && State.HasMicrosoft365)
    {
    <p class="kb-zacht">
        @T["start.accounts.help"]
    </p>
    }
</section>

<section class="kb-kaart">
    <h2>@T["menu.organisatie"]</h2>
    <p>
        @T["start.source"] <code>@(State.ConfigSourceText ?? T["start.noconfig"])</code>
        @if (State.ConfigIsModified)
        {
            <span class="kb-label">@T["start.ownchanges"]</span>
        }
    </p>
    <p>
        @Html("start.departments", State.Config.Departments.Count, State.Config.Departments.Count(d => string.IsNullOrWhiteSpace(d.Division)))
        <a href="organisatie">@T["start.link"]</a>
    </p>
</section>

@code {
    /// <summary>The systems of this tenant, in words (0.21.1).</summary>
    private string Systems => (State.HasAd, State.HasMicrosoft365) switch
    {
        (true, true) => T["start.systems.both"],
        (true, false) => T["start.systems.ad"],
        _ => T["start.systems.cloud"],
    };

    // The overview (R19): the tiles once per data and period, not at every redraw
    private int days = 30;
    private bool arranging;
    private (object Data, int Days, IReadOnlyList<OverviewTile> Tiles)? computed;

    private OverviewLayout Layout => State.OverviewLayout;

    private string? board;

    private void SaveBoard() => board = State.SaveBoardSummary(days);

    private IReadOnlyList<OverviewTile> Tiles
    {
        get
        {
            if (computed is not { } c || !ReferenceEquals(c.Data, State.Data) || c.Days != days)
            {
                computed = c = (State.Data, days, State.OverviewTiles(days));
            }

            return c.Tiles;
        }
    }

    // The start screen marks the visit (R18), once per session; the card shows what changed since the one before
    protected override void OnInitialized() => State.BeginVisit();
}
