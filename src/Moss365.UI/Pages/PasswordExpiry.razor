@page "/wachtwoorden"
@inherits RefreshingPage
@using Moss365.Core.Helpdesk
@* Passwords that expire soon (R10, 0.33): for people rarely on the network. A reminder e-mail (to the user and/or the
   manager) is a plan, sent by the signed-in administrator. *@

<h1>Wachtwoord verloopt binnenkort</h1>

<p class="kb-zacht">
    Accounts in AD waarvan het wachtwoord binnenkort verloopt (ingeschakeld, niet "verloopt nooit"). Vooral voor wie zelden op het
    netwerk zit (thuiswerk, VPN): stuur een herinnering, als plan zoals altijd.
</p>

<section class="kb-kaart">
    <div class="kb-rij">
        <label>Wachtwoorden verlopen na
            <input class="kb-invoer" type="number" min="0" max="999" value="@State.Config.PasswordMaxAgeDays" aria-label="Dagen"
                   @onchange="e => SetAge(e.Value)" /> dagen
        </label>
        @if (Suggested is { } s && s != State.Config.PasswordMaxAgeDays) { <button class="kb-knop kb-klein" @onclick="() => SetAge(s)">Voorstel uit de gegevens: @s dagen</button> }
        <label>Binnen
            <select class="kb-invoer" @bind="within" aria-label="Binnen hoeveel dagen">
                <option value="7">7 dagen</option><option value="14">14 dagen</option><option value="30">30 dagen</option>
            </select>
        </label>
    </div>
    @if (State.Config.PasswordMaxAgeDays <= 0)
    {
        <p class="kb-zacht">Vul in na hoeveel dagen een wachtwoord verloopt (het wachtwoordbeleid van het domein); 0 = verloopt niet.</p>
    }
</section>

@if (State.Config.PasswordMaxAgeDays > 0)
{
    <section class="kb-kaart">
        <h2>@List.Count account(s)</h2>
        <table class="kb-tabel">
            <thead><tr><th></th><th>Naam</th><th>Verloopt</th><th class="kb-getal">Dagen</th><th>Laatst gewijzigd</th></tr></thead>
            <tbody>
                @foreach (var x in List)
                {
                    <tr class="@(x.DaysLeft < 0 ? "kb-verschil" : null)">
                        <td><input type="checkbox" checked="@chosen.Contains(x.Person.Key)" aria-label="@x.Person.Name" @onchange="e => Toggle(x.Person.Key, e.Value is true)" /></td>
                        <td><a href="@Searcher.Link(x.Person)">@x.Person.Name</a></td>
                        <td>@x.Expires.ToString("dd/MM/yyyy")</td>
                        <td class="kb-getal">@(x.DaysLeft < 0 ? "verlopen" : x.DaysLeft.ToString())</td>
                        <td class="kb-zacht">@x.Person.Ad?.PasswordLastSet</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (State.Can(Permission.Helpdesk) && State.HasMicrosoft365)
        {
            <details>
                <summary>Tekst van de herinnering</summary>
                <textarea class="kb-invoer kb-breed" rows="6" aria-label="Tekst van de herinnering" @bind="text"></textarea>
                <p class="kb-zacht">{naam}, {datum} en {dagen} worden ingevuld. Bewaar de tekst bij Organisatie met de knop hieronder.</p>
                <button class="kb-knop kb-klein" @onclick="SaveText">Tekst bewaren</button>
            </details>
            <div class="kb-filters">
                <label><input type="checkbox" @bind="toManager" /> Ook naar de manager</label>
                <button class="kb-knop kb-primair" disabled="@(chosen.Count == 0)" @onclick="MakePlan">Herinnering mailen (@chosen.Count)</button>
            </div>
        }
    </section>
}

@if (outcome is not null)
{
    @foreach (var e in outcome.Errors) { <div class="kb-melding">@e</div> }
    @if (outcome.Plan.Count > 0) { <PlanView Plan="outcome.Plan" Context="Herinnering wachtwoord" Title="Herinneringen" /> }
}

@code {
    private int within = 14;
    private bool toManager;
    private readonly HashSet<string> chosen = new(StringComparer.OrdinalIgnoreCase);
    private PlanOutcome? outcome;
    private string text = string.Empty;

    protected override void OnInitialized() => text = State.Config.PasswordReminderText ?? HelpdeskTools.DefaultReminder;

    private int? Suggested => HelpdeskTools.SuggestedMaxAge(State.Data);

    private IReadOnlyList<ExpiringPassword> List => HelpdeskTools.ExpiringPasswords(State.Data, State.Config.PasswordMaxAgeDays, within, DateTime.Now);

    private void SetAge(object? value)
    {
        if (int.TryParse(value?.ToString(), out var days) && days >= 0)
        {
            State.Config.PasswordMaxAgeDays = days;
            State.SaveConfig();
        }
    }

    private void SaveText()
    {
        State.Config.PasswordReminderText = text.Trim() == HelpdeskTools.DefaultReminder ? null : text;
        State.SaveConfig();
    }

    private void Toggle(string key, bool on)
    {
        if (on) { chosen.Add(key); } else { chosen.Remove(key); }
        outcome = null;
    }

    private void MakePlan() => outcome = HelpdeskTools.PasswordReminders(State.Data, List.Where(x => chosen.Contains(x.Person.Key)), text, toManager);
}
