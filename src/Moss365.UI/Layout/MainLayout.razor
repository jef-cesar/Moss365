@inherits LayoutComponentBase
@implements IDisposable
@inject ManagementState State
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="kb-app">
    <nav class="kb-nav">
        <div class="kb-merk">
            <img src="_content/Moss365.UI/moss365.ico" alt="" />
            <div><span class="kb-merk-naam">Moss<span>365</span></span><span class="kb-merk-sub">The Moss Directory</span></div>
        </div>

        <button class="kb-nav-zoek" @onclick="() => search?.Open()" title="Zoek een pagina, gebruiker, groep of postvak (Ctrl+K)">
            <span aria-hidden="true">⌕</span> Zoeken <kbd>Ctrl+K</kbd>
        </button>

        @{ var favourites = State.View.Favourites.Select(f => AllItems.FirstOrDefault(i => i.Href == f)).OfType<MenuItem>().Where(Visible).ToList(); }
        @if (favourites.Count > 0)
        {
            <div class="kb-nav-kop">★ Favorieten</div>
            @foreach (var item in favourites)
            {
                @Item(item)
            }
        }

        <NavLink href="" Match="NavLinkMatch.All">Overzicht</NavLink>

        @foreach (var groupValue in MenuModel.Main)
        {
            var items = groupValue.Items.Where(Visible).ToList();
            if (items.Count == 0)
            {
                continue;
            }

            // The group of the page you are on is always open; the others stay as you left them
            var active = MenuModel.GroupOf(Nav.ToBaseRelativePath(Nav.Uri)) == groupValue.Name;
            var closed = State.View.MenuGroupClosed(groupValue.Name) && !active;
            <button class="kb-nav-groep" aria-expanded="@(closed ? "false" : "true")" @onclick="() => State.View.SetMenuGroup(groupValue.Name, !closed)">
                <span aria-hidden="true">@(closed ? "▸" : "▾")</span> @groupValue.Name
                @if (closed && items.Any(i => State.Pending.UnderMenu(i.Href))) { <span class="kb-nav-open" title="Hier staat nog iets open"> ●</span> }
            </button>
            @if (!closed)
            {
                @foreach (var item in items)
                {
                    @Item(item)
                }
            }
        }

        <NavLink class="kb-nav-instellingen" href="@MenuModel.SettingsHref" Match="NavLinkMatch.Prefix" @onclick:preventDefault="false">
            <span aria-hidden="true">⚙</span> <span>Instellingen</span>
            @if (MenuModel.Settings.SelectMany(g => g.Items).Any(i => State.Pending.UnderMenu(i.Href))) { <span class="kb-nav-open" title="Hier staat nog iets open"> ●</span> }
        </NavLink>

        <div class="kb-nav-voet">
            @if (State.Job is { } task && (task.Busy || task.End > DateTime.Now.AddMinutes(-10)))
            {
                <a class="kb-mini @(task.Busy ? "kb-mini-bezig" : task.WithErrors ? "kb-mini-fout" : "kb-mini-klaar")" href="verbindingen" title="Naar Verbindingen">
                    <span class="kb-mini-tekst">@(task.Busy ? "⟳ " : task.WithErrors ? "✗ " : "✓ ")@task.Summary</span>
                    @if (task.Busy)
                    {
                        <span class="kb-balk kb-balk-mini"><span class="kb-balk-vulling" style="width: @((int)(task.Progress * 100))%"></span></span>
                    }
                </a>
            }

            @if (!State.IsLive)
            {
                <a class="kb-niet-live" href="verbindingen" role="status">
                    <strong>⚠ Niet live</strong>
                    <span>Gegevens uit de inventaris@(State.InventoryDate(Moss365.Core.Inventory.InventoryLoader.AdUsers) is { } d ? $" van {d:dd/MM HH:mm}" : string.Empty). Live laden &rarr;</span>
                </a>
            }
            else
            {
                <div class="kb-live">
                    @foreach (var part in new[] { "AD", "Entra", "Rooms", "Postvakken" }.Where(x => x == "AD" ? State.HasAd : State.HasMicrosoft365))
                    {
                        <div>@part: @(State.LiveOn.TryGetValue(part, out var t) ? $"live {t:HH:mm}" : "inventaris")</div>
                    }
                </div>
            }

            @if (due > 0)
            {
                <a class="kb-nav-gepland" href="gepland">@due geplande actie(s) klaar om uit te voeren</a>
            }

            @if (State.UpdateAvailable)
            {
                <a class="kb-nav-update" href="updates">Nieuwe versie @State.Update!.NewestVersion beschikbaar</a>
            }

            @if (open.Count > 0)
            {
                var screens = open.Select(i => i.FilePath).Distinct(StringComparer.OrdinalIgnoreCase).Count();
                <details class="kb-nav-openstaand">
                    <summary>● @screens @(screens == 1 ? "scherm" : "schermen") niet bewaard of uitgevoerd</summary>
                    <ul>
                        @foreach (var i in open)
                        {
                            <li><a href="@i.FilePath">@i.Icon @(i.Screen.Length > 0 ? i.Screen : i.FilePath)</a></li>
                        }
                    </ul>
                </details>
            }

            <div class="kb-nav-profiel" title="Je profiel in Moss365">
                Profiel: @PermissionTable.Text(State.Roles, "en")
                @if (State.ProfileMessage is { } pm) { <div class="kb-zacht">@pm</div> }
            </div>

            @if (State.CountChanged > 0)
            {
                <div class="kb-nav-gewijzigd">@State.CountChanged gewijzigd, nog niet vernieuwd</div>
            }

            <div class="kb-slogan">Have you tried turning the user off and on again?</div>
        </div>
    </nav>
    <main class="kb-inhoud @(here.Count > 0 ? "kb-openstaand" : null)" style="--kb-tenant: @State.Tenant.Colour">
        <div class="kb-bovenbalk">
            <Navigation />
            <TenantBar />
        </div>
        @if (here.Count > 0)
        {
            <div class="kb-openbalk" role="status">
                @foreach (var i in here)
                {
                    <div class="kb-openbalk-item">
                        <span><span aria-hidden="true">@i.Icon</span> @i.Text</span>
                        @if (i.Saving is not null) { <button class="kb-knop kb-klein kb-primair" @onclick="i.Saving">Bewaren</button> }
                        @if (i.Anchor is not null) { <button class="kb-knop kb-klein" @onclick="() => ToPlan(i.Anchor)">Naar het plan</button> }
                        @if (i.Discard is not null) { <button class="kb-knop kb-klein" @onclick="i.Discard">Verwerpen</button> }
                    </div>
                }
            </div>
        }
        @if (State.AsOf is { } asOf)
        {
            <div class="kb-melding kb-verleden" role="status">
                Je bekijkt de stand van <strong>@asOf.Time.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</strong>: alleen lezen, plannen kunnen niet.
                <button class="kb-knop kb-klein kb-primair" @onclick="State.BackToNow">Terug naar nu</button>
            </div>
        }
        <SignInBar />
        @if (State.Error is not null)
        {
            <div class="kb-melding kb-fout">@State.Error</div>
        }
        @if (State.ConfigWarning is { } warning)
        {
            <div class="kb-melding kb-fout" role="alert">@warning <a href="organisatie">Organisatie</a></div>
        }
        @if (Access.ForPath(Nav.ToBaseRelativePath(Nav.Uri)) is { } permission && !State.Can(permission))
        {
            <section class="kb-kaart kb-geen-toegang" role="alert">
                <h1>Geen toegang</h1>
                <p>Je profiel (@PermissionTable.Text(State.Roles, "en")) laat deze pagina niet toe; ze vraagt @PermissionTable.Text(PermissionTable.RolesFor(permission)).</p>
                <p class="kb-zacht">Profielen worden toegekend via de groepen <code>GG-Moss365-...</code> in Entra. Vraag het aan wie Moss365 beheert.</p>
            </section>
        }
        else
        {
            @Body
        }
        <StatusBar />
        <QuickSearch @ref="search" />
    </main>
</div>

@code {
    private QuickSearch? search;

    private IEnumerable<MenuItem> AllItems => MenuModel.Main.SelectMany(g => g.Items);

    private bool Visible(MenuItem i) => (Access.ForPath(i.Href) is not { } r || State.Can(r)) && Access.FitsTenant(i.Href, State.HasAd, State.HasMicrosoft365);

    /// <summary>The text of an item, with what is waiting (a running script, actions that are due, follow-up tasks).</summary>
    private string Label(MenuItem i) => i.Href switch
    {
        "scripts" when State.ScriptBusy => i.Text + " (bezig)",
        "gepland" when due > 0 => $"{i.Text} ({due})",
        "opvolging" when State.CountFollowUpTasks > 0 => $"{i.Text} ({State.CountFollowUpTasks})",
        _ => i.Text,
    };

    private RenderFragment Item(MenuItem item) => __builder =>
    {
        var favourite = State.View.IsFavourite(item.Href);
        <div class="kb-nav-item">
            <NavLink href="@item.Href" Match="NavLinkMatch.Prefix">@Label(item)@if (State.Pending.UnderMenu(item.Href)) { <span class="kb-nav-open" title="Hier staat nog iets open"> ●</span> }</NavLink>
            <button class="kb-nav-ster @(favourite ? "kb-nav-ster-aan" : null)" aria-pressed="@favourite" aria-label="@($"{item.Text} {(favourite ? "uit de favorieten" : "bij de favorieten")}")"
                    title="@(favourite ? "Uit de favorieten" : "Bij de favorieten")" @onclick="() => State.View.SetFavourite(item.Href, !favourite)">★</button>
        </div>
    };

    private int due;
    private System.Threading.Timer? clock;
    private IReadOnlyList<OpenItem> open = Array.Empty<OpenItem>();
    private IReadOnlyList<OpenItem> here = Array.Empty<OpenItem>();

    // Every time the layout renders: what is open, and what is open on this screen
    protected override void OnParametersSet() => Recompute();

    private void Recompute()
    {
        open = State.Pending.Everything;
        var path = Pending.Normalise(Nav.ToBaseRelativePath(Nav.Uri));
        // Also the parts of a page (organisatie/diensten shows what is open on organisatie)
        here = open.Where(i => string.Equals(i.FilePath, path, StringComparison.OrdinalIgnoreCase)
                               || string.Equals(i.FilePath, MenuModel.Section(path), StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task ToPlan(string anchor)
    {
        try
        {
            await JS.InvokeVoidAsync("moss365.naar", anchor);
        }
        catch (Exception)
        {
            // No script (tests)
        }
    }

    protected override void OnInitialized()
    {
        State.Changed += Reload;
        State.Pending.Changed += Reload;
        due = State.CountDue;

        // Check every minute whether a scheduled action is due
        clock = new System.Threading.Timer(_ => Reload(), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    private void Reload() => InvokeAsync(() =>
    {
        due = State.CountDue;
        Recompute();
        StateHasChanged();
    });

    public void Dispose()
    {
        State.Changed -= Reload;
        State.Pending.Changed -= Reload;
        clock?.Dispose();
    }
}
