@* Een indicator. Met Kpi komen het getal, het label en de link uit dezelfde berekening als de lijst erachter.
   Een aandachtspunt boven nul krijgt de aandachtsstijl met icoon en tekst (nooit enkel kleur). *@
@inject BeheerState State

@if (LinkNaar is not null)
{
    <a class="kb-tegel @(Let ? "kb-tegel-let" : null)" href="@LinkNaar">@Inhoud</a>
}
else
{
    <div class="kb-tegel @(Let ? "kb-tegel-let" : null)">@Inhoud</div>
}

@code {
    [Parameter] public Kpi? Kpi { get; set; }
    [Parameter] public int Aantal { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Link { get; set; }
    /// <summary>Zonder Kpi: boven nul is dit een aandachtspunt (standaard ja).</summary>
    [Parameter] public bool Aandacht { get; set; } = true;

    private int Getal => Kpi is not null ? State.KpiAantal(Kpi) : Aantal;
    private string Tekst => Kpi is not null && Label.Length == 0 ? Kpi.Label : Label;
    private string? LinkNaar => Kpi?.Link ?? Link;
    private bool Let => Getal > 0 && (Kpi?.Aandacht ?? Aandacht);

    private RenderFragment Inhoud => @<text>
        <div class="kb-tegel-getal">@Getal</div>
        <div>@Tekst</div>
        @if (Let) { <div class="kb-status-let">⚠ nakijken</div> }
    </text>;
}
