@* Kenmerken van een gebruiker bewerken (0.8): de app kiest de weg (AD voor gesynchroniseerde accounts, anders Graph),
   toont het plan met nu en wordt, en zet de vorige waarden in het logboek (ongedaan te maken). *@
@inject BeheerState State

<section class="kb-kaart">
    <h2>Gegevens bewerken</h2>
    @if (!open)
    {
        <p class="kb-zacht">
            @(KenmerkPlannen.ViaAd(Persoon) ? "Dit account komt uit AD: de app wijzigt het in AD, Entra volgt na de synchronisatie." : "Cloudaccount: de app wijzigt het via Microsoft Graph.")
            UPN en e-mailadres pas je hier niet aan.
        </p>
        <button class="kb-knop" @onclick="Open">Bewerken</button>
    }
    else
    {
        <div class="kb-raster">
            <label>Weergavenaam <input class="kb-invoer" @bind="gewenst.Weergavenaam" /></label>
            <label>Voornaam <input class="kb-invoer" @bind="gewenst.Voornaam" /></label>
            <label>Achternaam <input class="kb-invoer" @bind="gewenst.Achternaam" /></label>
            <label>Functie <input class="kb-invoer" @bind="gewenst.Functie" /></label>
            <label>
                Dienst
                <select class="kb-invoer" @bind="gewenst.Dienst">
                    <option value="">(leeg)</option>
                    @foreach (var d in Keuzes(State.Config.Diensten.Select(d => d.Department), gewenst.Dienst))
                    {
                        <option value="@d">@d</option>
                    }
                </select>
                @if (State.Config.AfdelingVoor(gewenst.Dienst) is { } a) { <span class="kb-zacht">afdeling @a.Naam</span> }
            </label>
            <label>
                Kantoor
                <select class="kb-invoer" @bind="gewenst.Kantoor">
                    <option value="">(leeg)</option>
                    @foreach (var k in Keuzes(State.Config.Kantoren, gewenst.Kantoor))
                    {
                        <option value="@k">@k</option>
                    }
                </select>
            </label>
            <label>Stad <input class="kb-invoer" @bind="gewenst.Stad" /></label>
            <label>Telefoon <input class="kb-invoer" type="tel" @bind="gewenst.Telefoon" /></label>
            <label>Gsm <input class="kb-invoer" type="tel" @bind="gewenst.Gsm" /></label>
            @if (KenmerkPlannen.ViaAd(Persoon))
            {
                <label>Omschrijving <input class="kb-invoer" @bind="gewenst.Omschrijving" /></label>
                <label>
                    Logonscript
                    <select class="kb-invoer" @bind="gewenst.Logonscript">
                        <option value="">(geen)</option>
                        @foreach (var s in Keuzes(State.Config.Logonscripts, gewenst.Logonscript))
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </label>
            }
        </div>
        <PersoonKiezer Label="Manager" Gekozen="@(string.IsNullOrEmpty(gewenst.Manager) ? null : State.Data.ZoekPersoon(gewenst.Manager))" GekozenChanged="KiesManager" />
        @if (!string.IsNullOrEmpty(gewenst.Manager))
        {
            <button class="kb-knop kb-klein" @onclick="() => gewenst.Manager = string.Empty">Geen manager</button>
        }
        <div class="kb-filters">
            <button class="kb-knop kb-primair" @onclick="MaakPlan">Plan maken</button>
            <button class="kb-knop" @onclick="Leegmaken">Herstellen</button>
            <button class="kb-knop" @onclick="() => open = false">Sluiten</button>
        </div>
        @foreach (var f in fouten)
        {
            <div class="kb-melding">@f</div>
        }
    }
</section>

@if (plan is not null)
{
    <PlanWeergave Plan="plan" Context="@($"Gegevens {Persoon.Naam}")" Titel="Gegevens bewerken" Uitgevoerd="NaUitvoeren" />
}

@code {
    [Parameter, EditorRequired] public Persoon Persoon { get; set; } = default!;

    private bool open;
    private GebruikerGewenst gewenst = new();
    private IReadOnlyList<Wijziging>? plan;
    private IReadOnlyList<string> fouten = Array.Empty<string>();
    private string? geladen;

    private string Formulier => $"gebruiker/{Persoon.Sleutel}/bewerken";

    protected override void OnParametersSet()
    {
        if (geladen != Persoon.Sleutel)
        {
            geladen = Persoon.Sleutel;
            open = State.Paginastatus.Heeft(Formulier);
            gewenst = open ? Bewaard() : new();
            plan = null;
            fouten = Array.Empty<string>();
        }
    }

    // Wat je invulde, blijft bewaard tot het plan uitgevoerd is (Terug, Vooruit, menu)
    private GebruikerGewenst Bewaard() => State.Paginastatus.Formulier(Formulier, "gebruiker/" + Persoon.Sleutel, $"Gegevens {Persoon.Naam}", () => GebruikerGewenst.Van(Persoon, State.Data));

    private void KiesManager(Persoon? p) => gewenst.Manager = p?.Sleutel ?? string.Empty;

    private void Open()
    {
        gewenst = Bewaard();
        open = true;
    }

    private void Leegmaken()
    {
        State.Paginastatus.Vergeet(Formulier);
        gewenst = Bewaard();
        plan = null;
        fouten = Array.Empty<string>();
    }

    /// <summary>De keuzelijst, en de huidige waarde erbij als die er (nog) niet in staat.</summary>
    private static IEnumerable<string> Keuzes(IEnumerable<string> lijst, string? huidig)
    {
        var l = lijst.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
        if (!string.IsNullOrWhiteSpace(huidig) && !l.Contains(huidig, StringComparer.OrdinalIgnoreCase))
        {
            l.Insert(0, huidig);
        }

        return l;
    }

    private void MaakPlan()
    {
        var u = KenmerkPlannen.Gebruiker(State.Data, State.Config, Persoon, gewenst);
        fouten = u.Fouten;
        plan = u.Plan.Count > 0 ? u.Plan : null;
    }

    private void NaUitvoeren(IReadOnlyList<WijzigingResultaat> resultaten)
    {
        if (resultaten.Any(r => r.Status == ResultaatStatus.Gelukt))
        {
            State.Paginastatus.Vergeet(Formulier);
            open = false;
        }
    }
}
