@* Hoe actueel een object is, met een knop om enkel dit object opnieuw te lezen *@
@implements IDisposable
@inject BeheerState State
@inject IJSRuntime JS

<div class="kb-objectstatus @(State.IsGewijzigd(Object) ? "kb-objectstatus-gewijzigd" : null)">
    <span>Gegevens: @State.HerkomstVan(Object)</span>
    @if (State.IsGewijzigd(Object))
    {
        <span class="kb-label kb-label-let">gewijzigd, nog niet vernieuwd</span>
    }
    @if (State.TaakBezig && State.Taak!.Naam.StartsWith("Vernieuwen", StringComparison.Ordinal))
    {
        <span class="kb-zacht">@State.Taak.Samenvatting</span>
    }
    <button class="kb-knop kb-klein" disabled="@(!State.KanVerbinden || State.TaakBezig)" @onclick="Vernieuw"
            title="@(State.KanVerbinden ? "Enkel dit object opnieuw lezen uit AD, Entra en/of Exchange" : "Enkel in de Windows-app met verbindingen")">&#x21bb; Vernieuwen</button>
    @if (melding is not null) { <span class="kb-zacht">@melding</span> }
    @if (State.Data.Index.EntraIdVan(Object) is { } id)
    {
        <span class="kb-entra-id" title="Object-ID in Entra (Azure)">Entra-ID <code>@id</code>
            <button class="kb-knop kb-klein" @onclick="() => Kopieer(id)" aria-label="Entra-ID kopiëren">@(gekopieerd ? "Gekopieerd" : "Kopiëren")</button>
        </span>
    }
</div>

@code {
    [Parameter, EditorRequired] public ObjectRef Object { get; set; } = default!;

    private string? melding;
    private bool gekopieerd;

    private async Task Kopieer(string id)
    {
        try
        {
            await JS.InvokeVoidAsync("moss365.kopieer", id);
            gekopieerd = true;
        }
        catch (Exception)
        {
            // Klembord niet beschikbaar: de ID staat er om te selecteren
        }
    }

    protected override void OnInitialized() => State.Gewijzigd += Ververs;

    private void Ververs() => _ = InvokeAsync(StateHasChanged);

    private void Vernieuw() => melding = State.StartVernieuwen(new[] { Object }) ? null : "Kon niet starten (verbinding ingesteld?).";

    public void Dispose() => State.Gewijzigd -= Ververs;
}
