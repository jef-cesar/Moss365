@* Tabel met aanmeldingen uit Entra, nieuwste eerst *@

@if (Aanmeldingen.Count == 0)
{
    <p class="kb-zacht">Geen aanmeldingen in deze periode.</p>
}
else
{
    <table class="kb-tabel">
        <thead>
            <tr>
                <th>Tijd</th>
                @if (MetGebruiker) { <th>Gebruiker</th> }
                <th>App</th><th>Plaats</th><th>IP</th><th>Resultaat</th>
                @if (MetCa) { <th>Conditional Access</th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Aanmeldingen)
            {
                <tr class="@(a.Gelukt ? null : "kb-ontbreekt")">
                    <td>@a.Tijd.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    @if (MetGebruiker) { <td><ObjectLink Id="@a.GebruikerId" Tekst="@(a.Naam.Length > 0 ? a.Naam : a.Upn)" /></td> }
                    <td>@a.App <span class="kb-zacht">@a.Client</span></td>
                    <td>@a.Locatie</td>
                    <td><code>@a.Ip</code></td>
                    <td>@(a.Gelukt ? "gelukt" : $"mislukt ({a.Foutcode})") <span class="kb-zacht">@a.Reden</span></td>
                    @if (MetCa)
                    {
                        <td>
                            @foreach (var c in (a.Ca ?? Array.Empty<CaToepassing>()).Where(c => c.Resultaat is "success" or "failure" or "reportOnlyFailure" or "reportOnlyInterrupted"))
                            {
                                <span class="kb-tag @(c.Resultaat == "failure" ? "kb-rood" : null)" title="@CaResultaat(c.Resultaat)">@c.Naam <span class="kb-zacht">(@CaResultaat(c.Resultaat))</span></span>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Aanmelding> Aanmeldingen { get; set; } = Array.Empty<Aanmelding>();
    [Parameter] public bool MetGebruiker { get; set; } = true;

    private bool MetCa => Aanmeldingen.Any(a => a.Ca is { Count: > 0 });

    private static string CaResultaat(string r) => r switch
    {
        "success" => "voldaan",
        "failure" => "tegengehouden",
        "reportOnlyFailure" => "rapport: zou tegenhouden",
        "reportOnlyInterrupted" => "rapport: zou extra stap vragen",
        _ => r,
    };
}
