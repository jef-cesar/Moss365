@* Conditional Access beheren (0.9), enkel voor het profiel Beheerder. Elke wijziging is een plan met voorbeeld en
   bevestiging; een nieuw beleid komt altijd in alleen rapport; aanzetten vraagt een extra bevestiging. De motor weigert elk
   beleid dat aan staat en de noodaccounts niet uitsluit of jezelf buitensluit (CaVeiligheid), ook bij ongedaan maken. *@
@inject BeheerState State

<section class="kb-kaart">
    <h2>Beheren</h2>
    <p class="kb-zacht">
        Elke wijziging toont eerst een voorbeeld; pas na je bevestiging gaat ze naar Entra, en ze komt in het logboek (ongedaan te
        maken). Je eigen account heeft de rol Conditional Access Administrator (of Security Administrator) nodig.
        Wat je vooraf regelt: <code>docs/voorbereiding-0.9.md</code>.
    </p>
    @if (NoodFout is { } noodFout)
    {
        <div class="kb-melding kb-fout">@noodFout Een nieuw beleid maken en een beleid aanzetten kan pas als dat in orde is.</div>
    }
    else
    {
        <p>Noodaccounts: @string.Join(", ", Nood.Select(p => p.Naam)). Elk nieuw beleid sluit ze uit; een beleid aanzetten dat ze niet uitsluit, weigert de app.</p>
    }

    <div class="kb-filters">
        <span class="kb-segment" role="group" aria-label="Beheren">
            @foreach (var (o, tekst) in new[] { (Onderdeel.Status, "Aan en uit"), (Onderdeel.Uitzonderingen, "Uitzonderingen"), (Onderdeel.Nieuw, "Nieuw beleid"),
                                                 (Onderdeel.Locaties, "Benoemde locaties"), (Onderdeel.Backups, "Back-ups"), (Onderdeel.Audit, "Wie wijzigde wat") })
            {
                <button class="kb-knop @(onderdeel == o ? "kb-primair" : null)" @onclick="() => Kies(o)">@tekst</button>
            }
        </span>
    </div>

    @switch (onderdeel)
    {
        case Onderdeel.Status:
            <p class="kb-zacht">
                Een nieuw beleid laat je eerst in <strong>alleen rapport</strong> lopen (voorstel: 14 dagen) en je bekijkt het effect
                (Beleiden > Effect laden). Pas dan zet je het aan.
            </p>
            <label class="kb-groot-plan"><input type="checkbox" @bind="effectBekeken" /> Ik heb het effect in alleen rapport bekeken en wil een beleid <strong>aanzetten</strong></label>
            <table class="kb-tabel">
                <thead><tr><th>Beleid</th><th>Status</th><th>Vereist</th><th></th></tr></thead>
                <tbody>
                    @foreach (var b in Ca.Beleiden)
                    {
                        <tr>
                            <td><a href="@($"conditional-access/{Uri.EscapeDataString(b.Id)}")">@b.Naam</a></td>
                            <td><CaLabel Status="b.Status" /></td>
                            <td class="kb-zacht">@(b.Blokkeert ? "blokkeert" : string.Join(", ", b.Controles.Select(CaLezer.ControleNaam)))</td>
                            <td>
                                <span class="kb-filters">
                                    @foreach (var s in new[] { CaStatus.Rapport, CaStatus.Aan, CaStatus.Uit }.Where(s => s != b.Status))
                                    {
                                        <button class="kb-knop kb-klein @(s == CaStatus.Aan ? "kb-gevaar" : null)" disabled="@(s == CaStatus.Aan && !effectBekeken)"
                                                title="@(s == CaStatus.Aan && !effectBekeken ? "Vink eerst aan dat je het effect bekeken hebt" : null)"
                                                @onclick="() => Status(b, s)">@KnopTekst(s)</button>
                                    }
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            break;

        case Onderdeel.Uitzonderingen:
            <p class="kb-zacht">
                Iemand tijdelijk uitsluiten van een beleid (bv. op reis buiten de toegelaten landen), met een einddatum. Op die datum
                staat het terugzetten klaar bij <a href="gepland">Gepland</a>; de app voert het niet vanzelf uit.
            </p>
            <div class="kb-formulier">
                <label>Beleid
                    <select class="kb-invoer" @bind="uitBeleidId">
                        <option value="">(kies een beleid)</option>
                        @foreach (var b in Ca.Beleiden) { <option value="@b.Id">@b.Naam</option> }
                    </select>
                </label>
                <PersoonKiezer Label="Wie" @bind-Gekozen="uitPersoon" />
                <label>Tot en met <input type="date" class="kb-invoer" @bind="uitTot" /></label>
                <div class="kb-filters">
                    <button class="kb-knop kb-primair" disabled="@(UitBeleid is null || uitPersoon is null)" @onclick="Uitzonderen">Plan maken</button>
                </div>
            </div>
            @if (UitBeleid is { } gekozen)
            {
                <h3>Rechtstreeks uitgezonderd van "@gekozen.Naam" (@gekozen.GebruikersUit.Count)</h3>
                <ul class="kb-lijst-plat">
                    @foreach (var id in gekozen.GebruikersUit)
                    {
                        var p = State.Data.Personen.FirstOrDefault(x => string.Equals(x.Entra?.Id, id, StringComparison.OrdinalIgnoreCase));
                        <li>
                            @if (p is not null) { <ObjectLink Object="State.Data.Index.Ref(p)" /> } else { <code>@id</code> }
                            @if (p is not null && Nood.Contains(p)) { <span class="kb-label">noodaccount</span> }
                            else if (p is not null) { <button class="kb-knop kb-klein" @onclick="() => UitzonderingWeg(gekozen, p)">Weghalen</button> }
                        </li>
                    }
                </ul>
            }
            break;

        case Onderdeel.Nieuw:
            <p class="kb-zacht">
                Een nieuw beleid uit de aanbevelingen van Microsoft. Het komt altijd in <strong>alleen rapport</strong>, met de noodaccounts
                uitgesloten. Met een pilotgroep geldt het eerst enkel voor die groep.
            </p>
            <div class="kb-formulier">
                <label>Sjabloon
                    <select class="kb-invoer" @bind="sjabloon">
                        <option value="">(kies een sjabloon)</option>
                        @foreach (var s in CaSjablonen.Alle)
                        {
                            <option value="@s.Sleutel" disabled="@Ca.Beleiden.Any(b => b.Naam == s.Naam)">@s.Naam@(Ca.Beleiden.Any(b => b.Naam == s.Naam) ? " (bestaat al)" : "")</option>
                        }
                    </select>
                </label>
                @if (Sjabloon is { } sj)
                {
                    <p>@sj.Uitleg</p>
                    @if (sj.KanPilot)
                    {
                        <label>Pilotgroep (leeg = iedereen)
                            <select class="kb-invoer" @bind="pilotGroep">
                                <option value="">Iedereen</option>
                                @foreach (var g in CloudGroepen) { <option value="@g.Cloud!.Id">@g.Naam</option> }
                            </select>
                        </label>
                    }
                    @if (sj.VraagtLandenLocatie)
                    {
                        <label>Toegelaten landen
                            <select class="kb-invoer" @bind="landen">
                                <option value="">(kies een locatie met landen)</option>
                                @foreach (var l in Ca.Locaties.Where(l => !l.IsIp)) { <option value="@l.Id">@l.Naam (@string.Join(", ", l.Waarden))</option> }
                            </select>
                        </label>
                    }
                    <div class="kb-filters">
                        <button class="kb-knop kb-primair" disabled="@(NoodFout is not null)" @onclick="Nieuw">Plan maken</button>
                    </div>
                }
            </div>
            break;

        case Onderdeel.Locaties:
            <p class="kb-zacht">
                IP-adressen van de gebouwen (CIDR, bv. <code>203.0.113.10/32</code>) of landen (code van twee letters, bv. <code>BE</code>), één per regel.
                Een vertrouwde locatie met IP-adressen gebruik je voor "registreren enkel vanop kantoor".
            </p>
            <table class="kb-tabel">
                <thead><tr><th>Locatie</th><th>Soort</th><th>Waarden</th><th></th></tr></thead>
                <tbody>
                    @foreach (var l in Ca.Locaties)
                    {
                        <tr>
                            <td>@l.Naam</td>
                            <td>@(l.IsIp ? (l.Vertrouwd ? "IP-adressen, vertrouwd" : "IP-adressen") : "landen")</td>
                            <td class="kb-zacht">@string.Join(", ", l.Waarden)</td>
                            <td><button class="kb-knop kb-klein" @onclick="() => Bewerk(l)">Wijzigen</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <h3>@(locatie is null ? "Nieuwe locatie" : $"\"{locatie.Naam}\" wijzigen")</h3>
            <div class="kb-formulier">
                <label>Naam <input class="kb-invoer" @bind="locNaam" /></label>
                @if (locatie is null)
                {
                    <label><input type="radio" name="locsoort" checked="@locIp" @onchange="() => locIp = true" /> IP-adressen</label>
                    <label><input type="radio" name="locsoort" checked="@(!locIp)" @onchange="() => locIp = false" /> Landen</label>
                }
                @if (locIp) { <label><input type="checkbox" @bind="locVertrouwd" /> Vertrouwde locatie (kantoor)</label> }
                <label>@(locIp ? "IP-bereiken" : "Landen"), één per regel <textarea class="kb-invoer" rows="5" @bind="locWaarden"></textarea></label>
                <div class="kb-filters">
                    <button class="kb-knop kb-primair" @onclick="LocatiePlan">Plan maken</button>
                    @if (locatie is not null) { <button class="kb-knop" @onclick="() => Bewerk(null)">Nieuwe locatie</button> }
                </div>
            </div>
            break;

        case Onderdeel.Backups:
            <p class="kb-zacht">
                Na elk live laden bewaart de app een kopie van alle beleiden en locaties, als er iets veranderde. De bestanden staan in
                <code>@State.CaBackupMap</code>; ze bevatten id's van personen en groepen: hou ze lokaal en zet een kopie op een plek
                met beperkte toegang.
            </p>
            <div class="kb-filters">
                <button class="kb-knop" @onclick="BackupNu">Nu een back-up maken</button>
                @if (backupMelding is not null) { <span class="kb-zacht">@backupMelding</span> }
            </div>
            @if (backups.Count == 0)
            {
                <p class="kb-zacht">Nog geen back-ups. Laad live (Verbindingen) of kies "Nu een back-up maken".</p>
            }
            else
            {
                <label>Back-up
                    <select class="kb-invoer" value="@backupPad" @onchange="KiesBackup">
                        <option value="">(kies een back-up)</option>
                        @foreach (var b in backups) { <option value="@b.Pad">@b.Tijd.ToString("dd/MM/yyyy HH:mm") (@b.Beleiden beleiden)</option> }
                    </select>
                </label>
            }
            @if (backup is not null)
            {
                <h3>Verschillen met nu</h3>
                @if (verschillen.Count == 0)
                {
                    <p>Geen verschillen: de beleiden zijn nu zoals in deze back-up.</p>
                }
                <table class="kb-tabel">
                    <tbody>
                        @foreach (var v in verschillen)
                        {
                            <tr>
                                <td>@v.Naam <span class="kb-label">@VerschilTekst(v.Soort)</span></td>
                                <td><ul class="kb-lijst-plat">@foreach (var d in v.Details) { <li>@d</li> }</ul></td>
                                <td>
                                    @if (v.Soort != "nieuw" && backup.Beleiden.FirstOrDefault(b => b.Id == v.BeleidId) is { } oud)
                                    {
                                        <button class="kb-knop kb-klein" @onclick="() => Terugzetten(oud)">Terugzetten</button>
                                    }
                                    else
                                    {
                                        <span class="kb-zacht">nieuw sinds de back-up; uitzetten bij Aan en uit</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            break;

        default:
            <p class="kb-zacht">Uit het auditlogboek van Entra: wie welk beleid of welke locatie maakte, wijzigde of verwijderde (de laatste 30 dagen).</p>
            <div class="kb-filters">
                <button class="kb-knop" disabled="@auditBezig" @onclick="LaadAudit">Auditlogboek laden</button>
                @if (auditBezig) { <span class="kb-zacht">bezig...</span> }
            </div>
            @if (auditFout is not null) { <div class="kb-melding kb-fout">@auditFout</div> }
            @if (audit is not null)
            {
                <KbTabel Id="ca-audit" ExportNaam="Conditional-Access-audit" Items="audit" Kolommen="auditKolommen" StandaardSortering="tijd" />
            }
            break;
    }

    @foreach (var f in fouten)
    {
        <div class="kb-melding kb-fout">@f</div>
    }
</section>

@if (plan is not null)
{
    <PlanWeergave Plan="plan" Context="@planContext" Titel="Wijziging aan Conditional Access" Uitgevoerd="NaUitvoeren" />
}

@code {
    private enum Onderdeel { Status, Uitzonderingen, Nieuw, Locaties, Backups, Audit }

    [Parameter, EditorRequired] public CaGegevens Ca { get; set; } = default!;

    private Onderdeel onderdeel = Onderdeel.Status;
    private IReadOnlyList<Wijziging>? plan;
    private string planContext = string.Empty;
    private IReadOnlyList<string> fouten = Array.Empty<string>();
    private bool effectBekeken;

    // Uitzondering
    private string uitBeleidId = string.Empty;
    private Persoon? uitPersoon;
    private DateOnly uitTot = DateOnly.FromDateTime(DateTime.Today.AddDays(14));
    private (string BeleidId, Persoon Persoon, DateOnly Tot)? inTePlannen;

    // Nieuw beleid
    private string sjabloon = string.Empty;
    private string pilotGroep = string.Empty;
    private string landen = string.Empty;

    // Locaties
    private BenoemdeLocatie? locatie;
    private string locNaam = string.Empty;
    private bool locIp = true;
    private bool locVertrouwd = true;
    private string locWaarden = string.Empty;

    // Back-ups
    private IReadOnlyList<Moss365.Core.Opslag.CaBackupBestand> backups = Array.Empty<Moss365.Core.Opslag.CaBackupBestand>();
    private string backupPad = string.Empty;
    private Moss365.Core.Opslag.CaBackupInhoud? backup;
    private IReadOnlyList<CaVerschil> verschillen = Array.Empty<CaVerschil>();
    private string? backupMelding;

    // Audit
    private IReadOnlyList<CaAuditRegel>? audit;
    private bool auditBezig;
    private string? auditFout;

    private static readonly IReadOnlyList<Kolom<CaAuditRegel>> auditKolommen = new List<Kolom<CaAuditRegel>>
    {
        new() { Sleutel = "tijd", Titel = "Tijd", Cel = a => b => b.AddContent(0, a.Tijd.LocalDateTime.ToString("dd/MM/yyyy HH:mm")), SorteerOp = a => -a.Tijd.UtcTicks, Tekst = a => a.Tijd.LocalDateTime.ToString("yyyy-MM-dd HH:mm") },
        new() { Sleutel = "wie", Titel = "Wie", Cel = a => b => b.AddContent(0, a.Wie), SorteerOp = a => a.Wie },
        new() { Sleutel = "wat", Titel = "Wat", Cel = a => b => b.AddContent(0, a.Activiteit), SorteerOp = a => a.Activiteit },
        new() { Sleutel = "doel", Titel = "Beleid of locatie", Cel = a => b => b.AddContent(0, a.DoelNaam), SorteerOp = a => a.DoelNaam },
        new() { Sleutel = "resultaat", Titel = "Resultaat", Cel = a => b => b.AddContent(0, a.Resultaat), SorteerOp = a => a.Resultaat },
    };

    private (IReadOnlyList<Persoon> Accounts, string? Fout) NoodInfo => CaVeiligheid.Noodaccounts(State.Data, State.Config);
    private IReadOnlyList<Persoon> Nood => NoodInfo.Accounts;
    private string? NoodFout => NoodInfo.Fout;

    private CaBeleid? UitBeleid => Ca.Beleiden.FirstOrDefault(b => b.Id == uitBeleidId);
    private CaSjabloon? Sjabloon => CaSjablonen.Alle.FirstOrDefault(s => s.Sleutel == sjabloon);
    private IEnumerable<Groep> CloudGroepen => State.Data.Index.Groepen.Where(g => g.Cloud is not null && !g.Dynamisch).OrderBy(g => g.Naam, StringComparer.CurrentCultureIgnoreCase);

    private static string KnopTekst(CaStatus s) => s switch { CaStatus.Aan => "Aanzetten", CaStatus.Rapport => "Alleen rapport", _ => "Uitzetten" };

    private static string VerschilTekst(string soort) => soort switch { "nieuw" => "nieuw sinds de back-up", "verdwenen" => "bestaat niet meer", _ => "gewijzigd" };

    private void Kies(Onderdeel o)
    {
        onderdeel = o;
        plan = null;
        fouten = Array.Empty<string>();
        if (o == Onderdeel.Backups)
        {
            backups = State.CaBackups();
        }
    }

    private void Toon(PlanUitkomst u, string context)
    {
        fouten = u.Fouten;
        plan = u.Plan.Count > 0 ? u.Plan : null;
        planContext = context;
        inTePlannen = null;
    }

    private void Status(CaBeleid b, CaStatus s)
        => Toon(CaPlannen.Status(b, s, State.Data, State.Config, State.EigenUpn), $"Conditional Access: {b.Naam} {KnopTekst(s).ToLowerInvariant()}");

    private void Uitzonderen()
    {
        if (UitBeleid is not { } b || uitPersoon is not { } p)
        {
            return;
        }

        if (uitTot.ToDateTime(new TimeOnly(23, 59)) <= DateTime.Now)
        {
            fouten = new[] { "Kies een einddatum in de toekomst." };
            plan = null;
            return;
        }

        Toon(CaPlannen.Uitzondering(b, p, toevoegen: true, State.Data, State.Config, State.EigenUpn), $"Conditional Access: uitzondering tot {uitTot:dd/MM/yyyy}");
        if (plan is not null)
        {
            inTePlannen = (b.Id, p, uitTot);
        }
    }

    private void UitzonderingWeg(CaBeleid b, Persoon p)
        => Toon(CaPlannen.Uitzondering(b, p, toevoegen: false, State.Data, State.Config, State.EigenUpn), "Conditional Access: uitzondering weghalen");

    private void Nieuw()
        => Toon(CaSjablonen.Plan(sjabloon, new CaSjabloonOpties(pilotGroep.Length == 0 ? null : pilotGroep, landen.Length == 0 ? null : landen),
            State.Data, State.Config, State.EigenUpn), "Conditional Access: nieuw beleid uit een sjabloon");

    private void Bewerk(BenoemdeLocatie? l)
    {
        locatie = l;
        locNaam = l?.Naam ?? string.Empty;
        locIp = l?.IsIp ?? true;
        locVertrouwd = l?.Vertrouwd ?? true;
        locWaarden = l is null ? string.Empty : string.Join(Environment.NewLine, l.Waarden);
        plan = null;
        fouten = Array.Empty<string>();
    }

    private void LocatiePlan()
        => Toon(CaPlannen.Locatie(locatie, locNaam, locIp, locWaarden.Split('\n', ',', ';'), locVertrouwd, State.Data), "Conditional Access: benoemde locatie");

    private void BackupNu()
    {
        try
        {
            var pad = Moss365.Core.Opslag.CaBackup.Bewaar(Ca, State.CaBackupMap, DateTime.Now);
            backupMelding = pad is null
                ? (Ca.Beleiden.Any(b => b.Json.Length == 0) ? "Geen back-up: de beleiden komen niet rechtstreeks uit Entra. Laad eerst live." : "Geen nieuwe back-up nodig: er veranderde niets sinds de vorige.")
                : $"Bewaard: {Path.GetFileName(pad)}";
        }
        catch (IOException ex)
        {
            backupMelding = "Mislukt: " + ex.Message;
        }

        backups = State.CaBackups();
    }

    private void KiesBackup(ChangeEventArgs e)
    {
        backupPad = e.Value?.ToString() ?? string.Empty;
        backup = backupPad.Length == 0 ? null : Moss365.Core.Opslag.CaBackup.Lees(backupPad);
        verschillen = backup is null ? Array.Empty<CaVerschil>() : CaVergelijking.Vergelijk(backup.Beleiden, Ca.Beleiden, CaLezer.Namen(State.Data), Ca);
        plan = null;
        fouten = Array.Empty<string>();
    }

    private void Terugzetten(CaBeleid oud)
        => Toon(CaPlannen.Terugzetten(oud, Ca.Beleiden.FirstOrDefault(b => b.Id == oud.Id), State.Data, State.Config, State.EigenUpn),
            $"Conditional Access: terugzetten uit de back-up van {backup?.Tijd:dd/MM/yyyy HH:mm}");

    private async Task LaadAudit()
    {
        auditBezig = true;
        auditFout = null;
        try
        {
            audit = await State.LeesCaAuditAsync(30);
            if (audit is null)
            {
                auditFout = "Graph is niet ingesteld (Verbindingen).";
            }
        }
        catch (GeenRechtFout ex)
        {
            auditFout = "Je account mag het auditlogboek niet lezen (rol Reports Reader, Security Reader of Global Reader nodig). " + ex.Message;
        }
        catch (Exception ex)
        {
            auditFout = "Auditlogboek lezen mislukt: " + ex.Message;
        }
        finally
        {
            auditBezig = false;
        }
    }

    private void NaUitvoeren(IReadOnlyList<WijzigingResultaat> resultaten)
    {
        // Een gelukte uitzondering met een einddatum: het terugzetten klaarzetten bij Gepland (nooit vanzelf uitvoeren)
        if (inTePlannen is { } x && resultaten.Any(r => r.Status == ResultaatStatus.Gelukt)
            && Ca.Beleiden.FirstOrDefault(b => b.Id == x.BeleidId) is { } beleid)
        {
            var moment = x.Tot.ToDateTime(new TimeOnly(23, 59));
            State.Inplannen(GeplandPlannen.CaUitzonderingEinde(beleid, x.Persoon,
                new DateTimeOffset(moment, TimeZoneInfo.Local.GetUtcOffset(moment)), State.Gebruiker));
            inTePlannen = null;
        }

        effectBekeken = false;
    }
}
