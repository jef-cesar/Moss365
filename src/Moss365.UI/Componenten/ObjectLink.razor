@* Een gebruiker, groep, postvak of room als link naar zijn pagina. Geef Object, of Id (naam, adres, DN of id) om op te zoeken. *@
@inject BeheerState State

@if (Doel is { } r)
{
    @if (r.Route is { } route)
    {
        <a class="kb-obj kb-obj-@r.Soort.ToString().ToLowerInvariant()" href="@route" title="@Titel(r)">@(Tekst ?? r.Naam)</a>
    }
    else
    {
        <span class="kb-obj-los" title="@Titel(r)">@(Tekst ?? r.Naam)</span>
    }

    @if (ToonSoort)
    {
        <span class="kb-soort">@r.SoortTekst</span>
    }
}

@code {
    [Parameter] public ObjectRef? Object { get; set; }
    [Parameter] public string? Id { get; set; }

    /// <summary>Andere tekst dan de naam van het object.</summary>
    [Parameter] public string? Tekst { get; set; }

    [Parameter] public bool ToonSoort { get; set; }

    private ObjectRef? Doel => Object ?? (string.IsNullOrWhiteSpace(Id) ? null : State.Data.Index.Ref(Id));

    private static string Titel(ObjectRef r) => string.IsNullOrEmpty(r.Detail) ? r.SoortTekst : $"{r.SoortTekst}: {r.Detail}";
}
