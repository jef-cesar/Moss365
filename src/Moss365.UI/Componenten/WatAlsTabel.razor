@* De beleiden van een "wat als", met of ze gelden en waarom *@

<table class="kb-tabel">
    <thead><tr><th>Beleid</th><th>Geldt</th><th>Waarom</th><th>Gevolg</th></tr></thead>
    <tbody>
        @foreach (var r in Regels.OrderBy(r => r.Antwoord.Geldt).ThenBy(r => r.Beleid.Naam))
        {
            <tr class="@(r.Antwoord.Geldt == CaGeldt.Nee ? "kb-zacht" : null)">
                <td><a href="@($"conditional-access/{Uri.EscapeDataString(r.Beleid.Id)}")">@r.Beleid.Naam</a></td>
                <td><CaLabel Geldt="r.Antwoord.Geldt" /></td>
                <td>@r.Antwoord.Reden</td>
                <td>@r.Gevolg</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CaWatAlsRegel> Regels { get; set; } = Array.Empty<CaWatAlsRegel>();
}
