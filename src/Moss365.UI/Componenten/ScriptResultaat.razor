@* Het resultaat van een run: uitvoer, tabellen, bestanden en details *@
@inject BeheerState State

<div class="kb-filters">
    <span class="kb-segment" role="group" aria-label="Resultaat">
        <button class="kb-knop @(deel == 0 ? "kb-primair" : null)" @onclick="() => deel = 0">Uitvoer</button>
        <button class="kb-knop @(deel == 1 ? "kb-primair" : null)" @onclick="() => deel = 1">Tabellen (@tabellen.Count)</button>
        <button class="kb-knop @(deel == 2 ? "kb-primair" : null)" @onclick="() => deel = 2">Bestanden (@bestanden.Count)</button>
        <button class="kb-knop @(deel == 3 ? "kb-primair" : null)" @onclick="() => deel = 3">Details</button>
    </span>
</div>

@switch (deel)
{
    case 0:
        <ScriptUitvoerLijst Gebeurtenissen="Gebeurtenissen" LeegTekst="Het script gaf geen tekst." />
        break;
    case 1:
        @if (tabellen.Count == 0)
        {
            <p class="kb-zacht">Het script gaf geen objecten terug en maakte geen CSV-bestand.</p>
        }
        else
        {
            @if (tabellen.Count > 1)
            {
                <div class="kb-filters">
                    <select class="kb-invoer" @bind="tabelIndex" aria-label="Tabel">
                        @for (var i = 0; i < tabellen.Count; i++)
                        {
                            <option value="@i">@tabellen[i].Naam (@tabellen[i].Rijen.Count)</option>
                        }
                    </select>
                </div>
            }
            var t = tabellen[Math.Min(tabelIndex, tabellen.Count - 1)];
            <KbTabel @key="t" Id="@($"script-{Run.Sleutel}-{t.Naam}")" ExportNaam="@($"{Run.Sleutel}-{t.Naam}")" Items="t.Rijen" Kolommen="KolommenVan(t)" StandaardSortering="@t.Kolommen.FirstOrDefault()" />
        }
        break;
    case 2:
        @if (bestanden.Count == 0)
        {
            <p class="kb-zacht">Het script zette geen bestanden in zijn uitvoermap.</p>
        }
        else
        {
            <table class="kb-tabel">
                <thead><tr><th>Bestand</th><th class="kb-getal">Grootte</th><th></th></tr></thead>
                <tbody>
                    @foreach (var b in bestanden)
                    {
                        <tr>
                            <td>@Path.GetRelativePath(BestandenMap, b.FullName)</td>
                            <td class="kb-getal">@Grootte(b.Length)</td>
                            <td><button class="kb-knop kb-klein" @onclick="() => State.Omgeving.ToonBestand(b.FullName)">Tonen in Verkenner</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <p class="kb-zacht">Map van deze run: <code>@Run.Map</code></p>
        break;
    default:
        <table class="kb-tabel kb-naast">
            <tbody>
                <tr><th>Script</th><td>@Run.Naam @if (Run.Eenmalig) { <span class="kb-label">eenmalig</span> }</td></tr>
                <tr><th>Resultaat</th><td>@Run.ResultaatTekst <span class="kb-zacht">@Run.Melding</span></td></tr>
                <tr><th>Wie</th><td>@Run.Wie</td></tr>
                <tr><th>Start</th><td>@Run.Start.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss")</td></tr>
                <tr><th>Duur</th><td>@(Run.Duur is { } d ? $"{(int)d.TotalMinutes}:{d.Seconds:00}" : "bezig")</td></tr>
                <tr><th>Waarden</th><td>@foreach (var (k, v) in Run.Waarden) { <div><strong>@k</strong>: @v.Replace("\n", ", ")</div> }</td></tr>
                <tr><th>Vingerafdruk</th><td><code>@Run.Vingerafdruk</code></td></tr>
            </tbody>
        </table>
        break;
}

@code {
    [Parameter, EditorRequired] public ScriptRun Run { get; set; } = new();
    [Parameter, EditorRequired] public IReadOnlyList<ScriptGebeurtenis> Gebeurtenissen { get; set; } = Array.Empty<ScriptGebeurtenis>();

    private int deel;
    private int tabelIndex;
    private IReadOnlyList<ScriptTabel> tabellen = Array.Empty<ScriptTabel>();
    private List<FileInfo> bestanden = new();
    private readonly Dictionary<ScriptTabel, IReadOnlyList<Kolom<IReadOnlyDictionary<string, string>>>> kolommen = new();

    private string BestandenMap => Path.Combine(Run.Map, "bestanden");

    protected override void OnParametersSet()
    {
        tabellen = ScriptUitvoer.Tabellen(Gebeurtenissen, BestandenMap);
        bestanden = Directory.Exists(BestandenMap)
            ? new DirectoryInfo(BestandenMap).EnumerateFiles("*", SearchOption.AllDirectories).OrderBy(f => f.FullName).ToList()
            : new List<FileInfo>();
        if (deel == 0 && tabellen.Count > 0 && Gebeurtenissen.All(g => g.Soort is GebeurtenisSoort.Rij or GebeurtenisSoort.Info or GebeurtenisSoort.Voortgang))
        {
            deel = 1;
        }
    }

    private IReadOnlyList<Kolom<IReadOnlyDictionary<string, string>>> KolommenVan(ScriptTabel t)
    {
        if (!kolommen.TryGetValue(t, out var k))
        {
            k = t.Kolommen.Select(naam => new Kolom<IReadOnlyDictionary<string, string>>
            {
                Sleutel = naam,
                Titel = naam,
                Cel = r => @<text>@(r.TryGetValue(naam, out var w) ? w : string.Empty)</text>,
                SorteerOp = r => r.TryGetValue(naam, out var w) ? w : string.Empty,
            }).ToList();
            kolommen[t] = k;
        }

        return k;
    }

    private static string Grootte(long b) => b < 1024 ? $"{b} B" : b < 1024 * 1024 ? $"{b / 1024.0:0.#} kB" : $"{b / 1024.0 / 1024.0:0.#} MB";
}
