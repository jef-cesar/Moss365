@* Datum en uur kiezen om een actie later uit te voeren (na jouw bevestiging op dat moment). *@

<div class="kb-inplannen">
    <label>Datum <input class="kb-invoer" type="date" @bind="datum" /></label>
    <label>Uur <input class="kb-invoer" type="time" @bind="uur" /></label>
    <button class="kb-knop" @onclick="Bevestig">Inplannen</button>
    @if (fout is not null) { <span class="kb-fout-tekst">@fout</span> }
</div>

@code {
    [Parameter] public DateOnly? Standaard { get; set; }
    [Parameter] public EventCallback<DateTimeOffset> Gekozen { get; set; }

    private DateOnly datum = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private TimeOnly uur = new(17, 0);
    private DateOnly? vorigeStandaard;
    private string? fout;

    protected override void OnParametersSet()
    {
        if (Standaard is { } s && s != vorigeStandaard)
        {
            vorigeStandaard = s;
            datum = s;

            // Is het voorgestelde uur vandaag al voorbij, dan morgen (anders weigert Inplannen meteen)
            if (datum.ToDateTime(uur) <= DateTime.Now)
            {
                datum = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
            }
        }
    }

    private async Task Bevestig()
    {
        var moment = new DateTimeOffset(datum.ToDateTime(uur), TimeZoneInfo.Local.GetUtcOffset(datum.ToDateTime(uur)));
        if (moment <= DateTimeOffset.Now)
        {
            fout = "Kies een moment in de toekomst (of voer het plan nu uit).";
            return;
        }

        fout = null;
        await Gekozen.InvokeAsync(moment);
    }
}
