@* Het formulier met de variabelen van een script; de waarden staan in een woordenboek (naam naar tekst) *@
@inject BeheerState State

@if (Kop.Variabelen.Count == 0)
{
    <p class="kb-zacht">Dit script heeft geen variabelen.</p>
}
else
{
    <div class="kb-formulier">
        @foreach (var v in Kop.Variabelen)
        {
            var naam = v.Naam;
            <label class="kb-veld">
                <span>@v.Label @if (v.Verplicht) { <span class="kb-verplicht" title="verplicht">*</span> }</span>
                @switch (v.Soort)
                {
                    case VariabeleSoort.JaNee:
                        <span><input type="checkbox" checked="@IsJa(naam)" @onchange="e => ZetJaNee(naam, e)" /> ja</span>
                        break;
                    case VariabeleSoort.Keuze:
                        <select class="kb-invoer" value="@Waarde(naam)" @onchange="e => Zet(naam, e.Value?.ToString())">
                            <option value="">(kies)</option>
                            @foreach (var o in v.Opties ?? Array.Empty<string>())
                            {
                                <option value="@o">@o</option>
                            }
                        </select>
                        break;
                    case VariabeleSoort.Datum:
                        <span class="kb-rij">
                            @if (!IsRelatief(naam))
                            {
                                <input class="kb-invoer" type="date" value="@IsoDatum(Waarde(naam))" @onchange="e => Zet(naam, e.Value?.ToString())" />
                            }
                            <select class="kb-invoer" value="@RelatieveWaarde(naam)" @onchange="e => ZetRelatief(naam, e)" aria-label="Relatieve datum">
                                @foreach (var (w, t) in Relatief)
                                {
                                    <option value="@w">@t</option>
                                }
                            </select>
                        </span>
                        break;
                    case VariabeleSoort.Lijst:
                        <textarea class="kb-invoer" rows="4" placeholder="een waarde per regel" @onchange="e => Zet(naam, e.Value?.ToString())">@Waarde(naam)</textarea>
                        break;
                    case VariabeleSoort.Getal:
                        <input class="kb-invoer" type="number" value="@Waarde(naam)" @onchange="e => Zet(naam, e.Value?.ToString())" />
                        break;
                    default:
                        <input class="kb-invoer" value="@Waarde(naam)" list="@Lijstnaam(v.Soort)" @onchange="e => Zet(naam, e.Value?.ToString())"
                               placeholder="@Hint(v.Soort)" />
                        break;
                }
            </label>
        }
    </div>

    @foreach (var soort in Kop.Variabelen.Select(v => v.Soort).Distinct().Where(s => Lijstnaam(s) is not null))
    {
        <datalist id="@Lijstnaam(soort)">
            @foreach (var o in Keuzes(soort))
            {
                <option value="@o.Waarde">@o.Tekst</option>
            }
        </datalist>
    }
}

@code {
    [Parameter, EditorRequired] public ScriptKop Kop { get; set; } = new();
    [Parameter, EditorRequired] public Dictionary<string, string> Waarden { get; set; } = new();
    [Parameter] public EventCallback WaardenChanged { get; set; }

    private static readonly (string Waarde, string Tekst)[] Relatief =
    {
        (string.Empty, "(vaste datum)"), ("@vandaag", "vandaag"), ("@gisteren", "gisteren"), ("@werkjaar.van", "begin werkjaar (1/9)"),
        ("@werkjaar.tot", "einde werkjaar (31/8)"), ("@dezemaand.van", "begin deze maand"), ("@dezemaand.tot", "einde deze maand"),
        ("@vorigemaand.van", "begin vorige maand"), ("@vorigemaand.tot", "einde vorige maand"),
    };

    private string Waarde(string naam) => Waarden.TryGetValue(naam, out var w) ? w : string.Empty;

    private bool IsJa(string naam) => Waarde(naam) is "true" or "True" or "ja";

    private bool IsRelatief(string naam) => Waarde(naam).StartsWith('@');

    private string RelatieveWaarde(string naam) => IsRelatief(naam) ? Waarde(naam) : string.Empty;

    private Task ZetJaNee(string naam, ChangeEventArgs e) => Zet(naam, e.Value is true ? "true" : "false");

    private Task ZetRelatief(string naam, ChangeEventArgs e)
        => Zet(naam, string.IsNullOrEmpty(e.Value?.ToString()) ? DateTime.Today.ToString("yyyy-MM-dd") : e.Value!.ToString());

    private async Task Zet(string naam, string? waarde)
    {
        Waarden[naam] = waarde ?? string.Empty;
        await WaardenChanged.InvokeAsync();
    }

    private static string IsoDatum(string w)
        => DateTime.TryParseExact(w, new[] { "yyyy-MM-dd", "d/M/yyyy" }, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d)
            ? d.ToString("yyyy-MM-dd") : string.Empty;

    private static string? Lijstnaam(VariabeleSoort s) => s is VariabeleSoort.Gebruiker or VariabeleSoort.Groep or VariabeleSoort.Postvak or VariabeleSoort.Room
        ? "kb-keuzes-" + s.ToString().ToLowerInvariant() : null;

    private static string Hint(VariabeleSoort s) => s switch
    {
        VariabeleSoort.Gebruiker => "UPN, bv. voornaam.naam@...",
        VariabeleSoort.Groep => "naam of adres van de groep",
        VariabeleSoort.Postvak => "adres van het postvak",
        VariabeleSoort.Room => "adres van de room",
        VariabeleSoort.Bestand => "volledig pad naar een bestand",
        VariabeleSoort.Map => "volledig pad naar een map",
        _ => string.Empty,
    };

    private IEnumerable<(string Waarde, string Tekst)> Keuzes(VariabeleSoort s)
    {
        var d = State.Data;
        return s switch
        {
            VariabeleSoort.Gebruiker => d.Personen.Where(p => p.Upn.Length > 0).Select(p => (p.Upn, p.Naam)),
            VariabeleSoort.Groep => d.Index.Groepen.Select(g => (g.Mail.Length > 0 ? g.Mail : g.Naam, g.Naam)),
            VariabeleSoort.Postvak => d.Postvakken.Select(p => (p.Smtp, p.DisplayName)),
            VariabeleSoort.Room => d.Rooms.Select(r => (r.Smtp, r.DisplayName)),
            _ => Enumerable.Empty<(string, string)>(),
        };
    }
}
