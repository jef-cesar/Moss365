@* Welke Conditional Access-beleiden voor één persoon gelden, en waarom *@
@inject BeheerState State

<section class="kb-kaart">
    <h2>Conditional Access</h2>
    @if (Persoon.Entra is null)
    {
        <p class="kb-zacht">Geen Entra-account: Conditional Access geldt enkel bij aanmelden in Entra.</p>
    }
    else if (State.Data.ConditionalAccess is not { Melding: null } ca || CaGebruiker.Van(Persoon, State.Data) is not { } g)
    {
        <p class="kb-zacht">Niet geladen (Verbindingen, Alles live laden). <a href="conditional-access">Naar Conditional Access</a></p>
    }
    else
    {
        var naam = CaLezer.Namen(State.Data);
        var regels = ca.Beleiden.Where(b => b.Status != CaStatus.Uit)
            .Select(b => (Beleid: b, Antwoord: CaLezer.Bereik(b, g, naam, ca)))
            .OrderBy(x => x.Antwoord.Geldt).ThenBy(x => x.Beleid.Status).ToList();
        var geldt = regels.Count(r => r.Antwoord.Geldt != CaGeldt.Nee && r.Beleid.Status == CaStatus.Aan);
        <p class="kb-zacht">
            @geldt van de @regels.Count(r => r.Beleid.Status == CaStatus.Aan) beleiden die aan staan, gelden voor deze persoon (enkel wie: apps en voorwaarden spelen
            bij elke aanmelding mee). <a href="@($"conditional-access?persoon={Uri.EscapeDataString(Persoon.Sleutel)}")">Wat als deze persoon zich aanmeldt...</a>
        </p>
        <table class="kb-tabel">
            <thead><tr><th>Beleid</th><th>Staat</th><th>Voor deze persoon</th><th>Waarom</th><th>Gevolg</th></tr></thead>
            <tbody>
                @foreach (var (b, a) in regels)
                {
                    <tr class="@(a.Geldt == CaGeldt.Nee ? "kb-zacht" : null)">
                        <td><a href="@($"conditional-access/{Uri.EscapeDataString(b.Id)}")">@b.Naam</a></td>
                        <td><CaLabel Status="b.Status" /></td>
                        <td><CaLabel Geldt="a.Geldt" /></td>
                        <td>@a.Reden</td>
                        <td>@CaLezer.Uitleg(b, ca, naam).Gevolg</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    [Parameter, EditorRequired] public Persoon Persoon { get; set; } = null!;
}
