@* Kolommen over de tijd (een of twee gestapelde reeksen), in SVG. Dunne kolommen (hoogstens 24), afgerond aan de top,
   een haarlijn-raster, een legende vanaf twee reeksen, de waarde enkel bij de hoogste kolom, en een tabel als alternatief.
   Een kolom met een KPI opent de lijst met precies die rijen. *@
@inject NavigationManager Nav

@if (Kolommen.Count > 0 && Max == 0)
{
    <p class="kb-zacht">@LeegTekst</p>
}
else if (Kolommen.Count > 0)
{
    <svg class="kb-kolomgrafiek" viewBox="0 0 @B @H" role="img" aria-label="@Titel">
        @foreach (var t in Ticks)
        {
            var y = Y(t);
            <line x1="@F(L)" x2="@F(B - R)" y1="@F(y)" y2="@F(y)" class="@(t == 0 ? "kb-as" : "kb-raster")" />
            <g><text x="@F(L - 6)" y="@F(y + 4)" text-anchor="end" class="kb-as-tekst">@Kort(t)</text></g>
        }
        @for (var i = 0; i < Kolommen.Count; i++)
        {
            var k = Kolommen[i];
            var midden = L + Band * (i + 0.5);
            var hoogsteReeks = Enumerable.Range(0, k.Waarden.Count).LastOrDefault(r => k.Waarden[r] > 0, -1);
            var opgeteld = 0;
            var vorigeTop = Y(0);
            var eerste = true;
            for (var r = 0; r < k.Waarden.Count; r++)
            {
                if (k.Waarden[r] == 0) { continue; }
                opgeteld += k.Waarden[r];
                var top = Y(opgeteld);
                var bodem = eerste ? Y(0) : vorigeTop - 2; // 2px oppervlak tussen de delen
                <path d="@Kolom(midden - Breedte / 2, bodem, Breedte, Math.Max(0, bodem - top), r == hoogsteReeks)" class="kb-kleur-@(Reeksen.ElementAtOrDefault(r)?.Kleur ?? "reeks")" />
                vorigeTop = top;
                eerste = false;
            }
            if (k.Totaal == Max && Max > 0 && i == Kolommen.ToList().FindLastIndex(x => x.Totaal == Max))
            {
                <g><text x="@F(midden)" y="@F(Y(k.Totaal) - 6)" text-anchor="middle" class="kb-waarde-tekst">@k.Totaal</text></g>
            }
            if (i % LabelStap == 0 || i == Kolommen.Count - 1)
            {
                <g><text x="@F(midden)" y="@F(H - 6)" text-anchor="middle" class="kb-as-tekst">@k.Label</text></g>
            }
            <rect x="@F(L + Band * i)" y="@F(T)" width="@F(Band)" height="@F(H - T - Onder)" class="kb-raak @(k.Kpi is not null ? "kb-klikbaar" : null)"
                  tabindex="@(k.Kpi is not null ? 0 : -1)" @onclick="() => Open(k)" @onkeydown="e => Toets(e, k)">
                <title>@k.Tip</title>
            </rect>
        }
    </svg>
    @if (Reeksen.Count > 1)
    {
        <ul class="kb-legende" role="list">
            @foreach (var r in Reeksen)
            {
                <li><span class="kb-sleutel kb-kleur-@r.Kleur" aria-hidden="true"></span> @r.Naam</li>
            }
        </ul>
    }
    <details class="kb-als-tabel">
        <summary>Als tabel</summary>
        <table class="kb-tabel">
            <thead><tr><th>@KolomTitel</th>@foreach (var r in Reeksen) { <th class="kb-getal">@r.Naam</th> }</tr></thead>
            <tbody>
                @foreach (var k in Kolommen)
                {
                    <tr>
                        <td>@if (k.Kpi is not null) { <a href="@k.Kpi.Link">@k.Tip.Split(':')[0]</a> } else { @k.Tip.Split(':')[0] }</td>
                        @foreach (var w in k.Waarden) { <td class="kb-getal">@w</td> }
                    </tr>
                }
            </tbody>
        </table>
    </details>
}

@code {
    public sealed record Reeks(string Naam, string Kleur = "reeks");

    [Parameter, EditorRequired] public IReadOnlyList<GrafiekKolom> Kolommen { get; set; } = Array.Empty<GrafiekKolom>();
    [Parameter] public IReadOnlyList<Reeks> Reeksen { get; set; } = new[] { new Reeks("Aantal") };
    [Parameter] public string Titel { get; set; } = string.Empty;
    [Parameter] public string KolomTitel { get; set; } = "Periode";
    [Parameter] public string LeegTekst { get; set; } = "Nog niets in deze periode.";

    // Maten in de eenheden van de viewBox
    private const int B = 640, H = 200, L = 40, R = 8, T = 14, Onder = 24;
    private double Band => (B - L - R) / (double)Kolommen.Count;
    private double Breedte => Math.Min(24, Band * 0.6);
    private int LabelStap => Band >= 40 ? 1 : Band >= 20 ? 2 : 3;
    private int Max => Kolommen.Count == 0 ? 0 : Kolommen.Max(k => k.Totaal);

    /// <summary>Ronde stappen (1, 2 of 5 maal een macht van tien), hoogstens vijf lijnen.</summary>
    private IReadOnlyList<int> Ticks
    {
        get
        {
            var max = Math.Max(1, Max);
            var stap = 1;
            foreach (var basis in new[] { 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000, 2000, 5000, 10000 })
            {
                stap = basis;
                if (max / basis <= 4) { break; }
            }

            var top = (int)Math.Ceiling(max / (double)stap) * stap;
            return Enumerable.Range(0, top / stap + 1).Select(i => i * stap).ToList();
        }
    }

    private double Y(int waarde) => H - Onder - (H - Onder - T) * waarde / (double)Math.Max(1, Ticks[^1]);

    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static string Kort(int v) => v >= 1000 ? (v / 1000.0).ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("nl-BE")) + "K" : v.ToString();

    /// <summary>Een kolom met de basis recht en (voor het bovenste deel) een top met een ronding van 4.</summary>
    private static string Kolom(double x, double onder, double breedte, double hoogte, bool rondeTop)
    {
        var r = rondeTop ? Math.Min(4, Math.Min(breedte / 2, hoogte)) : 0;
        var boven = onder - hoogte;
        return string.Create(System.Globalization.CultureInfo.InvariantCulture,
            $"M{x:0.##},{onder:0.##} V{boven + r:0.##} Q{x:0.##},{boven:0.##} {x + r:0.##},{boven:0.##} H{x + breedte - r:0.##} Q{x + breedte:0.##},{boven:0.##} {x + breedte:0.##},{boven + r:0.##} V{onder:0.##} Z");
    }

    private void Open(GrafiekKolom k)
    {
        if (k.Kpi is not null)
        {
            Nav.NavigateTo(k.Kpi.Link);
        }
    }

    private void Toets(KeyboardEventArgs e, GrafiekKolom k)
    {
        if (e.Key is "Enter" or " ")
        {
            Open(k);
        }
    }
}
