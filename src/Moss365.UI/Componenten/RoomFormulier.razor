@* Gewenste roominstellingen; leeg laten = niet wijzigen *@
<div class="kb-raster">
    <label>Verwerking <select class="kb-invoer" @bind="Gewenst.AutomateProcessing"><option value="">(niet wijzigen)</option><option>AutoAccept</option><option>AutoUpdate</option><option>None</option></select></label>
    <label>Boekingsvenster (dagen) <input class="kb-invoer" type="number" @bind="Gewenst.BookingWindowInDays" /></label>
    <label>Maximale duur (min.) <input class="kb-invoer" type="number" @bind="Gewenst.MaximumDurationInMinutes" /></label>
    <label>Conflicten toestaan <JaNee @bind-Waarde="Gewenst.AllowConflicts" /></label>
    <label>Terugkerende vergaderingen <JaNee @bind-Waarde="Gewenst.AllowRecurringMeetings" /></label>
    <label>Organisator in onderwerp <JaNee @bind-Waarde="Gewenst.AddOrganizerToSubject" /></label>
    <label>Onderwerp wissen <JaNee @bind-Waarde="Gewenst.DeleteSubject" /></label>
    <label>Standaardrecht agenda
        <select class="kb-invoer" @bind="Gewenst.StandaardAgendaRecht">
            <option value="">(niet wijzigen)</option><option>AvailabilityOnly</option><option>LimitedDetails</option><option>Reviewer</option>
        </select>
    </label>
    <label>Gebouw <input class="kb-invoer" @bind="Gewenst.Gebouw" /></label>
    <label>Verdieping <input class="kb-invoer" @bind="Gewenst.Verdieping" /></label>
    <label>Verdiepingslabel <input class="kb-invoer" @bind="Gewenst.VerdiepingLabel" /></label>
    <label>Capaciteit <input class="kb-invoer" type="number" @bind="Gewenst.Capaciteit" /></label>
</div>

@code {
    [Parameter, EditorRequired] public RoomGewenst Gewenst { get; set; } = new();

    /// <summary>Lege tekstvelden betekenen "niet wijzigen".</summary>
    public static RoomGewenst Opgeschoond(RoomGewenst g) => new()
    {
        AutomateProcessing = Leeg(g.AutomateProcessing),
        BookingWindowInDays = g.BookingWindowInDays,
        MaximumDurationInMinutes = g.MaximumDurationInMinutes,
        AllowConflicts = g.AllowConflicts,
        AllowRecurringMeetings = g.AllowRecurringMeetings,
        AddOrganizerToSubject = g.AddOrganizerToSubject,
        DeleteSubject = g.DeleteSubject,
        StandaardAgendaRecht = Leeg(g.StandaardAgendaRecht),
        Gebouw = Leeg(g.Gebouw),
        Verdieping = Leeg(g.Verdieping),
        VerdiepingLabel = Leeg(g.VerdiepingLabel),
        Capaciteit = g.Capaciteit,
    };

    private static string? Leeg(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
