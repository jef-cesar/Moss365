@* Zoekt een gebruiker, groep, postvak of room; Soorten beperkt wat gekozen kan worden *@
@inject BeheerState State

<div class="kb-kiezer">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label>@Label</label>
    }
    <div class="kb-filters">
        <input class="kb-invoer kb-breed" placeholder="@Plaatshouder" @bind="zoek" @bind:event="oninput" aria-label="@(Label ?? Plaatshouder)" />
    </div>
    @if (Resultaten.Count > 0)
    {
        <ul class="kb-keuzes">
            @foreach (var r in Resultaten)
            {
                <li>
                    <button class="kb-link" @onclick="() => Kies(r)">@r.Naam</button>
                    <span class="kb-soort">@r.SoortTekst</span>
                    <span class="kb-zacht">@r.Detail</span>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Plaatshouder { get; set; } = "Zoek op naam of adres";
    [Parameter] public IReadOnlyCollection<ObjectSoort>? Soorten { get; set; }
    [Parameter] public EventCallback<ObjectRef> Gekozen { get; set; }

    private string zoek = string.Empty;

    private IReadOnlyList<ObjectRef> Resultaten
    {
        get
        {
            var z = zoek.Trim();
            if (z.Length < 2)
            {
                return Array.Empty<ObjectRef>();
            }

            bool Mag(ObjectSoort s) => Soorten is null || Soorten.Contains(s);
            bool Past(params string?[] velden) => velden.Any(v => v?.Contains(z, StringComparison.OrdinalIgnoreCase) == true);
            var d = State.Data;
            var uit = new List<ObjectRef>();
            if (Mag(ObjectSoort.Gebruiker))
            {
                uit.AddRange(d.Personen.Where(p => !p.IsGast && Past(p.Naam, p.Upn, p.Ad?.SamAccountName, p.Entra?.Mail))
                    .Where(p => d.Index.Zoek(p.Upn) is not { Soort: ObjectSoort.Postvak or ObjectSoort.Room })
                    .Select(d.Index.Ref));
            }

            if (Mag(ObjectSoort.Groep))
            {
                uit.AddRange(d.Index.Groepen.Where(g => Past(g.Naam, g.Mail, g.Ad?.SamAccountName)).Select(g => g.Ref));
            }

            if (Mag(ObjectSoort.Postvak))
            {
                uit.AddRange(d.Postvakken.Where(p => Past(p.DisplayName, p.Smtp)).Select(p => new ObjectRef(ObjectSoort.Postvak, p.Smtp, p.DisplayName, p.Smtp)));
            }

            if (Mag(ObjectSoort.Room))
            {
                uit.AddRange(d.Rooms.Where(r => Past(r.DisplayName, r.Smtp)).Select(r => new ObjectRef(ObjectSoort.Room, r.Smtp, r.DisplayName, r.Smtp)));
            }

            return uit.OrderBy(r => r.Naam.StartsWith(z, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(r => r.Naam, StringComparer.CurrentCultureIgnoreCase).Take(12).ToList();
        }
    }

    private async Task Kies(ObjectRef r)
    {
        zoek = string.Empty;
        await Gekozen.InvokeAsync(r);
    }
}
