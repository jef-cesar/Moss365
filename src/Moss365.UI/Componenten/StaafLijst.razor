@* Horizontale staven (één reeks): naam, staaf en het getal ernaast. Met Totaal toont de staaf het deel daarvan. *@
<ul class="kb-staven" role="list">
    @foreach (var s in Staven)
    {
        var breedte = s.Totaal is > 0 ? s.Deel : Max == 0 ? 0 : (double)s.Aantal / Max;
        var waarschuwing = Waarschuwing?.Invoke(s) == true;
        <li class="kb-staaf @(waarschuwing ? "kb-staaf-let" : null)" title="@Titel(s)">
            <span class="kb-staaf-naam">@if (s.Link is not null) { <a href="@s.Link">@s.Naam</a> } else { @s.Naam }</span>
            <span class="kb-staaf-spoor"><span class="kb-staaf-vulling" style="width: @((breedte * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
            <span class="kb-staaf-getal">
                @(s.Totaal is { } t ? $"{s.Aantal} / {t}" : s.Aantal.ToString())
                @if (waarschuwing) { <span class="kb-status-let">⚠ @WaarschuwingTekst</span> }
            </span>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Staaf> Staven { get; set; } = Array.Empty<Staaf>();
    [Parameter] public Func<Staaf, bool>? Waarschuwing { get; set; }
    [Parameter] public string WaarschuwingTekst { get; set; } = "let op";

    private int Max => Staven.Count == 0 ? 0 : Staven.Max(s => s.Aantal);

    private static string Titel(Staaf s) => s.Totaal is { } t
        ? $"{s.Naam}: {s.Aantal} van {t} ({s.Deel:P0}), {t - s.Aantal} vrij"
        : $"{s.Naam}: {s.Aantal}";
}
