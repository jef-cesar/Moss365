@* Een verdeling als één gestapelde staaf (100%), met een legende die het aantal en het deel toont. Elk deel en elke
   regel van de legende opent de lijst met precies die rijen (KPI). Kleur volgt de rol van het deel (Kleur in GrafiekDeel). *@
@inject NavigationManager Nav

@if (Totaal == 0)
{
    <p class="kb-zacht">@LeegTekst</p>
}
else
{
    <div class="kb-verdeling" role="img" aria-label="@AriaTekst">
        @foreach (var d in Delen.Where(d => d.Aantal > 0))
        {
            <span class="kb-verdeling-deel kb-kleur-@d.Kleur @(d.Kpi is not null ? "kb-klikbaar" : null)" style="flex-grow: @d.Aantal"
                  title="@($"{d.Naam}: {d.Aantal} ({Deel(d)})")" @onclick="() => Open(d)"></span>
        }
    </div>
    <ul class="kb-legende" role="list">
        @foreach (var d in Delen)
        {
            <li>
                <span class="kb-sleutel kb-kleur-@d.Kleur" aria-hidden="true"></span>
                @if (d.Kpi is not null && d.Aantal > 0) { <a href="@d.Kpi.Link">@d.Naam</a> } else { <span>@d.Naam</span> }
                <strong>@d.Aantal</strong> <span class="kb-zacht">@Deel(d)</span>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<GrafiekDeel> Delen { get; set; } = Array.Empty<GrafiekDeel>();
    [Parameter] public string LeegTekst { get; set; } = "Geen gegevens.";

    private int Totaal => Delen.Sum(d => d.Aantal);

    private string Deel(GrafiekDeel d) => Totaal == 0 ? "" : ((double)d.Aantal / Totaal).ToString("P0", System.Globalization.CultureInfo.GetCultureInfo("nl-BE"));

    private string AriaTekst => string.Join(", ", Delen.Select(d => $"{d.Naam}: {d.Aantal}"));

    private void Open(GrafiekDeel d)
    {
        if (d.Kpi is not null)
        {
            Nav.NavigateTo(d.Kpi.Link);
        }
    }
}
