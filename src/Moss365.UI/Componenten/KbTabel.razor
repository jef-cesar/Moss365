@* Tabel met sorteren (klik op een kolomkop), kolommen tonen/verbergen en verplaatsen (slepen of pijltjes), filteren per
   kolom, pagina's (250, 500 of alles) en selecteren. Kolomkeuzes en het aantal per pagina worden per lijst (Id) bewaard
   en overleven een herstart; filters, pagina en selectie blijven zolang de app open is (ook na Terug en Vooruit). *@
@typeparam T
@inject BeheerState State

<div class="kb-tabel-balk">
    @if (Telling is not null)
    {
        <span class="kb-zacht">@Telling</span>
    }
    @if (sessie.AantalActief > 0)
    {
        <span class="kb-label kb-label-let">@sessie.AantalActief @(sessie.AantalActief == 1 ? "filter" : "filters"): @gefilterd.Count van @alle.Count</span>
        <button class="kb-knop kb-klein" @onclick="FiltersWissen">Filters wissen</button>
    }
    @if (Selecteerbaar && GekozenSet.Count > 0)
    {
        <span class="kb-label">@GekozenSet.Count gekozen</span>
        <button class="kb-knop kb-klein" @onclick="SelectieWissen">Selectie wissen</button>
    }
    <span class="kb-tabel-knoppen">
        <button class="kb-knop kb-klein @(sessie.FiltersTonen ? "kb-primair" : null)" @onclick="() => sessie.FiltersTonen = !sessie.FiltersTonen" aria-expanded="@sessie.FiltersTonen">Filteren</button>
        @if (Selecteerbaar && GekozenSet.Count > 0 && State.Mag(Recht.Exporteren))
        {
            <button class="kb-knop kb-klein" @onclick="() => Exporteer(true)" title="Enkel de gekozen rijen">Exporteren (gekozen)</button>
        }
        <button class="kb-knop kb-klein" hidden="@(!State.Mag(Recht.Exporteren))" @onclick="() => Exporteer(false)" title="Alle (gefilterde) rijen, met de zichtbare kolommen, in deze volgorde en sortering, als CSV voor Excel">Exporteren</button>
        <button class="kb-knop kb-klein" @onclick="() => paneel = !paneel" aria-expanded="@paneel">Kolommen</button>
    </span>
</div>
@if (export is not null)
{
    <div class="kb-melding kb-export" role="status">
        @if (export.Fout is null)
        {
            <span>@export.Aantal rijen geëxporteerd naar <code>@export.Pad</code></span>
            <button class="kb-knop kb-klein" @onclick="() => State.Omgeving.ToonBestand(export.Pad)">Tonen in Verkenner</button>
        }
        else
        {
            <span>Exporteren mislukt: @export.Fout</span>
        }
        <button class="kb-knop kb-klein" @onclick="() => export = null" aria-label="Melding sluiten">&times;</button>
    </div>
}

@if (paneel)
{
    <div class="kb-kolompaneel" role="group" aria-label="Kolommen">
        <ul>
            @foreach (var (k, i) in Geordend.Select((k, i) => (k, i)))
            {
                <li>
                    <label><input type="checkbox" checked="@(!IsVerborgen(k))" @onchange="e => Zichtbaar(k, e)" /> @k.Titel</label>
                    <button class="kb-knop kb-klein" disabled="@(i == 0)" @onclick="() => Verplaats(k.Sleutel, -1)" aria-label="@($"{k.Titel} naar links")">&uarr;</button>
                    <button class="kb-knop kb-klein" disabled="@(i == Geordend.Count - 1)" @onclick="() => Verplaats(k.Sleutel, 1)" aria-label="@($"{k.Titel} naar rechts")">&darr;</button>
                </li>
            }
        </ul>
        <div class="kb-filters">
            <button class="kb-knop kb-klein" @onclick="Herstel">Standaard</button>
            <span class="kb-zacht">Je kan kolommen ook verslepen in de kop van de tabel.</span>
        </div>
    </div>
}

@if (Selecteerbaar && AlleOpPaginaGekozen && GekozenSet.Count < gefilterd.Count(Kiesbaar))
{
    <div class="kb-melding">
        De @pagina.Count rijen op deze pagina zijn gekozen.
        <button class="kb-link" @onclick="AllesKiezen">Alle @gefilterd.Count(Kiesbaar)@(sessie.AantalActief > 0 ? " gefilterde" : string.Empty) rijen kiezen</button>
    </div>
}

<table class="kb-tabel" data-lijst="@Id">
    <thead>
        <tr>
            @if (Selecteerbaar)
            {
                <th class="kb-kies"><input type="checkbox" checked="@AlleOpPaginaGekozen" @onchange="PaginaKiezen" aria-label="Alle rijen op deze pagina kiezen" title="Alle rijen op deze pagina" /></th>
            }
            @if (VoorKop is not null)
            {
                <th>@VoorKop</th>
            }
            @foreach (var k in Zichtbaar())
            {
                var actief = Actief == k.Sleutel;
                <th class="@(k.Getal ? "kb-getal" : null) @(k.SorteerOp is null ? null : "kb-sorteerbaar") @(gesleept == k.Sleutel ? "kb-gesleept" : null)"
                    draggable="true"
                    @ondragstart="() => gesleept = k.Sleutel"
                    @ondragend="() => gesleept = null"
                    @ondragover:preventDefault
                    @ondrop="() => Neerzetten(k.Sleutel)"
                    @onclick="() => Sorteer(k)"
                    aria-sort="@(actief ? (weergave.Aflopend ? "descending" : "ascending") : "none")"
                    title="@(k.SorteerOp is null ? "Sleep om te verplaatsen" : "Klik om te sorteren, sleep om te verplaatsen")">
                    @k.Titel@if (actief) { <span class="kb-pijl">@(weergave.Aflopend ? " ▼" : " ▲")</span> }
                    @if (sessie.Filters.TryGetValue(k.Sleutel, out var f) && f.Actief) { <span class="kb-filter-aan" title="Er staat een filter op deze kolom"> ⏷</span> }
                </th>
            }
        </tr>
        @if (sessie.FiltersTonen)
        {
            <tr class="kb-filterrij">
                @if (Selecteerbaar) { <th></th> }
                @if (VoorKop is not null) { <th></th> }
                @foreach (var k in Zichtbaar())
                {
                    var f = sessie.Filter(k.Sleutel);
                    var kolom = k;
                    <th>
                        @switch (SoortVan(k))
                        {
                            case FilterSoort.Tekst:
                                <input class="kb-invoer kb-klein" placeholder="bevat..." value="@f.Tekst" @oninput="e => ZetTekst(kolom, e)" aria-label="@($"Filter op {k.Titel}")" />
                                break;
                            case FilterSoort.Keuze:
                                <details class="kb-keuzefilter">
                                    <summary>@(f.Keuzes.Count == 0 ? "(alle)" : f.Keuzes.Count == 1 ? f.Keuzes.First() : $"{f.Keuzes.Count} gekozen")</summary>
                                    <div class="kb-keuzefilter-lijst">
                                        @foreach (var w in Waarden(k))
                                        {
                                            var waarde = w;
                                            <label><input type="checkbox" checked="@f.Keuzes.Contains(waarde)" @onchange="e => ZetKeuze(kolom, waarde, e)" /> @(waarde.Length == 0 ? "(leeg)" : waarde)</label>
                                        }
                                    </div>
                                </details>
                                break;
                            case FilterSoort.Bereik:
                                var datum = IsDatum(k);
                                <span class="kb-bereik">
                                    <input class="kb-invoer kb-klein" type="@(datum ? "date" : "number")" value="@f.Van" @onchange="e => ZetBereik(kolom, e, true)" aria-label="@($"{k.Titel} vanaf")" title="vanaf" />
                                    <input class="kb-invoer kb-klein" type="@(datum ? "date" : "number")" value="@f.Tot" @onchange="e => ZetBereik(kolom, e, false)" aria-label="@($"{k.Titel} tot en met")" title="tot en met" />
                                </span>
                                break;
                        }
                    </th>
                }
            </tr>
        }
    </thead>
    <tbody>
        @for (var r = 0; r < pagina.Count; r++)
        {
            var item = pagina[r];
            var index = r;
            var sleutel = Selecteerbaar ? SleutelVan!(item) : null;
            <tr class="@RijKlasse?.Invoke(item) @(sleutel is not null && GekozenSet.Contains(sleutel) ? "kb-rij-gekozen" : null)">
                @if (Selecteerbaar)
                {
                    <td class="kb-kies"><input type="checkbox" checked="@GekozenSet.Contains(sleutel!)" @onclick="e => Kies(index, e)" aria-label="Kiezen"
                                               disabled="@(!Kiesbaar(item))" title="@(Kiesbaar(item) ? null : WaaromNiet?.Invoke(item))" /></td>
                }
                @if (Voor is not null)
                {
                    <td>@Voor(item)</td>
                }
                @foreach (var k in Zichtbaar())
                {
                    <td class="@(k.Getal ? "kb-getal" : null)">@k.Cel(item)</td>
                }
            </tr>
        }
    </tbody>
</table>
@if (gefilterd.Count == 0 && alle.Count > 0)
{
    <p class="kb-zacht">Geen rijen voor deze filters. <button class="kb-link" @onclick="FiltersWissen">Filters wissen</button></p>
}

<div class="kb-pagineren">
    @if (PerPagina > 0 && gefilterd.Count > PerPagina)
    {
        <button class="kb-knop kb-klein" disabled="@(sessie.Pagina == 0)" @onclick="() => NaarPagina(sessie.Pagina - 1)">&larr; Vorige</button>
        <span>@(sessie.Pagina * PerPagina + 1)–@Math.Min(gefilterd.Count, (sessie.Pagina + 1) * PerPagina) van @gefilterd.Count.ToString("N0")</span>
        <button class="kb-knop kb-klein" disabled="@((sessie.Pagina + 1) * PerPagina >= gefilterd.Count)" @onclick="() => NaarPagina(sessie.Pagina + 1)">Volgende &rarr;</button>
    }
    @if (gefilterd.Count > 250 || weergave.PerPagina is not null)
    {
        <label class="kb-zacht">
            Per pagina
            <select class="kb-invoer kb-klein" value="@PerPagina" @onchange="ZetPerPagina" aria-label="Rijen per pagina">
                <option value="250">250</option>
                <option value="500">500</option>
                <option value="0">alles</option>
            </select>
        </label>
    }
</div>

@code {
    /// <summary>Naam waaronder de keuzes bewaard worden, bv. "gebruikers".</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IEnumerable<T> Items { get; set; } = Array.Empty<T>();
    [Parameter, EditorRequired] public IReadOnlyList<Kolom<T>> Kolommen { get; set; } = Array.Empty<Kolom<T>>();

    /// <summary>Rijen per pagina zolang de gebruiker niets kiest (standaard 250).</summary>
    [Parameter] public int? Max { get; set; }

    [Parameter] public Func<T, string?>? RijKlasse { get; set; }

    /// <summary>Vaste eerste cel (bv. een selectievakje), niet sorteerbaar of verplaatsbaar.</summary>
    [Parameter] public RenderFragment<T>? Voor { get; set; }
    [Parameter] public RenderFragment? VoorKop { get; set; }

    /// <summary>Sortering zolang de gebruiker niets kiest.</summary>
    [Parameter] public string? StandaardSortering { get; set; }

    /// <summary>Begin van de bestandsnaam bij exporteren (standaard het Id), bv. "Gebruikers".</summary>
    [Parameter] public string? ExportNaam { get; set; }

    /// <summary>Tekst boven de tabel, bv. "123 gevonden".</summary>
    [Parameter] public string? Telling { get; set; }

    /// <summary>Rijen kiezen met een vakje (ook alle rijen, over alle pagina's); vraagt een sleutel per rij.</summary>
    [Parameter] public bool Selecteerbaar { get; set; }
    [Parameter] public Func<T, string>? SleutelVan { get; set; }

    /// <summary>Eigen verzameling voor de gekozen sleutels (bv. bewaard als formulier); standaard die van de lijst.</summary>
    [Parameter] public HashSet<string>? Gekozen { get; set; }

    /// <summary>Kan deze rij gekozen worden (bv. niet terug te draaien in het logboek)? Standaard alles.</summary>
    [Parameter] public Func<T, bool>? KanKiezen { get; set; }

    /// <summary>Uitleg bij een rij die niet gekozen kan worden.</summary>
    [Parameter] public Func<T, string?>? WaaromNiet { get; set; }

    /// <summary>Gemeld als de selectie verandert (de sleutels van de gekozen rijen).</summary>
    [Parameter] public EventCallback<IReadOnlyCollection<string>> SelectieGewijzigd { get; set; }

    private TabelWeergave weergave = new();
    private TabelSessie sessie = new();
    private bool paneel;
    private string? gesleept;
    private List<T> alle = new();
    private List<T> gefilterd = new();
    private List<T> pagina = new();
    private int? laatsteKlik;
    private readonly Dictionary<string, FilterSoort> soorten = new();
    private readonly Dictionary<string, List<string>> waarden = new();
    private object? waardenVan;

    private int PerPagina => weergave.PerPagina ?? Max ?? 250;

    private HashSet<string> GekozenSet => Gekozen ?? sessie.Gekozen;

    private bool Kiesbaar(T item) => KanKiezen?.Invoke(item) ?? true;

    protected override void OnParametersSet()
    {
        weergave = State.Weergave.Tabel(Id);
        sessie = State.TabelSessie(Id);
        Bereken();
    }

    private void Bereken()
    {
        var vorigAantal = alle.Count;
        alle = Items.ToList();
        if (!ReferenceEquals(waardenVan, Items))
        {
            waardenVan = Items;
            soorten.Clear();
            waarden.Clear();
        }

        gefilterd = Gesorteerd(Gefilterd(alle));

        // Andere zoekterm of filter op het scherm: terug naar pagina 1 (en nooit voorbij de laatste pagina)
        if (vorigAantal != 0 && vorigAantal != alle.Count)
        {
            sessie.Pagina = 0;
        }

        if (PerPagina > 0 && sessie.Pagina * PerPagina >= gefilterd.Count)
        {
            sessie.Pagina = Math.Max(0, (gefilterd.Count - 1) / PerPagina);
        }

        pagina = PerPagina > 0 ? gefilterd.Skip(sessie.Pagina * PerPagina).Take(PerPagina).ToList() : gefilterd;
    }

    // ------------------------------------------------------------------ kolommen

    private bool IsVerborgen(Kolom<T> k)
        => weergave.Verborgen.Contains(k.Sleutel) || (k.Verborgen && !weergave.Getoond.Contains(k.Sleutel));

    /// <summary>Alle kolommen in de gekozen volgorde; nieuwe kolommen (na een update) achteraan.</summary>
    private List<Kolom<T>> Geordend
    {
        get
        {
            var plaats = weergave.Volgorde.Select((s, i) => (s, i)).ToDictionary(x => x.s, x => x.i);
            return Kolommen.Select((k, i) => (k, i))
                .OrderBy(x => plaats.TryGetValue(x.k.Sleutel, out var p) ? p : 1000 + x.i)
                .Select(x => x.k).ToList();
        }
    }

    /// <summary>De kolom waarop nu gesorteerd wordt: de keuze van de gebruiker, anders de standaard.</summary>
    private string? Actief => weergave.Sorteer ?? StandaardSortering;

    private IEnumerable<Kolom<T>> Zichtbaar() => Geordend.Where(k => !IsVerborgen(k));

    // ------------------------------------------------------------------ filteren

    private FilterSoort SoortVan(Kolom<T> k)
    {
        if (k.Filter != FilterSoort.Automatisch)
        {
            return k.Filter;
        }

        if (soorten.TryGetValue(k.Sleutel, out var s))
        {
            return s;
        }

        if (k.SorteerOp is null && k.Tekst is null)
        {
            s = FilterSoort.Geen;
        }
        else if (IsDatum(k) || alle.Select(x => k.SorteerOp?.Invoke(x)).FirstOrDefault(w => w is not null) is int or long or double or decimal)
        {
            s = FilterSoort.Bereik;
        }
        else
        {
            var verschillend = Waarden(k).Count;
            s = verschillend <= 25 && alle.Count > verschillend ? FilterSoort.Keuze : FilterSoort.Tekst;
        }

        soorten[k.Sleutel] = s;
        return s;
    }

    private bool IsDatum(Kolom<T> k) => alle.Select(x => k.SorteerOp?.Invoke(x)).FirstOrDefault(w => w is not null) is DateTime or DateTimeOffset;

    private List<string> Waarden(Kolom<T> k)
    {
        if (!waarden.TryGetValue(k.Sleutel, out var lijst))
        {
            lijst = alle.Select(x => k.TekstVan(x).Trim()).Distinct(StringComparer.CurrentCultureIgnoreCase)
                .OrderBy(w => w, StringComparer.CurrentCultureIgnoreCase).Take(200).ToList();
            waarden[k.Sleutel] = lijst;
        }

        return lijst;
    }

    private List<T> Gefilterd(List<T> lijst)
    {
        foreach (var (sleutel, f) in sessie.Filters.Where(x => x.Value.Actief))
        {
            if (Kolommen.FirstOrDefault(k => k.Sleutel == sleutel) is not { } k)
            {
                continue;
            }

            if (f.Keuzes.Count > 0)
            {
                lijst = lijst.Where(x => f.Keuzes.Contains(k.TekstVan(x).Trim())).ToList();
            }

            if (f.Tekst.Trim().Length > 0)
            {
                var t = f.Tekst.Trim();
                lijst = lijst.Where(x => k.TekstVan(x).Contains(t, StringComparison.CurrentCultureIgnoreCase)).ToList();
            }

            if (f.Van.Trim().Length > 0 || f.Tot.Trim().Length > 0)
            {
                lijst = lijst.Where(x => InBereik(k.SorteerOp?.Invoke(x), f)).ToList();
            }
        }

        return lijst;
    }

    private static bool InBereik(object? waarde, KolomFilter f)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        switch (waarde)
        {
            case DateTime or DateTimeOffset:
                var d = waarde is DateTimeOffset o ? o.LocalDateTime.Date : ((DateTime)waarde).Date;
                if (DateTime.TryParse(f.Van, inv, System.Globalization.DateTimeStyles.None, out var van) && d < van.Date) return false;
                if (DateTime.TryParse(f.Tot, inv, System.Globalization.DateTimeStyles.None, out var tot) && d > tot.Date) return false;
                return true;
            case null:
                return false;
            default:
                if (!double.TryParse(Convert.ToString(waarde, inv), System.Globalization.NumberStyles.Any, inv, out var g)) return false;
                if (double.TryParse(f.Van, System.Globalization.NumberStyles.Any, inv, out var min) && g < min) return false;
                if (double.TryParse(f.Tot, System.Globalization.NumberStyles.Any, inv, out var max) && g > max) return false;
                return true;
        }
    }

    private void ZetTekst(Kolom<T> k, ChangeEventArgs e)
    {
        sessie.Filter(k.Sleutel).Tekst = e.Value?.ToString() ?? string.Empty;
        NaFilter();
    }

    private void ZetKeuze(Kolom<T> k, string waarde, ChangeEventArgs e)
    {
        var f = sessie.Filter(k.Sleutel);
        if (e.Value is true)
        {
            f.Keuzes.Add(waarde);
        }
        else
        {
            f.Keuzes.Remove(waarde);
        }

        NaFilter();
    }

    private void ZetBereik(Kolom<T> k, ChangeEventArgs e, bool van)
    {
        var f = sessie.Filter(k.Sleutel);
        if (van)
        {
            f.Van = e.Value?.ToString() ?? string.Empty;
        }
        else
        {
            f.Tot = e.Value?.ToString() ?? string.Empty;
        }

        NaFilter();
    }

    private void FiltersWissen()
    {
        sessie.Filters.Clear();
        NaFilter();
    }

    private void NaFilter()
    {
        sessie.Pagina = 0;
        Bereken();
    }

    // ------------------------------------------------------------------ pagina's

    private void NaarPagina(int p)
    {
        sessie.Pagina = Math.Max(0, p);
        Bereken();
    }

    private void ZetPerPagina(ChangeEventArgs e)
    {
        weergave.PerPagina = int.TryParse(e.Value?.ToString(), out var n) ? n : 250;
        sessie.Pagina = 0;
        State.Weergave.Bewaar();
        Bereken();
    }

    // ------------------------------------------------------------------ selecteren

    private bool AlleOpPaginaGekozen => Selecteerbaar && pagina.Any(Kiesbaar) && pagina.Where(Kiesbaar).All(x => GekozenSet.Contains(SleutelVan!(x)));

    private async Task Kies(int index, MouseEventArgs e)
    {
        var sleutel = SleutelVan!(pagina[index]);
        var aan = !GekozenSet.Contains(sleutel);

        // Shift-klik: alles tussen de vorige klik en deze
        var van = e.ShiftKey && laatsteKlik is { } l ? Math.Min(l, index) : index;
        var tot = e.ShiftKey && laatsteKlik is { } l2 ? Math.Max(l2, index) : index;
        for (var i = van; i <= tot && i < pagina.Count; i++)
        {
            if (!Kiesbaar(pagina[i]))
            {
                continue;
            }

            var s = SleutelVan!(pagina[i]);
            if (aan)
            {
                GekozenSet.Add(s);
            }
            else
            {
                GekozenSet.Remove(s);
            }
        }

        laatsteKlik = index;
        await SelectieGewijzigd.InvokeAsync(GekozenSet.ToList());
    }

    private async Task PaginaKiezen(ChangeEventArgs e)
    {
        foreach (var s in pagina.Where(Kiesbaar).Select(SleutelVan!))
        {
            if (e.Value is true)
            {
                GekozenSet.Add(s);
            }
            else
            {
                GekozenSet.Remove(s);
            }
        }

        await SelectieGewijzigd.InvokeAsync(GekozenSet.ToList());
    }

    private async Task AllesKiezen()
    {
        GekozenSet.UnionWith(gefilterd.Where(Kiesbaar).Select(SleutelVan!));
        await SelectieGewijzigd.InvokeAsync(GekozenSet.ToList());
    }

    private async Task SelectieWissen()
    {
        GekozenSet.Clear();
        laatsteKlik = null;
        await SelectieGewijzigd.InvokeAsync(GekozenSet.ToList());
    }

    // ------------------------------------------------------------------ sorteren, exporteren, kolommen

    private sealed record ExportUitkomst(string Pad, int Aantal, string? Fout);

    private ExportUitkomst? export;

    /// <summary>De items in de gekozen sortering.</summary>
    private List<T> Gesorteerd(List<T> lijst)
    {
        var sleutel = Actief;
        var kolom = Kolommen.FirstOrDefault(k => k.Sleutel == sleutel && k.SorteerOp is not null);
        if (kolom is not null)
        {
            // Lege waarden altijd achteraan, ook bij aflopend sorteren
            var metWaarde = lijst.Select(x => (x, w: kolom.SorteerOp!(x))).ToList();
            var leeg = metWaarde.Where(x => x.w is null || x.w is string { Length: 0 }).Select(x => x.x);
            var vol = metWaarde.Where(x => !(x.w is null || x.w is string { Length: 0 }));
            var gesorteerd = weergave.Aflopend
                ? vol.OrderByDescending(x => x.w, SorteerVergelijker.Instantie)
                : vol.OrderBy(x => x.w, SorteerVergelijker.Instantie);
            lijst = gesorteerd.Select(x => x.x).Concat(leeg).ToList();
        }

        return lijst;
    }

    /// <summary>Exporteert alle gefilterde rijen (of enkel de gekozen) met de zichtbare kolommen naar de exportmap.</summary>
    private void Exporteer(bool enkelGekozen)
    {
        if (!State.Mag(Recht.Exporteren))
        {
            return;
        }

        var kolommen = Zichtbaar().ToList();
        var rijen = enkelGekozen ? gefilterd.Where(x => GekozenSet.Contains(SleutelVan!(x))).ToList() : gefilterd;
        var pad = Path.Combine(State.Omgeving.ExportMap, CsvSchrijver.Bestandsnaam($"{ExportNaam ?? (Id.Length > 0 ? char.ToUpperInvariant(Id[0]) + Id[1..] : "Lijst")}-{DateTime.Now:yyyyMMdd-HHmmss}") + ".csv");
        try
        {
            CsvSchrijver.Schrijf(pad, kolommen.Select(k => k.Titel), rijen.Select(r => kolommen.Select(k => k.TekstVan(r))), voorExcel: true);
            export = new ExportUitkomst(pad, rijen.Count, null);
            State.Toegang("Export", $"{Id}: {rijen.Count} rijen{(enkelGekozen ? " (gekozen)" : string.Empty)}, {kolommen.Count} kolommen");
        }
        catch (Exception ex)
        {
            export = new ExportUitkomst(pad, 0, ex.Message);
        }
    }

    private void Sorteer(Kolom<T> k)
    {
        if (k.SorteerOp is null)
        {
            return;
        }

        if (Actief == k.Sleutel)
        {
            weergave.Sorteer = k.Sleutel;
            weergave.Aflopend = !weergave.Aflopend;
        }
        else
        {
            weergave.Sorteer = k.Sleutel;
            weergave.Aflopend = false;
        }

        State.Weergave.Bewaar();
        Bereken();
    }

    private void Zichtbaar(Kolom<T> k, ChangeEventArgs e)
    {
        var tonen = e.Value is true || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        weergave.Verborgen.Remove(k.Sleutel);
        weergave.Getoond.Remove(k.Sleutel);
        if (!tonen)
        {
            weergave.Verborgen.Add(k.Sleutel);
        }
        else if (k.Verborgen)
        {
            weergave.Getoond.Add(k.Sleutel);
        }

        State.Weergave.Bewaar();
    }

    private void Verplaats(string sleutel, int richting)
    {
        // Verborgen kolommen overslaan, zodat de stap ook zichtbaar is in de tabel
        var geordend = Geordend;
        var i = geordend.FindIndex(k => k.Sleutel == sleutel);
        var j = i + richting;
        while (j >= 0 && j < geordend.Count && IsVerborgen(geordend[j]) && !IsVerborgen(geordend[i]))
        {
            j += richting;
        }

        if (i < 0 || j < 0 || j >= geordend.Count)
        {
            return;
        }

        var volgorde = geordend.Select(k => k.Sleutel).ToList();
        volgorde.RemoveAt(i);
        volgorde.Insert(j, sleutel);
        weergave.Volgorde = volgorde;
        State.Weergave.Bewaar();
    }

    private void Neerzetten(string doel)
    {
        if (gesleept is null || gesleept == doel)
        {
            gesleept = null;
            return;
        }

        var volgorde = Geordend.Select(k => k.Sleutel).ToList();
        volgorde.Remove(gesleept);
        volgorde.Insert(volgorde.IndexOf(doel), gesleept);
        weergave.Volgorde = volgorde;
        gesleept = null;
        State.Weergave.Bewaar();
    }

    private void Herstel()
    {
        State.Weergave.HerstelTabel(Id);
        weergave = State.Weergave.Tabel(Id);
        Bereken();
    }
}
