@inject BeheerState State

<div class="kb-kiezer">
    <label>@Label</label>
    @if (Gekozen is not null)
    {
        <div class="kb-gekozen">
            <strong>@Gekozen.Naam</strong> <span class="kb-zacht">@Gekozen.Upn &middot; @Gekozen.Bron</span>
            <button class="kb-knop kb-klein" @onclick="Wis">Wijzig</button>
        </div>
    }
    else
    {
        <input class="kb-invoer" placeholder="Zoek op naam, UPN of sAMAccountName" @bind="zoek" @bind:event="oninput" />
        @if (Resultaten.Count > 0)
        {
            <ul class="kb-keuzes">
                @foreach (var p in Resultaten)
                {
                    <li><button class="kb-link" @onclick="() => Kies(p)">@p.Naam <span class="kb-zacht">@p.Upn &middot; @p.Bron</span></button></li>
                }
            </ul>
        }
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "Gebruiker";
    [Parameter] public Persoon? Gekozen { get; set; }
    [Parameter] public EventCallback<Persoon?> GekozenChanged { get; set; }

    private string zoek = string.Empty;

    private IReadOnlyList<Persoon> Resultaten => zoek.Trim().Length < 2
        ? Array.Empty<Persoon>()
        : Zoeker.Zoek(State.Data.Personen, zoek, metGasten: false).Take(8).ToList();

    private async Task Kies(Persoon p)
    {
        zoek = string.Empty;
        await GekozenChanged.InvokeAsync(p);
    }

    private Task Wis() => GekozenChanged.InvokeAsync(null);
}
