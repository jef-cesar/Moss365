@* Vraagt bevestiging als je een scherm met niet-bewaarde instellingen verlaat: Bewaren, Verwerpen of Blijven. *@
@implements IDisposable
@inject NavigationManager Nav

@if (doel is not null)
{
    <div class="kb-dialoog-achter">
        <div class="kb-dialoog" role="alertdialog" aria-labelledby="kb-weggaan-titel">
            <h2 id="kb-weggaan-titel">Niet bewaard</h2>
            <p>@Tekst</p>
            <div class="kb-filters">
                <button class="kb-knop kb-primair" disabled="@(!KanBewaren)" @onclick="BewaarEnGa">Bewaren</button>
                <button class="kb-knop" @onclick="VerwerpEnGa">Verwerpen</button>
                <button class="kb-knop" @onclick="() => doel = null">Blijven</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Er is iets niet bewaard: weggaan wordt eerst gevraagd.</summary>
    [Parameter] public bool Actief { get; set; }
    [Parameter] public bool KanBewaren { get; set; } = true;
    [Parameter] public string Tekst { get; set; } = "Je hebt niet-bewaarde wijzigingen.";
    [Parameter] public EventCallback Bewaren { get; set; }
    [Parameter] public EventCallback Verwerpen { get; set; }

    private IDisposable? registratie;
    private string? doel;
    private bool doorlaten;

    protected override void OnInitialized() => registratie = Nav.RegisterLocationChangingHandler(Wijzigt);

    private ValueTask Wijzigt(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (Actief && !doorlaten)
        {
            context.PreventNavigation();
            doel = context.TargetLocation;
            _ = InvokeAsync(StateHasChanged);
        }

        return ValueTask.CompletedTask;
    }

    private async Task BewaarEnGa()
    {
        await Bewaren.InvokeAsync();
        Ga();
    }

    private async Task VerwerpEnGa()
    {
        await Verwerpen.InvokeAsync();
        Ga();
    }

    private void Ga()
    {
        if (doel is { } d)
        {
            doel = null;
            doorlaten = true;
            Nav.NavigateTo(d);
        }
    }

    public void Dispose() => registratie?.Dispose();
}
