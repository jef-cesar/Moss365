@* Label voor een oordeel, de staat van een beleid of "geldt"; altijd met tekst, nooit enkel kleur *@
@if (Oordeel is { } o)
{
    <span class="kb-label @Klasse(o)">@(o switch { CaOordeel.InOrde => "✓ in orde", CaOordeel.Info => "info", CaOordeel.Aandacht => "⚠ aandacht", _ => "✕ probleem" })</span>
}
else if (Status is { } s)
{
    <span class="kb-label @(s switch { CaStatus.Aan => "kb-label-goed", CaStatus.Rapport => "kb-label-let", _ => null })">@CaLezer.StatusNaam(s)</span>
}
else if (Geldt is { } g)
{
    <span class="kb-label @(g switch { CaGeldt.Ja => "kb-label-goed", CaGeldt.Misschien => "kb-label-let", _ => null })">@(g switch { CaGeldt.Ja => "geldt", CaGeldt.Misschien => "misschien", _ => "geldt niet" })</span>
}

@code {
    [Parameter] public CaOordeel? Oordeel { get; set; }
    [Parameter] public CaStatus? Status { get; set; }
    [Parameter] public CaGeldt? Geldt { get; set; }

    private static string? Klasse(CaOordeel o) => o switch
    {
        CaOordeel.InOrde => "kb-label-goed",
        CaOordeel.Aandacht => "kb-label-let",
        CaOordeel.Probleem => "kb-rood",
        _ => null,
    };
}
