@* PowerShell-editor: Monaco (de editor van VS Code, ingebouwd); lukt dat niet, dan een gewoon tekstvak *@
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (zonderEditor)
{
    <textarea class="kb-invoer kb-code" spellcheck="false" rows="28" readonly="@AlleenLezen" value="@Tekst" @oninput="TekstvakGewijzigd" aria-label="Script"></textarea>
}
else
{
    <div class="kb-editor" @ref="vak"></div>
}

@code {
    [Parameter] public string Tekst { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TekstChanged { get; set; }
    [Parameter] public bool AlleenLezen { get; set; }

    /// <summary>Fouten om te onderlijnen (regel, kolom, tekst).</summary>
    [Parameter] public IReadOnlyList<ScriptGebeurtenis>? Fouten { get; set; }

    private ElementReference vak;
    private DotNetObjectReference<CodeEditor>? zelf;
    private bool klaar;
    private bool zonderEditor;
    private string laatst = string.Empty;
    private IReadOnlyList<ScriptGebeurtenis>? getoondeFouten;

    protected override async Task OnAfterRenderAsync(bool eersteKeer)
    {
        if (eersteKeer && !zonderEditor)
        {
            try
            {
                zelf = DotNetObjectReference.Create(this);
                klaar = await JS.InvokeAsync<bool>("mossEditor.maak", vak, Tekst, zelf, AlleenLezen);
                laatst = Tekst;
            }
            catch (Exception)
            {
                klaar = false;
            }

            if (!klaar)
            {
                zonderEditor = true;
                StateHasChanged();
            }
        }
        else if (klaar)
        {
            if (Tekst != laatst)
            {
                laatst = Tekst;
                await JS.InvokeVoidAsync("mossEditor.zet", vak, Tekst);
            }

            if (!ReferenceEquals(Fouten, getoondeFouten))
            {
                getoondeFouten = Fouten;
                await JS.InvokeVoidAsync("mossEditor.markeer", vak,
                    (Fouten ?? Array.Empty<ScriptGebeurtenis>()).Select(f => new { regel = f.Regel ?? 1, kolom = f.Kolom ?? 1, tekst = f.Tekst }).ToArray());
            }
        }
    }

    [JSInvokable]
    public async Task Gewijzigd(string tekst)
    {
        laatst = tekst;
        Tekst = tekst;
        await TekstChanged.InvokeAsync(tekst);
    }

    private async Task TekstvakGewijzigd(ChangeEventArgs e)
    {
        Tekst = e.Value?.ToString() ?? string.Empty;
        await TekstChanged.InvokeAsync(Tekst);
    }

    public async ValueTask DisposeAsync()
    {
        if (klaar)
        {
            try
            {
                await JS.InvokeVoidAsync("mossEditor.weg", vak);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
        }

        zelf?.Dispose();
    }
}
