@* De variabelen van een script: naam, vraag, soort, verplicht, standaard en (bij Keuze) de opties *@

<table class="kb-tabel kb-variabelen">
    <thead><tr><th>Naam</th><th>Vraag</th><th>Soort</th><th>Verplicht</th><th>Standaard</th><th></th></tr></thead>
    <tbody>
        @for (var i = 0; i < rijen.Count; i++)
        {
            var r = rijen[i];
            var index = i;
            <tr>
                <td><input class="kb-invoer" value="@r.Naam" @onchange="e => Zet(index, r with { Naam = Schoon(e.Value) })" aria-label="Naam" placeholder="Postvak" /></td>
                <td><input class="kb-invoer" value="@r.Vraag" @onchange="e => Zet(index, r with { Vraag = e.Value?.ToString() ?? string.Empty })" aria-label="Vraag" placeholder="Welk postvak?" /></td>
                <td>
                    <select class="kb-invoer" value="@r.Soort" @onchange="e => Zet(index, r with { Soort = Enum.Parse<VariabeleSoort>(e.Value?.ToString() ?? nameof(VariabeleSoort.Tekst)) })" aria-label="Soort">
                        @foreach (var s in Enum.GetValues<VariabeleSoort>())
                        {
                            <option value="@s">@SoortNaam(s)</option>
                        }
                    </select>
                    @if (r.Soort == VariabeleSoort.Keuze)
                    {
                        <input class="kb-invoer" value="@string.Join("; ", r.Opties ?? Array.Empty<string>())" placeholder="optie 1; optie 2" aria-label="Opties"
                               @onchange="e => Zet(index, r with { Opties = (e.Value?.ToString() ?? string.Empty).Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) })" />
                    }
                </td>
                <td><input type="checkbox" checked="@r.Verplicht" @onchange="e => Zet(index, r with { Verplicht = e.Value is true })" aria-label="Verplicht" /></td>
                <td><input class="kb-invoer" value="@r.Standaard" @onchange="e => Zet(index, r with { Standaard = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString() })" aria-label="Standaard" /></td>
                <td class="kb-knoppen-klein">
                    <button class="kb-knop kb-klein" title="Omhoog" disabled="@(index == 0)" @onclick="() => Verplaats(index, -1)">&uarr;</button>
                    <button class="kb-knop kb-klein" title="Omlaag" disabled="@(index == rijen.Count - 1)" @onclick="() => Verplaats(index, 1)">&darr;</button>
                    <button class="kb-knop kb-klein" title="Verwijderen" @onclick="() => Verwijder(index)">&times;</button>
                </td>
            </tr>
        }
    </tbody>
</table>
<button class="kb-knop" @onclick="Nieuw">+ Variabele</button>
<p class="kb-zacht">
    De naam is de parameter in het script (<code>$Naam</code>): enkel letters, cijfers en _. Een datum kan ook relatief zijn,
    bv. <code>@@werkjaar.van</code> of <code>@@vorigemaand.tot</code>.
</p>

@code {
    [Parameter] public IReadOnlyList<ScriptVariabele> Variabelen { get; set; } = Array.Empty<ScriptVariabele>();
    [Parameter] public EventCallback<IReadOnlyList<ScriptVariabele>> VariabelenChanged { get; set; }

    private List<ScriptVariabele> rijen = new();
    private IReadOnlyList<ScriptVariabele>? vorige;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(vorige, Variabelen))
        {
            vorige = Variabelen;
            rijen = Variabelen.ToList();
        }
    }

    public static string SoortNaam(VariabeleSoort s) => s switch
    {
        VariabeleSoort.JaNee => "Ja/nee",
        VariabeleSoort.Lijst => "Lijst (meerdere)",
        _ => s.ToString(),
    };

    private static string Schoon(object? waarde)
        => new string((waarde?.ToString() ?? string.Empty).Where(c => char.IsLetterOrDigit(c) || c == '_').ToArray());

    private Task Zet(int i, ScriptVariabele nieuw)
    {
        rijen[i] = nieuw;
        return Doorgeven();
    }

    private Task Nieuw()
    {
        var n = 1;
        while (rijen.Any(r => r.Naam.Equals($"Waarde{n}", StringComparison.OrdinalIgnoreCase)))
        {
            n++;
        }

        rijen.Add(new ScriptVariabele($"Waarde{n}", VariabeleSoort.Tekst, false, string.Empty));
        return Doorgeven();
    }

    private Task Verwijder(int i)
    {
        rijen.RemoveAt(i);
        return Doorgeven();
    }

    private Task Verplaats(int i, int richting)
    {
        (rijen[i], rijen[i + richting]) = (rijen[i + richting], rijen[i]);
        return Doorgeven();
    }

    private async Task Doorgeven()
    {
        vorige = rijen.ToList();
        await VariabelenChanged.InvokeAsync(vorige);
    }
}
